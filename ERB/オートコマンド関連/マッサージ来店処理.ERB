DRAWLINE

$INPUT_LOOP
INPUT

SELECTCASE RESULT
	CASE 100
		RETURN 管理番号
	CASE 118
		CALL ランダムキャラ名前変更(Ｒキャラ追加候補記録, 管理番号)
		GOTO 表示_LOOP
	CASE 120
		INVERTBIT OPTION変数:汎用立ち絵制御, 0
		GOTO 表示_LOOP
	CASE 130
		INVERTBIT OPTION変数:ワーウルフ画像ケモ度, 0
		;今の候補がワーウルフなら即時適用
		SIF GETBIT(特殊種族フラグ, 0)
			CALL ランダムキャラ画像キー再選択(Ｒキャラ追加候補記録, 管理番号)
		GOTO 表示_LOOP
	CASE 131
		CALL ランダムキャラそっくりさん設定
		GOTO 表示_LOOP
	CASEELSE
		GOTO INPUT_LOOP
ENDSELECT
