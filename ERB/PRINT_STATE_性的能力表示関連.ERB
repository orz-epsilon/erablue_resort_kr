	素質名 '= ""
ELSEIF 性別 == 3 || 性別 == 0
	;ふたなり・無性
	素質名 '= ""
ELSEIF 性別 == 性愛傾向
	;[女性愛]持ち女性 / [男性愛]持ち男性
	素質名 '= "異性愛"
ELSE
	;それ以外
	素質名 '= "同性愛"
ENDIF
RETURNF 素質名
