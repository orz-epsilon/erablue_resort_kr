@敵トリガー行動_Lv55_カミカイヒ
#DIM 攻撃回数
#DIM 与ダメージ量

;F GETBIT(敵BATTLE_STATE:(戦闘行動キャラ - 10):トリガー行動フラグ, 2) == 0
;
;
;	アビ汎用文字列:実行時メッセージ１ = %敵BATTLE_STATE_STR:(戦闘行動キャラ - 10):エネミー名%は身を隠した！
;	
;
;	CALL アビ対象選択テンプレート_自己のみ
;	アビ汎用文字列:バフ・デバフ枠 = カミカイヒ
;	アビ汎用文字列:バフ・デバフ対象能力 = 潜伏
;	アビ汎用変数:消去不可オプション = 1
;	アビ汎用変数:持続ターン = -1
;	CALL アビテンプレート_有利効果_バフ効果セット
;	;トリガーフラグをセット
;
;	CALL アビ汎用変数文字列リセット
;	アビ汎用変数:消去不可オプション = 1
;	アビ汎用変数:持続ターン = -1
;	アビ汎用変数:特殊表示オプション = 1
;	アビ汎用文字列:バフ・デバフ枠 = ボスフラグ_状態異常耐性_即死
;	アビ汎用文字列:バフ・デバフ対象能力 = 状態異常耐性_即死
;	アビ汎用変数:効果量 = 999
;	CALL アビテンプレート_有利効果_バフ効果セット
;
;	SETBIT 敵BATTLE_STATE:(戦闘行動キャラ - 10):トリガー行動フラグ, 2
;
;
IF 現在ターン数 == 10
	WSTR:(K++) = 키쿠루：「지금이야!」
	WSTR:(K++) = %敵BATTLE_STATE_STR:(戦闘行動キャラ - 10):エネミー名%은(는) 함정에 빠졌다!
	WSTR:(K++) = 토키싯코：「너를 쓰러뜨리고, 나는 화장실에 가겠다!」
	;アビ汎用文字列:実行時メッセージ１ = キクル：：「今だ！」
	;アビ汎用文字列:実行時メッセージ１ = %敵BATTLE_STATE_STR:(戦闘行動キャラ - 10):エネミー名%は罠に嵌められた！
	;アビ汎用文字列:実行時メッセージ３ = トキシッコ：「お前を倒して，私はトイレに行かせてもらう！」

	CALL アビ対象選択テンプレート_自己のみ
	CALL アビ汎用変数文字列リセット
	アビ汎用文字列:バフ・デバフ枠 = 回避率A
	アビ汎用文字列:バフ・デバフ対象能力 = 回避率
	アビ汎用変数:効果量 = 100
	アビ汎用変数:持続ターン = 5
	アビ汎用変数:基礎成功確率 = 100
	CALL アビテンプレート_不利効果_デバフ効果セット

	CALL アビ対象選択テンプレート_自己のみ
	CALL アビ汎用変数文字列リセット
	アビ汎用文字列:バフ・デバフ枠 = 火傷
	アビ汎用文字列:バフ・デバフ対象能力 = 火傷
	アビ汎用変数:効果量 = 1000
	アビ汎用変数:累積上限_固定値 = 3000
	アビ汎用変数:持続ターン = -1
	アビ汎用変数:基礎成功確率 = 100
	CALL アビテンプレート_不利効果_累積デバフ効果セット


ELSEIF 敵BATTLE_STATE:(戦闘行動キャラ - 10):ＨＰ < 敵BATTLE_STATE:(戦闘行動キャラ - 10):最大ＨＰ * 1 / 3


	アビ汎用文字列:実行時メッセージ１ = %敵BATTLE_STATE_STR:(戦闘行動キャラ - 10):エネミー名%은(는) 필사적으로 저항한다!


	FOR 攻撃回数, 0, 5
		CALL アビ対象選択テンプレート_味方ランダムＸ体(1)
		アビ汎用変数:効果割合 = 100
		CALL アビテンプレート_ダメージ処理_自属性()	
		;与ダメージ量 = RESULT
		;IF 与ダメージ量 > 0		
		
		IF MATCH(被ダメ反応者, アビテンプレート用_対象保存:0) > 0	
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 劇毒
			アビ汎用文字列:バフ・デバフ対象能力 = 毒
			アビ汎用変数:効果量 = 400
			アビ汎用変数:累積上限_固定値 = 2000
			アビ汎用変数:持続ターン = 10
			;アビ汎用変数:消去不可オプション = 1
			CALL アビテンプレート_不利効果_累積デバフ効果セット
			
			アビ汎用文字列:バフ・デバフ枠 = 麻痺
			アビ汎用文字列:バフ・デバフ対象能力 = 麻痺
			アビ汎用変数:効果割合 = 90
			アビ汎用変数:持続ターン = 2
			アビ汎用変数:基礎成功確率 = 100
			CALL アビテンプレート_不利効果_デバフ効果セット
		ENDIF
	NEXT
	敵BATTLE_STATE:(戦闘行動キャラ - 10):チャージターン += 1
ELSE
	アビ汎用文字列:実行時メッセージ１ = %敵BATTLE_STATE_STR:(戦闘行動キャラ - 10):エネミー名%은(는) 공격을 시작한다!
	CALL アビ対象選択テンプレート_味方ランダムＸ体(1)
	アビ汎用変数:効果割合 = 100
	CALL アビテンプレート_ダメージ処理_自属性()	
	;与ダメージ量 = RESULT
	;IF 与ダメージ量 > 0		
		
	IF MATCH(被ダメ反応者, アビテンプレート用_対象保存:0) > 0
		
	;ELSE 
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 劇毒
		アビ汎用文字列:バフ・デバフ対象能力 = 독
		アビ汎用変数:効果量 = 400
		アビ汎用変数:累積上限_固定値 = 2000
		アビ汎用変数:持続ターン = 10
		;アビ汎用変数:消去不可オプション = 1
		CALL アビテンプレート_不利効果_累積デバフ効果セット

		アビ汎用文字列:バフ・デバフ枠 = 마비
		アビ汎用文字列:バフ・デバフ対象能力 = 마비
		アビ汎用変数:効果割合 = 90
		アビ汎用変数:持続ターン = 2
		アビ汎用変数:基礎成功確率 = 100
		CALL アビテンプレート_不利効果_デバフ効果セット
	ENDIF
	敵BATTLE_STATE:(戦闘行動キャラ - 10):チャージターン += 1
	;RETURN 0
ENDIF

RETURN 1

@敵チャージ行動_Lv55_カミカイヒ
#DIM 攻撃回数
#DIM 与ダメージ量

	アビ汎用文字列:実行時メッセージ１ = %敵BATTLE_STATE_STR:(戦闘行動キャラ - 10):エネミー名%은(는) 실을 뿜었다!
	CALL アビ対象選択テンプレート_味方全体_生者のみ
	アビ汎用文字列:バフ・デバフ枠 = 糸_麻痺
	アビ汎用文字列:バフ・デバフ対象能力 = 마비
	アビ汎用変数:効果割合 = 65
	アビ汎用変数:持続ターン = 2
	アビ汎用変数:基礎成功確率 = 60
	CALL アビテンプレート_不利効果_デバフ効果セット
		
		
	CALL アビ対象選択テンプレート_味方全体_生者のみ
	アビ汎用文字列:バフ・デバフ枠 = 回避率A
	アビ汎用文字列:バフ・デバフ対象能力 = 회피율
	アビ汎用変数:効果割合 = 65
	アビ汎用変数:持続ターン = 2
	アビ汎用変数:基礎成功確率 = 60
	CALL アビテンプレート_不利効果_デバフ効果セット
		
	FOR 攻撃回数, 0, 5
		CALL アビ対象選択テンプレート_味方ランダムＸ体(1)
		アビ汎用変数:効果割合 = 100
		CALL アビテンプレート_ダメージ処理_自属性()
		与ダメージ量 = RESULT
		
		;IF 与ダメージ量 > 0		
			
		IF MATCH(被ダメ反応者, アビテンプレート用_対象保存:0) > 0	
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 맹독
			アビ汎用文字列:バフ・デバフ対象能力 = 독
			アビ汎用変数:効果量 = 400
			アビ汎用変数:累積上限_固定値 = 2000
			アビ汎用変数:持続ターン = 10
			;アビ汎用変数:消去不可オプション = 1
			CALL アビテンプレート_不利効果_累積デバフ効果セット
			
			アビ汎用文字列:バフ・デバフ枠 = 마비
			アビ汎用文字列:バフ・デバフ対象能力 = 마비
			アビ汎用変数:効果割合 = 90
			アビ汎用変数:持続ターン = 2
			アビ汎用変数:基礎成功確率 = 100
			CALL アビテンプレート_不利効果_デバフ効果セット
		ENDIF
	NEXT
	
	CALL アビ対象選択テンプレート_自己のみ
	CALL アビ汎用変数文字列リセット
	アビ汎用文字列:バフ・デバフ枠 = 回避率B
	アビ汎用文字列:バフ・デバフ対象能力 = 회피율
	アビ汎用変数:効果量 = 100
	アビ汎用変数:持続ターン = 1
	アビ汎用変数:基礎成功確率 = 100
	CALL アビテンプレート_不利効果_デバフ効果セット


