		LOCALS '= DT_CELL_GETS("アビエディタデータベース", 奥義ID:(選択番号 - 400), "어빌리티 대상", 1)
		IF LOCAL - 1 == 0 && LOCALS == "上と同じ相手"
			IF DT_CELL_GETS("アビエディタデータベース", RESULT:1, "アビ文字列３", 1) == "奥義基礎攻撃"
				DT_CELL_SET "アビエディタデータベース", 奥義ID:(選択番号 - 400), "アビ対象", "奥義と同じ相手", 1
			ELSE
				LOCALS '= DT_CELL_GETS("アビエディタデータベース", RESULT:1, "アビ対象", 1)
				DT_CELL_SET "アビエディタデータベース", RESULT:1, "アビ対象", DT_CELL_GETS("アビエディタデータベース", 奥義ID:(選択番号 - 400), "アビ対象", 1), 1
				DT_CELL_SET "アビエディタデータベース", 奥義ID:(選択番号 - 400), "アビ対象", LOCALS, 1
			ENDIF
		ENDIF
	CASE 500 TO 599
		;下に移動
		LOCAL = DT_CELL_GET("アビエディタデータベース", 奥義ID:(選択番号 - 500), "効果順番", 1)
		DT_SELECT "アビエディタデータベース", @"効果順番 = {LOCAL + 1}"
		DT_CELL_SET "アビエディタデータベース", RESULT:1, "効果順番", LOCAL, 1
		DT_CELL_SET "アビエディタデータベース", 奥義ID:(選択番号 - 500), "効果順番", LOCAL + 1, 1
		;もしも奥義基礎攻撃が下に移動した場合、入れ替わった効果の奥義前不可の対象は奥義と同じ相手に書き換える
		LOCALS '= DT_CELL_GETS("アビエディタデータベース", RESULT:1, "アビ対象", 1)
		IF 基礎攻撃位置:(DT_CELL_GET("アビエディタデータベース", RESULT:1, "アビ段階", 1)) == LOCAL - 1 && GROUPMATCH(LOCALS, "味方単体", "敵単体", "敵横列", "敵縦列")
			DT_CELL_SET "アビエディタデータベース", RESULT:1, "アビ対象", "奥義と同じ相手", 1
		ENDIF
		;もしも下に移動した効果が二番目以降不可の対象だった時、入れ替え対象だったものと効果対象を入れ替える（基礎攻撃は動かさない）
		IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:(選択番号 - 500), "アビ文字列３", 1) != "奥義基礎攻撃"
			IF GROUPMATCH(DT_CELL_GETS("アビエディタデータベース", 奥義ID:(選択番号 - 500), "アビ対象", 1), "味方単体", "敵単体", "敵横列", "敵縦列")
				LOCALS '= DT_CELL_GETS("アビエディタデータベース", 奥義ID:(選択番号 - 500), "어빌리티 대상", 1)
				DT_CELL_SET "アビエディタデータベース", 奥義ID:(選択番号 - 500), "アビ対象", DT_CELL_GETS("アビエディタデータベース", RESULT:1, "アビ対象", 1), 1
				DT_CELL_SET "アビエディタデータベース", RESULT:1, "アビ対象", LOCALS, 1
			ENDIF
		ENDIF
		;もしも一番上に来た効果の位置が最初、かつ対象が「上と同じ」だった場合、入れ替え対象だったものと効果対象を入れ替える（基礎攻撃との入れ替えの時は奥義と同じに書き換える）
		LOCALS '= DT_CELL_GETS("アビエディタデータベース", RESULT:1, "アビ対象", 1)
		IF LOCAL == 0 && LOCALS == "上と同じ相手"
			IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:(選択番号 - 500), "アビ文字列３", 1) == "奥義基礎攻撃"
				DT_CELL_SET "アビエディタデータベース", RESULT:1, "アビ対象", "奥義と同じ相手", 1
			ELSE
				LOCALS '= DT_CELL_GETS("アビエディタデータベース", 奥義ID:(選択番号 - 500), "어빌리티 대상", 1)
				DT_CELL_SET "アビエディタデータベース", 奥義ID:(選択番号 - 500), "アビ対象", DT_CELL_GETS("アビエディタデータベース", RESULT:1, "アビ対象", 1), 1
				DT_CELL_SET "アビエディタデータベース", RESULT:1, "アビ対象", LOCALS, 1
			ENDIF
		ENDIF
	CASE 1000 TO 1010
		奥義段階 = 選択番号 - 1000
ENDSELECT

; SIF 消費ＭＰ:奥義段階 < 0
; 	CALL ＭＰ自動計算(消費ＭＰ, 取得条件:奥義段階, 奥義段階)
GOTO 動作LOOP



@奥義エディタ_ERB生成(対象No, 奥義名, 取得条件)
#DIM DB行数
#DIMS 奥義ERB記述
#DIMS 奥義説明記述, 10
#DIMS 奥義効果記述_奥義前, 10
#DIMS 奥義効果記述, 10
#DIMS 効果一時保存
#DIM 奥義段階
#DIM 奥義威力
#DIM DYNAMIC 最大奥義段階
#DIM 対象No
#DIMS REF 奥義名
#DIMS REF 取得条件
#DIMS 取得条件_文字列, 10
#DIM 奥義ID, 100
#DIM 基礎攻撃位置, 5

VARSET 奥義説明記述
VARSET 奥義効果記述
VARSET 奥義効果記述_奥義前
VARSET 基礎攻撃位置, -1

;奥義段階は連番であること、全てに奥義名が設定されていることを前提とする
FOR 奥義段階, 0, VARSIZE("奥義名")
	SIF 奥義名:奥義段階 != "" && 奥義名:奥義段階 != "（未定）"
		最大奥義段階 = 奥義段階
NEXT

奥義ERB記述 = @固有奥義_{対象No}(ARGS, キャラ番号)<br>
奥義ERB記述 += "#DIM キャラ番号<br>"
奥義ERB記述 += "#DIM 奥義威力<br>"
奥義ERB記述 += "#DIMS 奥義名<br>"
奥義ERB記述 += "#DIM 表示用奥義威力<br>"
奥義ERB記述 += "<br>"

;ここに習得条件入れる
IF MATCH(取得条件, "") < VARSIZE("取得条件") || MATCH(奥義名, "（未定）") < VARSIZE("奥義名") - 1
	;取得条件存在、もしくは奥義名複数時にIF文を記述する
	VARSET 取得条件_文字列 
	FOR 奥義段階, 最大奥義段階, -1, -1
		;取得条件を解析
		VARSET RESULTS
		SPLIT 取得条件:奥義段階, "***", RESULTS
		FOR LOCAL, 0, RESULT
			IF STRFIND(RESULTS:LOCAL, "Lv") >= 0
				SIF 取得条件_文字列:奥義段階 != ""
					取得条件_文字列:奥義段階 += " &amp;&amp; "
				取得条件_文字列:奥義段階 += @"基礎BATTLE_STATE:キャラ番号:Lv >= %REPLACE(RESULTS:LOCAL, "Lv_", "")%"
			ELSEIF STRFIND(RESULTS:LOCAL, "陥落") >= 0
				SIF 取得条件_文字列:奥義段階 != ""
					取得条件_文字列:奥義段階 += " &amp;&amp; "
				SELECTCASE REPLACE(RESULTS:LOCAL, "陥落_", "")
					CASE "陥落"
						取得条件_文字列:奥義段階 += "陥落チェック(キャラ番号)"
					CASE "恋慕"
						取得条件_文字列:奥義段階 += "陥落チェック_恋慕系(キャラ番号)"
					CASE "セフレ"
						取得条件_文字列:奥義段階 += "GETBIT(陥落チェック(キャラ番号), 1)"
					CASE "非エロ"
						取得条件_文字列:奥義段階 += "陥落チェック_非性的(キャラ番号)"
				ENDSELECT
			ENDIF
		NEXT
		SIF 取得条件_文字列:奥義段階 == ""
			取得条件_文字列:奥義段階 = 1
		IF 奥義段階 == 最大奥義段階
			奥義ERB記述 += @"IF %取得条件_文字列:奥義段階%<br>"
		ELSE
			奥義ERB記述 += @"ELSEIF %取得条件_文字列:奥義段階%<br>"
		ENDIF
		奥義ERB記述 += @"	奥義名 = %奥義名:奥義段階%<br>"
		DT_SELECT "アビエディタデータベース", @"アビ段階 = {奥義段階} And アビ文字列３ = '奥義基礎攻撃'"
		IF !奥義基礎攻撃_特殊チェック(RESULT:1)
			奥義ERB記述 += @"	奥義威力 = {DT_CELL_GET("アビエディタデータベース", RESULT:1, "アビ数値１", 1)}<br>"
		ELSE
			奥義ERB記述 += @"	奥義威力 = 0<br>"
			奥義ERB記述 += @"	表示用奥義威力 = {DT_CELL_GET("アビエディタデータベース", RESULT:1, "アビ数値１", 1)}<br>"
		ENDIF
	NEXT
	奥義ERB記述 += "ENDIF<br><br>"
ELSE
	奥義ERB記述 += @"奥義名 = %奥義名:0%<br>"
	DT_SELECT "アビエディタデータベース", @"アビ段階 = 0 And アビ文字列３ = '奥義基礎攻撃'"
	IF !奥義基礎攻撃_特殊チェック(RESULT:1)
		奥義ERB記述 += @"	奥義威力 = {DT_CELL_GET("アビエディタデータベース", RESULT:1, "アビ数値１", 1)}<br>"
	ELSE
		奥義ERB記述 += @"	奥義威力 = 0<br>"
		奥義ERB記述 += @"	表示用奥義威力 = {DT_CELL_GET("アビエディタデータベース", RESULT:1, "アビ数値１", 1)}<br>"
	ENDIF
ENDIF

VARSET RESULT
DT_SELECT "アビエディタデータベース", "", "アビ段階 ASC, 効果順番 ASC"
;配列に保存
ARRAYCOPY "RESULT", "奥義ID"
ARRAYSHIFT 奥義ID, -1, 0
奥義段階 = 0

;基礎攻撃の位置記録
FOR DB行数, 0, DT_ROW_LENGTH("アビエディタデータベース")
	SIF 奥義段階 != DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ段階", 1)
		奥義段階 = DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ段階", 1)

	IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列３", 1) == "奥義基礎攻撃"
		奥義説明記述:奥義段階 += @"오의 위력：{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1)}　"
		基礎攻撃位置:奥義段階 = DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "効果順番", 1)
		IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1) > 1
			奥義説明記述:奥義段階 += @"{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1)}회"
		ENDIF
		IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値３", 1) < 0
			奥義説明記述:奥義段階 += "자속성"
		ELSE
			奥義説明記述:奥義段階 += @"<font color='#%カラーパレット_HTML(@"%属性数値文字列変換(DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値３", 1))%属性")%'>%属性数値文字列変換(DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値３", 1))%속성</font>"
		ENDIF
		IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) == "敵横列"
			奥義説明記述:奥義段階 += "가로열 공격"
		ELSEIF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) == "敵縦列"
			奥義説明記述:奥義段階 += "세로열 공격"
		ELSEIF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) == "敵全体"
奥義説明記述:奥義段階 += "전체 공격"
		ENDIF
		IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1) != "攻撃力"
			奥義説明記述:奥義段階 += @"（%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%의존）"
		ENDIF
		奥義説明記述:奥義段階 += "<br>"

		IF 奥義基礎攻撃_特殊チェック(奥義ID:DB行数)
			奥義効果記述_奥義前:奥義段階 += アビエディタ_対象CALL変換(DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1))
			奥義効果記述_奥義前:奥義段階 += "ARRAYCOPY \"アビテンプレート用_対象保存\", \"アビテンプレート用_奥義使用先保存\"<br>"
		ENDIF
	ENDIF
NEXT


FOR DB行数, 0, DT_ROW_LENGTH("アビエディタデータベース")
	効果一時保存 = 

	SIF 奥義段階 != DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ段階", 1)
		奥義段階 = DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ段階", 1)

	;まず奥義基礎攻撃
	IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列３", 1) == "奥義基礎攻撃"
		IF !奥義基礎攻撃_特殊チェック(奥義ID:DB行数)
			CONTINUE
		ENDIF
	ENDIF

	奥義説明記述:奥義段階 += "<br>"

	IF 基礎攻撃位置:奥義段階 > DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "効果順番", 1)
		奥義説明記述:奥義段階 += "오의 전에"
	ENDIF

	;各種効果
	SELECTCASE DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ効果種別", 1)
		CASE "ダメージ効果"
			IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列３", 1) != "奥義基礎攻撃"
				IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) == "奥義と同じ相手"
					奥義説明記述:奥義段階 += "오의의 대상에게"
				ELSEIF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) != "上と同じ相手"
					奥義説明記述:奥義段階 += @"%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1)%에게"
				ENDIF
				IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1) > 0
					奥義説明記述:奥義段階 += @"［{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1)}％］"
					IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1) != "攻撃力"
						奥義説明記述:奥義段階 += @"（%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%의존）"
					ENDIF
				ELSE
					奥義説明記述:奥義段階 += @"［{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値２", 1)}］"
				ENDIF
				IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値３", 1) < 0
					奥義説明記述:奥義段階 += "의 자속성 데미지를"
				ELSE
					奥義説明記述:奥義段階 += @"의<font color='#%カラーパレット_HTML(@"%属性数値文字列変換(DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値３", 1))%属性")%'>%属性数値文字列変換(DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値３", 1))%속성</font>데미지를"
				ENDIF
				IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1) < 2
					奥義説明記述:奥義段階 += "준다."
				ELSE
					奥義説明記述:奥義段階 += @"{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1)}회 준다."
				ENDIF
			ENDIF

			IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列３", 1) != "奥義基礎攻撃"
				効果一時保存 += "CALL アビ汎用変数文字列リセット<br>"
				IF DB行数 > 0 && DT_CELL_GETS("アビエディタデータベース", 奥義ID:(DB行数 - 1), "アビ文字列３", 1) == "奥義基礎攻撃" && DT_CELL_GETS("アビエディタデータベース", 奥義ID:(DB行数 - 1), "アビ対象", 1) == "敵単体" && DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) == "上と同じ相手"
					効果一時保存 += アビエディタ_対象CALL変換("오의 대상과 동일")
				ELSE
					効果一時保存 += アビエディタ_対象CALL変換(DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1))
				ENDIF
			ELSE
				効果一時保存 += アビエディタ_対象CALL変換("오의 대상과 동일")
			ENDIF
			IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1) > 0
				効果一時保存 += @"アビ汎用変数:効果割合 = {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1)}<br>"
				効果一時保存 += @"アビ汎用文字列:攻撃側使用能力値 = %DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%<br>"
			ELSE
				効果一時保存 += @"アビ汎用変数:効果量 = {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値２", 1)}<br>"
			ENDIF
			IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値３", 1) < 0
				LOCALS = CALL アビテンプレート_ダメージ処理_自属性
			ELSE
				LOCALS = CALL アビテンプレート_ダメージ処理_%属性数値文字列変換(DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値３", 1))%属性
			ENDIF
			IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1) > 1
				効果一時保存 += @"FOR LOCAL, 0, {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1)}<br>"
				効果一時保存 += @"	%LOCALS%<br>"
				効果一時保存 += @"NEXT<br>"
