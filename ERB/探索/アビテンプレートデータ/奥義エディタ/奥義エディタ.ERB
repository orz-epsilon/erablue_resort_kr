奥義ERB記述 += "		TSTR:コマンド名受渡 = \%奥義名\%<br>"
奥義ERB記述 += "	CASE \"오의 설명문\"<br>"
HTML_PRINT 奥義ERB記述, 1
IF MATCH(取得条件, "") < VARSIZE("取得条件") || MATCH(奥義名, "（未定）") < VARSIZE("奥義名") - 1
	FOR 奥義段階, 最大奥義段階, -1, -1
