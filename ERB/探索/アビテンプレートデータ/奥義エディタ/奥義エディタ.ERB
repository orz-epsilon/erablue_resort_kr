@奥義基礎攻撃_特殊チェック(判定ID)
#FUNCTION
#DIM 判定ID
;入力したIDの奥義基礎攻撃が特殊か通常かを見る

;単体攻撃
SIF DT_CELL_GETS("アビエディタデータベース", 判定ID, "アビ対象", 1) != "敵単体"
	RETURNF 1

;攻撃力依存
SIF DT_CELL_GETS("アビエディタデータベース", 判定ID, "アビ文字列１", 1) != "攻撃力"
	RETURNF 1

;自属性
SIF DT_CELL_GET("アビエディタデータベース", 判定ID, "アビ数値３", 1) >= 0
	RETURNF 1

;ダメージ１回
SIF DT_CELL_GET("アビエディタデータベース", 判定ID, "アビ数値４", 1) > 1
	RETURNF 1

;全部OKなら通常奥義
RETURNF 0
