			効果一時保存 += "CALL アビテンプレート_不利効果_デバフ効果セット<br>"
		CASE "その他不利効果"
			RSTR:表示設定受け渡し = 
			CALLF アビエディタ_ＭＰ自動計算_不利効果種類(DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1))
			IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) == "奥義と同じ相手"
				奥義説明記述:奥義段階 += "오의의 대상에게"
			ELSEIF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) != "上と同じ相手"
				奥義説明記述:奥義段階 += @"%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1)%에게"
			ENDIF
			IF STRFIND(RSTR:表示設定受け渡し, "［］") >= 0
				奥義説明記述:奥義段階 += "［"
				IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1) > 0
					奥義説明記述:奥義段階 += @"{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1)}％"
				ENDIF
				IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値２", 1) > 0
					SIF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1) > 0
						奥義説明記述:奥義段階 += "＋"
					奥義説明記述:奥義段階 += @"{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値２", 1)}"
				ENDIF
				IF STRFIND(RSTR:表示設定受け渡し, "期間表示") >= 0
					奥義説明記述:奥義段階 += @"%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列２", 1)%"
				ENDIF
				奥義説明記述:奥義段階 += "］의"
			ENDIF
			奥義説明記述:奥義段階 += @"%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%효과를 부여한다."
			IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1) > 0
				奥義説明記述:奥義段階 += @"성공률{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1)}％。"
			ENDIF

			効果一時保存 += "CALL アビ汎用変数文字列リセット<br>"
			IF DB行数 > 0 && DT_CELL_GETS("アビエディタデータベース", 奥義ID:(DB行数 - 1), "アビ文字列３", 1) == "奥義基礎攻撃" && DT_CELL_GETS("アビエディタデータベース", 奥義ID:(DB行数 - 1), "アビ対象", 1) == "敵単体" && DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) == "上と同じ相手"
				効果一時保存 += アビエディタ_対象CALL変換("오의 대상과 동일")
			ELSE
				効果一時保存 += アビエディタ_対象CALL変換(DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1))
			ENDIF

			IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1) == "トレハン" || DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1) == "バフ消去"
				IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1) > 0
					効果一時保存 += @"アビ汎用変数:基礎成功確率 = {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1)}<br>"
				ENDIF

				FOR LOCAL, 0, DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値２", 1)
					効果一時保存 += @"CALL アビテンプレート_不利効果_トレハン<br>"
				NEXT
			ELSE
				IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1) > 0
					効果一時保存 += @"アビ汎用変数:効果割合 = {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1)}<br>"
				ENDIF
				IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値２", 1) > 0
					効果一時保存 += @"アビ汎用変数:効果量 = {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値２", 1)}<br>"
				ENDIF

				IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1) > 0
					効果一時保存 += @"アビ汎用変数:基礎成功確率 = {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1)}<br>"
				ENDIF
				
				IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1) == "バフ効果短縮" || DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1) == "デバフ効果延長"
					SELECTCASE DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列２", 1)
						CASE "ターン"
							効果一時保存 += @"CALL アビテンプレート_不利効果_%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%_持続ターン<br>"
						CASE "回"
							効果一時保存 += @"CALL アビテンプレート_不利効果_%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%_持続回数<br>"
						CASE "行動"
							効果一時保存 += @"CALL アビテンプレート_不利効果_%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%_持続行動回数<br>"
						CASE "被ダメ"
							効果一時保存 += @"CALL アビテンプレート_不利効果_%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%_持続被ダメ回数<br>"
					ENDSELECT
				ELSE
					効果一時保存 += @"CALL アビテンプレート_不利効果_%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%<br>"
				ENDIF
			ENDIF
			
		CASE "回復効果"
			IF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) == "奥義と同じ相手"
				奥義説明記述:奥義段階 += "오의 대상에게"
			ELSEIF DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) != "上と同じ相手"
				奥義説明記述:奥義段階 += @"%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1)%에게"
			ENDIF
			IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1) > 0
				奥義説明記述:奥義段階 += @"［%DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%✕{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1)}％］의"
			ELSE
				奥義説明記述:奥義段階 += @"［{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値２", 1)}］의"
			ENDIF
			奥義説明記述:奥義段階 += "HP 회복을"
			IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1) < 2
				奥義説明記述:奥義段階 += "부여한다."
			ELSE
				奥義説明記述:奥義段階 += @"{DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1)}회 부여한다."
			ENDIF

			効果一時保存 += "CALL アビ汎用変数文字列リセット<br>"
			IF DB行数 > 0 && DT_CELL_GETS("アビエディタデータベース", 奥義ID:(DB行数 - 1), "アビ文字列３", 1) == "奥義基礎攻撃" && DT_CELL_GETS("アビエディタデータベース", 奥義ID:(DB行数 - 1), "アビ対象", 1) == "敵単体" && DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1) == "上と同じ相手"
				効果一時保存 += アビエディタ_対象CALL変換("오의 대상과 동일")
			ELSE
				効果一時保存 += アビエディタ_対象CALL変換(DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ対象", 1))
			ENDIF
			IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1) > 0
				効果一時保存 += @"アビ汎用変数:効果割合 = {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値１", 1)}<br>"
				効果一時保存 += @"アビ汎用文字列:回復側使用能力値 = %DT_CELL_GETS("アビエディタデータベース", 奥義ID:DB行数, "アビ文字列１", 1)%<br>"
			ELSE
				効果一時保存 += @"アビ汎用変数:効果量 = {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値２", 1)}<br>"
			ENDIF
			LOCALS = CALL アビテンプレート_回復処理_MAXでも回復
			IF DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1) > 1
				効果一時保存 += @"FOR LOCAL, 0, {DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "アビ数値４", 1)}<br>"
				効果一時保存 += @"	%LOCALS%<br>"
				効果一時保存 += @"NEXT<br>"
			ELSE
				効果一時保存 += @"%LOCALS%<br>"
			ENDIF
	ENDSELECT

	
	IF 基礎攻撃位置:奥義段階 > DT_CELL_GET("アビエディタデータベース", 奥義ID:DB行数, "効果順番", 1)
		奥義効果記述_奥義前:奥義段階 += 効果一時保存
	ELSE
		奥義効果記述:奥義段階 += 効果一時保存
	ENDIF

	SIF 最大奥義段階 < 奥義段階
		最大奥義段階 = 奥義段階
NEXT

