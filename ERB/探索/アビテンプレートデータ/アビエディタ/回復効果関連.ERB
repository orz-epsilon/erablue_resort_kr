HTML文字列 += "</div>"


HTML_PRINT HTML文字列, 1
FOR LOCAL, 0, 35
	PRINTL
NEXT

BINPUT
PRINTL
PRINTL
SELECTCASE RESULT
	CASE 1
		CALL アビエディタ_対象選択(回復対象, 効果順番)
	CASE 2
		DRAWLINE
		PRINTFORML 사용할 능력치를 선택해 주세요. 현재：%回復能力値%
		PRINTL
		FOR LOCAL, 6, 10
			PRINTBUTTON @"[{LOCAL}] %ERDNAME(基礎BATTLE_STATE, LOCAL)%", LOCAL
			PRINTL
		NEXT
		BINPUT
		PRINTL
		PRINTL
		回復能力値 '= ERDNAME(基礎BATTLE_STATE, RESULT)
	CASE 3
		DRAWLINE
		IF 回復モード == 0
			PRINTFORML 회복 배율을 입력해 주세요. 현재：{回復倍率}
		ELSE
			PRINTFORML 회복 값을 입력해 주세요. 현재：{回復固定値}
		ENDIF
		PRINTL
		INPUT
		IF RESULT < 1
			PRINTW 0이나 음수 값은 지정할 수 없습니다.
		ENDIF
		IF 回復モード == 0
			回復倍率 = RESULT
		ELSE
			回復固定値 = RESULT
		ENDIF
	CASE 5
		DRAWLINE
		PRINTFORML 회복 횟수를 입력해 주세요. 현재：{回復回数}회
		PRINTL
		INPUT
		IF RESULT < 1
			PRINTW 0이나 음수 값은 지정할 수 없습니다.
		ENDIF
		回復回数 = RESULT
	CASE 998
		IF 変更ID
			;既存効果変更
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ対象", 回復対象, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値４", 回復回数, 1
			IF 回復モード == 0
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ文字列１", 回復能力値, 1
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値１", 回復倍率, 1
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値２", 0, 1
			ELSE
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値２", 回復固定値, 1
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ文字列１", "", 1
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値１", 0, 1
			ENDIF
			PRINTW 회복 효과를 변경했습니다.
		ELSE
			;新規効果追加
			IF 回復モード == 0
				DT_ROW_ADD "アビエディタデータベース", "効果順番", 効果順番, "アビ段階", アビ段階, "アビ効果種別", "回復効果", "アビ対象", 回復対象, "アビ文字列１", 回復能力値, "アビ数値１", 回復倍率, "アビ数値４", 回復回数
			ELSE
				DT_ROW_ADD "アビエディタデータベース", "効果順番", 効果順番, "アビ段階", アビ段階, "アビ効果種別", "回復効果", "アビ対象", 回復対象, "アビ数値２", 回復固定値, "アビ数値４", 回復回数
			ENDIF
			PRINTW 새로운 회복 효과를 추가했습니다.
		ENDIF
		RETURN 1
	CASE 999
		RETURN 0
ENDSELECT

GOTO 動作LOOP
