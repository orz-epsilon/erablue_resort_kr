; 	HTML文字列 += @"　　横列対象　回復目安：<font color='#%カラーパレット_HTML("黄")%'> 160</font>％<br>"
; 	HTML文字列 += @"　　縦列対象　回復目安：<font color='#%カラーパレット_HTML("黄")%'> 120</font>％<br>"
