;効果の最初かどうかを判定
IF 変更ID == 0
	;アビ段階が同じ効果がある、かつ新規効果追加状態＝最初ではない
	LOCAL = DT_SELECT("アビエディタデータベース", @"アビ段階 = {アビ段階}")
	効果順番 = LOCAL
ELSE
	;既存効果変更の場合、行数を見る
	FOR LOCAL, 0, DT_ROW_LENGTH("アビエディタデータベース")
		IF DT_CELL_GET("アビエディタデータベース", LOCAL, "id") == 変更ID
			効果順番 = LOCAL
			BREAK
		ENDIF
	NEXT
ENDIF

IF 変更ID
	回復対象 '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ対象", 1)
	回復倍率 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値１", 1)
	回復固定値 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値２", 1)
	回復回数 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値４", 1)
	回復能力値 '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ文字列１", 1)
	アビ段階 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ段階", 1)
ENDIF
IF 回復対象 == ""
	IF 効果順番 < 1
		回復対象 = 敵単体
	ELSE
		回復対象 = 上と同じ相手
	ENDIF
ENDIF
SIF 回復回数 < 1
	回復回数 = 1
SIF 回復能力値 == ""
	回復能力値 = 回復力
SIF 回復倍率 == 0
	回復倍率 = 100

$動作LOOP

DRAWLINE
PRINTL 회복 효과 설정을 선택해주세요.
DRAWLINE

PRINTL ・현재 효과
PRINT 　　
PRINTFORM %回復対象%에게
IF 回復モード == 0
	PRINTFORM ［%回復能力値%✕{回復倍率}％］의
ELSE
	PRINTFORM ［{回復固定値}］의
ENDIF
PRINT ＨＰ 회복을
IF 回復回数 < 2
	PRINT 부여한다.
ELSE
	PRINTFORM {回復回数}회 부여한다.
ENDIF
PRINTL
DRAWLINE

HTML文字列 = 
HTML文字列 += "<div rect='50, 0, 5000, 3000' padding='50,25,50' color='#101010' border='31' bcolor='#C0C0C0'><nobr>"
HTML文字列 += @"<button value='1'>[1] 회복 대상 변경</button>　　　　현재:%回復対象%<br>"
IF 回復モード == 0
	HTML文字列 += @"<button value='2'>[2] 사용 능력치 변경</button>　　　현재:%回復能力値%<br>"
	HTML文字列 += @"<button value='3'>[3] 회복 배율 변경</button>　　　　현재:{回復倍率}％<br>"
ELSE
	HTML文字列 += @"<button value='3'>[3] 회복값 변경</button>　　　　　현재:{回復固定値}<br>"
ENDIF
HTML文字列 += @"<button value='5'>[5] 회복 횟수 변경</button>　　　현재:{回復回数}회<br>"
HTML文字列 += "<br>"
HTML文字列 += "<br>"
HTML文字列 += @"<button value='998'>[998] 이 설정으로 효과 결정</button><br>"
HTML文字列 += @"<button value='999'>[999] 저장하지 않고 돌아가기</button><br>"
HTML文字列 += "</div>"

;効果目安
VARSET RESULTS
取得条件_Lv = 0
取得条件_陥落 = 
SPLIT 取得条件, "***", RESULTS
FOR LOCAL, 0, RESULT
	IF STRFIND(RESULTS:LOCAL, "Lv") >= 0
		取得条件_Lv = TOINT(REPLACE(RESULTS:LOCAL, "Lv_", ""))
	ELSEIF STRFIND(RESULTS:LOCAL, "陥落") >= 0
		取得条件_陥落 '= REPLACE(RESULTS:LOCAL, "陥落_", "")
	ENDIF
NEXT
HTML文字列 += "<div rect='5100, 0, 3000, 3000' padding='50,25,50' color='#101010' border='31' bcolor='#C0C0C0'><nobr>"
HTML文字列 += "■참고 정보　　<br>　　작성 중"

