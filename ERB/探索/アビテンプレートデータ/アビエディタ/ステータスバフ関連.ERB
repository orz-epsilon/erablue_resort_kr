
@アビエディタ_バフ効果追加(変更ID = 0, アビ段階 = 0, 取得条件)
;アビ文字列１ バフ対象のステータス
;アビ文字列２ バフ枠
;アビ文字列３ 持続種類（ターンや回数、行動回数など）
;アビ文字列４ その他オプション（消去不可など）
;アビ文字列５
;アビ数値１ バフ倍率
;アビ数値２ バフ固定値
;アビ数値３ 持続数値
;アビ数値４ 基礎成功率
;アビ数値５
#DIM 効果順番
#DIM DYNAMIC バフ倍率
#DIM DYNAMIC バフ固定値
#DIM DYNAMIC 持続数値
#DIMS DYNAMIC バフ対象能力
#DIMS DYNAMIC バフ枠
#DIMS DYNAMIC 持続種類
#DIMS DYNAMIC オプション
#DIMS DYNAMIC バフ対象
#DIM アビ段階
#DIM 変更ID
#DIM 枠補正フラグ
#DIMS 枠保存
#DIMS HTML文字列
#DIMS 計算式タイプ
#DIMS 取得条件

#DIM 取得条件_Lv
#DIMS 取得条件_陥落

;効果の最初かどうかを判定
IF 変更ID == 0
	;アビ段階が同じ効果がある、かつ新規効果追加状態＝最初ではない
	LOCAL = DT_SELECT("アビエディタデータベース", @"アビ段階 = {アビ段階}")
	効果順番 = LOCAL
ELSE
	;既存効果変更の場合、行数を見る
	FOR LOCAL, 0, DT_ROW_LENGTH("アビエディタデータベース")
		IF DT_CELL_GET("アビエディタデータベース", LOCAL, "id") == 変更ID
			効果順番 = LOCAL
			BREAK
		ENDIF
	NEXT
ENDIF

IF 変更ID
	バフ対象 '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ対象", 1)
	バフ対象能力 '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ文字列１", 1)
	バフ枠 '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ文字列２", 1)
	持続種類 '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ文字列３", 1)
	オプション '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ文字列４", 1)
	バフ倍率 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値１", 1)
	バフ固定値 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値２", 1)
	持続数値 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値３", 1)
	アビ段階 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ段階", 1)
ENDIF
IF バフ対象 == ""
	IF 効果順番 < 1
		バフ対象 = 味方単体
	ELSE
		バフ対象 = 上と同じ相手
	ENDIF
ENDIF
SIF バフ対象能力 == ""
	バフ対象能力 = 攻撃力
SIF バフ枠 == ""
	バフ枠 = 攻撃力A
SIF 持続種類 == ""
	持続種類 = ターン
SIF バフ倍率 == 0 && バフ固定値 == 0
	バフ倍率 = 10
SIF 持続数値 == 0
	持続数値 = 3

$動作LOOP

;バフの計算式タイプ取得
RSTR:表示設定受け渡し = 
計算式タイプ '= アビエディタ_ＭＰ自動計算_バフ種類(バフ対象能力)

DRAWLINE
PRINTL 버프 효과 설정을 선택해주세요.
DRAWLINE

PRINTL ・현재의 효과
PRINT 　　
PRINTFORM %バフ対象%에게
IF STRFIND(RSTR:表示設定受け渡し, "［］") >= 0
	PRINT ［
	IF バフ倍率 > 0
		PRINTFORM {バフ倍率}％
	ENDIF
	IF バフ固定値 > 0
		SIF バフ倍率 > 0
			PRINT ＋
		PRINTFORM {バフ固定値}
	ENDIF
	PRINTFORM ］
ENDIF
PRINT （
IF STRFIND(バフ枠, バフ対象能力) == 0
	PRINTFORM %TOFULL(REPLACE(バフ枠, バフ対象能力, ""))%칸
ELSE
	PRINT 고유 칸
ENDIF
IF 持続数値 > 0
	PRINTFORM ・{持続数値}%持続種類%
ENDIF
IF STRFIND(オプション, "消去不可") >= 0
	PRINT ・삭제 불가
ENDIF
IF STRFIND(RSTR:表示設定受け渡し, "上昇") >= 0
	PRINTFORM ）의%バフ能力表示変換(バフ対象能力)% 상승 효과를 부여한다.
ELSE
	PRINTFORM ）의%バフ能力表示変換(バフ対象能力)% 효과를 부여한다.
ENDIF
PRINTL
DRAWLINE

HTML文字列 = 
HTML文字列 += "<div rect='50, 0, 5000, 3000' padding='50,25,50' color='#101010' border='31' bcolor='#C0C0C0'><nobr>"
HTML文字列 += @"<button value='1'>[1] 버프 대상을 변경한다</button>　　　　　　현재：%バフ対象%<br>"
HTML文字列 += @"<button value='2'>[2] 버프할 능력치를 변경한다</button>　　　현재：%バフ能力表示変換(バフ対象能力)%<br>"
IF STRFIND(計算式タイプ, "割合") >= 0
	HTML文字列 += @"<button value='3'>[3] 버프 배율을 변경한다</button>　　　　　　현재：{バフ倍率}％<br>"
ELSE
	HTML文字列 += @"<font color='#%カラーパレット_HTML("グレーアウト")%'>[3] 버프 배율을 변경한다</font><br>"
ENDIF
IF STRFIND(計算式タイプ, "固定値") >= 0
	HTML文字列 += @"<button value='4'>[4] 버프 고정값을 변경한다</button>　　　　　현재：{バフ固定値}<br>"
ELSE
	HTML文字列 += @"<font color='#%カラーパレット_HTML("グレーアウト")%'>[4] 버프 고정값을 변경한다</font><br>"
ENDIF
IF 持続数値 < 1
	HTML文字列 += @"<button value='5'>[5] 버프 지속 시간을 변경한다</button>　　　현재：영구<br>"
ELSE
	HTML文字列 += @"<button value='5'>[5] 버프 지속 시간을 변경한다</button>　　　현재：{持続数値}%持続種類%<br>"
ENDIF
HTML文字列 += "<button value='6'>[6] 버프 칸을 변경한다</button>　　　　　　현재："
IF STRFIND(バフ枠, バフ対象能力) == 0
	HTML文字列 += @"%TOFULL(REPLACE(バフ枠, バフ対象能力, ""))%칸<br>"
ELSE
	HTML文字列 += "고유 칸<br>"
ENDIF
IF STRFIND(オプション, "消去不可") >= 0
	HTML文字列 += @"<button value='7'>[7] 삭제 불가 옵션을 제거한다</button>　　　현재：있음<br>"
ELSE
	HTML文字列 += @"<button value='7'>[7] 삭제 불가 옵션을 추가한다</button>　　현재：없음<br>"
ENDIF
HTML文字列 += "<br>"
HTML文字列 += "<br>"
HTML文字列 += @"<button value='998'>[998] 이 설정으로 효과를 결정한다</button><br>"
HTML文字列 += @"<button value='999'>[999] 저장하지 않고 돌아간다</button><br>"
HTML文字列 += "</div>"

;効果目安
VARSET RESULTS
取得条件_Lv = 0
取得条件_陥落 = 
SPLIT 取得条件, "***", RESULTS
FOR LOCAL, 0, RESULT
	IF STRFIND(RESULTS:LOCAL, "Lv") >= 0
		取得条件_Lv = TOINT(REPLACE(RESULTS:LOCAL, "Lv_", ""))
	ELSEIF STRFIND(RESULTS:LOCAL, "陥落") >= 0
		取得条件_陥落 '= REPLACE(RESULTS:LOCAL, "陥落_", "")
	ENDIF
NEXT

HTML文字列 += "<div rect='5100, 0, 3000, 3000' padding='50,25,50' color='#101010' border='31' bcolor='#C0C0C0'><nobr>"
HTML文字列 += "■참고 정보　　"
IF 取得条件_Lv > 0 || 取得条件_陥落 != ""
	HTML文字列 += @"Lv<font color='#%カラーパレット_HTML("黄")%'>{MAX(1, 取得条件_Lv), 2}"
	IF 取得条件_陥落 != ""
		HTML文字列 += "＋함락 시"
	ENDIF
	HTML文字列 += "</font> 시점<br>"
	HTML文字列 += アビエディタ_効果目安_ステータスバフ種類(バフ対象能力, 取得条件_Lv, 取得条件_陥落)
ELSE
	HTML文字列 += @"Lv<font color='#%カラーパレット_HTML("黄")%'>1</font> 시점<br>"
	HTML文字列 += アビエディタ_効果目安_ステータスバフ種類(バフ対象能力, 1, "")
ENDIF
HTML文字列 += "<br>"
HTML文字列 += "</div>"


HTML_PRINT HTML文字列, 1
FOR LOCAL, 0, 35
	PRINTL
NEXT

BINPUT
PRINTL
PRINTL
SELECTCASE RESULT
	CASE 1
		CALL アビエディタ_対象選択(バフ対象, 効果順番)
	CASE 2
		枠補正フラグ = 0
		IF STRFIND(バフ枠, バフ対象能力) >= 0
			枠保存 '= バフ対象能力
			枠補正フラグ = 1
		ENDIF
		CALL アビエディタ_バフ種類選択(バフ対象能力)
		IF RESULT > 0
			;初期値補正
			計算式タイプ '= アビエディタ_ＭＰ自動計算_バフ種類(バフ対象能力)
			IF STRFIND(計算式タイプ, "割合") >= 0
				SIF バフ倍率 <= 0
					バフ倍率 = 10
			ELSE
				バフ倍率 = 0
			ENDIF
			IF STRFIND(計算式タイプ, "固定値") >= 0 && バフ倍率 == 0
				SIF バフ固定値 <= 0
					バフ固定値 = 10
			ELSE
				バフ固定値 = 0
			ENDIF
		ENDIF
		IF 枠補正フラグ
			バフ枠 '= REPLACE(バフ枠, 枠保存, バフ対象能力)
		ENDIF
	CASE 3
		DRAWLINE
		PRINTFORML 버프 배율을 입력해주세요. 현재：{バフ倍率}％
		PRINTL
		INPUT
		IF RESULT < 0
			PRINTW 음수 값은 지정할 수 없습니다
		ENDIF
		バフ倍率 = RESULT
	CASE 4
		DRAWLINE
		PRINTFORML 버프 고정값을 입력해주세요. 현재：{バフ固定値}
		PRINTL
		INPUT
		IF RESULT < 0
			PRINTW 음수 값은 지정할 수 없습니다
		ENDIF
		バフ固定値 = RESULT
	CASE 5
		$持続LOOP
		DRAWLINE
		IF 持続数値 < 1
			PRINTFORML 버프 지속 시간을 설정해주세요. 현재：영구
		ELSE
			PRINTFORML 버프 지속 시간을 설정해주세요. 현재：{持続数値}%持続種類%
		ENDIF
		PRINTL
		PRINTL
		PRINTBUTTON @"[0] 수치 변경", 0
		PRINTL 　　：0으로 설정 시, 영구 효과가 됩니다.
		PRINTL
		PRINTL ・지속 종류 변경
		IF 持続種類 == "ターン"
			SETCOLOR カラーパレット("黄")
			PRINTPLAIN [턴]
			RESETCOLOR
		ELSE
			PRINTBUTTON "[턴]", 10
		ENDIF
		PRINTL 　　：턴 종료 시 수치가 감소하며, 0이 되었을 때 해제
		IF 持続種類 == "回"
			SETCOLOR カラーパレット("黄")
			PRINTPLAIN [횟수]
			RESETCOLOR
		ELSE
			PRINTBUTTON "[횟수]", 11
		ENDIF
		PRINTL 　　　：버프가 발동한 후에 감소하며, 0이 되었을 때 해제
		IF 持続種類 == "行動"
			SETCOLOR カラーパレット("黄")
			PRINTPLAIN [행동]
			RESETCOLOR
		ELSE
			PRINTBUTTON "[행동]", 12
		ENDIF
		PRINTL 　　　：행동 종료 시 감소하며, 0이 되었을 때 해제
		IF 持続種類 == "被ダメ"
			SETCOLOR カラーパレット("黄")
			PRINTPLAIN [피해]
			RESETCOLOR
		ELSE
			PRINTBUTTON "[피해]", 13
		ENDIF
		PRINTL 　　：피해를 입은 후 감소하며, 0이 되었을 때 해제
		PRINTL
		PRINTBUTTON @"[999] 돌아가기", 999
		BINPUT
		PRINTL
		PRINTL
		SELECTCASE RESULT
			CASE 0
				$数値LOOP
				DRAWLINE
				PRINTL 수치를 입력해 주세요
				PRINTL
				INPUT
				IF RESULT < 0
					PRINTW 음수 값은 입력할 수 없습니다
					GOTO 数値LOOP
				ENDIF
				持続数値 = RESULT
			CASE 10
				持続種類 = ターン
			CASE 11
				持続種類 = 回
			CASE 12
				持続種類 = 行動
			CASE 13
				持続種類 = 被ダメ
			CASE 999
				GOTO 動作LOOP
		ENDSELECT
		GOTO 持続LOOP
	CASE 6
		DRAWLINE
		PRINTFORM 버프 칸을 선택해 주세요. 현재：
		IF STRFIND(バフ枠, バフ対象能力) == 0
			PRINTFORM %TOFULL(REPLACE(バフ枠, バフ対象能力, ""))%칸
		ELSE
			PRINTFORM 고유 칸（%バフ枠%）
		ENDIF
		PRINTL
		PRINTFORML ※칸이란 버프의 공존 관계를 관리하기 위한 문자열입니다.
		PRINTFORML 　버프의 대상 능력과 칸이 둘 다 같은 효과는 공존하지 않으며, 효과가 높은 쪽으로 덮어씌워집니다.
		PRINTFORML 　버프와 디버프에서 칸이 같은 경우에는 공존하며, 둘 다 효과를 발휘합니다.
		PRINTL
		PRINTBUTTON "[0] A칸", 0
		PRINTL
		PRINTBUTTON "[1] B칸", 1
		PRINTL
		PRINTBUTTON "[2] C칸", 2
		PRINTL
		PRINTBUTTON "[3] D칸", 3
		PRINTL
		PRINTBUTTON "[10] 직접 입력하기", 10
		PRINTL
		BINPUT
		SELECTCASE RESULT
			CASE 0
				バフ枠 = %バフ対象能力%A
			CASE 1
				バフ枠 = %バフ対象能力%B
			CASE 2
				バフ枠 = %バフ対象能力%C
			CASE 3
				バフ枠 = %バフ対象能力%D
			CASE 10
				$任意枠LOOP
				DRAWLINE
				PRINTFORML 원하는 칸 이름을 입력해 주세요.
				INPUTS
				IF RESULTS == ""
					PRINTW 공백은 입력할 수 없습니다.
					GOTO 任意枠LOOP
				ENDIF
				バフ枠 '= RESULTS
		ENDSELECT
	CASE 7
		IF STRFIND(オプション, "消去不可") >= 0
			オプション '= REPLACE(オプション, "消去不可", "")
		ELSE
			オプション += "삭제 불가"
		ENDIF
	CASE 998
		IF STRFIND(計算式タイプ, "割合") < 0
			バフ倍率 = 0
		ENDIF
		IF STRFIND(計算式タイプ, "固定値") < 0
			バフ固定値 = 0
		ENDIF
		IF 変更ID
			;既存効果変更
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ対象", バフ対象, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値１", バフ倍率, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値２", バフ固定値, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値３", 持続数値, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ文字列１", バフ対象能力, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ文字列２", バフ枠, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ文字列３", 持続種類, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ文字列４", オプション, 1
			PRINTW 버프 효과를 변경했습니다.
		ELSE
			;新規効果追加
			{
			DT_ROW_ADD 
			"アビエディタデータベース", "効果順番", 効果順番, "アビ段階", アビ段階, "アビ効果種別", "バフ効果", "アビ対象", バフ対象, 
			"アビ数値１", バフ倍率, "アビ数値２", バフ固定値, "アビ数値３", 持続数値,
			"アビ文字列１", バフ対象能力, "アビ文字列２", バフ枠, "アビ文字列３", 持続種類, "アビ文字列４", オプション
			}
			PRINTW 새로운 버프 효과를 추가했습니다.
		ENDIF
		RETURN 1
	CASE 999
		RETURN 0
ENDSELECT

GOTO 動作LOOP



@アビエディタ_バフ種類選択(バフ対象能力)
#DIMS REF バフ対象能力
#DIM 表示数

DRAWLINE
PRINTFORML 버프할 능력치를 선택해주세요. 현재：%バフ能力表示変換(バフ対象能力)%
DRAWLINE
PRINTL ・기초 스탯
表示数 = 0
FOR LOCAL, 6, 28
	SIF GROUPMATCH(LOCAL, 16, 17, 20, 22, 23, 24, 25, 26, 27)
		CONTINUE
	PRINTBUTTONLC @"[{LOCAL}] %ERDNAME(BATTLE_STATE, LOCAL, 2)%", LOCAL
	表示数 ++
	IF 表示数 >= 4
		PRINTL
		表示数 = 0
	ENDIF
NEXT
PRINTBUTTONLC @"[50] 연속 공격률", 50
PRINTL
DRAWLINE
PRINTL ・대미지 보정　　（같은 효과는 버프량・디버프량이 합산되어 계산됩니다）
PRINTBUTTONLC "[100] 일반 공격 대미지", 100
PRINTBUTTONLC "[101] 어빌리티 대미지", 101
PRINTBUTTONLC "[102] 오의 대미지", 102
PRINTBUTTONLC "[103] 체인 버스트 대미지", 103
PRINTL
DRAWLINE
PRINTL ・가하는 대미지　　（가하는 대미지 버프・디버프가 계산된 후 받는 대미지 버프・디버프가 계산됩니다）
PRINTBUTTONLC "[200] 가하는 대미지", 200
PRINTBUTTONLC "[201] 화속성 공격", 201
PRINTBUTTONLC "[202] 수속성 공격", 202
PRINTBUTTONLC "[203] 풍속성 공격", 203
PRINTL
PRINTBUTTONLC "[204] 토속성 공격", 204
PRINTBUTTONLC "[205] 광속성 공격", 205
PRINTBUTTONLC "[206] 어둠 속성 공격", 206
PRINTL
DRAWLINE
PRINTL ・받는 대미지
PRINTBUTTONLC "[300] 받는 대미지", 300
PRINTBUTTONLC "[301] 화속성 내성", 301
PRINTBUTTONLC "[302] 수속성 내성", 302
PRINTBUTTONLC "[303] 풍속성 내성", 303
PRINTL
PRINTBUTTONLC "[304] 토속성 내성", 304
PRINTBUTTONLC "[305] 광속성 내성", 305
PRINTBUTTONLC "[306] 어둠 속성 내성", 306
PRINTL
DRAWLINE
PRINTL ・기타 공격 계열 버프
PRINTBUTTONLC "[400] 텐션", 400
PRINTBUTTONLC "[401] 스트렝스", 401
PRINTBUTTONLC "[402] 역경", 402
PRINTBUTTONLC "[403] 추격", 403
PRINTL
PRINTBUTTONLC "[404] 오의 재발동", 404
