
@アビエディタ_ダメージ効果追加(変更ID = 0, アビ段階 = 0, 取得条件)
;アビ文字列１ ダメージ倍率に使用する能力値
;アビ文字列２ ダメージ種類
;アビ文字列３ 奥義基礎攻撃 ※奥義時のみ使用
;アビ文字列４
;アビ文字列５
;アビ数値１ ダメージ倍率
;アビ数値２ ダメージ固定値
;アビ数値３ ダメージ属性
;アビ数値４ ダメージ回数
;アビ数値５
#DIM 効果順番
#DIM DYNAMIC ダメージ倍率
#DIM DYNAMIC ダメージ固定値
#DIM DYNAMIC ダメージ属性
#DIM DYNAMIC ダメージ回数
#DIMS DYNAMIC ダメージ能力値
#DIMS DYNAMIC ダメージ対象
#DIMS DYNAMIC ダメージ種類
#DIM DYNAMIC 奥義基礎攻撃
#DIM アビ段階
#DIM ダメージモード
#DIM 変更ID
#DIMS HTML文字列
#DIMS 取得条件

#DIM 取得条件_Lv
#DIMS 取得条件_陥落

;効果の最初かどうかを判定
IF 変更ID == 0
	;アビ段階が同じ効果がある、かつ新規効果追加状態＝最初ではない
	LOCAL = DT_SELECT("アビエディタデータベース", @"アビ段階 = {アビ段階}")
	効果順番 = LOCAL
ELSE
	;既存効果変更の場合、効果順番を見る
	FOR LOCAL, 0, DT_ROW_LENGTH("アビエディタデータベース")
		IF DT_CELL_GET("アビエディタデータベース", LOCAL, "id") == 変更ID
			効果順番 = DT_CELL_GET("アビエディタデータベース", LOCAL, "効果順番")
			BREAK
		ENDIF
	NEXT
ENDIF

IF 変更ID
	ダメージ対象 '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ対象", 1)
	ダメージ倍率 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値１", 1)
	ダメージ固定値 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値２", 1)
	ダメージ属性 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値３", 1)
	ダメージ回数 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ数値４", 1)
	ダメージ能力値 '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ文字列１", 1)
	ダメージ種類 '= DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ文字列２", 1)
	SIF DT_CELL_GETS("アビエディタデータベース", 変更ID, "アビ文字列３", 1) == "奥義基礎攻撃"
		奥義基礎攻撃 = 1
	アビ段階 = DT_CELL_GET("アビエディタデータベース", 変更ID, "アビ段階", 1)
ENDIF
IF ダメージ対象 == ""
	IF 効果順番 < 1
		ダメージ対象 = 敵単体
	ELSE
		ダメージ対象 = 上と同じ相手
	ENDIF
ENDIF
SIF ダメージ回数 < 1
	ダメージ回数 = 1
SIF ダメージ能力値 == ""
	ダメージ能力値 = 攻撃力
SIF ダメージ倍率 == 0
	ダメージ倍率 = 100

$動作LOOP

DRAWLINE
PRINTL 대미지効果の設定を選択してください。
DRAWLINE

PRINTL ・현재の効果
PRINT 　　
IF 奥義基礎攻撃
	PRINT 오의 기초 공격：
ENDIF
PRINTFORM %ダメージ対象%에게
IF ダメージモード == 0
	PRINTFORM ［%ダメージ能力値%✕{대미지倍率}％］
ELSE
	PRINTFORM ［{대미지固定値}］
ENDIF
IF ダメージ能力値 != "攻撃力"
	PRINTFORM （%ダメージ能力値% 의존）
ENDIF
PRINT 의
IF ダメージ属性 < 0
	PRINT 자속성 대미지를
ELSE
	SETCOLOR カラーパレット(@"%属性数値文字列変換(ダメージ属性)%属性")
	PRINTFORM %属性数値文字列変換(ダメージ属性)%속성
	RESETCOLOR
	PRINT 대미지를
ENDIF
IF ダメージ回数 < 2
	PRINT 부여한다.
ELSE
	PRINTFORM {대미지回数}회 부여한다.
ENDIF
PRINTL
DRAWLINE

HTML文字列 = 
HTML文字列 += "<div rect='50, 0, 5000, 3000' padding='50,25,50' color='#101010' border='31' bcolor='#C0C0C0'><nobr>"

HTML文字列 += @"<button value='1'>[1] 대미지 대상을 변경한다</button>　　　　현재：%ダメージ対象%<br>"
IF ダメージモード == 0
HTML文字列 += @"<button value='2'>[2] 사용할 능력치를 변경한다</button>　　　현재:%ダメージ能力値%<br>"
HTML文字列 += @"<button value='3'>[3] 대미지 배율을 변경한다</button>　　　　현재:{ダメージ倍率}％<br>"
ELSE
HTML文字列 += @"<button value='3'>[3] 대미지 값을 변경한다</button>　　　　　현재:{ダメージ固定値}<br>"
ENDIF
IF ダメージ属性 < 0
HTML文字列 += @"<button value='4'>[4] 대미지 속성을 변경한다</button>　　　현재: 자속성<br>"
ELSE
HTML文字列 += @"<button value='4'>[4] 대미지 속성을 변경한다</button>　　　현재:<font color='#%カラーパレット_HTML(@"%属性数値文字列変換(ダメージ属性)%属性")%'>%属性数値文字列変換(ダメージ属性)%속성</font><br>"
ENDIF
HTML文字列 += @"<button value='5'>[5] 대미지 횟수를 변경한다</button>　　　현재:{ダメージ回数}회<br>"
HTML文字列 += "<br>"
HTML文字列 += "<br>"
HTML文字列 += @"<button value='998'>[998] 이 설정으로 효과를 결정한다</button><br>"
HTML文字列 += @"<button value='999'>[999] 저장하지 않고 돌아간다</button><br>"
HTML文字列 += "</div>"

;効果目安
VARSET RESULTS
取得条件_Lv = 0
取得条件_陥落 = 
SPLIT 取得条件, "***", RESULTS
FOR LOCAL, 0, RESULT
	IF STRFIND(RESULTS:LOCAL, "Lv") >= 0
		取得条件_Lv = TOINT(REPLACE(RESULTS:LOCAL, "Lv_", ""))
	ELSEIF STRFIND(RESULTS:LOCAL, "陥落") >= 0
		取得条件_陥落 '= REPLACE(RESULTS:LOCAL, "陥落_", "")
	ENDIF
NEXT
HTML文字列 += "<div rect='5100, 0, 3000, 3000' padding='50,25,50' color='#101010' border='31' bcolor='#C0C0C0'><nobr>"
HTML文字列 += "■참고 정보　　"
IF 奥義基礎攻撃 == 0

	IF 取得条件_Lv > 0 || 取得条件_陥落 != ""
		SELECTCASE 取得条件_Lv
			CASE 1 TO 10
				LOCAL = 200
			CASE 10 TO 20
				LOCAL = 250
			CASE 20 TO 30
				LOCAL = 300
			CASE 30 TO 40
				LOCAL = 350
			CASE 40 TO 50
				LOCAL = 400
			CASE 50 TO 60
				LOCAL = 430
			CASE 60 TO 70
				LOCAL = 460
			CASEELSE
				LOCAL = 500
		ENDSELECT
		HTML文字列 += @"Lv<font color='#%カラーパレット_HTML("黄")%'>{MAX(1, 取得条件_Lv), 2}"
		IF 取得条件_陥落 != ""
			HTML文字列 += "＋함락 시"
			LOCAL += 50
		ENDIF
		HTML文字列 += "</font> 시점<br>"
		HTML文字列 += @"　　단일 대상　대미지 예상:<font color='#%カラーパレット_HTML("黄")%'>{LOCAL, 4}</font>％<br>"
		HTML文字列 += @"　　가로열 대상　대미지 예상:<font color='#%カラーパレット_HTML("黄")%'>{LOCAL * 8 / 10, 4}</font>％<br>"
		HTML文字列 += @"　　세로열 대상　대미지 예상:<font color='#%カラーパレット_HTML("黄")%'>{LOCAL * 6 / 10, 4}</font>％<br>"
		HTML文字列 += @"　　전체 대상　대미지 예상:<font color='#%カラーパレット_HTML("黄")%'>{LOCAL * 5 / 10, 4}</font>％<br>"
	ELSE
		HTML文字列 += @"Lv<font color='#%カラーパレット_HTML("黄")%'>1"
HTML文字列 += "</font> 시점<br>"
		HTML文字列 += @"　　단일 대상　대미지 예상치：<font color='#%カラーパレット_HTML("黄")%'> 200</font>％<br>"
		HTML文字列 += @"　　가로열 대상　대미지 예상치：<font color='#%カラーパレット_HTML("黄")%'> 160</font>％<br>"
		HTML文字列 += @"　　세로열 대상　대미지 예상치：<font color='#%カラーパレット_HTML("黄")%'> 120</font>％<br>"
		HTML文字列 += @"　　전체 대상　대미지 예상치：<font color='#%カラーパレット_HTML("黄")%'> 100</font>％<br>"
	ENDIF
	HTML文字列 += "<br>"
	HTML文字列 += "　　여러 번 공격하는 경우, 합계를 대미지 예상치와 같은 정도로 하는 것을 권장합니다.<br>"
ENDIF
HTML文字列 += "</div>"


HTML_PRINT HTML文字列, 1
FOR LOCAL, 0, 35
	PRINTL
NEXT

BINPUT
PRINTL
PRINTL
SELECTCASE RESULT
	CASE 1
		CALL アビエディタ_対象選択(ダメージ対象, 効果順番)
	CASE 2
		DRAWLINE
		PRINTFORML 사용할 능력치를 선택해주세요. 현재：%ダメージ能力値%
		PRINTL
		FOR LOCAL, 6, 10
			PRINTBUTTON @"[{LOCAL}] %ERDNAME(基礎BATTLE_STATE, LOCAL)%", LOCAL
			PRINTL
		NEXT
		BINPUT
		PRINTL
		PRINTL
		ダメージ能力値 '= ERDNAME(基礎BATTLE_STATE, RESULT)
	CASE 3
		DRAWLINE
		IF ダメージモード == 0
			PRINTFORML 대미지 배율을 입력해주세요. 현재：{대미지倍率}
		ELSE
			PRINTFORML 대미지 값을 입력해주세요. 현재：{대미지固定値}
		ENDIF
		PRINTL
		INPUT
		IF RESULT < 1
			PRINTW 0이나 음수 값은 지정할 수 없습니다
		ENDIF
		IF ダメージモード == 0
			ダメージ倍率 = RESULT
		ELSE
			ダメージ固定値 = RESULT
		ENDIF
	CASE 4
		DRAWLINE
		PRINT 대미지 속성을 선택해주세요. 현재：
		IF ダメージ属性 < 0
			PRINT 자속성
		ELSE
			PRINTFORM %属性数値文字列変換(ダメージ属性)%속성
		ENDIF
		PRINTL
		PRINTL
			PRINTBUTTON @"[-1] 자속성", -1
			PRINTL
		FOR LOCAL, 0, 7
			SETCOLOR カラーパレット(@"%属性数値文字列変換(LOCAL)%属性")
			PRINTBUTTON @"[{LOCAL}] %属性数値文字列変換(LOCAL)%속성", LOCAL
			PRINTL
		NEXT
		RESETCOLOR
		BINPUT
		PRINTL
		PRINTL
		ダメージ属性 = RESULT
	CASE 5
		DRAWLINE
		PRINTFORML 대미지의 횟수를 입력해주세요. 현재: {대미지回数}회
		PRINTL
		INPUT
		IF RESULT < 1
			PRINTW 0이나 음수 값은 지정할 수 없습니다.
		ENDIF
		ダメージ回数 = RESULT
	CASE 998
		IF 変更ID
			;既存効果変更
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ対象", ダメージ対象, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値３", ダメージ属性, 1
			DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値４", ダメージ回数, 1
			IF ダメージモード == 0
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ文字列１", ダメージ能力値, 1
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値１", ダメージ倍率, 1
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値２", 0, 1
			ELSE
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値２", ダメージ固定値, 1
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ文字列１", "", 1
				DT_CELL_SET "アビエディタデータベース", 変更ID, "アビ数値１", 0, 1
			ENDIF
			PRINTW 대미지 효과를 변경했습니다.
		ELSE
			;新規効果追加
			IF ダメージモード == 0
				DT_ROW_ADD "アビエディタデータベース", "効果順番", 効果順番, "アビ段階", アビ段階, "アビ効果種別", "ダメージ効果", "アビ対象", ダメージ対象, "アビ文字列１", ダメージ能力値, "アビ数値１", ダメージ倍率, "アビ数値３", ダメージ属性, "アビ数値４", ダメージ回数
			ELSE
				DT_ROW_ADD "アビエディタデータベース", "効果順番", 効果順番, "アビ段階", アビ段階, "アビ効果種別", "ダメージ効果", "アビ対象", ダメージ対象, "アビ数値２", ダメージ固定値, "アビ数値３", ダメージ属性, "アビ数値４", ダメージ回数
			ENDIF
			PRINTW 새로운 대미지 효과를 추가했습니다.
		ENDIF
		RETURN 1
	CASE 999
		RETURN 0
ENDSELECT

GOTO 動作LOOP
