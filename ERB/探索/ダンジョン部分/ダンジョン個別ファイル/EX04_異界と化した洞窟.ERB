;---------------------------------------------------------------------
;マップ構造
;---------------------------------------------------------------------
;イベントミニマップなので一本道
;---------------------------------------------------------------------
;1マス目。入口。オーナー視点での主観を記載する。カワイイスパイスがガイド役
@ダンジョンマス情報_異界と化した洞窟_1_1(ARGS)
#DIM マス深度
#DIM マス分岐
マス深度 = 1
マス分岐 = 1

SELECTCASE ARGS
	CASE "マス画像"
		ダンジョンマス画像URL = 壁_洞窟
		ダンジョンマス画像URL_重ね表示 = 会話アイコン
	CASE "接続先"
		CALL ダンジョン分岐線描画(@"{マス深度}_{マス分岐}", "6_1")
	CASE "マスイベント"
		RFLAG:ダンジョン再視聴フラグ = 0
		IF 初来訪マス判定用フラグ
			;最初に訪れた時
			SETBIT RFLAG:ダンジョン再視聴フラグ, 0
			SETBIT RFLAG:ダンジョン再視聴フラグ, 1
			SETBIT RFLAG:ダンジョン再視聴フラグ, 10
		ELSE
			$再視聴表示
			KSTR:(K++) = 동굴 입구다. 벽의 윤곽이 흔들리며 현실감이 없다.
			CALL 再視聴確認(1)
		ENDIF
		IF GETBIT(RFLAG:ダンジョン再視聴フラグ, 0)
			CALL 口上変数初期化
			WSTR:(K++) = 이세계로의 문을 통과하여, 분홍색 안개에 휩싸인 동굴 안으로 발을 들였다.
			WSTR:(K++) = 메카네스 나비스. 이야기로는 성간 문명이라고 들었지만, 하늘이 보이지 않으니 실감이 나지 않는다.
			CALL メッセージ欄表示用関数(,,,0)
			CALL 口上変数初期化
			WSTR:(K++) = 「얍! 쓰러져!」
			WSTR:(K++) = 동굴 안쪽. 소녀의 목소리가 울린다. 아무래도 선객이 있는 모양이다.
			WSTR:(K++) = 가세하는 것이 좋겠다. 이곳은 어둠의 기운으로 가득 차 있다. 빛 속성 공격이 유효할 것이다.
			CALL メッセージ欄表示用関数(,,,0)
			CALL 口上変数初期化
		ENDIF
		IF GETBIT(RFLAG:ダンジョン再視聴フラグ, 1)
			;戦闘部分
		ENDIF
		IF GETBIT(RFLAG:ダンジョン再視聴フラグ, 10)
			;再視聴では通らない報酬部分
			CALL 接続ルート全開放処理(マス深度, マス分岐)
		ENDIF
		RFLAG:ダンジョン再視聴フラグ = 0
		CALL メッセージ欄表示用関数(,,,0)
		CALL 画面再描画
ENDSELECT


;2マス目。戦闘導入。ここからありかのサポートバフ付与
@ダンジョンマス情報_異界と化した洞窟_6_1(ARGS)
#DIM マス深度
#DIM マス分岐
#DIMS 立ち絵_カワイイスパイス
マス深度 = 6
マス分岐 = 1

SELECTCASE ARGS
	CASE "マス画像"
		ダンジョンマス画像URL = 壁_洞窟
		ダンジョンマス画像URL_重ね表示 = エネミーアイコン
	CASE "接続先"
		CALL ダンジョン分岐線描画(@"{マス深度}_{マス分岐}", "6_7")
	CASE "マスイベント"
		IF GETBIT(ダンジョン構造配列_異界と化した洞窟:マス深度:マス分岐, 4) == 0
			;最初に訪れた時
			CALL 口上変数初期化
			WSTR:(K++) = 동굴을 나아가자, 연꽃 지팡이를 든 마법소녀 같은 소녀가 싸우고 있었다.
			WSTR:(K++) = 적은 노출도가 높은 여성 두 명. 음마였다.
			CALL メッセージ欄表示用関数(,,,0)
			CALL 口上変数初期化
			WSTR:(K++) = 「새로운 적!?」
			WSTR:(K++) = %CALLNAME:PLAYER%와 그 동료들은, 소녀를 등지고 음마 앞에 뛰쳐나간다.
			CALL メッセージ欄表示用関数(,,,0)
			CALL 口上変数初期化
			WSTR:(K++) = 「알았어, 고마워. 상태 이상에 조심해!」
			WSTR:(K++) = 음마들은 히죽히죽 웃고 있다. 전투 시작이다!
			CALL メッセージ欄表示用関数(,,,0)
			戦闘時_特殊処理フラグ = ありかのサポート_異界洞窟
			敵BATTLE_STATE_STR:0:エネミー名 = Lv10_下級淫魔
			敵BATTLE_STATE_STR:2:エネミー名 = Lv10_下級淫魔
			CALL 雑魚敵遭遇汎用処理
			IF RESULT == 0
				;勝利時のみ先へ進む
				;立ち絵リソース記録に必要な画像のリソースを生成する
				CALLF 顔グラ表示用文字列関数(キャラ検索("[死と瘴気の魔女]カワイイスパイス"),100,,,1,1)
				立ち絵_カワイイスパイス = %立ち絵リソース記録%
				CALL 口上変数初期化
				WSTR:(K++) = 싸움이 끝나고, 소녀는 안도한 표정으로 이쪽을 보았다.
				WSTR:(K++) = 그녀의 이름은 시라세가와 아리카라고 한다. 신참 마법소녀라고.
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				WSTR:(K++) = 「증원이 온다는 이야기는 못 들었는데 말이지」
				WSTR:(K++) = %CALLNAME:PLAYER%은(는) 우연히 마주친 것일 거라고 대답했다.
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				WSTR:(K++) = 「하지만 덕분에 살았어. ……버릇없지만, 걸으면서 이야기하자」
				WSTR:(K++) = 소녀는 스커트 자락을 걷어 올리고, 판 모양의 작은 기계를 꺼냈다.
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				WSTR:(K++) = 그렇다 해도, 이계, 인가.
				WSTR:(K++) = 의뢰서에 따르면 「현실과 겹쳐지도록, 또 다른 현실이 배치되는」 행위라고 한다만.
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				WSTR:(K++) = 그 부분에 대한 설명은 딱히 없다. 「알아서 하라」는 뜻인 듯하다.
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				WSTR:(K++) = 「본부에 연락하게 해줘. 예상보다 강한 음마가 있어」
				WSTR:(K++) = 아리카가 기계 표면을 몇 번 쓸어보니, 글래머러스한 여성의 모습이 공간에 떠올랐다.
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				WSTR:(K++) = 「음, 당신이 그 리조트의 오너시죠? 이야기는 퓨리에게 들었어요」
				CALL メッセージ欄表示用関数(立ち絵_カワイイスパイス,"カワイイスパイス",,0)
				CALL 口上変数初期化
				WSTR:(K++) = 과연, 의뢰인이었던 모양이다.
				WSTR:(K++) = 붙임성 있는 그녀는 이쪽을 향해 미소 지었다.
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				WSTR:(K++) = 「그래서, 아리카 쨩. 보내온 수치를 보니, 이건 네가 감당할 수 없을 것 같아」
				CALL メッセージ欄表示用関数(立ち絵_カワイイスパイス,"カワイイスパイス",,0)
				CALL 口上変数初期化
				WSTR:(K++) = 이야기를 꺼낸 아리카는 불만스러운 표정이다.
				WSTR:(K++) = 「여기까지 와서 철수하라는 건가요!?」
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				WSTR:(K++) = 「반대야, 반대. 실전 경험을 쌓게 해야 하니까
				WSTR:(K++) = 　%CALLNAME:PLAYER%님의 파티에 따라가 줬으면 해서」
				CALL メッセージ欄表示用関数(立ち絵_カワイイスパイス,"カワイイスパイス",,0)
				CALL 口上変数初期化
				WSTR:(K++) = 아리카는 「그건 그렇지만요오……」라며 시선을 피한다.
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				WSTR:(K++) = 「그런 고로, %CALLNAME:PLAYER%님. 방해는 되지 않을 테니, 후위에 두시면 될 거예요」
				CALL メッセージ欄表示用関数(立ち絵_カワイイスパイス,"カワイイスパイス",,0)
				CALL 口上変数初期化
				WSTR:(K++) = 그런 거라면, 뭐. 그녀의 약체 내성은 믿음직하다.
				WSTR:(K++) = %CALLNAME:PLAYER%은(는) 고개를 끄덕이며, 아리카를 파티에 받아들였다.
				CALL メッセージ欄表示用関数(,,,0)
				CALL 口上変数初期化
				CALL 接続ルート全開放処理(マス深度, マス分岐)
				SETBIT ダンジョン構造配列_異界と化した洞窟:マス深度:マス分岐, 4
			ENDIF
		ELSE
			戦闘時_特殊処理フラグ = ありかのサポート_異界洞窟
			敵BATTLE_STATE_STR:0:エネミー名 = Lv10_下級淫魔
			敵BATTLE_STATE_STR:2:エネミー名 = Lv10_下級淫魔
			CALL 雑魚敵繰り返し戦闘処理
		ENDIF
		CALL 画面再描画
ENDSELECT

;3マス目。宝箱。遺留品。
@ダンジョンマス情報_異界と化した洞窟_6_7(ARGS)
#DIM マス深度
#DIM マス分岐
#DIMS 立ち絵_カワイイスパイス
マス深度 = 6
マス分岐 = 7

SELECTCASE ARGS
	CASE "マス画像"
		ダンジョンマス画像URL = 壁_洞窟
		ダンジョンマス画像URL_重ね表示 = 宝箱アイコン_木箱_開
	CASE "接続先"
		CALL ダンジョン分岐線描画(@"{マス深度}_{マス分岐}", "1_7")
	CASE "マスイベント"
		IF 初来訪マス判定用フラグ
			;最初に訪れた時
			CALLF 顔グラ表示用文字列関数(キャラ検索("[死と瘴気の魔女]カワイイスパイス"),100,,,1,1)
			立ち絵_カワイイスパイス = %立ち絵リソース記録%
			CALL 口上変数初期化
			WSTR:(K++) = 감옥이다. 무인이지만, 몇 가지 도구가 방치되어 있다.
			CALL メッセージ欄表示用関数(,,,0)
			CALL 口上変数初期化
			WSTR:(K++) = 「아리카 쨩. 유류품 같은 거 있어?」
			CALL メッセージ欄表示用関数(立ち絵_カワイイスパイス,"カワイイスパイス",,0)
			CALL 口上変数初期化
			WSTR:(K++) = 촉촉한 목소리로, 카와이 스파이스는 물었다.
			WSTR:(K++) = 의류, 액세서리, 지갑 등이 흩어져 있다. 그것들을 아리카는 정리한다.
			WSTR:(K++) = 무엇을 하고 있는지, 라고 %CALLNAME:PLAYER%이(가) 묻자, 카와이 스파이스는 대답해 주었다.
			CALL メッセージ欄表示用関数(,,,0)
			CALL 口上変数初期化
			WSTR:(K++) = 「음마들은 인간을 붙잡아 조교하고, 자신의 종족에 동화시키는 거야
			WSTR:(K++) = 　동화가 완전히 진행되면, 대부분은 인간으로서의 삶을 살 수 없게 돼」
			CALL メッセージ欄表示用関数(立ち絵_カワイイスパイス,"カワイイスパイス",,0)
			CALL 口上変数初期化
			WSTR:(K++) = 「예외는 몇 명 있지만 말이야. 어쨌든, 그들의 유물은 회수해서 연고자에게 돌려줘야 하니까」
			CALL メッセージ欄表示用関数(立ち絵_カワイイスパイス,"カワイイスパイス",,0)
			CALL 口上変数初期化
			WSTR:(K++) = 그건…… 큰일이네.
			WSTR:(K++) = 유물 회수를 돕고, 아리카에게 건넨다.
			WSTR:(K++) = 아리카는 프로펠러가 달린 작은 기계에 그것들을 싣고, 입구를 향해 날려 보냈다.
			CALL メッセージ欄表示用関数(,,,0)
			CALL 口上変数初期化
			WSTR:(K++) = 「이걸로, 괜찮아」
			WSTR:(K++) = 일어나서, 앞으로 나아간다. 적은 아직도 많다. 정신을 바짝 차려야 해.
			CALL 接続ルート全開放処理(マス深度, マス分岐)
		ELSE
			KSTR:(K++) = 특별히 눈에 띄는 것은 더 이상 없는 것 같다.
		ENDIF
		CALL メッセージ欄表示用関数(,,,0)
		CALL 画面再描画
