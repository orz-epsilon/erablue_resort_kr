;-------------------------------------------------------------------------------------------
;射精先の選択肢関連の処理
;-------------------------------------------------------------------------------------------
@EVENT_SHOOT_MASTER
#DIM 射精先キャラ, 射精先キャラ最大数
#DIM 未使用１, 1
#DIMS 未使用２, 1
#DIM 対象キャラカウンタ
#DIM 対象キャラ数
#DIM 射精場所カウンタ
#DIM 選択肢数
#DIMS 選択肢文字列
#DIM 選択射精場所
#DIM 選択キャラ
#DIM 選択番号
VARSET 射精先キャラ, -1
;0では駄目なので初期化

;射精キャラを登録
RFLAG:口上用射精キャラ番号 = MASTER

;どこに射精するかを決定する

;選択なしでそのまま出すもの
CALL 確定射精先判定(MASTER)
SIF RESULT
	RETURN 0

;まずTARGETのうちうふふ状態の相手を探す
CALL キャラ番号配列_初期化_フィルタソート(射精先キャラ, "キャラソート_射精先_MASTER", 未使用１, 未使用２, 1)
対象キャラ数 = RESULT

;候補がいない＝非うふふ時の射精
IF 対象キャラ数 == 0
	IF SELECTCOM == 315
		;性処理業務時は、各コマンドに射精場所の管理を渡す
		IF RFLAG:性処理射精先
			CALL 射精実処理(PLAYER, TARGET, RFLAG:性処理射精先 - 10)
			RETURN 0
		ELSE
			TRYCCALLFORM 性処理_射精時処理_%RSTR:コマンド結果受渡し文字列%
				SIF RESULT
					RETURN 0
			CATCH
			ENDCATCH
			;コマンドが特に指定しなかった場合は30番
			JUMP 射精実処理(MASTER, TARGET, 30)
		ENDIF
	ELSE
		;オートコマンドのみのはずなので、オートコマンド相手で呼び出す
		JUMP 射精実処理(MASTER, AUTOCOM_実行番号保存, 30)
	ENDIF
ENDIF

CALL SHOOT予告口上(MASTER)
PRINTL 

;オート射精設定があればそれに従う
CALL オート射精先判定_MASTER(MASTER, 射精先キャラ, 対象キャラ数)
SIF RESULT
	RETURN 0

選択射精場所 = -1
選択キャラ = -1

$INPUT_LOOP
;射精先の一覧から可能な選択肢を引っ張ってくる
選択肢文字列 '= ""
選択肢数 = 0
FOR 対象キャラカウンタ, 0, 対象キャラ数
	FOR 射精場所カウンタ, 0, 31
		TRYCCALLFORM SHOOT_ABLE_{射精場所カウンタ}(MASTER, 射精先キャラ:対象キャラカウンタ)
			;ABLEが通れば決定
			IF RESULT
				CALLFORM SHOOT_NAME_{射精場所カウンタ}(射精先キャラ:対象キャラカウンタ)
				選択番号 = 射精場所カウンタ + 対象キャラカウンタ * 100
				;選択射精場所のものはえっちな色にする
				SIF 選択射精場所 == 射精場所カウンタ && 選択キャラ == 対象キャラカウンタ
					選択肢文字列 += @"<font color='#0xFF3399'>"
				選択肢文字列 += @"<button value='{選択番号}'>[{選択番号,3}]%CALLNAME:(射精先キャラ:対象キャラカウンタ)%:%TSTR:コマンド名受渡%</button><br>"
				SIF 選択射精場所 == 射精場所カウンタ && 選択キャラ == 対象キャラカウンタ
					選択肢文字列 += @"</font>"
				選択肢数 += 1
			ENDIF
		CATCH
		ENDCATCH
	NEXT
	選択肢文字列 += "<br>"
NEXT

IF 選択肢数 == 0
	;選択肢がないなら30番確定
	JUMP 射精実処理(MASTER, -1, 30)
ELSEIF 選択肢数 == 1
	;射精先が一択の場合
	JUMP 射精実処理(MASTER, 射精先キャラ:(選択番号 / 100), 選択番号 % 100)
ENDIF

DRAWLINE
PRINTL 어디에 사정하시겠습니까?
DRAWLINE
HTML_PRINT 選択肢文字列

IF INRANGE(選択射精場所, 0, 30) && INRANGE(選択キャラ, 0, 対象キャラ数 - 1)
	PRINTBUTTON @"[ -1]발사!", -1
ELSE
	SETCOLOR 0x666666
	PRINTPLAIN [ -1]유효한 사정 위치를 선택해 주세요
	RESETCOLOR
ENDIF
PRINTL

BINPUT
選択番号 = RESULT

SELECTCASE 選択番号
	CASE -1
		JUMP 射精実処理(MASTER, 射精先キャラ:選択キャラ, 選択射精場所)
	CASEELSE
		選択射精場所 = 選択番号 % 100
		選択キャラ = 選択番号 / 100
		REUSELASTLINE 
		GOTO INPUT_LOOP
ENDSELECT


@オート射精先判定_MASTER(射精キャラ, 射精先キャラ, 対象キャラ数)
#DIM 射精キャラ
#DIM REF 射精先キャラ, 0
#DIM 対象キャラ数
#DIM オプション番号
#DIM 対象キャラカウンタ
#DIMS 候補配列, 500
#DIM 候補数
#DIM 補正キー
#DIMS 分割配列, 2

VARSET 候補配列
候補数 = 0
;オート射精設定を上から見る
FOR オプション番号, 0, 31
	SIF オート射精先オプション:オプション番号 == -1
		BREAK
	SIF 候補数 > 0 && オート射精先オプション:オプション番号 < 10000
		BREAK
	SIF 候補数 >= 500
		BREAK

	FOR 対象キャラカウンタ, 0, 対象キャラ数
		IF オート射精先オプション:オプション番号 >= 10000
			補正キー = オート射精先オプション:オプション番号 - 10000
		ELSE
			補正キー = オート射精先オプション:オプション番号
		ENDIF
		TRYCCALLFORM SHOOT_ABLE_{補正キー}(射精キャラ, 射精先キャラ:対象キャラカウンタ)
			;ABLEが通ったら候補配列に突っ込んでおく
			IF RESULT
				候補配列:候補数 '= @"{補正キー}_{射精先キャラ:対象キャラカウンタ}"
				候補数 ++
			ENDIF
		CATCH
		ENDCATCH
		SIF 候補数 >= 500
			BREAK
	NEXT
NEXT

IF 候補数 > 0
	;候補があるならそこからランダムに選んで実処理に投げる
	SPLIT 候補配列:(RAND:候補数), "_", 分割配列
	CALL 射精実処理(射精キャラ, TOINT(分割配列:1), TOINT(分割配列:0))
	RETURN 1
ENDIF

RETURN 0


@SHOOT絶頂計算(ARG, 射精キャラ)
#DIM 絶頂残値
#DIM 射精キャラ
#DIM 強度一時保存
#DIM ソート用配列, 5
#DIM _C
#DIM _V
#DIM _A
#DIM _B
#DIM _S
#DIM _L

_C = 0
_V = 0
_A = 0
_B = 0
_S = 0

絶頂残値 = 絶頂残値算出処理(ARG)

;絶頂Ｃ
NOWEX:ARG:被射精Ｃ絶頂 = 0
DO
	IF CUP:ARG:快Ｃ + PALAM:ARG:快Ｃ - CDOWN:ARG:快Ｃ >= PALAMLV:4
		強度一時保存 = (CUP:ARG:快Ｃ + PALAM:ARG:快Ｃ - CDOWN:ARG:快Ｃ) / PALAMLV:4
		NOWEX:ARG:被射精Ｃ絶頂 += 強度一時保存
		_C = NOWEX:ARG:被射精Ｃ絶頂
		CDOWN:ARG:快Ｃ += 強度一時保存 * PALAMLV:4 - 絶頂残値
	ENDIF
LOOP CUP:ARG:快Ｃ + PALAM:ARG:快Ｃ - CDOWN:ARG:快Ｃ >= PALAMLV:4
;絶頂Ｖ
NOWEX:ARG:被射精Ｖ絶頂 = 0
DO
	IF CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ - CDOWN:ARG:快Ｖ >= PALAMLV:4
		強度一時保存 = (CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ - CDOWN:ARG:快Ｖ) / PALAMLV:4
		NOWEX:ARG:被射精Ｖ絶頂 += 強度一時保存
		_V = NOWEX:ARG:被射精Ｖ絶頂
		CDOWN:ARG:快Ｖ += 強度一時保存 * PALAMLV:4 - 絶頂残値
	ENDIF
LOOP CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ - CDOWN:ARG:快Ｖ >= PALAMLV:4
;絶頂Ａ
NOWEX:ARG:被射精Ａ絶頂 = 0
DO
	IF CUP:ARG:快Ａ + PALAM:ARG:快Ａ - CDOWN:ARG:快Ａ >= PALAMLV:4
		強度一時保存 = (CUP:ARG:快Ａ + PALAM:ARG:快Ａ - CDOWN:ARG:快Ａ) / PALAMLV:4
		NOWEX:ARG:被射精Ａ絶頂 += 強度一時保存
		_A = NOWEX:ARG:被射精Ａ絶頂
		CDOWN:ARG:快Ａ += 強度一時保存 * PALAMLV:4 - 絶頂残値
	ENDIF
LOOP CUP:ARG:快Ａ + PALAM:ARG:快Ａ - CDOWN:ARG:快Ａ >= PALAMLV:4
;絶頂Ｂ
NOWEX:ARG:被射精Ｂ絶頂 = 0
DO
	IF CUP:ARG:快Ｂ + PALAM:ARG:快Ｂ - CDOWN:ARG:快Ｂ >= PALAMLV:4
		強度一時保存 = (CUP:ARG:快Ｂ + PALAM:ARG:快Ｂ - CDOWN:ARG:快Ｂ) / PALAMLV:4
		NOWEX:ARG:被射精Ｂ絶頂 += 強度一時保存
		_B = NOWEX:ARG:被射精Ｂ絶頂
		CDOWN:ARG:快Ｂ += 強度一時保存 * PALAMLV:4 - 絶頂残値
	ENDIF
LOOP CUP:ARG:快Ｂ + PALAM:ARG:快Ｂ - CDOWN:ARG:快Ｂ >= PALAMLV:4
;絶頂Ｓ
NOWEX:ARG:被射精Ｓ絶頂 = 0
DO
	IF CUP:ARG:快Ｓ + PALAM:ARG:快Ｓ - CDOWN:ARG:快Ｓ >= PALAMLV:4
		強度一時保存 = (CUP:ARG:快Ｓ + PALAM:ARG:快Ｓ - CDOWN:ARG:快Ｓ) / PALAMLV:4
		NOWEX:ARG:被射精Ｓ絶頂 += 強度一時保存
		_S = NOWEX:ARG:被射精Ｓ絶頂
		CDOWN:ARG:快Ｓ += 強度一時保存 * PALAMLV:4 - 絶頂残値
	ENDIF
LOOP CUP:ARG:快Ｓ + PALAM:ARG:快Ｓ - CDOWN:ARG:快Ｓ >= PALAMLV:4

;-------------------------------------------------
;絶頂時の追加処理
;-------------------------------------------------
RCVAR:ARG:被射精絶頂の強度 = _C + _V + _A + _B + _S
IF	ARG == MASTER
	TFLAG:調教者被射精絶頂強度 = _C + _V + _A + _B + _S
ENDIF
IF ARG == TARGET
	;快楽刻印の処理
	IF RCVAR:ARG:被射精絶頂の強度 > 3 && MARK:ARG:1 < 3
		RCVAR:ARG:快楽強度 = 3
	;Rが3以上で快楽刻印２に相当
	ELSEIF RCVAR:ARG:被射精絶頂の強度 > 2 && MARK:ARG:1 < 2
		RCVAR:ARG:快楽強度 = 2
	;Rが2以上で快楽刻印１に相当
	ELSEIF RCVAR:ARG:被射精絶頂の強度 > 1 && MARK:ARG:1 < 1
		RCVAR:ARG:快楽強度 = 1
	ELSEIF RCVAR:ARG:被射精絶頂の強度 >= 1
		RCVAR:ARG:快楽強度 = 0
	ENDIF
ENDIF

IF RCVAR:ARG:被射精絶頂の強度 > 0 && 射精キャラ == MASTER
	IF 初体験日:ARG:あなたの手で初絶頂 == 0
		初体験日:ARG:あなたの手で初絶頂 = DAY
		CALL 履歴データベース登録(CFLAG:MASTER:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>처음으로 %CALLNAME:ARG%을 절정시켰다</font>","うふふ")
		CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>처음으로 %CALLNAME:MASTER%의 손으로 절정했다</font>","うふふ")
	ENDIF
ENDIF

;同時絶頂による補正
_L = 0
SELECTCASE MIN(_C, _V, _A, _B, _S)
	CASE IS >= 5
		_L = 5
		_C *= 60
		_V *= 60
		_A *= 60
		_B *= 60
		_S *= 60
	CASE 4
		_L = 5
		_C *= 48
		_V *= 48
		_A *= 48
		_B *= 48
		_S *= 48
	CASE 3
		_L = 5
		_C *= 36
		_V *= 36
		_A *= 36
		_B *= 36
		_S *= 36
	CASE 2
		_L = 5
		_C *= 24
		_V *= 24
		_A *= 24
		_B *= 24
		_S *= 24
	CASE 1
		_L = 5
		_C *= 12
		_V *= 12
		_A *= 12
		_B *= 12
		_S *= 12
	CASEELSE
		;絶頂状態部位がいくつあるかを検索
		SELECTCASE GROUPMATCH(0, _C, _V, _A, _B, _S)
			CASE 1
				_L = 4
				LOCAL = 8
			CASE 2
				_L = 3
				LOCAL = 4
			CASE 3
				_L = 2
				LOCAL = 2
			CASE 4
				_L = 1
				LOCAL = 1
			ENDSELECT
		_C *= LOCAL
		_V *= LOCAL
		_A *= LOCAL
		_B *= LOCAL
		_S *= LOCAL
ENDSELECT

IF _C
	SOURCE:ARG:露出 += 500 * _C
	SOURCE:ARG:屈従 += 200 * _C
ENDIF
IF _V
	SOURCE:ARG:欲情 += 800 * _V
	SOURCE:ARG:恭順 += 500 * _V
	SOURCE:ARG:露出 += 700 * _V
	SOURCE:ARG:屈従 += 400 * _V
ENDIF
IF _A
	SOURCE:ARG:欲情 += 500 * _A
	SOURCE:ARG:恭順 += 700 * _A
	SOURCE:ARG:露出 += 900 * _A
	SOURCE:ARG:屈従 += 500 * _A
	SOURCE:ARG:逸脱 += 200 * _A
ENDIF
IF _B
	SOURCE:ARG:露出 += 500 * _B
	SOURCE:ARG:屈従 += 200 * _B
	SIF TALENT:ARG:性別  == 10
		SOURCE:ARG:逸脱 += 100 * _B
ENDIF
IF _S
	SOURCE:ARG:露出 += 500 * _S
	SOURCE:ARG:屈従 += 200 * _S
	SOURCE:ARG:逸脱 += 100 * _S
ENDIF

NOWEX:ARG:被射精多重絶頂 = _L

;スコアを増やす
ソート用配列 = NOWEX:ARG:被射精Ｃ絶頂, NOWEX:ARG:被射精Ｖ絶頂, NOWEX:ARG:被射精Ａ絶頂, NOWEX:ARG:被射精Ｂ絶頂, NOWEX:ARG:被射精Ｓ絶頂
ARRAYSORT ソート用配列, BACK
NOWEX:ARG:スコア += (SUMARRAY(ソート用配列, 0, 4) * POWER(2, MIN(3, NOWEX:ARG:被射精多重絶頂 - 1)) + ソート用配列:4) * 2

;絶頂回数を増やす
EX:ARG:Ｃ絶頂 += NOWEX:ARG:被射精Ｃ絶頂
EX:ARG:Ｖ絶頂 += NOWEX:ARG:被射精Ｖ絶頂
EX:ARG:Ａ絶頂 += NOWEX:ARG:被射精Ａ絶頂
EX:ARG:Ｂ絶頂 += NOWEX:ARG:被射精Ｂ絶頂
EX:ARG:Ｓ絶頂 += NOWEX:ARG:被射精Ｓ絶頂
EX:ARG:多重絶頂 += _L

;絶頂経験を増やす
EXP:ARG:絶頂経験 += RCVAR:ARG:被射精絶頂の強度
EXP:ARG:Ｃ絶頂経験 += NOWEX:ARG:被射精Ｃ絶頂
EXP:ARG:Ｖ絶頂経験 += NOWEX:ARG:被射精Ｖ絶頂
EXP:ARG:Ａ絶頂経験 += NOWEX:ARG:被射精Ａ絶頂
EXP:ARG:Ｂ絶頂経験 += NOWEX:ARG:被射精Ｂ絶頂
EXP:ARG:Ｓ絶頂経験 += NOWEX:ARG:被射精Ｓ絶頂
SIF RCVAR:ARG:露出コマンドフラグ
	EXP:ARG:露出絶頂経験 += RCVAR:ARG:被射精絶頂の強度
SIF RCVAR:ARG:苦痛コマンドフラグ && CUP:ARG:苦痛 >= MAX(1, 100 - (ABL:ARG:マゾ性感 * 20))
	EXP:ARG:苦痛絶頂経験 += RCVAR:ARG:被射精絶頂の強度
SIF RCVAR:ARG:嗜虐コマンドフラグ
	EXP:ARG:嗜虐絶頂経験 += RCVAR:ARG:被射精絶頂の強度
SIF RCVAR:ARG:奉仕コマンドフラグ
	EXP:ARG:奉仕絶頂経験 += RCVAR:ARG:被射精絶頂の強度
SIF RCVAR:ARG:道具コマンドフラグ
	EXP:ARG:道具絶頂経験 += RCVAR:ARG:被射精絶頂の強度
SIF RCVAR:ARG:触手コマンドフラグ
	EXP:ARG:触手絶頂経験 += RCVAR:ARG:被射精絶頂の強度
SIF MODE_存在判定_ターゲット側("首絞め", ARG)
	EXP:ARG:首絞め絶頂経験 += RCVAR:ARG:被射精絶頂の強度
IF RCVAR:ARG:精飲フラグ
	EXP:ARG:精飲絶頂経験 += RCVAR:ARG:被射精絶頂の強度
	EXP:ARG:精飲快楽経験 += RCVAR:ARG:被射精絶頂の強度 * 10
ENDIF
IF RCVAR:ARG:膣内射精フラグ
	EXP:ARG:膣内射精絶頂経験 += RCVAR:ARG:被射精絶頂の強度
ENDIF
IF RCVAR:ARG:腸内射精フラグ
	EXP:ARG:腸内射精絶頂経験 += RCVAR:ARG:被射精絶頂の強度
ENDIF

; ;絶頂による欲望ＬＶアップ
; IF ARG == TARGET
; 	;自制心があると１下がる
; 	SIF TALENT:ARG:自制心
; 		_L -= 1
; 	IF ABL:ARG:欲望 < _L
; 		ABL:ARG:欲望 = _L
; 		PRINTFORML そして欲望がLV{_L}になった
; 	ENDIF
; ENDIF
CALL EXP取得表示_指定キャラ(ARG)
CALL EXP変動記録処理(ARG)

;-------------------------------------------------
;絶頂時の追加処理
;-------------------------------------------------
;射精
IF TALENT:ARG:性別 & 2
	CALL 射精処理_コマンド(ARG, RCVAR:ARG:被射精絶頂の強度)
	SIF RESULT > 0
		CALL 勃起度下降_射精時(ARG)
ENDIF

;ZPの取得
IF RCVAR:ARG:被射精絶頂の強度 > 0
	CALL 絶頂体力減少処理(ARG, NOWEX:ARG:被射精Ｃ絶頂, NOWEX:ARG:被射精Ｖ絶頂, NOWEX:ARG:被射精Ａ絶頂, NOWEX:ARG:被射精Ｂ絶頂, NOWEX:ARG:被射精Ｓ絶頂)
	CALL ZP_取得処理(ARG, RCVAR:ARG:被射精絶頂の強度)
	CFLAG:ARG:体力成長値 = MIN(4000, CFLAG:ARG:体力成長値 + RCVAR:ARG:被射精絶頂の強度 * 5)
ENDIF


;連れ込み状態時、満足したか
;ついでに中毒欲求不満の判定も行う
CALL 中毒連れ込み判定_精飲(ARG)
IF RESULT
	;精飲時は必ず絶頂するはずなのでフラグだけ見る
	IF RCVAR:ARG:精飲フラグ
		CFLAG:ARG:中毒欲求不満フラグ = -1
		SIF 連れ込みパターン == "精飲"
			RCVAR:ARG:連れ込み満足フラグ = 1
		NOWEX:ARG:スコア += NOWEX:ARG:被射精多重絶頂 * 2
	ENDIF
ENDIF
CALL 中毒連れ込み判定_膣内射精(ARG)
IF RESULT
	;膣内射精時は必ず絶頂するはずなのでフラグだけ見る
	IF RCVAR:ARG:膣内射精フラグ
		CFLAG:ARG:中毒欲求不満フラグ = -1
		SIF 連れ込みパターン == "膣内射精"
			RCVAR:ARG:連れ込み満足フラグ = 1
		NOWEX:ARG:スコア += NOWEX:ARG:被射精多重絶頂 * 2
	ENDIF
ENDIF
CALL 中毒連れ込み判定_腸内射精(ARG)
IF RESULT
	;腸内射精時は必ず絶頂するはずなのでフラグだけ見る
	IF RCVAR:ARG:腸内射精フラグ
		CFLAG:ARG:中毒欲求不満フラグ = -1
		SIF 連れ込みパターン == "腸内射精"
			RCVAR:ARG:連れ込み満足フラグ = 1
		NOWEX:ARG:スコア += NOWEX:ARG:被射精多重絶頂 * 2
	ENDIF
ENDIF

RETURN 1


@SHOOT予告口上(射精キャラ)
#DIM 射精キャラ
#DIM 口上用キャラ番号

RESULT = 0
TRYCALL SHOOT予告口上_MOD(射精キャラ)
SIF RESULT > 0
	RETURN 0

;射精キャラがＶ挿入中
;ちんこは一本だけなので場合分けしなくていいはず
IF MODE_存在判定_プレイヤー側("Ｖ挿入系", 射精キャラ)
	口上用キャラ番号 = DT_CELL_GET("体位モードデータベース", モードID受渡し, "対象キャラ", 1)
	IF CFLAG:口上用キャラ番号:睡眠
		;睡眠時はなし
	ELSE
		PRINTFORML 한계에 다다른 %CALLNAME:射精キャラ%이(가) 질내사정을 예고하자,
		IF TCVAR:口上用キャラ番号:泥酔眠姦
			PRINTFORML 만취해 몽롱해진 %CALLNAME:口上用キャラ番号%은(는) 영문도 모른 채 본능에 이끌리듯 질벽을 조였습니다.
		ELSEIF TFLAG:マッサージ_鬼灯の香使用時間 > 0 && TFLAG:マッサージ_鬼灯の香使用時間 + 20 < DAY * 1440 + TIME
			SELECTCASE RAND:2
			CASE 0
				PRINTFORML 귀등의 향이 듣고 있는 %CALLNAME:口上用キャラ番号%은(는) 몽롱한 채 본능에 이끌리듯 질벽을 조였습니다.
			CASE 1
				PRINTFORML 귀등의 향이 듣고 있는 %CALLNAME:口上用キャラ番号%은(는) 몽롱하면서도 약하게 저항했지만, 싫어 몸을 비튼 탓에 오히려 질벽이 음경을 불규칙하게 조여 사정을 재촉했습니다.
			ENDSELECT
		ELSEIF SAVESTR:ゲームフェイズ管理 == "むりやりうふふモード"
			IF RISKY_DAY(口上用キャラ番号) > 0
				PRINTFORM %CALLNAME:口上用キャラ番号%은(는) 새파랗게 질리며,
				PRINTFORML 필사적으로 %TEXTR("고개를 저으며/손을 뻗어 몸부림치며/발을 버둥거리며")%、%TEXTR("위험한 날이니까/생겨버릴 날이니까/싫어, 그만해/안에만은 싫어/임신은 싫어/임신하고 싶지 않아")%라고 저항합니다.
				PRINTL
				PRINTFORML ……하지만 그 %TEXTR("필사적인/가련한/헛된/무의미한")%저항 때문에 %CALLNAME:口上用キャラ番号%의 %TEXTR("몸/질 근육")%은(는) %CALLNAME:射精キャラ%의 음경을 %TEXTR("꽉/꽉꽉")%라고 조이듯 자극해 오히려 강하게 %TEXTR("사정/토정")%을 재촉하는 결과가 되었습니다……
			ELSE
				SELECTCASE RAND:2
				CASE 0
					PRINTFORM %CALLNAME:口上用キャラ番号%은(는) 갑자기 얌전해지고,
					PRINTFORM %TEXTR("뭐든지 할게/뭐든지 말하는 대로 들을게/더 이상 저항하지 않을게/오늘의 일은 용서할 테니 누구에게도 말하지 않을게/오늘의 일은 용서할 테니 이제부터는 언제든지 범해도 좋아")%에게 %TEXTR("안에만은/안에 내는 것만은/그것만은/임신만은/임신시키는 것만은")%용서해 달라고 %TEXTR("떨리는/겁에 질린")%목소리로 필사적으로 %TEXTR("간청/애원/목숨 구걸")%합니다.
					PRINTL
					PRINTFORML ……하지만 그 %TEXTR("필사적인/가련한/헛된/무의미한")%%TEXTR("간청/애원/목숨 구걸")%은(는) 오히려 %CALLNAME:射精キャラ%의 %TEXTR("정복욕/지배욕/가학심")%을 더욱 부추겨 더 강하게 %TEXTR("사정/토정")%을 재촉하는 결과가 되었습니다……
				CASE 1
					PRINTFORM %CALLNAME:口上用キャラ番号%은(는) 새파랗게 질리며,
					PRINTFORML 필사적으로 %TEXTR("고개를 저으며/손을 뻗어 몸부림치며/발을 버둥거리며")%、%TEXTR("싫어, 그만해/안에만은 싫어/임신은 싫어/임신하고 싶지 않아")%라고 저항합니다.
					PRINTL
					PRINTFORML ……하지만 그 %TEXTR("필사적인/가련한/헛된/무의미한")%저항 때문에 %CALLNAME:口上用キャラ番号%의 %TEXTR("몸/질 근육")%은(는) %CALLNAME:射精キャラ%의 음경을 %TEXTR("꽉/꽉꽉")%라고 조이듯 자극해 오히려 강하게 %TEXTR("사정/토정")%을 재촉하는 결과가 되었습니다……
				ENDSELECT
			ENDIF
		ELSEIF 知識素質:口上用キャラ番号:性知識 < 0
			PRINTFORML 의미를 제대로 이해하지 못하고 있지만, %CALLNAME:口上用キャラ番号%은(는) 본능대로 신음하며 질을 조이고 있었습니다.
		ELSEIF TALENT:口上用キャラ番号:恋慕 && 射精キャラ == MASTER
			PRINTFORM %CALLNAME:口上用キャラ番号%은(는) \@ PREGNANCY_SIZE(口上用キャラ番号) > 2 ? 부푼 배를 흔들며 # 스스로 허리를 흔들며 \@교성을 지르며,
			IF TALENT:口上用キャラ番号:妊娠 && CFLAG:口上用キャラ番号:子の父親 == 射精キャラ
				PRINTFORM 아빠의 자지 밀크 줘
			ELSEIF RISKY_DAY(口上用キャラ番号) > 0
				IF CSTR:口上用キャラ番号:一人称 != ""
					PRINTFORM %CSTR:口上用キャラ番号:一人称%을(를)
				ENDIF
				PRINTDATA
					DATA 엄마로 만들어줘
					DATA 임신시켜줘
					DATA 임신시켜줘
				ENDDATA
			ELSE
				PRINTFORM 안에 싸줘
			ENDIF
			PRINT_IMG "えっちハート"
			PRINTFORML 、라며 질내사정을 졸랐다
		ELSEIF CFLAG:口上用キャラ番号:発情期フラグ < 0
			IF TALENT:口上用キャラ番号:妊娠
				PRINTFORML %TEXTR("완전히 발정한/완전히 발정해버린")%%CALLNAME:口上用キャラ番号%은(는) 임신한 몸이니 피임할 필요가 없다며 음란한 목소리로 질내사정을 졸랐습니다.
			ELSE
				PRINTFORML %TEXTR("완전히 발정한/완전히 발정해버린/발정으로 완전히 이성을 잃어버린")%%CALLNAME:口上用キャラ番号%은(는) %TEXTR("암컷의 본능에 거역하지 못하고/쾌락에 몰두한 채/본능이 이끄는 대로 법열을 탐하며/암컷의 본능이 원하는 대로")%、%TEXTR("음란한/녹아내린/완전히 녹아내린")%%TEXTR("표정/얼굴")%로 %TEXTR("씨 뿌리기/질내 사정")%을 졸랐습니다.
			ENDIF
		ELSE
			IF RISKY_DAY(口上用キャラ番号) < -1
				PRINTFORML %CALLNAME:口上用キャラ番号%은(는) 요염하게 신음하며 안에 싸도 괜찮으니 마음대로 하라고 대답했습니다.
			ELSEIF PREGNANCY_SIZE(口上用キャラ番号) > 2
				PRINTFORML %CALLNAME:口上用キャラ番号%은(는) 자신의 불룩한 배를 힐끗 보고 마음대로 하라며 체념한 듯 대답했습니다.
			ELSEIF RISKY_DAY(口上用キャラ番号) > 0 && TALENT:口上用キャラ番号:妊娠 < 1
				PRINTFORML %CALLNAME:口上用キャラ番号%은(는) 필사적으로 고개를 저으며 오늘은 위험일이니 적어도 밖에 싸달라고 애원합니다.
			ELSEIF RISKY_DAY(口上用キャラ番号) < 0 && TALENT:口上用キャラ番号:妊娠 < 1
				PRINTFORML %CALLNAME:口上用キャラ番号%은(는) 요염하게 신음하며 오늘은 괜찮으니 마음대로 하라고 대답했습니다.
			ELSE
				PRINTFORML %CALLNAME:口上用キャラ番号%은(는) 쾌감에 녹아든 머리로 안에 싸게 해도 될지 망설였습니다.
			ENDIF
		ENDIF
	ENDIF
ENDIF


@SHOOT絶頂口上(射精先キャラ, 射精キャラ)
#DIM 射精先キャラ
#DIM 射精キャラ

;後々口上を入れる処理を入れ込む

RESULT = 0
TRYCALL SHOOT絶頂口上_MOD(射精先キャラ, 射精キャラ)
SIF RESULT > 0
	RETURN 0

PRINTFORM %CALLNAME:射精先キャラ%은(는)

SELECTCASE RFLAG:フィニッシュ場所
	CASE 0
		;膣内
		IF SAVESTR:ゲームフェイズ管理 == "むりやりうふふモード"
			PRINTFORML %TEXTR("쿵쾅쿵쾅/쿵쿵/철퍽철퍽/질척질척")%와 %TEXTR("자궁/여자의 가장 소중한 곳")%%TEXTR("넘쳐흐르는/쏟아지는/침략하는/토해져 버린/토해지는/더럽혀가는/더럽혀가는/범하는/물들여가는")%%TEXTR("원치 않는/농후한")%정액의 %TEXTR("/절망적인")%감각에 %TEXTR("몸을/목소리를")%떨면서, %TEXTR("실의/굴욕/굴복/치욕")%와 함께 절정했습니다.
		ELSE
			PRINTL 자궁에 넘쳐흐르는 진한 정액의 감각으로 절정했다
		ENDIF
	CASE 1
		;腸内
		PRINTL 장 안에서 느껴지는 정액의 열기에 절정했다
	CASE 2
		;口内
		PRINTFORML 목구멍에 %CALLNAME:射精キャラ%의 정액을 흘려 넣어져 절정했다
	CASE 3
		;乳内
		PRINTL 가슴에 흘러내리는 정액의 감촉으로 절정했다
ENDSELECT

IF 射精可能(射精先キャラ) && RCVAR:射精先キャラ:空打ちフラグ == 0
	PRINTL 동시에 자신의 음경에서도 정액을 쏟아냈다…
ENDIF
WAIT


@キャラソート_射精先_MASTER(キャラ番号, オプション変数, オプション文字列)
#DIM キャラ番号
#DIM REF オプション変数, 0
#DIMS REF オプション文字列, 0

SIF キャラ番号 == 0
	RETURN 0
SIF FINDELEMENT(TARGET, キャラ番号, 1) == -1
	RETURN 0

SIF MODE_存在判定_完全一致("Ｖ挿入系", MASTER, キャラ番号)
	RETURN -2
SIF MODE_存在判定_完全一致("Ａ挿入系", MASTER, キャラ番号)
	RETURN -2
SIF CFLAG:キャラ番号:うふふ
	RETURN -1

RETURN 0

