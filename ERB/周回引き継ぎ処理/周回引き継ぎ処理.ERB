		ENDIF
		PRINTL
	ELSE
		PRINTBUTTON @"{LOCAL, 2}：--------------------", LOCAL
		PRINTL
	ENDIF
NEXT
自動引き継ぎ枠 = 0
PRINTL ■자동 계승 캐릭터
FOR LOCAL, 1, CHARANUM
	IF TALENT:LOCAL:時空移動 == 2
		PRINTFORML %NAME表示(LOCAL)%
