@周回引き継ぎ処理(戻れないフラグ = 0)
#DIM 引き継ぎ枠
#DIM 自動引き継ぎ枠
#DIM 引き継ぎ枠空位置
#DIM 同行枠
#DIM 戻れないフラグ
#DIMS HTML文
#DIM DYNAMIC 起動直後

IF 起動直後 == 0
	VARSET 引き継ぎキャラ番号
	VARSET キャラ妊娠引き継ぎ
	;時空移動セット
	FOR LOCAL, 1, CHARANUM
		;素質なしと既に引き継ぎの時スキップ
		SIF TALENT:LOCAL:時空移動 <= 0 || TALENT:LOCAL:時空移動 >= 2
			CONTINUE
		RESULT = 0
		TRYCALLFORM 時空移動有効化_{NO:LOCAL}(LOCAL)
		SELECTCASE RESULT
			CASE 0
				;通常条件、婚姻状態なら許可
				SIF TALENT:LOCAL:恋慕 >= 2
					TALENT:LOCAL:時空移動 = 2
			CASE 1
				;許可
				TALENT:LOCAL:時空移動 = 2
			CASE -1
				;不許可なのでなにもしない
		ENDSELECT
	NEXT
	起動直後 = 1
ENDIF

