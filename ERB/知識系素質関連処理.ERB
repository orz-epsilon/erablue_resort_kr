	IF 知識素質:ARG:(LOCAL + 100) >= LOCAL:1
		知識素質:ARG:LOCAL += 1
		PRINTFORMW %CALLNAME:ARG%은(는) [%ERDNAME(知識素質, LOCAL)%Lv{知識素質:ARG:LOCAL}]을(를) 습득했다!
		;知識成長口上
		TRYCALLFORM KOJO_SKILLUP_知識素質_{NO:ARG}(ARG, LOCAL)
