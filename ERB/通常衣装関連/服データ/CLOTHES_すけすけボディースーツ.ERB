@CLOTHES_初期所持関数_すけすけボディースーツ()
SIF STRCOUNT(所持制服文字列, @"汎用/つやつや光沢服_") || STRCOUNT(所持エロ衣装文字列, @"エロ/つやつや光沢服_")
CALL エロ衣装登録処理("すけすけボディースーツ")

@CLOTHES_衣装説明_すけすけボディースーツ()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 0
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 1

説明文章 += "이세계의 고무라고 불리는 소재로 만들어진, 전신을 딱 달라붙게 덮는 아주 얇은 보디슈트<br>"
説明文章 += "피부에 딱 달라붙어 그 보디라인을 강조할 뿐만 아니라<br>"
説明文章 += "그 아래의, 본래 숨겨야 할 여러 가지 것들이 비쳐 보이고 있다.<br>"
説明文章 += "엄청나게 야하네요♪<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

