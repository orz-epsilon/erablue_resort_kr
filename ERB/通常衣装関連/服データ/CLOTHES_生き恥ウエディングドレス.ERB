@CLOTHES_衣装説明_生き恥ウエディングドレス()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 20000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
IF STRCOUNT(所持制服文字列, @"汎用/ウエディングドレス_") || STRCOUNT(所持エロ衣装文字列, @"エロ/ウエディングビキニ_")
	販売禁止フラグ = 0
ELSE
	販売禁止フラグ = 1
ENDIF

説明文章 = 
説明文章 += "결혼식에서 입을 예정이었던 신부 의상을, 신랑의 열정을 부추기기 위해 개조한 것.<br>"
説明文章 += "전라보다도 선정적으로, 은밀한 부위를 스스로 드러내는 파렴치한 속옷 차림을<br>"
説明文章 += "간신히 순수함을 남긴 베일과 오버 스커트가 덮어 가리려 헛된 저항을 하고 있다.<br>"
説明文章 += "이 의상이 향하는 곳은 버진 로드 따위가 아니다.<br>"
説明文章 += "짐승들이 모여 짝짓는 새까만 침실이야말로 종착점이다.<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

