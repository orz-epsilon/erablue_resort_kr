@CLOTHES_初期所持関数_ウエディングビキニ()
SIF STRCOUNT(所持制服文字列, @"汎用/ウエディングドレス_") || STRCOUNT(所持エロ衣装文字列, @"エロ/ウエディングドレス_")
	CALL エロ衣装登録処理("ウエディングビキニ")

@CLOTHES_衣装説明_ウエディングビキニ()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 0
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 1

説明文章 = 
説明文章 += "비키니 수영복을 베이스로, 베일이나 긴 장갑, 가터나 트레인 등을 추가하여 웨딩드레스로 만든 것. <br>"
説明文章 += "이 리조트에서는 풀사이드나 해변 등, 물가에서의 결혼식에 잘 어울릴 것이다. <br>"
説明文章 += "속옷으로밖에 안 보인다고? 괜찮아, 원단의 두께나 안감이 달라. <br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

