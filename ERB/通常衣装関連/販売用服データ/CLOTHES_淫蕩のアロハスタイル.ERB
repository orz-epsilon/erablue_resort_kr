@CLOTHES_衣装説明_淫蕩のアロハスタイル()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 0
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
IF STRFIND(所持制服文字列, @"汎用/常夏のアロハスタイル_") >= 0
	販売禁止フラグ = 0
ELSE
	販売禁止フラグ = 1
ENDIF

説明文章 = 
説明文章 += "한여름의 알로하 스타일에 몇 가지 개조를 가한 의복<br>"
説明文章 += "화려하고 다채로운 색상의 오픈 칼라 셔츠는 그대로 두고 반바지는 가위로 잘라 핫팬츠가 되어 있다<br>"
説明文章 += " <br>"
説明文章 += "하지만 그것뿐만이 아니라 자세히 보면 위에는 속옷 종류는 없고 맨살 위에 직접 셔츠를 걸치고<br>"
説明文章 += "아래는 짧은 핫팬츠에서는 눈부실 정도로 허벅지와 맨발이 드러나 있다<br>"
説明文章 += "이래서는 본래라면 보일 리 없는 것이 성별 불문하고 보일지도 모른다<br>"
説明文章 += " <br>"
説明文章 += "이 복장은 황혼과 어둑한 골목, 혹은 침구 위에서야말로 둔하게 빛날 것이다<br>"

;出典元がある場合、それを記載
出典元 = 夏衣装？

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

