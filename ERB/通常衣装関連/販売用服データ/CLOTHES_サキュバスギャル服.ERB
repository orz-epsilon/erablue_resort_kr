@CLOTHES_衣装説明_サキュバスギャル服()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 20000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
IF STRCOUNT(所持制服文字列, @"汎用/学生服_") || STRCOUNT(所持制服文字列, @"エロ/アメスク_")
	販売禁止フラグ = 0
ELSE
	販売禁止フラグ = 1
ENDIF

説明文章 = 
説明文章 += "플리츠 스커트처럼 보이는 짧은 길이의 천을 밑단에 꿰맨 스쿨 카디건. <br>"
説明文章 += "평범하게 입어도 꽤 섹시하지만, 요즘 갸루들은 전라 위에 이것을<br>"
説明文章 += "팔꿈치부터 소매 주변과 배꼽 아래 버튼 하나로 잠가, 오프숄더처럼 입는 것이 트렌드라고 한다. <br>"
説明文章 += "목 주위에 두르는 세일러 칼라와, 커다란 리본으로 흉부를 가리면 '너무 달콤해서 감당 불가'…라고 한다<br>"
説明文章 += "시대가 한 바퀴 돌아 루즈삭스도 인기라고 한다. 정말인가?<br>"

出典元 = 麻雀ファイトガール

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

