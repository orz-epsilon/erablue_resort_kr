@CLOTHES_初期所持関数_喫茶店従業員服（特殊業務）()
SIF STRCOUNT(所持制服文字列, @"汎用/喫茶店従業員服_") || STRCOUNT(所持エロ衣装文字列, @"エロ/喫茶店従業員服_")
CALL エロ衣装登録処理("喫茶店従業員服（特殊業務）")

@CLOTHES_衣装説明_喫茶店従業員服（特殊業務）()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 0
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 1

説明文章 = 
説明文章 += "카페 종업원 복장의 실용적인 앞치마만을 걸친, 이른바 나체 앞치마. <br>"
説明文章 += "보여주기 위한 장식 과다한 앞치마와 달리, 프릴도 아무것도 없는 수수함이<br>"
説明文章 += "육체미를 돋보이게 하여 색다른 매력을 즐길 수 있다고, 일부에서 인기가 높다고 한다. <br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

