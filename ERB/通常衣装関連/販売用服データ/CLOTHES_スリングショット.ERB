@CLOTHES_衣装説明_スリングショット()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 10000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 0

説明文章 = 
説明文章 += "끈과 같은 형태의 수영복<br>"
説明文章 += "이름의 유래는 동물을 쏘기 위한 무기 「새총(투석기)」과 형태가 닮았다는 것에서 유래했다<br>"
説明文章 += "사실 남성용도 존재하며, 그것은 「맨키니」 혹은 「무탕가」라고 불린다<br>"
説明文章 += "　<br>"
説明文章 += "일단 천 폭이 넓은 것도 존재하지만 이곳의 수영복은 끈을 연상시키는 가는 것이 많은 듯하다<br>"
説明文章 += "어느 쪽이든, 이것을 입기 위해서는 상당한 담력이나 수치심 없는 정신성이 필요할 것이다<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

