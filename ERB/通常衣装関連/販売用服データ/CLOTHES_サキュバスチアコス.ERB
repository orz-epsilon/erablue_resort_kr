@CLOTHES_衣装説明_サキュバスチアコス()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 20000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
IF STRCOUNT(所持制服文字列, @"汎用/チアリーダー_") || STRCOUNT(所持制服文字列, @"エロ/セクシーチア_")
	販売禁止フラグ = 0
ELSE
	販売禁止フラグ = 1
ENDIF

説明文章 = 
説明文章 += "어떤 세계에서, 응원을 선도하는 소녀(?)들이 입는 옷. <br>"
説明文章 += "가슴팍이 크게 열려 두 언덕의 정점만을 덮는 V프런트 레오타드에<br>"
説明文章 += "무엇 하나 숨길 의도가 없는 변변찮은 마이크로 스커트가 엉덩이를 장식하고 있다. <br>"
説明文章 += "악마 같은 뿔과 꼬리, 허리춤에 달린 작은 날개. 그리고 아랫배에 빛나는 음란한 문양이 매력 포인트. <br>"
説明文章 += "대체 무엇을 응원해 줄 것인지, 정말이지 흥미가 끊이지 않는다. <br>"

;出典元がある場合、それを記載
出典元 = 麻雀ファイトガール

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

