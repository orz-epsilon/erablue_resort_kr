@CLOTHES_衣装説明_スーパーセクシー巫女服()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 20000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
;セクシー巫女服を入手後に販売開始
販売禁止フラグ = !(STRCOUNT(所持制服文字列, @"汎用/セクシー巫女服_") + STRCOUNT(所持エロ衣装文字列, @"エロ/セクシー巫女服_"))

説明文章 = 
説明文章 += "섹시 무녀복의 노출을 더욱 높이도록 과감하게 어레인지한 복장. <br>"
説明文章 += "하얀 코소데는 더 이상 유방을 가리는 것을 포기하고, 소매를 잇는 역할 정도밖에 없으며<br>"
説明文章 += "붉은 하카마는 음부가 보일 정도로 짧은 미니스커트로 변모했다. <br>"
説明文章 += "이봐! 십이신장조차 부끄러워서 착용하지 않는다고 말하지 마. <br>"
説明文章 += "착용자가 변태 노출광이라든가, 그런 황송한 말을 해서는 안 됩니다. <br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

