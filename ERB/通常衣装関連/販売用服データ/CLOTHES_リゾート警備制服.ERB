@CLOTHES_衣装説明_リゾート警備制服()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 10000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = 通常衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 0

説明文章 = 
説明文章 += "이국의 경비 조직에 소속된 여경의 제복을 극단적으로 재해석한, 도발적인 복장이다。<br>"
説明文章 += "짧게 재단된 흰 셔츠가 부드러운 곡선과 잘록한 허리 라인을 아낌없이 드러내고, 푸른 재킷이 그 실루엣을 더욱 요염하게 돋보이게 한다。<br>"
説明文章 += "짧은 푸른색 스커트는 걸을 때마다 가볍게 흔들리고, 검은 가죽 롱부츠가 다리 전체를 우아하게 조여준다。<br>"
説明文章 += "그것을 입은 자는 청렴한 치안 유지관의 모습과는 한참 멀리, 그저 암컷으로서의 성적 매력을 극한까지 돋보이게 한 존재가 될 것이다。<br>"
説明文章 += "혹은, 흘러넘치는 그 색기에 저항하지 못하고 손을 뻗어온 건장한 남자들의 욕망을, 오히려 그 육체로 '체포'하기 위한, 달콤한 덫일지도 모른다……。<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

