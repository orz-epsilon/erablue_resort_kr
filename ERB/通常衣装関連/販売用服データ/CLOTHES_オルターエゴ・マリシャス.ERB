@CLOTHES_衣装説明_オルターエゴ・マリシャス()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 50000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = 通常衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 0

説明文章 = 
説明文章 += "『금기의 침범은 깊은 쾌락의 징조를 낳고, 성과 죽음의 나선에 그 몸을 빠뜨린다.』<br>"
説明文章 += "『달콤한 배덕에 영혼은 물들고, 끝없는 본능이 이끄는 대로 희롱에 빠져든다.』<br>"
説明文章 += " <br>"
説明文章 += "고위 타천사에 의해 전해졌다고 하는, 검은색을 기조로 한 고딕 & 펑크 의상의 레플리카.<br>"
説明文章 += "그의 변태성을 짙게 반영한 선정적인 착의 모습은, 그것을 본 자들이 시선을 돌리는 것을 허락하지 않는다.<br>"
説明文章 += "몸에 걸치면 자신도 모르게 타락하여, 「주말에 커피 우유를 마시고 밤샘을 한다」는 등의<br>"
説明文章 += "비도덕적인 악행에도 쉽게 손을 대게 된다고 한다.<br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

