@CLOTHES_衣装説明_セクシーポリス()
#DIMS 説明文章
#DIMS 出典元
#DIM 販売価格
#DIMS 販売分類

;単位はルピ
販売価格 = 10000
;通常衣装、もしくはエロ衣装のどちらか
販売分類 = エロ衣装
;販売させない服はこれに1を入れる
販売禁止フラグ = 0

説明文章 = 
説明文章 += "이국의 경비 조직 제복을, 극한까지 선정적으로 재해석한 도발의 극치이다. <br>"
説明文章 += "푸른 제모에 황금 휘장까지는 어디에나 있는 조합이다. 하지만 그 아래는 더 이상 제복이라 부를 수 없는 수준의 의상으로 완성되어 있다. <br>"
説明文章 += "광택 있는 짙은 푸른색의 짧은 재킷은 가슴팍을 대담하게 드러내고, 하얀 셔츠는 가슴조차 다 가리지 못하며, 푸른 넥타이만이 가늘게 늘어져 무의미하게 청순함을 가장한다. <br>"
説明文章 += "하얀 장갑이 긴 소매 아래로 드러나 손끝까지 덮으면서도 드러난 피부와의 대비로 더욱 선정적으로 비친다. <br>"
説明文章 += "극단적으로 짧은 광택 있는 짙은 푸른색 미니스커트는, 아주 작은 움직임에도 은밀한 부위를 가릴지 말지의 아슬아슬한 경계를 드러내며, 걸을 때마다 주변의 시각을 자극한다. <br>"
説明文章 += "롱부츠가 허벅지를 대담하게 드러내고, 날카로운 힐이 위험한 매력을 발산한다. <br>"
説明文章 += "저항할 수 없이 손을 뻗는 남자들의 욕망과 시선을 몸으로 얽어매어, 달콤하고 잔혹하게 '체포'하는, 완벽하고 음란한 덫이다. <br>"

RESULTS = %説明文章%
RESULTS:1 = %出典元%
RESULTS:2 = %販売分類%

RETURN 販売価格

