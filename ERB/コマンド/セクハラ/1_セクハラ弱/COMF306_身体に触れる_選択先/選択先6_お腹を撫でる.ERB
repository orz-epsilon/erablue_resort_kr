@COM_S306_6
;お腹を撫でる

;発生する快楽は受け手の状態に依存しない
CALL SOURCE_CALC_快Ｓ(TARGET, PLAYER, 30)
SIF CFLAG:TARGET:子の父親 == PLAYER
	CALL SOURCE_CALC_快Ｓ(TARGET, PLAYER, 50)
SIF TALENT:PLAYER:器用な指
	CALL SOURCE_CALC_快Ｓ(TARGET, PLAYER, 20)
TIME += 10

SIF CFLAG:TARGET:睡眠
