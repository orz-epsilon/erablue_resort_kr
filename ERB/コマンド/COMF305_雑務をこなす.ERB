			RETURN 0
		CASE 22
			;おくちレイプ
			セクハラ部位 = 5
			PRINTL 을(를) 갑자기 물건 뒤로 끌고 갔다
			PRINTFORML 그리고 입을 벌리게 하여, 억지로 %CALLNAME:PLAYER%에게 펠라를 시켰다…
			RETURN 0
		CASE 23
			;V逆レイプ
			セクハラ部位 = 0
			PRINTL 을(를) 갑자기 물건 뒤로 끌고 갔다
			PRINTFORML 그리고 옷을 벗기고, 발기시킨 %CALLNAME:PLAYER%의 페니스를 질구로 물었다…
			RETURN 0
		CASE 24
			;A逆レイプ
			セクハラ部位 = 0
			PRINTL 을(를) 갑자기 물건 뒤로 끌고 갔다
			PRINTFORML 그리고 옷을 벗기고, 발기시킨 %CALLNAME:PLAYER%의 페니스를 항문으로 물었다…
			RETURN 0
	ENDSELECT

	PRINTFORM %CALLNAME:PLAYER%은(는) 상대의
	IF RFLAG:コマンド結果受渡し変数２ > 300
		PRINT 능숙한 모습의
	ENDIF
	PRINT 성희롱에,
	SELECTCASE PALAM:PLAYER:セクハラ部位
		CASE IS < 1000
			PRINTFORML 조금 달아오르고 있다…
		CASE IS < 3000
			PRINTFORML 쾌락에 조금 소리를 내버렸다…
		CASE IS < 6000
			PRINTFORML 강한 쾌감을 느끼고 있다…
		CASEELSE
			PRINTFORML 지금이라도 절정해 버릴 것 같다.
	ENDSELECT
ENDIF


