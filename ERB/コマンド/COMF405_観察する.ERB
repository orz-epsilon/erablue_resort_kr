
@COMNAME405
#FUNCTIONS
TSTR:コマンド名受渡 = 관찰한다


;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_405
#FUNCTION
TFLAG:コマンドタイプ受渡 = COMTYPE("単独可能")

@COM_TOOLTIP_405
LOCALS = <br>■관찰한다<br>
LOCALS += "주변이나 캐릭터를 잘 관찰하는 커맨드."
LOCALS += "<br>COM타입：단독가능<br>획득소스：없음"
LOCALS += "<br>고유 획득 경험: 없음<br>"
TSTR:ツールチップ受渡 = %LOCALS%


;-------------------------------------------------
;観察する
;-------------------------------------------------
@COM405
#DIM ループ用

;RFLAG:コマンド結果受渡し変数
;  0 =人の気配はない
;  1 =人の気配がある
; 10 =眠っているキャラの観察
; 11 =ダウンしているキャラの観察

RFLAG:コマンド結果受渡し変数 = 0
FOR ループ用, 1, VARSIZE("TARGET")
	SIF TARGET:ループ用 <= 0
		BREAK
	IF CFLAG:(TARGET:ループ用):隠密
		RFLAG:コマンド結果受渡し変数 = 1
		BREAK
	ENDIF
NEXT

IF TARGET > 0 && CFLAG:睡眠
	;眠った対象がいるとき
	IF CFLAG:体力限界
		;対象がダウンしているとき、気絶キャラの観察になる
		RFLAG:コマンド結果受渡し変数 = 11
		;RFLAG:コマンド結果受渡し変数２にスコア（体力により補正）
		RFLAG:コマンド結果受渡し変数２ = EX:スコア * 9999 / MAXBASE:体力
	ELSE
		RFLAG:コマンド結果受渡し変数 = 10
		;RFLAG:コマンド結果受渡し変数２に起床までの残り時間
		CALL CHARA_ROUTINE_STATUS(TARGET, "起床時刻")
		RFLAG:コマンド結果受渡し変数２ = MAX(RESULT + TCVAR:行動時間ゆらぎ - TIME, 0)
	ENDIF
ELSEIF TARGET > 0 && CFLAG:キャラ同士うふふ
	;キャラ同士でうふふしてるとき
	RFLAG:コマンド結果受渡し変数 = 20
ENDIF

TIME += 3
RETURN 1


;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE405
;観察実行判定
SIF SAVESTR:ゲームフェイズ管理 != "通常モード"
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(405) && GLOBAL_COMABLE_TYPE("隠密")
	RETURN RESULT
SIF CFLAG:PLAYER:うふふ
	RETURN 0
RETURN 1


;-------------------------------------------------
;実行時メッセージ
;-------------------------------------------------
@MESSAGE_COM405
#DIM 候補配列, 100
#DIM 候補番号
#DIM 表示id

SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE 0
		PRINTFORML %CALLNAME:PLAYER%은(는) 주변을 둘러보았다
		IF TARGET <= 0
			PRINTL ……사람의 기척은 없는 것 같다
		ELSE
			PRINTL ……평소와 같은 활기찬 리조트의 풍경이다
		ENDIF
	CASE 1
		PRINTFORML %CALLNAME:PLAYER%은(는) 주변을 둘러보았다
		PRINTL ……？
		PRINTL 물그림자에 무언가가 숨어있는 것 같다
	CASE 10
		PRINTFORML %CALLNAME:PLAYER%은(는) 잠들어 있는%CALLNAME:TARGET%의 모습을 관찰했다
		;起床までの残り時間
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS > 180
				PRINTFORML %CALLNAME:TARGET%은(는) 곤히 잠들어 있다. 한동안 깨어날 일은 없을 것 같다…
			CASE IS > 90
				PRINTFORML %CALLNAME:TARGET%은(는) 곤히 잠들어 있다. 깨어나려면 좀 더 걸릴 것 같다…
			CASE IS > 30
				PRINTFORML %CALLNAME:TARGET%이(가)%CALLNAME:PLAYER%이(가) 낸 희미한 소리에 반응했다. 슬슬 잠에서 깰 것 같다…
			CASEELSE
				PRINTFORML %CALLNAME:TARGET%%TEXTR("은(는) 뒤척이고 있다/은(는) 잠꼬대를 하고 있다/의 몸은 계속 움직이고 있다/의 호흡은 얕다")%. 곧 깨어날 것 같다…
		ENDSELECT
	CASE 11
		PRINTFORML %CALLNAME:PLAYER%은(는) 잠들어 있는 %CALLNAME:TARGET%의 모습을 관찰했다
		;スコアの多さ
		SELECTCASE RFLAG:コマンド結果受渡し変数２
			CASE IS >= 400
				PRINTFORM %CALLNAME:TARGET%의 몸은 주입된 쾌락의 깊이를 말해주듯, 잠들면서도 경련하며
				IF GETBIT(TALENT:性別, 0)
					IF TEQUIP:下半身服あり
						PRINT , 음순에서 뿜어져 나온 조수로 잠옷에 얼룩을 만들고
					ELSEIF TEQUIP:下タイツあり && !TEQUIP:下タイツ破れ
						PRINT , 음순에서 뿜어져 나온 조수로 타이츠에 얼룩을 만들고
					ELSEIF TEQUIP:下半身下着あり
						PRINT , 음순에서 뿜어져 나온 조수로
						IF TEQUIP:下半身下着あり > 0
							PRINT 속옷에 얼룩을 만들고
						ELSE
							IF TEQUIP:下半身下着あり == -1
								PRINT 가랑이를 감싸는 작은 천 조각을
							ELSEIF TEQUIP:下半身下着あり == -2
								PRINT 반짝이는 피어스를
							ELSE
								PRINT 음란한 표기의 명찰을
							ENDIF
							PRINT 적시고
						ENDIF
					ELSE
						PRINT , 음순에서 조수를 뿜어내며
					ENDIF
				ENDIF
				PRINTL 계속하고 있다…
			CASE IS >= 20
				PRINTFORML %CALLNAME:TARGET%의 몸은 주어진 쾌락의 여운으로, 잠들면서도 시시때때로 경련하고 있다…
			CASEELSE
				PRINTFORML %CALLNAME:TARGET%은(는) 새근새근 잠들어 있다…
		ENDSELECT
	CASE 20
		PRINTFORM %CALLNAME:TARGET%은(는)
		;モード候補登録
		VARSET 候補配列
		候補番号 = 0
		FOR LOCAL, 0, DT_ROW_LENGTH("体位モードデータベース")
			IF DT_CELL_GET("体位モードデータベース", LOCAL, "対象キャラ") == TARGET || DT_CELL_GET("体位モードデータベース", LOCAL, "実行キャラ") == TARGET
				SIF 系統リスト_アイテム系(DT_CELL_GETS("体位モードデータベース", LOCAL, "モード名")) && DT_CELL_GET("体位モードデータベース", LOCAL, "実行キャラ") == TARGET
					CONTINUE
				候補配列:候補番号 = DT_CELL_GET("体位モードデータベース", LOCAL, "id")
				候補番号 ++
			ENDIF
		NEXT
		IF 候補番号 > 0
			;モードがある
			表示id = 候補配列:(RAND:候補番号)
			IF 系統リスト_アイテム系(DT_CELL_GETS("体位モードデータベース", 表示id, "モード名", 1))
				;相手なし時
				PRINTFORML %DT_CELL_GETS("体位モードデータベース", 表示id, "モード名", 1)%을(를) 사용하여 쾌락에 빠져 있다……
			ELSEIF 系統リスト_自慰系(DT_CELL_GETS("体位モードデータベース", 表示id, "モード名", 1))
				PRINTFORML 스스로 %DT_CELL_GETS("体位モードデータベース", 表示id, "モード名", 1)%을(를) 하여 흥분을 높이고 있다……
			ELSEIF DT_CELL_GET("体位モードデータベース", 表示id, "対象キャラ", 1) == TARGET
				;TARGETが対象の時
				PRINTFORM %CALLNAME:(DT_CELL_GET("体位モードデータベース", 表示id, "実行キャラ", 1))%에게 %DT_CELL_GETS("体位モードデータベース", 表示id, "モード名", 1)%(으)로 공격받아, 쾌락에 신음하고 있다……
			ELSE
				;TARGETが実行者の時
				PRINTFORM %CALLNAME:(DT_CELL_GET("体位モードデータベース", 表示id, "対象キャラ", 1))%을(를) %DT_CELL_GETS("体位モードデータベース", 表示id, "モード名", 1)%(으)로 몰아붙여, 상대에게 쾌락을 주고 있다……
			ENDIF
		ELSE
			VARSET 候補配列
			候補番号 = 0
			FOR LOCAL, 1, CHARANUM
				SIF TARGET:LOCAL == TARGET
					CONTINUE
				IF CFLAG:(TARGET:LOCAL):キャラ同士うふふ && !恋愛対象外チェック(TARGET, TARGET:LOCAL)
					候補配列:候補番号 = TARGET:LOCAL
					候補番号 ++
				ENDIF
			NEXT
			;流石に相手はいるはずなのでそのまま表示構文
			PRINTFORML %CALLNAME:(候補配列:(RAND:候補番号))%와(과) 함께 침대에서 성행위를 하고 있다……
		ENDIF
ENDSELECT
