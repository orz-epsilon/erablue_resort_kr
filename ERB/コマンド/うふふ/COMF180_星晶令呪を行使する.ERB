;-------------------------------------------------
;星晶令呪を行使する
;コミュニケーション系コマンド、レベル1
;-------------------------------------------------
@COMNAME180
#FUNCTIONS
TSTR:コマンド名受渡 = 성정령주를 행사한다


;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_180
#FUNCTION
TFLAG:コマンドタイプ受渡 = COMTYPE("うふふ_被挿入中_セクハラ")

@COM_TOOLTIP_180
LOCALS = <br>■성정령주를 행사한다
LOCALS += "<br>정력과 ZP를 소모해 상대에게 절대적인 명령을 내리는 커맨드."
LOCALS += "<br>특정 소질을 가진 상대에게만 효과가 있다."
LOCALS += @"<br>정력은, 단적으로 말해 마력이다. 엄청난 정력을 가진 %CALLNAME:PLAYER%는 다시 말해, 엄청난 마력을 품고 있는 것과 같다."
LOCALS += "<br>ZP가 이 세계에 ‘소환한’ 연결을 더듬어가, 만능 에너지 자원인 ZP와 결합해 해방한다면,"
LOCALS += "<br>다른 세계에서 온 영령이라는 존재라고 할지라도 저항하는 것이 불가능할 것이다."
LOCALS += "<br>COM타입：우후후or삽입중or성희롱"
LOCALS += "<br>획득 소스：정복(PLAYER)・고통(특정 조건 시)・반감(특정 조건 시)"
LOCALS += "<br>고유 획득 경험: 없음<br>"
TSTR:ツールチップ受渡 = %LOCALS%


@COM180
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------

CALL SOURCE_CALC_征服(PLAYER, TARGET, 1000)
IF 陥落チェック(TARGET) == 0
	;抵抗しようとすることで発生する苦痛
	CALL SOURCE_CALC_苦痛(TARGET, PLAYER, 500)
	CALL SOURCE_CALC_反感(TARGET, PLAYER, 1000)
ENDIF
RCVAR:TARGET:苦痛コマンドフラグ = 1
RCVAR:PLAYER:嗜虐コマンドフラグ = 1

;サドは嗜虐快楽
SIF ABL:PLAYER:サド性感
	EXP:PLAYER:嗜虐快楽経験 ++


;-------------------------------------------------
;経験の処理
;-------------------------------------------------


RETURN 1



;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE180
;実行判定
SIF SAVESTR:ゲームフェイズ管理 != "通常モード"
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(180)
	RETURN RESULT
IF あなた特殊能力:星晶令呪回路 >= 2 && TALENT:TARGET:従業員
	;星晶令呪回路・改なら従業員にも使える
ELSEIF あなた特殊能力:星晶令呪回路 > 0 && サーヴァント判定(TARGET)
	;相手が固有素質の中に［サーヴァント］[ムーンキャンサー]を持つなら使える
	;デミサーヴァントはどうしようね？本家ではできないけどこっちはできるとかしてもいい
ELSE
	RETURN 0
ENDIF

;口を何かに使ってるなら無理
IF TEQUIP:PLAYER:口
	RETURN 0
ENDIF

;精力の残りが9000以上、ZP10以上所持
SIF BASE:PLAYER:精力 <= 9000
	RETURN 0
SIF FLAG:ZP所持量 < 10
	RETURN 0

;オートコマンド中の制限
IF FLAG:オートコマンド判定中フラグ
	RETURN 0
ENDIF

RETURN 1

;-------------------------------------------------
;実行時メッセージ
