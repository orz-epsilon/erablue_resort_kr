@高速船派遣先関数_スイーツアイランド(動作モード)
#DIMS 動作モード

SELECTCASE 動作モード
	CASE "出現条件"
		;初期解放
		;返り値は表示の順番制御に使う。出現しない場合は0
		RETURN 999
	CASE "派遣条件"
		;誰か一人乗組員がいること
		SIF 高速船派遣_乗組員数() < 1
			RETURN 0
		RETURN 1
	CASE "解説文"
		TSTR:ツールチップ受渡 = 
		TSTR:ツールチップ受渡 += "온 하늘의 디저트가 모인다고 알려진 섬. <br>"
		TSTR:ツールチップ受渡 += "거리에서 먹거리 탐방을 할 수 있으며, 특히 여성 관광객에게 인기가 많다. <br>"
		TSTR:ツールチップ受渡 += "정통 디저트 외에도 이색적인 종류가 많이 존재하며, 「초코 파르페 라멘」<br>"
		TSTR:ツールチップ受渡 += "같은 것도 있다고 한다. <br>"
		TSTR:ツールチップ受渡 += "<br>"
		TSTR:ツールチップ受渡 += "파견 중 효과: 과자를 선물로 가져오면 성정수 era의 기분이 좋아진다. <br>"
		TSTR:ツールチップ受渡 += "　　　　　　（플레이버 텍스트. 데이터적인 효과 없음）<br>"
		TSTR:ツールチップ受渡 += "첫 파견: 공공정항 에리어의 점포 개조로 「감미처」 해방 (미구현)<br>"
		TSTR:ツールチップ受渡 += "<br>"
		TSTR:ツールチップ受渡 += "파견 조건: 고속 선원 한 명 이상<br>"
ENDSELECT
