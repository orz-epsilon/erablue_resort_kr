; ゆきずりセックス関連処理（攻め）
; 男性キャラクターが見知らぬ女性を相手にする場合の処理。
; 発生判定、残時間などは既存処理のTCVARを共用する。
;==================================================================================================

;==================================================================================================
@ゆきずりセックス継続判定_攻め(ARG)
;-------------------------------------------------
;男性キャラクターのゆきずりセックス継続処理
;--------------------------------------------------------------------------------------------------
#DIM 経過時間

;対象の隠密状態を継続
CFLAG:ARG:隠密 = 1

;覗き処理内で更新済みの時間を除き、未処理の経過時間だけを反映する
;ゆきずりセックス_覗きフラグは、このコマンド中に処理済みの時間を保持している
経過時間 = MAX(0, TIME_PROGRESS(TFLAG:行動前時刻) - TCVAR:ARG:ゆきずりセックス_覗きフラグ)

;未処理の時間がない場合は能力変動を行わない
IF 経過時間
	TCVAR:ARG:ゆきずりセックス_残時間 = MAX(0, TCVAR:ARG:ゆきずりセックス_残時間 - 経過時間)
	CALL ゆきずりセックス_パラメータ変動処理_攻め(ARG, 経過時間)
ENDIF

TCVAR:ARG:ゆきずりセックス_覗きフラグ = 0
CALL ゆきずりセックス_遭遇処理(ARG)

IF IS_ゆきずりセックス中(ARG)
	RETURN 1
ELSE
	IF CFLAG:ARG:同室
		SETCOLOR カラーパレット("えっちな色")
		PRINTFORML 만족스러운 %CALLNAME:ARG%이(가) 낯선 여자와 함께 그림자 속에서 나왔다……
		RESETCOLOR
	ENDIF

	TCVAR:ARG:ゆきずりセックス_体位 = 0
	TCVAR:ARG:ゆきずりセックス_残時間 = 0
	TCVAR:ARG:ゆきずりセックス_終了時刻 = NOW()
	TCVAR:ARG:覗きバレ = 0
	CFLAG:ARG:隠密 = 0
	RETURN 0
ENDIF


;==================================================================================================
@ゆきずりセックス_パラメータ変動処理_攻め(ARG, 経過時間=1)
;-------------------------------------------------
;男性キャラクター側の絶頂・射精・性欲減少を処理する
;--------------------------------------------------------------------------------------------------
#DIM 経過時間
#DIM 絶頂数
;--------------------------------------------------------------------------------------------------
絶頂数 = 0

;女性側と共通の絶頂値更新を使用し、100から0になった時に射精する
CALL ゆきずりセックス_絶頂値更新(ARG, 経過時間)
IF !TCVAR:ARG:ゆきずりセックス_絶頂値
	CALL ゆきずりセックス_射精加算_攻め(ARG)
	絶頂数 = 1
ENDIF

IF 絶頂数
	CALL ZP_取得処理(ARG, 絶頂数, 0)
	BASE:ARG:性欲 = MAX(BASE:ARG:性欲 - 100 * 絶頂数, 0)
ENDIF

;射精描写を表示するか判定するため、今回の射精回数を返す
RETURN 絶頂数


