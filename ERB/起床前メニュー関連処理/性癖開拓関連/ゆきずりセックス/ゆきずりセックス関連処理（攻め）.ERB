						CASE 1
							PRINTFORML 여자가 여운에 잠길 틈도 없이, %CALLNAME:ARG%은(는) 그 허리를 끌어안고, 아직 끝이 아니라고 속삭였다.
							PRINTFORMW 그는 다시 열기를 띤 육봉을 %挿入部位%에 밀어붙이며, 다음 관계를 시작했다……
						CASE 2
							PRINTFORML %CALLNAME:ARG%은(는) 거친 숨을 내쉬며 여자의 반응을 바라보며, 만족하기에는 아직 이르다고 웃었다.
							PRINTFORMW 그는 쉬려는 여자의 다리를 다시 한번 벌리게 하고, %最奥表現%을(를) 파고들 듯 허리를 겹치기 시작했다……
					ENDSELECT
			ENDSELECT
		ELSE
			;▼奉仕後も満足せず、さらに口での奉仕を続けさせる
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 여자가 입가를 닦고 숨을 고르자, %CALLNAME:ARG%은(는) 그 턱에 손을 얹어 얼굴을 들게 했다.
					PRINTFORML 그는 아직 끝이 아니라고 고하고, 완전히 시들지 않은 육봉을 여자의 입술에 다시 한번 밀어붙였다.
					PRINTFORMW 여자는 여운에 젖은 혀를 내밀고, 열기를 되찾게 하려는 듯 다음 봉사를 시작했다……
				CASE 1
					PRINTFORML %CALLNAME:ARG%은(는) 무릎을 꿇은 채인 여자를 내려다보며, 요도 안에 남은 여운까지 핥아내라고 명했다.
					PRINTFORML 여자가 입술과 혀를 움직이기 시작하자, 그는 그 머리카락을 쓰다듬으며 다시 단단해지는 육봉을 이끌어간다.
					PRINTFORMW 이윽고 여자의 입이 깊이 잠기고, 두 번째 봉사가 축축한 소리와 함께 시작되었다……
				CASE 2
					PRINTFORML 여자가 겨우 육봉을 입에서 떼자, %CALLNAME:ARG%은(는) 쉬려는 어깨에 손을 얹어 붙잡았다.
					PRINTFORML 그는 여자의 젖은 뺨을 쓰다듬고, 아직 봉사가 부족하다고 고하며 다시 자신의 허리 쪽으로 몸을 돌리게 한다.
					PRINTFORMW 여자는 뜨거운 숨을 내쉬며 입술을 열고, 요구받는 대로 육봉을 다시 물었다……
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	IF TCVAR:ARG:覗きバレ
		;▼覗きがバレている状態で行為終了
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 만족한 두 사람이 옷을 정돈하기 시작하고, %CALLNAME:ARG%도 이쪽으로 시선을 돌렸기 때문에, %CALLNAME:PLAYER%은(는) 서둘러 그 자리를 떠났다.
			CASE 1
				PRINTFORMW 여자가 흐트러진 옷을 고치는 옆에서, %CALLNAME:ARG%이(가) 이쪽을 나무라듯이 노려보았기 때문에, %CALLNAME:PLAYER%은(는) 황급히 그 자리를 떠났다.
		ENDSELECT
	ELSE
		;▼覗きに気付かれないまま行為終了
		SELECTCASE RAND:2
			CASE 0
PRINTFORMW 만족한 두 사람이 옷을 정리하기 시작했으므로, %CALLNAME:PLAYER%은(는) 눈치채지 못하게 조용히 그 자리를 떠났다.
			CASE 1
PRINTFORMW 두 사람이 여운을 남기며 몸단장을 시작하는 것을 지켜보고, %CALLNAME:PLAYER%은(는) 소리를 내지 않도록 살며시 그 자리를 떠났다.
		ENDSELECT
	ENDIF
ENDIF


;==================================================================================================
@ゆきずりセックス内容決定_攻め(ARG)
;-------------------------------------------------
;男性キャラクターが見知らぬ女性に行うプレイ内容を決定する
;体位0:奉仕を受ける、1:Ｖ挿入、2:Ａ挿入
;--------------------------------------------------------------------------------------------------
#DIMS プレイ内容
#DIM Ｖ性交重み
#DIM Ａ性交重み
#DIM 奉仕重み
#DIM 重み合計
;--------------------------------------------------------------------------------------------------

;途中終了後に前回の体位を持ち越さない
TCVAR:ARG:ゆきずりセックス_体位 = 0

IF TCVAR:ARG:ゆきずりセックス_誘い
	;相手から誘われた場合は、許可された挿入とフェラチオを均等に抽選する
	;純潔設定が有効な場合、未経験の挿入先は候補から外す
	SIF !(OPTION変数:夜這い処女・童貞 && !GETBIT(TALENT:ARG:非童貞, 0))
		Ｖ性交重み = 1
	SIF !(OPTION変数:夜這い処女・童貞 && !GETBIT(TALENT:ARG:非童貞, 1))
		Ａ性交重み = 1
	奉仕重み = 1
ELSE
	;キャラクターから誘った場合は、能力と経験に応じて行為を抽選する
	;純潔設定が有効な場合、未経験の挿入先は候補から外す
	SIF !(OPTION変数:夜這い処女・童貞 && !GETBIT(TALENT:ARG:非童貞, 0))
		Ｖ性交重み = MAX(1, ABL:ARG:技巧)
	SIF !(OPTION変数:夜這い処女・童貞 && !GETBIT(TALENT:ARG:非童貞, 1))
		Ａ性交重み = MAX(1, ABL:ARG:技巧)

	;対応する挿入経験100回ごとに重みを1加算する
	SIF Ｖ性交重み
		Ｖ性交重み += EXP:ARG:Ｃ性交経験_Ｖ挿入 / 100
	SIF Ａ性交重み
		Ａ性交重み += EXP:ARG:Ｃ性交経験_Ａ挿入 / 100
	;奉仕は欲望に応じて重みを得る
	奉仕重み = MAX(1, ABL:ARG:欲望)

	;候補が二つ以上ある場合、どの行為も抽選率が50%を超えないよう重みを制限する
	;候補が一つしかない場合は、成立する行為を優先するため制限しない
	IF Ａ性交重み + 奉仕重み
		Ｖ性交重み = MIN(Ｖ性交重み, Ａ性交重み + 奉仕重み)
	ENDIF
	IF Ｖ性交重み + 奉仕重み
		Ａ性交重み = MIN(Ａ性交重み, Ｖ性交重み + 奉仕重み)
	ENDIF
	IF Ｖ性交重み + Ａ性交重み
		奉仕重み = MIN(奉仕重み, Ｖ性交重み + Ａ性交重み)
	ENDIF
ENDIF

重み合計 = Ｖ性交重み + Ａ性交重み + 奉仕重み

IF 重み合計
	SELECTCASE RAND:重み合計
		CASE IS < 奉仕重み
			プレイ内容 = フェラチオ

		CASE 奉仕重み TO 奉仕重み+Ｖ性交重み-1
			SELECTCASE RAND:6
				CASE 0
					プレイ内容 = 正常位
				CASE 1
					プレイ内容 = 後背位
				CASE 2
					プレイ内容 = 寝バック
				CASE 3
					プレイ内容 = 騎乗位
				CASE 4
					プレイ内容 = 対面立位
				CASE 5
					プレイ内容 = 立ちバック
			ENDSELECT
			TCVAR:ARG:ゆきずりセックス_体位 = 1
			IF !GETBIT(TALENT:ARG:非童貞, 0)
				CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>出会ったばかりの女性に自ら童貞を捧げてしまった</font><img src='えっちハート'>","うふふ")
			ENDIF
			SETBIT TALENT:ARG:非童貞, 0
			EXP:ARG:Ｃ性交経験_Ｖ挿入 ++

		CASEELSE
			SELECTCASE RAND:6
				CASE 0
					プレイ内容 = Ａ正常位
				CASE 1
					プレイ内容 = Ａ後背位
				CASE 2
					プレイ内容 = Ａ寝バック
				CASE 3
					プレイ内容 = Ａ騎乗位
				CASE 4
					プレイ内容 = Ａ対面立位
				CASE 5
					プレイ内容 = Ａ立ちバック
			ENDSELECT
			TCVAR:ARG:ゆきずりセックス_体位 = 2
			IF !GETBIT(TALENT:ARG:非童貞, 1)
				CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>出会ったばかりの女性で初めてアナルへ挿入した</font><img src='えっちハート'>","うふふ")
			ENDIF
			SETBIT TALENT:ARG:非童貞, 1
			EXP:ARG:Ｃ性交経験_Ａ挿入 ++
	ENDSELECT
ELSE
	;純潔設定で挿入できず、相手を誘った場合も最低限の行為を成立させる
	プレイ内容 = フェラチオ
ENDIF

CSTR:ARG:ゆきずりセックス_プレイ内容 = %プレイ内容%
