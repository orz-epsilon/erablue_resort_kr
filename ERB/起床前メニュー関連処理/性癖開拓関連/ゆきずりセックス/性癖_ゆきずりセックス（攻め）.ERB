;==================================================================================================
@性癖開拓チャレンジ処理_ゆきずりセックス（攻め）(ARG)
;-------------------------------------------------
;男性用の性癖「ゆきずりセックス（攻め）」を取得するための処理
;--------------------------------------------------------------------------------------------------
#DIM 興味度
;--------------------------------------------------------------------------------------------------

;攻め側の性癖は男性器所持者（男性・ふたなり女性）が対象
IF !GETBIT(TALENT:ARG:性別, 1)
	RETURN -1
ENDIF

CSTR:ARG:性癖開拓報告_記録文字列 += @"%CALLNAME:PLAYER%은(는) %CALLNAME:ARG%에게 은근슬쩍 「낯선 여성과의 하룻밤」을 그린 야한 책이 건네지도록 손을 썼다…<br><br>"

;固有処理
RESULT = 0
CALL 口上変数初期化
TRYCALLFORM 性癖開拓_固有条件_ゆきずりセックス（攻め）_{NO:ARG}(ARG)
LOCAL = RESULT
SIF 口上有無確認(0, 1)
	CSTR:ARG:性癖開拓報告_記録文字列 += @"性癖開拓_固有条件"
IF LOCAL == 1
	CSTR:ARG:性癖開拓報告_記録文字列 += @"<br>%CALLNAME:ARG%은(는) 성벽 소질[원나잇 섹스 (공격) (흥미)]을(를) 취득했다<br>"
	性癖素質:ARG:ゆきずりセックス（攻め） = 1
	CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>性癖素質[ゆきずりセックス（攻め）(興味)]を取得した</font>","うふふ")
	RETURN 1
ELSEIF LOCAL == -1
	RETURN 0
ENDIF

IF 知識素質:ARG:性知識 < 性知識条件_性癖開拓チャレンジ()
	CSTR:ARG:性癖開拓報告_記録文字列 += @"%CALLNAME:ARG%은(는) 책을 펼쳐 보았지만, 내용을 잘 이해하지 못한 듯하다…<br>"
	RETURN -1
ENDIF

興味度 = 10

;プラス補正
SIF TALENT:ARG:性的興味 > 0
	興味度 += 10
SIF TALENT:ARG:性欲 > 0
	興味度 += 10
SIF BASE:ARG:性欲 > 1500
	興味度 += 10
興味度 += ABL:ARG:欲望 * 10
興味度 += MAX(EXP:ARG:Ｃ性交経験_Ｖ挿入, EXP:ARG:Ｃ性交経験_Ａ挿入, EXP:ARG:射精経験) / 10

;マイナス補正
SIF TALENT:ARG:プライド > 0
	興味度 -= 5
SIF TALENT:ARG:羞恥心 > 0
	興味度 -= 10
SIF TALENT:ARG:性的興味 < 0
	興味度 -= 10
SIF TALENT:ARG:性欲 == -1
	興味度 -= 10
SIF TALENT:ARG:自制心 > 1
	興味度 -= 20
SIF TALENT:ARG:抵抗
	興味度 -= 20
SIF TALENT:ARG:一線越えない
	興味度 -= 20
SIF TALENT:ARG:貞操
	興味度 -= 30

LOCAL = MAX(10, 興味度)

;童貞または恋人持ちなら最終確率を半減
SIF !GETBIT(TALENT:ARG:非童貞, 0) || TALENT:ARG:恋人持ち
	LOCAL /= 2
SIF 高速船記録:派遣先登録 == "叡智の殿堂"
	LOCAL += 10
SIF TALENT:ARG:経験豊富 || TALENT:ARG:淫乱
	LOCAL = 100
SIF TALENT:ARG:性欲 == -2
	LOCAL = -1

IF RAND:100 < LOCAL
	CSTR:ARG:性癖開拓報告_記録文字列 += @"…%CALLNAME:ARG%은(는) 주위에 아무도 없는 것을 확인하고, 몰래 책을 펼쳤다.<br><br>"
	CSTR:ARG:性癖開拓報告_記録文字列 += @"그곳에는 여행지에서 막 만난 여자를 그늘로 유혹하여, 그 순간만의 쾌락을 탐하는 남자의 모습이 그려져 있었다.<br>"
	IF TALENT:ARG:貞操 == 1
		CSTR:ARG:性癖開拓報告_記録文字列 += @"정조를 중시하는 %CALLNAME:ARG%은(는) 처음에는 혐오감을 느꼈지만, 얽매임 없는 찰나적인 관계에 점차 이끌려 갔다……<br>"
	ELSE
		CSTR:ARG:性癖開拓報告_記録文字列 += @"낯선 상대와 욕망만을 나누는 가벼움에, %CALLNAME:ARG%은(는) 페이지를 넘기는 손을 멈출 수 없게 되었다……<br>"
	ENDIF
	CSTR:ARG:性癖開拓報告_記録文字列 += @"<br>%CALLNAME:ARG%은(는) 성벽 소질[원나잇 섹스 (공격) (흥미)]을(를) 취득했다<br>"
	性癖素質:ARG:ゆきずりセックス（攻め） = 1
	CALL 履歴データベース登録(CFLAG:ARG:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>性癖素質[ゆきずりセックス（攻め）(興味)]を取得した</font>","うふふ")
	RETURN 1
ELSEIF 興味度 <= 0
	CSTR:ARG:性癖開拓報告_記録文字列 += @"%CALLNAME:ARG%은(는) 책을 의심스럽게 바라보며, 그대로 쓰레기통에 던져 버렸다.<br>"
ELSE
	CSTR:ARG:性癖開拓報告_記録文字列 += @"%CALLNAME:ARG%은(는) 책을 손에 들고 즐겼지만, 새로운 성벽이 되기까지는 이르지 못한 듯하다……<br>"
ENDIF

RETURN 0


;==================================================================================================
@性癖段階非同室成長_ゆきずりセックス（攻め）(キャラ番号)
;-------------------------------------------------
;「ゆきずりセックス（攻め）」の性癖レベル上昇処理
;--------------------------------------------------------------------------------------------------
#DIM キャラ番号
;--------------------------------------------------------------------------------------------------
SELECTCASE 性癖素質:キャラ番号:ゆきずりセックス（攻め）
	CASE 1
		SIF EXP:キャラ番号:ゆきずりセックス（攻め）経験 < 30
			RETURN 0
		性癖素質:キャラ番号:ゆきずりセックス（攻め） = 2
		DRAWLINE
		PRINTFORML %CALLNAME:キャラ番号%은(는) 낯선 여성과의 가벼운 관계를 반복하며, 첫 만남의 상대를 유혹하는 것에 저항감을 느끼지 않게 된 듯하다……
		PRINTL
		PRINTFORML %CALLNAME:キャラ番号%의 성벽 소질[원나잇 섹스 (공격) (흥미)]은(는) [원나잇 섹스 (공격) (애호)]로 성장했다
		IF TALENT:キャラ番号:貞操 == 1
			PRINTFORML %CALLNAME:キャラ番号%은(는) [정조 관념]을(를) 잃었다……
			TALENT:キャラ番号:貞操 = 0
		ENDIF
		CALL 履歴データベース登録(CFLAG:キャラ番号:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>性癖素質[ゆきずりセックス（攻め）(興味)]が[ゆきずりセックス（攻め）(愛好)]に成長した</font>","うふふ")
		PRINTL
		RETURN 1

	CASE 2
		SIF EXP:キャラ番号:ゆきずりセックス（攻め）経験 < 100
			RETURN 0
		性癖素質:キャラ番号:ゆきずりセックス（攻め） = 3
		DRAWLINE
		PRINTFORML %CALLNAME:キャラ番号%에게 있어, 여행지에서 적당한 여성을 유혹하여 일기일회의 쾌락을 탐하는 것은, 이제 생활의 일부가 되어 버렸다……
		PRINTL
		PRINTFORML %CALLNAME:キャラ番号%의 性癖素質[원나잇 섹스(공격)(애호)]은(는) [원나잇 섹스(공격)(중독)]으로 성장했다
		IF TALENT:キャラ番号:貞操 == 0
			PRINTFORML %CALLNAME:キャラ番号%은(는) [정조 무관심]을(를) 얻었다
			TALENT:キャラ番号:貞操 = -1
		ENDIF
		CALL 履歴データベース登録(CFLAG:キャラ番号:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>性癖素質[ゆきずりセックス（攻め）(愛好)]が[ゆきずりセックス（攻め）(中毒)]に成長した</font>","うふふ")
		PRINTL
		RETURN 1

	CASE 3
		RETURN 0
ENDSELECT
