@ITEM種別(アイテム番号)
#FUNCTIONS
#DIM アイテム番号

SELECTCASE アイテム番号
	CASE 0 TO 20
		RETURNF "アダルトグッズ"
	CASE 40, 70, 73, 90, 91, 92
		RETURNF "消費アイテム"
	CASE 80 TO 83
		RETURNF "自宅用アイテム"
	CASE 60, 71, 72
		RETURNF "本・書籍アイテム"
ENDSELECT


@通信販売_アイテム説明(アイテム名)
#DIMS アイテム名

SELECTCASE アイテム名
	CASE "トランプセット"
		PRINTL 일반적인 트럼프 세트.
		PRINTL 이것 하나로 여러 가지 놀이를 할 수 있습니다.
		PRINTL ※자택 거실에서 「카드로 놀기」 커맨드 해방
		PRINTL
	CASE "ドリンクセラー"
		PRINTL 음료를 많이 차갑게 보관하기 위한 마도구.
		PRINTL 이것만 있으면 여러 명이서 집에서 술 마시는 것도 문제없어.
		PRINTL ※자택 거실에서 「술자리 시작하기」 명령어를 해방
		PRINTL
