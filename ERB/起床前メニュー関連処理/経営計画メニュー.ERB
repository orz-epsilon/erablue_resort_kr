@経営計画メニュー

DRAWLINE
PRINTL 리조트 경영에 관한 개발·연구를 진행합니다.
PRINTL ※개발 중이므로 정상적으로 작동하지 않을 수 있습니다.
DRAWLINE

;右枠
LOCALS = <div rect='81,31,1937,2812' border='31' bcolor='#C0C0C0'></div><div rect='2050,31,3875,2812' padding='50, 25, 50' border='31' bcolor='#C0C0C0'>
LOCALS += @"■%リゾート名称, 36, LEFT%　인기도：%リゾート人気度全文字列()%"
CALL 人気度上限算出()
IF リゾート人気度 >= RESULT / 1000
	LOCALS += @"<font color='#C0C070'>　　　상한 도달</font>"
ENDIF
LOCALS += "<br>"
LOCALS += @"리조트 랭크: %リゾートランク文字列:リゾートランク%<br>"
LOCALS += @"---------------------------------------------------------------------------<br>"
LOCALS += "</div>"
LOCALS += "<div rect='2130,430,3720,700' padding='50, 25, 50' border='15' bcolor='#C0C0C0'>"
IF 客室テーマ:設定テーマ == 0
	客室テーマ:設定テーマ = 1
ENDIF
LOCALS += @"・객실 「%ERDNAME(客室テーマ, 客室テーマ:設定テーマ)%」　　　<button value='0'>[변경]</button><br>"
TSTR:ツールチップ受渡 = 
CALLFORM 客室テーマ_%ERDNAME(客室テーマ, 客室テーマ:設定テーマ)%("部屋説明")
LOCALS += TSTR:ツールチップ受渡
LOCALS += "</div>"
LOCALS += "<div rect='2130,1160,1860,1600' padding='50, 25, 50' border='15' bcolor='#C0C0C0'>"
LOCALS += "・설비 목록<br>"
FOR LOCAL, 0, VARSIZE("配置客室設備")
	LOCALS += @"<button value='{LOCAL + 10}'>[변경]</button>"
	IF 配置客室設備:LOCAL > 0
		TSTR:コマンド名受渡 = 
		TSTR:ツールチップ受渡 = 
		CALLFORM 客室設備_%ERDNAME(客室設備, 配置客室設備:LOCAL)%("名前取得", 客室設備:(配置客室設備:LOCAL))
		IF TSTR:ツールチップ受渡 != ""
			LOCALS += @"　<nonbutton  title='%TSTR:ツールチップ受渡%'>%TSTR:コマンド名受渡%</nonbutton>"
		ELSE
			LOCALS += @"　%TSTR:コマンド名受渡%"
		ENDIF
	ELSE
		LOCALS += "　----------"
	ENDIF
	LOCALS += "<br>"
NEXT
LOCALS += "</div>"
LOCALS += "<div rect='4030,1160,1820,1600' padding='50, 25, 50' border='15' bcolor='#C0C0C0'>"
LOCALS += "・어메니티 목록<br>"
FOR LOCAL, 0, VARSIZE("配置アメニティ")
	LOCALS += @"<button value='{LOCAL + 20}'>[변경]</button>"
	IF 配置アメニティ:LOCAL > 0
		TSTR:コマンド名受渡 = 
		TSTR:ツールチップ受渡 = 
		CALLFORM アメニティ_%ERDNAME(アメニティ, 配置アメニティ:LOCAL)%("名前取得", アメニティ:(配置アメニティ:LOCAL))
		IF TSTR:ツールチップ受渡 != ""
			LOCALS += @"　<nonbutton  title='%TSTR:ツールチップ受渡%'>%TSTR:コマンド名受渡%</nonbutton>"
		ELSE
			LOCALS += @"　%TSTR:コマンド名受渡%"
		ENDIF
	ELSE
		LOCALS += "　----------"
	ENDIF
	LOCALS += "<br>"
NEXT
LOCALS += "</div>"

;左枠
LOCALS += "<div rect='156,156,1937,2812'>"
LOCALS += "■계획 목록"
LOCALS += "<br>"
IF ダンジョンクリアフラグ_沿岸部の森
	IF チュートリアルフラグ:施設改造 == 0
		LOCALS += @"<font color='#%カラーパレット_HTML("黄")%'><button value='100'>[100] 시설 개조</font>　<font color='#%カラーパレット_HTML("真っ赤")%'>NEW!</font></button>"
	ELSE
		LOCALS += "<button value='100'>[100] 시설 개조</button>"
	ENDIF
ELSE
	IF OPTION変数:ツールチップ切り替え == 0
		LOCALS += "<font color='#666666'><nonbutton title='<br>미개방 기능<br>던전 「연안부의 숲」 클리어 시 해방<br>'>[100] 시설 개조</nonbutton></font>"
	ELSE
		LOCALS += "<font color='#666666'><nonbutton>[100] 시설 개조</nonbutton></font>"
	ENDIF
ENDIF
LOCALS += "<br>"
IF チュートリアルフラグ:食事開発 == 0
	LOCALS += @"<font color='#%カラーパレット_HTML("黄")%'><button value='101'>[101] 식사 메뉴 개발</font>　<font color='#%カラーパレット_HTML("真っ赤")%'>NEW!</font></button>"
ELSE
	LOCALS += "<button value='101'>[101] 식사 메뉴 개발</button>"
ENDIF
LOCALS += "<br>"
IF チュートリアルフラグ:食事設定 == 0
	LOCALS += @"<font color='#%カラーパレット_HTML("黄")%'><button value='102'>[102] 식당 메뉴 설정</font>　<font color='#%カラーパレット_HTML("真っ赤")%'>NEW!</font></button>"
ELSE
	LOCALS += "<button value='102'>[102] 식당 메뉴 설정</button>"
ENDIF
LOCALS += "<br>"
IF チュートリアルフラグ:お祭り企画 == 0
	LOCALS += @"<font color='#%カラーパレット_HTML("黄")%'><button value='110'>[110] 축제 기획</font>　<font color='#%カラーパレット_HTML("真っ赤")%'>NEW!</font></button>"
ELSE
	LOCALS += "<button value='110'>[110] 축제 기획</button>"
ENDIF
LOCALS += "<br>"
IF 開拓エリア解放フラグ:0
	IF MATCH(開拓エリア開発番号, 大規模番号_居住区エリア) > 0
		IF チュートリアルフラグ:定住者管理 == 0
			LOCALS += @"<font color='#%カラーパレット_HTML("黄")%'><button value='115'>[115] 정주민 관리</font>　<font color='#%カラーパレット_HTML("真っ赤")%'>NEW!</font></button>"
		ELSE
			LOCALS += "<button value='115'>[115] 정주민 관리</button>"
		ENDIF
	ELSE
		IF OPTION変数:ツールチップ切り替え == 0
			LOCALS += "<font color='#666666'><nonbutton title='<br>미개방 기능<br>대규모 구역 「거주 구역」 건축 시 해방<br>'>[115] 정주민 관리</nonbutton></font>"
		ELSE
			LOCALS += "<font color='#666666'><nonbutton>[115] 정주민 관리</nonbutton></font>"
		ENDIF
	ENDIF
	LOCALS += "<br>"
	IF チュートリアルフラグ:大規模エリア建築 == 0
		LOCALS += @"<font color='#%カラーパレット_HTML("黄")%'><button value='120'>[120] 대규모 구역 건축</font>　<font color='#%カラーパレット_HTML("真っ赤")%'>NEW!</font></button>"
	ELSE
		LOCALS += "<button value='120'>[120] 대규모 구역 건축</button>"
	ENDIF
	LOCALS += "<br>"
ENDIF
LOCALS += "<br>"
LOCALS += "<button value='999'>[999] 돌아가기</button>"
LOCALS += "<br>"
LOCALS += "</div>"

HTML_PRINT LOCALS
FOR LOCAL, 0, 25
	PRINTL
NEXT
DRAWLINE

$INPUT_LOOP
BINPUT
LOCAL = RESULT
SELECTCASE LOCAL
	CASE 0
		CALL 客室テーマ変更()
	CASE 10 TO 19
		CALL 客室設備変更(LOCAL - 10)
	CASE 20 TO 29
		CALL アメニティ変更(LOCAL - 20)
	CASE 100
		CALL 施設改装メニュー処理
	CASE 101
		CALL 食堂メニュー開発処理
	CASE 102
		CALL 食堂メニュー設定処理
	CASE 110
		CALL お祭り企画メニュー処理
	CASE 115
		CALL 定住者管理メニュー処理
	CASE 120
		CALL 大規模エリア建築メニュー処理
	CASE 999
		RETURN 0
ENDSELECT

RESTART

