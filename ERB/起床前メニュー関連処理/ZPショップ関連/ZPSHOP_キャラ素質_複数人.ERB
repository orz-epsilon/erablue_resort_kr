PRINTL

DRAWLINE
PRINTL
PRINTBUTTONLC "[999]돌아가기", 999
PRINTL

$INPUT_LOOP
BINPUT
SELECTCASE RESULT
	CASE 1
		CALL 敏感素質変化_複数人()
		RESTART
	CASE 2
		CALL バスト素質変化_複数人()
		RESTART
	CASE 3
		CALL 男性器素質変化_複数人()
		RESTART
	CASE 4
		CALL 性別素質変化_複数人()
		RESTART
	CASE 5
		CALL 種族素質変化_複数人()
		RESTART
	CASE 6
		CALL 妊娠不可素質変化_複数人()
		RESTART
	CASE 7
		CALL 受胎体質素質変化_複数人()
		RESTART
	CASE 8
		CALL 発情期素質設定_複数人()
		RESTART
	; CASE 9
	; 	CALL 体格・体型素質設定_複数人()
	; 	RESTART
	CASE 10
		CALL ハーレムの心得素質設定_複数人()
		RESTART
	; CASE 20
	; 	CALL フレーバー素質再設定_複数人()
	; 	RESTART
	; CASE 30
	; 	CALL 弱点コマンド追加_複数人()
	; 	RESTART
	CASE 100
		PRINTL
		DRAWLINE
		PRINTFORML 특성 [장유]를 제거하고, 획득에 필요한 커맨드 실행 횟수를 리셋합니다. (ZP 소비 없음)
		PRINTL 다시 조건을 만족하면 특성을 재획득할 수 있습니다.
		PRINTL 
		PRINTL 특성 [장유]를 제거하시겠습니까?
		PRINTBUTTONLC "[0] 제거한다", 0
		PRINTBUTTONLC "[1] 제거하지 않는다", 1
		PRINTL
		PRINTL
		BINPUT
		PRINTL
		IF RESULT == 0
			FOR LOCAL, 0, キャラクタ数上限
				SIF 汎用キャラ配列:LOCAL < 0
					BREAK
				SIF TALENT:(汎用キャラ配列:LOCAL):長乳 == 0
					CONTINUE
				PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%
				CFLAG:(汎用キャラ配列:LOCAL):おっぱい引っぱりカウント = 0
				TALENT:(汎用キャラ配列:LOCAL):長乳 = 0
			NEXT
			PRINTFORMW 이상의 캐릭터에 대해 처리를 실행했습니다.
		ENDIF
		RESTART
	CASE 995
		RESTART
	CASE 996
		RETURN 1
	CASE 997
		RETURN 2
	CASE 998
		CALL キャラメイク設定
		RESTART
	CASE 999
		RETURN -1
ENDSELECT



@敏感素質変化_複数人()
#DIM 対象キャラ
#DIM CONST COST_TO_敏感 = 300
#DIM CONST COST_TO_通常 = 100
#DIM CONST COST_TO_鈍感 = 300
#DIM 必要COST
#DIM 必要COST_計算値
#DIM 素質番号
#DIMS 段階名

DRAWLINE
PRINTL ZP를 소비하여 캐릭터에게 민감계 특성을 부여할 수 있습니다.
PRINTL 어떤 부위를 민감화하시겠습니까?
PRINTFORML 소지ZP:{FLAG:ZP所持量}.{(ZP小数点以下所持量 % 1000) / 100}{(ZP小数点以下所持量 % 100) / 10}{(ZP小数点以下所持量 % 10)}
DRAWLINE
FOR LOCAL:1 , 101, 106
	PRINTFORM %TALENTNAME:(LOCAL:1)%　　
	PRINTBUTTON @"[{LOCAL:1 * 10}]둔감까지 상승", LOCAL:1 * 10
	PRINT 　　　
	PRINTBUTTON @"[{LOCAL:1 * 10 + 1}]보통까지 상승", LOCAL:1 * 10 + 1
	PRINT 　　　
	PRINTBUTTON @"[{LOCAL:1 * 10 + 2}]민감까지 상승", LOCAL:1 * 10 + 2
	PRINTL
NEXT

PRINTBUTTON @"[241] [즉시 절정]을 얻는다", 241
PRINTFORML 　　　필요ZP:{COST_TO_敏感 * 2}（1캐릭터분）

PRINTBUTTON @"[242] [조루]를 얻는다", 242
PRINTFORML 　　　필요ZP:{COST_TO_敏感}（1キャラ분）

PRINTBUTTON @"[243] 절정하기 쉬운 소질을 삭제한다", 243
PRINTFORML 　　　필요ZP:{COST_TO_通常}（1キャラ분）

PRINTBUTTON @"[244] [지루]를 얻는다", 244
PRINTFORML 　　　필요ZP:{COST_TO_通常 / 2}（1캐릭터분）

PRINTBUTTON @"[250] [ED]를 얻는다", 250
PRINTFORML 　　　필요ZP:{COST_TO_通常}（1キャラ분）

PRINTBUTTON @"[251] [ED]를 삭제한다", 251
PRINTFORML 　　　필요ZP:{COST_TO_通常}（1キャラ분）

PRINTL
PRINTBUTTON "[999]돌아가기", 999
$INPUT_LOOP2
BINPUT
LOCAL:1 = RESULT
SELECTCASE LOCAL:1
	CASE 999
		RETURN 0
	CASE IS > 1000
		;1010~はそれぞれの素質変化
		SELECTCASE LOCAL:1 % 10
			CASE 0
				;鈍感まで上げ
				段階名 = 鈍感
			CASE 1
				;通常まで上げ
				段階名 = 通常
			CASE 2
				;敏感まで上げ
				段階名 = 敏感
		ENDSELECT
		PRINTFORML %TALENTNAME:(LOCAL:1 / 10)%을(를)%段階名%까지 상승시키겠습니까?
		PRINTL ※이미 그 이상의 소질을 가진 경우에는 변동하지 않습니다.
		PRINTFORML （소지 ZP:{FLAG:ZP所持量}.{(ZP小数点以下所持量 % 1000) / 100}{(ZP小数点以下所持量 % 100) / 10}{(ZP小数点以下所持量 % 10)}）
		PRINTBUTTONLC "[0]예", 0
		PRINTBUTTONLC "[1]아니오", 1
		BINPUT
		IF RESULT == 0
			必要COST = 0
			FOR LOCAL, 0, キャラクタ数上限
				SIF 汎用キャラ配列:LOCAL < 0
					BREAK
				必要COST_計算値 = 0
				SELECTCASE LOCAL:1 % 10
					CASE 0
						;鈍感まで上げ
						SIF TALENT:(汎用キャラ配列:LOCAL):(LOCAL:1 / 10) >= -1
							CONTINUE
						必要COST_計算値 += COST_TO_鈍感
					CASE 1
						;通常まで上げ
						SIF TALENT:(汎用キャラ配列:LOCAL):(LOCAL:1 / 10) >= 0
							CONTINUE
						SIF TALENT:(汎用キャラ配列:LOCAL):(LOCAL:1 / 10) == -2
							必要COST_計算値 += COST_TO_鈍感
						必要COST_計算値 += COST_TO_通常
					CASE 2
						;敏感まで上げ
						SIF TALENT:(汎用キャラ配列:LOCAL):(LOCAL:1 / 10) >= 1
							CONTINUE
						SIF TALENT:(汎用キャラ配列:LOCAL):(LOCAL:1 / 10) == -2
							必要COST_計算値 += COST_TO_鈍感 + COST_TO_通常
						SIF TALENT:(汎用キャラ配列:LOCAL):(LOCAL:1 / 10) == -1
							必要COST_計算値 += COST_TO_通常
						必要COST_計算値 += COST_TO_敏感
				ENDSELECT
				IF 必要COST + 必要COST_計算値 > FLAG:ZP所持量
					PRINTL 필요 ZP가 부족하여 처리를 중지했습니다.
					BREAK
				ENDIF
				必要COST += 必要COST_計算値
				IF TALENT:(汎用キャラ配列:LOCAL):(LOCAL:1 / 10) == 0
					PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: 일반 > 
				ELSE
					PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: %GET_TALENTNAME(LOCAL:1 / 10, TALENT:(汎用キャラ配列:LOCAL):(LOCAL:1 / 10), , 汎用キャラ配列:LOCAL)% > 
				ENDIF
				IF LOCAL:1 % 10 == 1
					PRINTL 일반
				ELSE
					PRINTFORML %GET_TALENTNAME(LOCAL:1 / 10, LOCAL:1 % 10 - 1, , 汎用キャラ配列:LOCAL)%
				ENDIF
				TALENT:(汎用キャラ配列:LOCAL):(LOCAL:1 / 10) = LOCAL:1 % 10 - 1
			NEXT
			FLAG:ZP所持量 -= 必要COST
			
			IF 必要COST <= 0
				PRINTW 변경 조건을 만족하는 캐릭터가 존재하지 않습니다.
			ELSE
				PRINTFORMW 이상의 캐릭터에 대해 처리를 실행했습니다. (소비ZP:{必要COST}）
			ENDIF
		ENDIF
		RETURN 0
	CASE 241
		素質番号 = 241
		PRINTFORML ［즉 이키］을(를) 가지지 않은 캐릭터에게 습득시키겠습니까?
		PRINTFORML ※다른 이키 쉬움 소질을 덮어씁니다
		PRINTFORML (소지 ZP:{FLAG:ZP所持量}.{(ZP小数点以下所持量 % 1000) / 100}{(ZP小数点以下所持量 % 100) / 10}{(ZP小数点以下所持量 % 10)})
		PRINTBUTTONLC "[0]예", 0
		PRINTBUTTONLC "[1]아니오", 1
		BINPUT
		IF RESULT == 0
			必要COST = 0
			FOR LOCAL, 0, キャラクタ数上限
				SIF 汎用キャラ配列:LOCAL < 0
					BREAK
				必要COST_計算値 = COST_TO_敏感 * 2
				IF TALENT:(汎用キャラ配列:LOCAL):イキやすさ != 2
					IF 必要COST + 必要COST_計算値 > FLAG:ZP所持量
						PRINTL 필요 ZP가 부족하여 처리를 중지했습니다.
						BREAK
					ENDIF
					IF TALENT:(汎用キャラ配列:LOCAL):イキやすさ == 0
						PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: 일반 > 
					ELSE
						PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: %GET_TALENTNAME(素質番号, TALENT:(汎用キャラ配列:LOCAL):素質番号, , 汎用キャラ配列:LOCAL)% > 
					ENDIF
					PRINTL 즉 이키
					TALENT:(汎用キャラ配列:LOCAL):素質番号 = 2
					必要COST += 必要COST_計算値
				ENDIF
			NEXT
			FLAG:ZP所持量 -= 必要COST
			
			IF 必要COST <= 0
				PRINTW 변경 조건을 만족하는 캐릭터가 존재하지 않습니다.
			ELSE
				PRINTFORMW 이상의 캐릭터에 대해 처리를 실행했습니다. (소비ZP:{必要COST}）
			ENDIF
		ENDIF
		RETURN 0
	CASE 242
		素質番号 = 242
		PRINTFORML {必要COST}ZP를 지불하고, ［조루］을(를) 습득하시겠습니까?
		PRINTFORML ※다른 절정하기 쉬움 소질을 덮어씁니다
		PRINTFORML （소지 ZP：{FLAG:ZP所持量}.{(ZP小数点以下所持量 % 1000) / 100}{(ZP小数点以下所持量 % 100) / 10}{(ZP小数点以下所持量 % 10)}）
		PRINTBUTTONLC "[0]예", 0
		PRINTBUTTONLC "[1]아니오", 1
		BINPUT
		IF RESULT == 0
			必要COST = 0
			FOR LOCAL, 0, キャラクタ数上限
				SIF 汎用キャラ配列:LOCAL < 0
					BREAK
				必要COST_計算値 = COST_TO_敏感
				IF TALENT:(汎用キャラ配列:LOCAL):イキやすさ != 1
					IF 必要COST + 必要COST_計算値 > FLAG:ZP所持量
						PRINTL 필요 ZP가 부족하여 처리를 정지했습니다.
						BREAK
					ENDIF
					IF TALENT:(汎用キャラ配列:LOCAL):イキやすさ == 0
						PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: 보통 > 
					ELSE
						PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: %GET_TALENTNAME(素質番号, TALENT:(汎用キャラ配列:LOCAL):素質番号, , 汎用キャラ配列:LOCAL)% > 
					ENDIF
					PRINTL 조루
					TALENT:(汎用キャラ配列:LOCAL):素質番号 = 1
					必要COST += 必要COST_計算値
				ENDIF
			NEXT
			FLAG:ZP所持量 -= 必要COST
			
			IF 必要COST <= 0
				PRINTW 변경 조건을 만족하는 캐릭터가 존재하지 않습니다.
			ELSE
				PRINTFORMW 이상의 캐릭터에 대해 처리를 실행했습니다.（소비ZP:{必要COST}）
			ENDIF
		ENDIF
		RETURN 0
	CASE 243
		素質番号 = 243
		PRINTFORML {必要COST}ZP를 지불하고, 절정하기 쉬움 소질을 삭제하시겠습니까?
		PRINTFORML ※다른 절정하기 쉬움 소질을 덮어씁니다
		PRINTFORML （소지 ZP：{FLAG:ZP所持量}.{(ZP小数点以下所持量 % 1000) / 100}{(ZP小数点以下所持量 % 100) / 10}{(ZP小数点以下所持量 % 10)}）
		PRINTBUTTONLC "[0]예", 0
		PRINTBUTTONLC "[1]아니오", 1
		BINPUT
		IF RESULT == 0
			必要COST = 0
			FOR LOCAL, 0, キャラクタ数上限
				SIF 汎用キャラ配列:LOCAL < 0
					BREAK
				必要COST_計算値 = COST_TO_通常
				IF TALENT:(汎用キャラ配列:LOCAL):イキやすさ != 0
					IF 必要COST + 必要COST_計算値 > FLAG:ZP所持量
						PRINTL 필요 ZP가 부족하여 처리를 정지했습니다.
						BREAK
					ENDIF
					PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: %GET_TALENTNAME(素質番号, TALENT:(汎用キャラ配列:LOCAL):素質番号, , 汎用キャラ配列:LOCAL)% > 
					PRINTL 보통
					TALENT:(汎用キャラ配列:LOCAL):素質番号 = 0
					必要COST += 必要COST_計算値
				ENDIF
			NEXT
			FLAG:ZP所持量 -= 必要COST
			
			IF 必要COST <= 0
				PRINTW 변경 조건을 만족하는 캐릭터가 존재하지 않습니다.
			ELSE
				PRINTFORMW 이상의 캐릭터에 대해 처리를 실행했습니다.（소비ZP:{必要COST}）
			ENDIF
		ENDIF
		RETURN 0
	CASE 244
		素質番号 = 244
		必要COST = COST_TO_通常 / 2
		PRINTFORML {必要COST}ZP를 지불하고, ［지루］를 취득하시겠습니까?
		PRINTFORML ※다른 절정 민감도 소질을 덮어씁니다
		PRINTFORML （보유 ZP：{FLAG:ZP所持量}.{(ZP小数点以下所持量 % 1000) / 100}{(ZP小数点以下所持量 % 100) / 10}{(ZP小数点以下所持量 % 10)}）
		PRINTBUTTONLC "[0]예", 0
		PRINTBUTTONLC "[1]아니오", 1
		BINPUT
		IF RESULT == 0
			必要COST = 0
			FOR LOCAL, 0, キャラクタ数上限
				SIF 汎用キャラ配列:LOCAL < 0
					BREAK
				必要COST_計算値 = COST_TO_通常 / 2
				IF TALENT:(汎用キャラ配列:LOCAL):イキやすさ != -1
					IF 必要COST + 必要COST_計算値 > FLAG:ZP所持量
						PRINTL 필요 ZP가 부족하여 처리를 중지했습니다.
						BREAK
					ENDIF
					IF TALENT:(汎用キャラ配列:LOCAL):イキやすさ == 0
						PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: 보통 > 
					ELSE
						PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: %GET_TALENTNAME(素質番号, TALENT:(汎用キャラ配列:LOCAL):素質番号, , 汎用キャラ配列:LOCAL)% > 
					ENDIF
					PRINTL 지루
					TALENT:(汎用キャラ配列:LOCAL):素質番号 = -1
					必要COST += 必要COST_計算値
				ENDIF
			NEXT
			FLAG:ZP所持量 -= 必要COST
			
			IF 必要COST <= 0
				PRINTW 변경 조건을 만족하는 캐릭터가 존재하지 않습니다.
			ELSE
				PRINTFORMW 이상의 캐릭터에 대해 처리를 실행했습니다. (소비ZP:{必要COST}）
			ENDIF
		ENDIF
		RETURN 0
	CASE 250
		必要COST = COST_TO_通常
		PRINTFORML {必要COST}ZP를 지불하고, [ＥＤ]를 취득하시겠습니까?
		PRINTFORML ※페니스를 소지한 캐릭터에게만 적용됩니다
		PRINTFORML （보유 ZP：{FLAG:ZP所持量}.{(ZP小数点以下所持量 % 1000) / 100}{(ZP小数点以下所持量 % 100) / 10}{(ZP小数点以下所持量 % 10)}）
		PRINTBUTTONLC "[0]예", 0
		PRINTBUTTONLC "[1]아니오", 1
		BINPUT
		IF RESULT == 0
			必要COST = 0
			必要COST_計算値 = COST_TO_通常
			FOR LOCAL, 0, キャラクタ数上限
				SIF 汎用キャラ配列:LOCAL < 0
					BREAK
				SIF !GETBIT(TALENT:(汎用キャラ配列:LOCAL):性別, 1)
					CONTINUE
				IF TALENT:(汎用キャラ配列:LOCAL):ＥＤ != 1
					IF 必要COST + 必要COST_計算値 > FLAG:ZP所持量
						PRINTL 필요 ZP가 부족하여 처리를 중지했습니다.
						BREAK
					ENDIF
					PRINTFORML %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%
					TALENT:(汎用キャラ配列:LOCAL):ＥＤ = 1
					必要COST += 必要COST_計算値
				ENDIF
			NEXT
			FLAG:ZP所持量 -= 必要COST
			
			IF 必要COST <= 0
				PRINTW 변경 조건을 만족하는 캐릭터가 존재하지 않습니다.
			ELSE
				PRINTFORMW 이상의 캐릭터에 대해 처리를 실행했습니다. (소비ZP:{必要COST}）
			ENDIF
		ENDIF
		RETURN 0
	CASE 251
		必要COST = COST_TO_通常
		PRINTFORML {必要COST}ZP를 지불하고, [ＥＤ]를 삭제하시겠습니까?
		PRINTFORML ※페니스를 소지한 캐릭터에게만 적용됩니다
		PRINTFORML （보유 ZP：{FLAG:ZP所持量}.{(ZP小数点以下所持量 % 1000) / 100}{(ZP小数点以下所持量 % 100) / 10}{(ZP小数点以下所持量 % 10)}）
		PRINTBUTTONLC "[0]예", 0
		PRINTBUTTONLC "[1]아니오", 1
		BINPUT
		IF RESULT == 0
			必要COST = 0
