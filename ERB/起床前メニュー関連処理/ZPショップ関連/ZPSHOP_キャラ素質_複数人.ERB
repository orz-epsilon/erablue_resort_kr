PRINTL ※후타나리화의 발정이 있을 경우, 그쪽이 우선됩니다.
		ENDIF
PRINTFORML 사용 ZP： {必要COST}
		PRINTBUTTONLC "[0] 예", 0
		PRINTBUTTONLC "[1] 아니오", 1
		BINPUT
		IF RESULT == 0
			必要COST = 0
			FOR LOCAL, 0, キャラクタ数上限
				SIF 汎用キャラ配列:LOCAL < 0
					BREAK
				SIF 発情期存在判定(汎用キャラ配列:LOCAL) == 0
					CONTINUE
				IF LOCAL:1 > 100
					SIF GETBIT(TALENT:(汎用キャラ配列:LOCAL):発情期あり, LOCAL:1 % 100) == 0
						CONTINUE
				ELSE
					SIF GETBIT(TALENT:(汎用キャラ配列:LOCAL):発情期あり, LOCAL:1 % 100)
						CONTINUE
				ENDIF
				必要COST_計算値 = COST_TO_発情期
				IF 必要COST + 必要COST_計算値 > FLAG:ZP所持量
PRINTL 필요 ZP가 부족하여 처리를 중지했습니다.
					BREAK
				ENDIF
				必要COST += 必要COST_計算値
				PRINTFORM %GET_NAME(汎用キャラ配列:LOCAL, 1, 50), 50, LEFT%: 
				SELECTCASE LOCAL:1 % 100
					CASE 1
PRINT 욕정 부스트（대）
					CASE 2
PRINT 모유 체질화
					CASE 3
PRINT 후타나리화
					CASE 4
PRINT 위험일 주기 단축
					CASE 5
PRINT 체력 자동 회복
					CASE 6
PRINT 과민 체질 (쾌락・고통＋)
					CASE 7
PRINT 함몰 유두 상시 발기
					CASE 8
PRINT 여체화
				ENDSELECT
				IF LOCAL:1 > 100
PRINTL 삭제
				ELSE
PRINTL 추가
				ENDIF
				IF LOCAL:1 == 103 && CFLAG:(汎用キャラ配列:LOCAL):発情期フラグ < 0 && GETBIT(TALENT:(汎用キャラ配列:LOCAL):発情期あり, 3) && TALENT:(汎用キャラ配列:LOCAL):性別 == 3
					;女性器ないキャラがふたなり化妊娠中の時は戻さない
					IF GETBIT(CFLAG:(汎用キャラ配列:LOCAL):元性別保存, 0) != 0 || TALENT:(汎用キャラ配列:LOCAL):妊娠 == 0
						TALENT:(汎用キャラ配列:LOCAL):性別 = CFLAG:(汎用キャラ配列:LOCAL):元性別保存
					ENDIF
				ENDIF
				IF LOCAL:1 == 108 && CFLAG:(汎用キャラ配列:LOCAL):発情期フラグ < 0 && GETBIT(TALENT:(汎用キャラ配列:LOCAL):発情期あり, 8) && TALENT:(汎用キャラ配列:LOCAL):性別 == 1
					;女性器ないキャラが女体化妊娠中の時は戻さない
					IF GETBIT(CFLAG:(汎用キャラ配列:LOCAL):元性別保存, 0) != 0 || TALENT:(汎用キャラ配列:LOCAL):妊娠 == 0
						TALENT:(汎用キャラ配列:LOCAL):性別 = CFLAG:(汎用キャラ配列:LOCAL):元性別保存
					ENDIF
				ENDIF
				INVERTBIT TALENT:(汎用キャラ配列:LOCAL):発情期あり, LOCAL:1 % 100
			NEXT
			FLAG:ZP所持量 -= 必要COST
			IF 必要COST <= 0
PRINTW 변경 조건을 만족하는 캐릭터가 존재하지 않습니다.
			ELSE
PRINTFORMW 이상의 캐릭터에 대해 처리를 실행했습니다. (소비ZP:{必要COST}）
			ENDIF
		ENDIF

ENDSELECT

