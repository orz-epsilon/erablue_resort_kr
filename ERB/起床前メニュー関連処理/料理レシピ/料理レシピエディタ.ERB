LOCALS += "<br>"
LOCALS += "<button value='124'>[장르 설정]</button>"
LOCALS += " <button value='134'>[제외]</button>"
LOCALS += "</div>"

HTML_PRINT LOCALS

FOR LOCAL, 0, 33
	PRINTL
NEXT

BINPUT
LOCAL = RESULT

SELECTCASE LOCAL
	CASE 999
		RETURN 0
	CASE 100
		PRINTL
		PRINTL
		PRINTL
		DRAWLINE
		PRINTL 요리명을 입력해 주세요.
		DRAWLINE
		INPUTS
		料理名 '= RESULTS
	CASE 110
		INVERTBIT 食材メニュー開閉, 0
	CASE 111 TO 114
		CALL 素材アイテム一覧表示("食材分類 <> ''", 1, 1)
		IF RESULT == -2
			使用食材:(LOCAL - 111) = 0
		ELSEIF RESULT != -1
			使用食材:(LOCAL - 111) = RESULT
		ENDIF

		;名前だけ別に保存
		設定食材:(LOCAL - 111) '= DT_CELL_GETS("所持素材データベース", 使用食材:(LOCAL - 111), "素材アイテム名", 1)
	CASE 121 TO 124
		PRINTL
		PRINTL
		PRINTL
		DRAWLINE
		PRINTL 식재료 장르를 선택해 주세요.
		DRAWLINE
		FOR LOCAL:1, 0, VARSIZE("ジャンル登録")
			SIF ジャンル登録:(LOCAL:1) == ""
				BREAK

			PRINTBUTTON @"[{LOCAL:1}] %ジャンル登録:(LOCAL:1)%", LOCAL:1
			PRINTL
		NEXT
		PRINTL
		PRINTBUTTON @"[999] 변경하지 않고 돌아가기", 999
		PRINTL
		BINPUT
		SELECTCASE RESULT
			CASE 999
				RESTART
			CASEELSE
				設定食材:(LOCAL - 121) '= ジャンル登録:RESULT
				使用食材:(LOCAL - 121) = 0
		ENDSELECT
	CASE 131 TO 134
		使用食材:(LOCAL - 131) = 0
		設定食材:(LOCAL - 131) = 
	CASE 115
		CALL 調理道具選択処理
		SIF RESULT != -1
			設定食材:9 '= 調理器具名:RESULT
ENDSELECT

