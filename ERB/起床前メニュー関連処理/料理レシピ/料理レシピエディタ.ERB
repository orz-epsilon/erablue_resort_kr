		LOCALS += @"<font color='#%LOCALS:1%'><button value='111'>[랭크%TOFULL(TOSTR(DT_CELL_GET("所持素材データベース", 使用食材:0, "素材ランク", 1)))%：%設定食材:0%]</button></font>"
