;-------------------------------------------------
;肉棒でおまんこマッサージ♡
;-------------------------------------------------
@MASSAGE_COMNAME51
#FUNCTIONS
IF GETBIT(TALENT:PLAYER:性別, 1) == 0
	TSTR:コマンド名受渡 = 페니반으로 보지 마사지_H_
ELSEIF TALENT:TARGET:恋人持ち == 2
	TSTR:コマンド名受渡 = 임신 활동 보지 마사지_H_
ELSE
	TSTR:コマンド名受渡 = 육봉으로 보지 마사지_H_
ENDIF
TSTR:コマンドカラー受渡 = FFD900

;===================================================
;コマンドタイプ
;===================================================
@MASSAGE_COMTYPE_51
#FUNCTION
TFLAG:コマンドタイプ受渡 = MASSAGE_COMTYPE("エロマッサージ")

@MASSAGE_COM_TOOLTIP_51
LOCALS = <br>■육봉으로 보지 마사지<br>
LOCALS += "흐물흐물하게 풀려서 먹기 좋게 된 보지를, 전용 『시술 도구』를 사용해서 마사지한다."
LOCALS += "<br>삽입하기 전까지는 백만 보 양보해서 에스테였을지도 모르지만, 삽입해 버렸다면 그건 이미 섹스이므로, 우후후 모드에 돌입한다."
LOCALS += "<br>COM 타입: 에로 마사지<br>획득 소스: 쾌락V・노출・접촉・고통・불결(일정 조건 시)"
LOCALS += "<br>고유 획득 경험: V성교 경험(TARGET)・C성교 경험_V삽입(PLAYER)<br>"
TSTR:ツールチップ受渡 = %LOCALS%


@MASSAGE_COM51
#DIM CONST 必要実行値 = 20
#DIM 実行値
#DIM ＋表示フラグ
;まずキャラの状態によって３つに分岐する

CALL MASSAGE_分岐_COM51(TARGET)
RFLAG:コマンド結果受渡し変数 = RESULT
;RFLAG:コマンド結果受渡し変数に結果を入れる
; 1:通常許可
; 2:なし崩し許可
; 3:レイプ
;失敗はそもそもコマンドを出さないので分岐しない

;ここでレイプ時の記憶喪失手段使うよ～とか
;レイプするけどOK～？　みたいな確認分岐を入れる
IF RFLAG:コマンド結果受渡し変数 == 2
	PRINTFORML %CALLNAME:TARGET%은(는) %CALLNAME:PLAYER%이 무엇을 하려는지 눈치채고, 그만두라고 말한다.
	PRINTW 하지만 그 거부는 나약하고, 강하게 밀어붙이면 무너뜨려 허락해 줄 것 같다……
	PRINTL
	PRINTL 이대로 실행하시겠습니까?
	PRINTL
	PRINTBUTTONLC "[0] 예", 0
	PRINTBUTTONLC "[1] 아니오", 1
	BINPUT
	IF RESULT == 1
		PRINTFORMW %CALLNAME:PLAYER%은(는) 다시 생각하기로 했다.
		RETURN -1
	ENDIF
	;履歴セット
	CFLAG:TARGET:泥酔ックス回数 += 1
	CALL 履歴データベース登録(CFLAG:PLAYER:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>マッサージ中に快楽でとろとろにした%CALLNAME:TARGET%を手籠めにした</font><img src='えっちハート'>","うふふ")
	CALL 履歴データベース登録(CFLAG:TARGET:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>マッサージ中に快楽に負け、%CALLNAME:PLAYER%と一線を越えてしまった</font><img src='えっちハート'>","うふふ")
	

	IF ((CFLAG:TARGET:お願いックス回数 + CFLAG:TARGET:泥酔ックス回数 / 3) >= 4 || TALENT:淫乱) && 性癖素質:ゆきずりセックス < 1
		SETBIT CFLAG:1 , 0
		TALENT:セフレ = 1
		初体験日:セフレ = DAY
		RFLAG:コマンド結果受渡し変数３ = 1
		RFLAG:コマンド結果受渡し変数４ = TALENT:陥落不可
		CLEARBIT TALENT:陥落不可, 1
		CALL 履歴データベース登録(CFLAG:PLAYER:人物番号, @"<img src='えっちハート'><font color='#%カラーパレット_HTML("赤ピンク")%'>%CALLNAME:TARGET%を[セフレ]陥落させた</font><img src='えっちハート'>","うふふ")
		CALL 履歴データベース登録(CFLAG:TARGET:人物番号, @"<img src='えっちハート'><font color='#%カラーパレット_HTML("赤ピンク")%'>陥落素質[セフレ]を得た</font><img src='えっちハート'>","うふふ")
	ENDIF

ELSEIF 特定状況口上用フラグ:TARGET:0 >= 1
;シンデレラ勢
	PRINTFORM 『마사지』를 명분으로 삼아 하반신 옷을 벗고
		IF GETBIT(TALENT:PLAYER:性別, 1)
			PRINTFORM %TEXTR("단단하게 발기하고/단단히 솟아오른")% %TEXTR("음경/꼬추/페니스/육봉")%을(를) 내밀었다
		ELSE
			PRINTFORM 페니스 밴드를 착용했다
		ENDIF
	PRINTFORML %CALLNAME:PLAYER%%TEXTR("이, 지금부터 무엇을 하려 하는지/에게, 앞으로 무엇을 당하게 될지")%를 눈치챈 %CALLNAME:TARGET%은(는),
	PRINTFORMW %TEXTR("작게 소리를 내며/움찔 어깨를 떨면서도")% 저항은 하지 않고, %TEXTR("열기가 담긴/욕정에 녹아내린/어딘가 기대하는 듯한")% 시선을 %CALLNAME:PLAYER%에게 향하고 있다……。
	PRINTL
	PRINTL 이대로 실행하시겠습니까?
	PRINTL
	PRINTBUTTONLC "[0] 예", 0
	PRINTBUTTONLC "[1] 아니오", 1
	BINPUT
	IF RESULT == 1
		PRINTFORMW %CALLNAME:PLAYER%은(는) 다시 생각하기로 했다.
		RETURN -1
	ENDIF
	;履歴セット
	CFLAG:TARGET:泥酔ックス回数 += 1
	CALL 履歴データベース登録(CFLAG:PLAYER:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>マッサージ中に快楽でとろとろにした%CALLNAME:TARGET%を手籠めにした</font><img src='えっちハート'>","うふふ")
	CALL 履歴データベース登録(CFLAG:TARGET:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>マッサージ中に快楽に負け、%CALLNAME:PLAYER%と一線を越えてしまった</font><img src='えっちハート'>","うふふ")
	

	IF ((CFLAG:TARGET:お願いックス回数 + CFLAG:TARGET:泥酔ックス回数 / 3) >= 4 || TALENT:淫乱) && 性癖素質:ゆきずりセックス < 1
		SETBIT CFLAG:1 , 0
		TALENT:セフレ = 1
		初体験日:セフレ = DAY
		RFLAG:コマンド結果受渡し変数３ = 1
		RFLAG:コマンド結果受渡し変数４ = TALENT:陥落不可
		CLEARBIT TALENT:陥落不可, 1
		CALL 履歴データベース登録(CFLAG:PLAYER:人物番号, @"<img src='えっちハート'><font color='#%カラーパレット_HTML("赤ピンク")%'>%CALLNAME:TARGET%を[セフレ]陥落させた</font><img src='えっちハート'>","うふふ")
		CALL 履歴データベース登録(CFLAG:TARGET:人物番号, @"<img src='えっちハート'><font color='#%カラーパレット_HTML("赤ピンク")%'>陥落素質[セフレ]を得た</font><img src='えっちハート'>","うふふ")
	ENDIF

ELSEIF RFLAG:コマンド結果受渡し変数 == 3
	;レイプしないを選んだ時はキャンセル扱いでコマンド選択に戻す
	IF (TFLAG:マッサージ_鬼灯の香使用時間 + 20 < DAY * 1440 + TIME) || TCVAR:言いなり || TCVAR:特殊言いなり
		PRINTFORM 『마사지』를 핑계 삼아 하반신 옷을 벗고
		IF GETBIT(TALENT:PLAYER:性別, 1)
			PRINTFORM %TEXTR("단단하게 발기한/굳게 솟아오른")% %TEXTR("음경/자지/페니스/육봉")%을 꺼냈다
		ELSE
			PRINTFORM 페니스 밴드를 착용했다
		ENDIF
		PRINTFORML %CALLNAME:PLAYER%%TEXTR("이, 지금부터 무엇을 하려 하는지/에게, 앞으로 무엇을 당하게 될지")%를 눈치챈 %CALLNAME:TARGET%은(는)
		PRINTFORM 꿈꾸는 듯 멍하니 있으면서도
		IF TALENT:TARGET:度胸 == -1 || TALENT:TARGET:応答 == -1 || TALENT:TARGET:プライド == -1 || TALENT:TARGET:陽気／陰気 == -1
		;臆病、大人しい、プライド低い、陰気
			PRINTFORML 필사적으로, 그만해 달라고 간청한다.
		ELSE
			PRINTFORML 필사적으로, 그만%TEXTR("하라고 말해 온다/해 달라고 말한다")%。
		ENDIF
		PRINTFORMW 억지로 일을 벌이려 한다면, 분명 평소의 %CALLNAME:TARGET%이라면 %TEXTR("강하게/격렬하게")% 저항했을 것이다……。
	ELSE
		PRINTFORML %CALLNAME:PLAYER%의 손기술로 실컷 주물러 풀린 %CALLNAME:TARGET%은(는), 완전히 쾌락에 녹아내리고 있다……。
		PRINTFORMW ……하지만, %CALLNAME:PLAYER%의 마사지사로서의 직감이 「아직」이라고 알린다. 지금 상태에서 억지로 일을 벌이려 한다면, 분명 %CALLNAME:TARGET%은(는) 강하게 저항할 것이다……。
	ENDIF
	PRINTL
	;香使用から20分以上経ってると許可
	IF (TFLAG:マッサージ_鬼灯の香使用時間 > 0 && TFLAG:マッサージ_鬼灯の香使用時間 + 20 < DAY * 1440 + TIME) || TCVAR:言いなり || TCVAR:特殊言いなり
		IF TCVAR:言いなり || TCVAR:特殊言いなり
			PRINTFORML 하지만 지금, %CALLNAME:TARGET%은(는) %CALLNAME:PLAYER%의 말대로 할 수밖에 없는 입장이다.
PRINTFORMW 아무리 본의 아니더라도, 거역하는 것은 허락되지 않는다……。
			PRINTL
PRINTFORM 입장에 따라 저항이 봉쇄된%CALLNAME:TARGET%이라면, %CALLNAME:PLAYER%의 힘으로도 쉽게%TEXTR("저항을 봉쇄하고/저항을 꺾어 눕히고")%、
		ELSE
			;ここで記憶を曖昧にする薬の所持分岐
PRINTFORML 하지만 「귀등의 향」이 충분히 효과를 발휘하는 지금이라면, 쾌락과 약효로 몽롱해진%CALLNAME:TARGET%에게는 더 이상 갓난아기 정도의 저항력밖에 남아있지 않다.
PRINTFORMW 게다가 향의 효과로 행위 중의 기억은 모호해지고, 「잘 기억나지 않지만 기분 좋았다」 정도로밖에 남지 않는다……。
			PRINTL
PRINTFORM 이것이라면%CALLNAME:PLAYER%의 힘으로도 쉽게%CALLNAME:TARGET%의%TEXTR("저항을 봉쇄하고/저항을 꺾어 눕히고")%、
		ENDIF
		IF TALENT:TARGET:恋人持ち == 1 || TALENT:TARGET:恋人持ち == 2
PRINTFORM 싫어하는%CALLNAME:TARGET%의 가장 깊숙한 곳에 억지로%TEXTR("부정의/바람의/바람 섹스의/연인 이외에게 범해지는/연인 이외의 형태와 그")%쾌락을%TEXTR("각인시킨다/가르쳐준다/새겨준다")%
		ELSEIF アイドル判定(TARGET)
			SELECTCASE RAND:9
			CASE 0
				PRINTL
				PRINTFORM %TEXTR("범해져/몽롱 레이프/섹스/원치 않는")%스캔들로 팬을 배신하게 한다
			CASE 1
				PRINTL
				PRINTFORM %TEXTR("팬을 위해 갈고닦아온/모두를 매료시키고 마는")%%CALLNAME:TARGET%의 그 몸을%TEXTR("마음껏/합의 없이/실컷/제멋대로")%%TEXTR("탐한다/즐긴다/만끽한다/맛본다/독점한다")%
			CASE 2
				PRINTL
				PRINTFORM 그 매력적인 몸을 사용해 실컷 「%TEXTR("특별한/당신만의/")%팬 서비스」를 받는다
			CASE 3
				PRINTL
				PRINTFORM 아름다운 그녀의 얼굴도 몸도, 눈물도 신음도 모든 것을%CALLNAME:PLAYER%%TEXTR("만의 것으로 만들어버린다/가 독점한다")%
			CASE 4
				PRINTL
				PRINTFORM 팬을 위해 갈고닦아온%CALLNAME:TARGET%의 몸을, %CALLNAME:PLAYER%%TEXTR("만의 것으로 만들어버린다/만이 즐긴다/에게만 바치게 한다/")%
			CASE 5
				PRINTL
				PRINTFORM 확고부동한 인기 아이돌・%SUBSTRING(NAME:TARGET, STRFIND(NAME:TARGET, "]") + 1, -1)%의 아무도 모르는%TEXTR("안는 느낌/박는 느낌/박는 정도")%를 파헤치고, %TEXTR("마음껏/합의 없이/실컷/제멋대로")%%TEXTR("탐한다/맛본다/만끽한다/즐긴다/독점한다/정복한다")%
			CASE 6
				PRINTL
				PRINTFORM 인기 아이돌・%SUBSTRING(NAME:TARGET, STRFIND(NAME:TARGET, "]") + 1, -1)%에게 매료된%TEXTR("수많은/별처럼 많은")%팬들로부터, 그녀를 빼앗아%CALLNAME:PLAYER%만의 것으로 만든다
			CASE 7
				PRINTL
				PRINTFORM 팬에게%TEXTR("숨어서/몰래")%인기 아이돌・%SUBSTRING(NAME:TARGET, STRFIND(NAME:TARGET, "]") + 1, -1)%와%TEXTR("육체적 관계를 맺는다/관계를 가진다")%
			CASE 8
				PRINTL 
				PRINTFORML 팬 모두가%TEXTR("동경하는/갈망해 마지않는")%인기 아이돌・%SUBSTRING(NAME:TARGET, STRFIND(NAME:TARGET, "]") + 1, -1)%의 입술도 혀도 실컷 빨고, 가슴의 부드러움이나 엉덩이의 때리는 감촉을%TEXTR("마음껏/실컷/제멋대로")%만끽하고,
				PRINTFORM 미성(美聲)의 탄식과 신음을 안주 삼아 저항으로 꽉 조이는 암컷 구멍을 깊숙한 곳까지 침략하여, 최고의 %TEXTR("달성/정복")%감과 사정 쾌락을 맛본다
			ENDSELECT
		ELSEIF TALENT:TARGET:恋人持ち == -1
			PRINTFORM %CALLNAME:TARGET%의 %TEXTR("가슴속에 있는 연인에게서 그녀를 억지로 빼앗아간다/품고 있는 달콤한 연심을 짓밟고, 마음껏 그 몸을 탐닉한다")%
		ELSE
			SELECTCASE RAND:5
			CASE 0
				PRINTFORM %TEXTR("마음껏/합의 없이/실컷/제멋대로")%%CALLNAME:TARGET%의 몸을 %TEXTR("탐하다/즐기다")%
			CASE 1
				PRINTFORM 합의 없이 %CALLNAME:TARGET%의 몸을 %TEXTR("마음껏/실컷/제멋대로")%%TEXTR("탐하다/즐기다")%
			CASE 2
				PRINTFORM 여자로서의 '사용감'을 마음껏 즐긴다
			CASE 3
				PRINTFORM 마사지로 %CALLNAME:TARGET%의 몸에 닿은 탓에 실컷 흥분했던 %TEXTR("수욕/욕망")%%TEXTR("을 마음껏 그 몸에 쏟아붓는다/을 마음껏 그 몸에 퍼붓는다/의 책임을 지게 한다")%
			CASE 4
				PRINTFORM 노 리스크로 강간을 즐긴다
			ENDSELECT
		ENDIF
		PRINTFORMW 할 수 있을 것이다.
		PRINTL
		PRINTL 이대로 실행하시겠습니까?
		PRINTL
		PRINTBUTTONLC "[0] 예", 0
		PRINTBUTTONLC "[1] 아니오", 1
		BINPUT
		IF RESULT == 1
			PRINTFORMW %CALLNAME:PLAYER%은(는) 생각을 고쳐먹기로 했다.
			RETURN -1
		ENDIF
		CFLAG:TARGET:泥酔ックス回数 += 1
		IF TCVAR:言いなり || TCVAR:特殊言いなり
			CALL 履歴データベース登録(CFLAG:PLAYER:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>マッサージ中、言いなりになることしかできない%CALLNAME:TARGET%を無理やり手籠めにした</font><img src='えっちハート'>","うふふ")
			CALL 履歴データベース登録(CFLAG:TARGET:人物番号, @"<font color='#%カラーパレット_HTML("薄ピンク")%'>マッサージ中、言いなりになることしかできないまま%CALLNAME:PLAYER%に%TEXTR("犯/レイプ")%されてしまった</font><img src='えっちハート'>","うふふ")
			IF TALENT:TARGET:処女
				IF  アイドル判定(TARGET)
					CALL 履歴データベース登録(CFLAG:PLAYER:人物番号, @"<font color='#%カラーパレット_HTML("赤ピンク")%'>大人気アイドル・%SUBSTRING(NAME:TARGET, STRFIND(NAME:TARGET, "]") + 1, -1)%%TEXTR("の/が守り抜いてきた")%%TEXTR("処女/純潔")%%TEXTR("を無理やり奪って/を力ずくでモノにして/を喰い散らかして/を無理やり奪い、新品だったアイドル雌穴を中古品にして")%やった</font><img src='えっちハート'>","うふふ")
					CALL 履歴データベース登録(CFLAG:TARGET:人物番号, @"<font color='#%カラーパレット_HTML("赤ピンク")%'>言いなりになることしかできないなか、%CALLNAME:PLAYER%に犯されアイドル%TEXTR("でありながら/として守ってきた")%処女を%TEXTR("奪われ/散らされ")%てしまった。ファンの皆さん、ごめんなさい……</font><img src='えっちハート'>","うふふ")
				ELSEIF 高貴知識_初期所持判定(TARGET) >= 1
					CALL 履歴データベース登録(CFLAG:PLAYER:人物番号, @"<font color='#%カラーパレット_HTML("赤ピンク")%'>「マッサージ」にかこつけて、%CALLNAME:TARGET%%TEXTR("の高貴なる/が守り抜いてきた貴い")%純潔を無理やり奪ってやった</font><img src='えっちハート'>","うふふ")
					CALL 履歴データベース登録(CFLAG:TARGET:人物番号, @"<font color='#%カラーパレット_HTML("赤ピンク")%'>言いなりになることしかできないなか、%CALLNAME:PLAYER%に無理やり犯され、高貴な身でありながら処女を%TEXTR("奪われ/散らされ")%てしまった</font><img src='えっちハート'>","うふふ")
				ELSE
