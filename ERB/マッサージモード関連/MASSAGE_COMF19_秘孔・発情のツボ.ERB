;-------------------------------------------------
;乳腺開発マッサージ
;-------------------------------------------------
@MASSAGE_COMNAME19
;20に排卵のツボとか来てもいいようにこの位置
#FUNCTIONS
TSTR:コマンド名受渡 = 비공・발정의 혈


;===================================================
;コマンドタイプ
;===================================================
@MASSAGE_COMTYPE_19
#FUNCTION
TFLAG:コマンドタイプ受渡 = MASSAGE_COMTYPE("マッサージ")

@MASSAGE_COM_TOOLTIP_19
LOCALS = <br>■비공・발정의 혈<br>
LOCALS += "마사지를 극한까지 익힌 자만이 도달할 수 있는 오의."
LOCALS += "<br>부드러우면서도 힘차게 그 혈을 자극받은 자는,"
LOCALS += "<br>혈액순환이 좋아지는 동시에 성욕이 고조되어, 육체가 번식의 본능에 눈을 뜬다고 한다……."
LOCALS += "<br>국부에 닿는 것은 아니므로 에로 마사지는 아니다."
LOCALS += "<br>이미 발정하고 있는 상대에게는 실행할 수 없다."
LOCALS += "<br>COM 타입: 마사지<br>취득 소스: 노출・접촉・환락"
LOCALS += "<br>고유 획득 경험: 없음<br>"
TSTR:ツールチップ受渡 = %LOCALS%

@MASSAGE_COM19
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------

CALL SOURCE_CALC_露出(TARGET, PLAYER, 100)
CALL SOURCE_CALC_接触(TARGET, PLAYER, 80)
CALL SOURCE_CALC_歓楽(TARGET, PLAYER, 50)

;性欲をとても煽る。
BASE:TARGET:性欲 += 200

;局部に触れるわけではないため警戒されず、理性がゴリっと削れる
BASE:TARGET:理性 += 理性変動値算出(TARGET, -100)
BASE:TARGET:警戒 += 警戒変動値算出(TARGET, -50)

TCVAR:強制発情フラグ = 1
CFLAG:発情期フラグ = -1

;-------------------------------------------------
;経験の処理
;-------------------------------------------------

RETURN 1

;-------------------------------------------------
;実行判定
;-------------------------------------------------

@MASSAGE_COM_ABLE19
SIF SAVESTR:ゲームフェイズ管理 != "マッサージモード"
	RETURN 0

SIF GLOBAL_MASSAGE_COMABLE(19)
	RETURN RESULT

;ＣかＶがない場合駄目。要はロボ想定
SIF TALENT:Ｃ感度 == -2 && TALENT:Ｖ感度 == -2
	RETURN 0

;うつ伏せだとダメ。発情のツボ、あるとしても背中じゃなさそうな気がしない？
SIF TCVAR:TARGET:マッサージ_うつ伏せフラグ == 1
	RETURN 0

;既に発情してるとダメ。実質一回限り
SIF CFLAG:TARGET:発情期フラグ < 0
	RETURN 0

;マッサージ技能4以下はダメ
SIF ABL:MASTER:マッサージ技能 < 5
	RETURN 0

RETURN 1

;-------------------------------------------------
;実行時メッセージ
;-------------------------------------------------
@MASSAGE_MESSAGE_COM19
PRINTFORML %CALLNAME:PLAYER%은(는) %CALLNAME:TARGET%의 배를 마사지하면서, 몰래 발정하는 혈을 자극했다.
PRINTL 
PRINTFORM %CALLNAME:PLAYER%의 절묘한 손기술에 의해 %TEXTR("몸속 깊은 곳/본능의 틈새")%에서부터
SETCOLOR カラーパレット("えっちな色")
PRINT 발정
RESETCOLOR
PRINTFORML 을(를) 이끌어내져 버린 %CALLNAME:TARGET%은(는) 그 피부에 촉촉하게 땀을 배어 나오게 하며,
PRINTFORML 꿈꾸는 듯 멍하니 %CALLNAME:PLAYER%에게 몸을 주무름 당하면서, 무의식중에 숨결을 뜨겁게 하고 고동을 고조시키고 있다……。

