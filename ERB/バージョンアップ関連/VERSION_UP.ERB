;変数の書き換えなどを伴なうバージョンアップ用
@VERSION_UP

;飛ばしたバージョンかどうかを判定する関数
;バージョンを飛ばした場合、ここに飛ばしたバージョンを入れる
@IS_SKIPPED_VERSION(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 48, 49
		RETURNF 1
	CASE 58 TO 99
		RETURNF 1
	CASEELSE
		RETURNF 0
ENDSELECT


@バージョンアップ準備処理
#DIM NEW_VERSION
#DIM NEW_ALLOWVERSION
#DIM VERCOUNT

PRINTL erablue_resort 버전 업그레이드 어시스턴트입니다(개발자용)
PRINTL 버전 업그레이드를 준비하시겠습니까?
PRINTBUTTONLC "[0]예", 0
PRINTBUTTONLC "[1]아니오", 1

BINPUT
SIF RESULT == 1
	RETURN

NEW_VERSION = GAMEBASE_VERSION + 1
NEW_ALLOWVERSION = MAX(GAMEBASE_ALLOWVERSION, NEW_VERSION - 2)

CALL VERUP用ファイル生成(NEW_VERSION)

PRINTFORML ./CSV/GameBase.csv 파일의 "バージョン,{GAMEBASE_VERSION}"을 "バージョン,{NEW_VERSION}"으로
PRINTFORML "バージョン違い認める,{GAMEBASE_ALLOWVERSION}"을 "バージョン違い認める,{NEW_ALLOWVERSION}"으로 바꿔주세요
PRINTL 
PRINTFORML ./ERB_EDITFILE/VERUP_{NEW_VERSION}.ERB 파일을 ./ERB/バージョンアップ関連/ 에 두고, 대신 다음을 삭제해주세요:
FOR VERCOUNT, GAMEBASE_ALLOWVERSION, NEW_ALLOWVERSION
	PRINTFORML ./ERB/バージョンアップ関連/VERUP_{VERCOUNT}.ERB
NEXT
PRINTL 
PRINTL 내부에서 사용되는 팔로우 변수의 정의도 적절히 삭제해주세요
WAIT

CLEARLINE LINECOUNT
RETURN 0

@VERUP用ファイル生成(バージョン)
#DIM バージョン

REDRAW 0
CLEARLINE LINECOUNT

PRINTFORML ;Ver%TOSTR(バージョン, "0,.000")%と旧バージョンとの互換のための処理
PRINTFORML ;Ver%TOSTR(バージョン+3, "0,.000")%にしたとき消す、互換を{バージョン+1}に
HTML_PRINT "<br>"
PRINTL ;追加TALENT、追加CSTRのチェック
PRINTFORML @VERUP_{バージョン}_CHARA(ARG)
HTML_PRINT "<br>"
PRINTL ;기타広域変数の書き換えなど
PRINTFORML @VERUP_{バージョン}()
HTML_PRINT "<br>"
PRINTL ; IF なんらかフォロー == 0
PRINTL ; 	;なんらかのフォロー処理
PRINTL ; 	;ここで"なんらかフォロー = 1"しない
PRINTL ; ENDIF
HTML_PRINT "<br>"
PRINTL 대응 처리용 플래그를 대응 완료 상태로 설정
PRINTFORML @VERUP_{バージョン}_FINISH()
PRINTL ; 뭔가 팔로우 = 1
HTML_PRINT "<br>"

OUTPUTLOG @"ERB_EDITFILE/VERUP_{バージョン}.ERB", 1
CLEARLINE LINECOUNT
REDRAW 1
