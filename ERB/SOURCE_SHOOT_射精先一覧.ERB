PRINTFORM %CALLNAME:(対象キャラ)%의
PRINTDATA
	DATA 질 안쪽
;	DATA 最奥
;	DATA 肉穴の最奥
;教えの最奥がチラつく
	DATA 질 구멍 가장 안쪽
	DATA 가장 깊은 곳
	DATA 가장 깊은 곳
	DATA 암컷 구멍 안쪽
ENDDATA
PRINT 에
PRINTDATA
	DATA 귀두를
	DATA 페니스의 끝을
ENDDATA
PRINTDATA
	DATA 찰싹 달라붙어
	DATA 딱 맞게
	DATA 꾸욱꾸욱
	DATA 부비부비
	DATA 
ENDDATA
PRINTFORM %TEXTR("밀어붙이며/문지르며/눌러 대며/밀착시키면서")%

IF 高貴知識_初期所持判定((対象キャラ)) >= 1
	IF RISKY_DAY((対象キャラ)) >= 1
		SELECTCASE RAND:4
		CASE 0
			PRINTFORM 、위험일의 %TEXTR("자궁/태")%에게
		CASE 1
			PRINTFORM %TEXTR("고귀한/고급스러운/혈통서 있는/양혈의")%알을 품은 %TEXTR("고급/")%%TEXTR("자궁/태")%에게
		CASE 2
			PRINTFORM 임신하기 딱 좋은 시기의 %TEXTR("고급 자궁/로열 자궁/노블 자궁/고급 태/고급 자궁/양혈 자궁/영애 자궁/숙녀 자궁")%에게
		CASE 3
			PRINTFORM 후계자를 임신시키기 딱 좋은 시기의 %TEXTR("자궁/태")%에게
		ENDSELECT
	ELSE
		PRINTFORM 、%TEXTR("고귀한/혈통서 있는/격식 높은/노블한/귀한/유서 깊은/청아한/품위 있는/럭셔리한/고귀한")%%TEXTR("자궁/태")%에게
	ENDIF
ELSEIF アイドル判定((対象キャラ))
	IF RISKY_DAY(対象キャラ) >= 1
		PRINTFORM 、%TEXTR("위험일의/알을 품은/딱 임신하기 좋은 시기의/절호의 임신 스캔들 날씨인")% 아이돌 자궁에
	ELSE
		PRINTFORM 、%TEXTR("팬들이 침 흘리는/스캔들 엄금의/청순을 가장하는/고고한/팬 모두가 동경하는/")%%TEXTR("아이돌/극상의")%자궁에
	ENDIF
ELSE
	SIF RISKY_DAY((対象キャラ)) >= 1
		PRINTFORM 、%TEXTR("위험일의/알을 품은/딱 임신하기 좋은 시기의")% 자궁에
ENDIF
IF RFLAG:フィニッシュフラグ > 1
	PRINTDATA
		DATA 대량의
		DATA 농후한
		DATA 엄청난 양의
		DATA 끈적이는
		;DATA 生きのいい
	ENDDATA
ENDIF
SIF TALENT:(対象キャラ):恋人持ち == 1 || TALENT:(対象キャラ):恋人持ち == 2
	PRINTFORM %TEXTR("바람/불륜/간통/밀통")%
PRINTDATA
	DATA 정액
	DATA 정액
;	DATA 種汁
;オラッ！APとBP満タンにしてやる！
	DATA 정액
ENDDATA
PRINT 을(를)
IF CFLAG:(対象キャラ):睡眠 || TCVAR:(対象キャラ):泥酔眠姦 || SAVESTR:ゲームフェイズ管理 == "むりやりうふふモード"
	PRINT 무책임하게
ENDIF
PRINTFORM %TEXTR("끈적하게/끈적하게/철퍽철퍽/듬뿍//")%
PRINTDATA
	DATA 뱉어냈다
	DATA 흩뿌렸다
	DATA 내뿜었다
	DATA 쏟아부었다
	DATA 쏟아넣었다
ENDDATA
PRINT …
PRINTL 
IF 実行キャラ == MASTER
	CALL 挿入アニメ表示(対象キャラ, "_射精")
ENDIF
TCVAR:(対象キャラ):被射精位置 = 1

