;-------------------------------------------------------------------------------------------
;射精先の選択肢
;-------------------------------------------------------------------------------------------
@オート射精先設定
;射精先をいちいち選ばなくてもいいように設定する
DRAWLINE
PRINTL 사정 시 선택 없이 사정하도록 설정합니다.
PRINTL 설정된 사정 위치를 선택할 수 있는 경우 자동으로 그 위치를 선택합니다.
PRINTL 선택 가능한 사정 위치가 여러 개 설정되어 있으면 우선도 숫자가 작은 쪽을 우선 선택합니다.
PRINTL 우선도를 공유하면 같은 우선도 안에서 무작위로 사정 위치가 선택됩니다.
DRAWLINE

FOR LOCAL, 0, 31
	IF オート射精先オプション:LOCAL == -1
		PRINTBUTTON @"[{LOCAL}] 자동 사정 대상을 추가한다", LOCAL
		PRINTL
		BREAK
	ELSE
		TSTR:コマンド名受渡 = 
		IF オート射精先オプション:LOCAL >= 10000
			TRYCALLFORM SHOOT_NAME_{オート射精先オプション:LOCAL - 10000}(-1)
			SIF TSTR:コマンド名受渡 == ""
				CONTINUE

			PRINTFORM └우선도-: %TSTR:コマンド名受渡, 18, LEFT%　　
		ELSE
			TRYCALLFORM SHOOT_NAME_{オート射精先オプション:LOCAL}(-1)
			SIF TSTR:コマンド名受渡 == ""
				CONTINUE

			PRINTFORM 우선도 {LOCAL}: %TSTR:コマンド名受渡, 20, LEFT%　　
		ENDIF
		IF LOCAL > 0
			PRINTBUTTON "[↑]", LOCAL + 100
		ELSE
			PRINT     
		ENDIF
		IF LOCAL < 30 && オート射精先オプション:(LOCAL + 1) > -1
			PRINTBUTTON "[↓]", LOCAL + 200
		ELSE
			PRINT     
		ENDIF
		PRINT 　　
		PRINTBUTTON "[변경]", LOCAL
		PRINT   
		PRINTBUTTON "[해제]", LOCAL + 300
		IF LOCAL > 0
			PRINT 　　
			IF オート射精先オプション:LOCAL >= 10000
				PRINTBUTTON "[우선도 공유 해제]", LOCAL + 400
			ELSE
				PRINTBUTTON "[위 항목과 우선도 공유]", LOCAL + 400
			ENDIF
		ENDIF
		PRINTL
	ENDIF
NEXT
PRINTL
PRINTBUTTON @"[999] 돌아가기", 999
PRINTL
DRAWLINE
BINPUT
LOCAL = RESULT
SELECTCASE LOCAL
	CASE 999
		RETURN 0
	CASE IS < 100
		DRAWLINE
		FOR LOCAL:1, 0, 31
			TSTR:コマンド名受渡 = 
			TRYCALLFORM SHOOT_NAME_{LOCAL:1}(-1)
			SIF TSTR:コマンド名受渡 == ""
				CONTINUE
			PRINTBUTTON @"[{LOCAL:1}] %TSTR:コマンド名受渡%", LOCAL:1
			PRINTL
		NEXT
		PRINTL
		PRINTBUTTON @"[999] 돌아가기", 999
		PRINTL
		DRAWLINE
		BINPUT
		IF RESULT != 999
			オート射精先オプション:LOCAL = RESULT
		ENDIF
	CASE IS < 200
		;上に移動
		SWAP オート射精先オプション:(LOCAL - 100), オート射精先オプション:(LOCAL - 101)
	CASE IS < 300
		;下に移動
		SWAP オート射精先オプション:(LOCAL - 200), オート射精先オプション:(LOCAL - 199)
	CASE IS < 400
		;削除
		ARRAYSHIFT オート射精先オプション, -1, -1, LOCAL - 300
	CASEELSE
		;優先度共有
		IF オート射精先オプション:(LOCAL - 400) >= 10000
			オート射精先オプション:(LOCAL - 400) = オート射精先オプション:(LOCAL - 400) - 10000
		ELSE
			オート射精先オプション:(LOCAL - 400) = オート射精先オプション:(LOCAL - 400) + 10000
		ENDIF
ENDSELECT

;一番上が優先度共有になってたら戻す
IF オート射精先オプション:0 >= 10000
	オート射精先オプション:0 = オート射精先オプション:0 - 10000
ENDIF

RESTART


;-------------------------------------------------------------------------------------------
;SHOOT_0:膣内
;-------------------------------------------------------------------------------------------
@SHOOT_NAME_0(対象キャラ)
#DIM 対象キャラ
TSTR:コマンド名受渡 = 질내사정
RETURN 1


@SHOOT_PALAM_0(実行キャラ, 対象キャラ)
#DIM 実行キャラ
#DIM 対象キャラ

EXP:(対象キャラ):Ｖ経験 += 5
EXP:(対象キャラ):精液経験 += RFLAG:フィニッシュフラグ

;履歴登録
RFLAG:履歴用数値保存 = 1
CALL 履歴登録チェック(対象キャラ, "膣内射精回数")
履歴用実績:対象キャラ:膣内射精回数 += 1

;Q.なんでフラグを別に作成してるの？
;A.将来的にコンドームとかに対応する用
RCVAR:(対象キャラ):膣内射精フラグ = 1

CALL SOURCE_CALC_快Ｖ(対象キャラ, 実行キャラ, 200 * (RCVAR:対象キャラ:被精液濃縮 / 4 + 1))
CALL SOURCE_CALC_接触(対象キャラ, 実行キャラ, 400)

;妊娠処理用に膣内射精された精液を計上
CALL TAKE_SPERM(対象キャラ, 実行キャラ, RCVAR:実行キャラ:射精量)


@SHOOT_ABLE_0(実行キャラ, 対象キャラ)
#DIM 実行キャラ
#DIM 対象キャラ
;選択肢に出る条件
;Ｖ挿入系モードじゃない時はアウト
{
SIF !MODE_存在判定_完全一致("Ｖ挿入系", 実行キャラ, 対象キャラ)
	&& !MODE_存在判定_完全一致("ハーヴィンオナホＶ", 実行キャラ, 対象キャラ)
	&& !MODE_存在判定_完全一致("挿入歩きＶ", 実行キャラ, 対象キャラ)
	&& !MODE_存在判定_完全一致("ハーヴィンディルドＶ", 対象キャラ, 実行キャラ)
}
	RETURN 0
RETURN 1


@MESSAGE_SHOOT_0(実行キャラ, 対象キャラ)
#DIM 実行キャラ
#DIM 対象キャラ
;PRINTFORM %CALLNAME:実行キャラ%は%CALLNAME:(対象キャラ)%の膣奥で
;以上元部分 以下加筆部分
