	CASE -1
		;性知識が0か-1のため、エロ本が理解出来なかったパターン
	CASE 0
		;性癖獲得失敗
		KSTR:(K++) = 「모…못 본 걸로 하자…」
	CASE 1
		;性癖獲得成功
		KSTR:(K++) = 「이 그림 이야기를 참고하면, 나도 젖소님이 될 수 있을까…? 우히히히…」
ENDSELECT
