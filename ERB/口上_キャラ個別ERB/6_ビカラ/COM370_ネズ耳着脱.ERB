
;----------------------------------------------------
;キャラ固有コマンド処理
;----------------------------------------------------
;コマンド名
;----------------------------------------------------
@CHARACOMNAME370_6
#FUNCTION
LOCAL = GETCHARA(6)
IF CSTR:LOCAL:スタイル管理文字列 == "[北の守護神]ビカラ（陰）"
	TSTR:コマンド名受渡 = 쥐 귀를 달다
ELSEIF CSTR:LOCAL:スタイル管理文字列 == ""
	TSTR:コマンド名受渡 = 쥐 귀를 벗기다
ENDIF
;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_370_6
#FUNCTION
TFLAG:コマンドタイプ受渡 = COMTYPE("日常")

@COM_TOOLTIP_370_6
LOCALS = <br>■쥐 귀를 벗기다<br>
LOCALS += "쥐 귀를 벗겨 음 비카라로 변화시키는 커맨드. <br>쥐 귀가 벗겨져 있을 때, [쥐 귀를 달다]로 변화한다. <br>복수의 소질과 이름, 그래픽이 변화한다."
LOCALS += "<br>COM 타입: 일상<br>획득 소스: 없음"
LOCALS += "<br>고유 획득 경험: 없음<br>"
TSTR:ツールチップ受渡 = %LOCALS%

;-------------------------------------------------
;実行処理
;-------------------------------------------------
@CHARACOM370_6
LOCAL = GETCHARA(6)
IF CSTR:LOCAL:スタイル管理文字列 == "[北の守護神]ビカラ（陰）"
	CSTR:LOCAL:スタイル管理文字列 = 
	CALL スタイル変更_6(LOCAL, "変更後処理")
ELSEIF CSTR:LOCAL:スタイル管理文字列 == ""
	CSTR:LOCAL:スタイル管理文字列 = [北の守護神]ビカラ（陰）
	CALL スタイル変更_6(LOCAL, "変更後処理")
ENDIF

;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE370_6
;一括管理
SIF GLOBAL_COMABLE(370)
	RETURN RESULT
LOCAL = GETCHARA(6)
SIF TARGET != LOCAL
	RETURN 0
RETURN 1


;-------------------------------------------------
;実行時メッセージ
;-------------------------------------------------
@MESSAGE_COM370_6
LOCAL = GETCHARA(6)
IF CSTR:LOCAL:スタイル管理文字列 == "[北の守護神]ビカラ（陰）"
	PRINTFORML %CALLNAME:PLAYER%은(는) 비카라의 쥐 귀를 벗겼다.
	PRINTFORML 
	PRINTFORML 「%TEXTR("하와와와……왜 벗기는 거예요?/아와와와……달린 귀가, 벗기지 말아주세~요/왜 떼어버리는 거예요오……심술 부리지 마~요")%……」
	PRINTFORML 
	PRINTFORMW %CALLNAME:TARGET%의 머리카락이 눈 깜짝할 사이에 검게 물들어간다……
ELSEIF CSTR:LOCAL:スタイル管理文字列 == ""
	PRINTFORML %CALLNAME:PLAYER%은(는) 비카라에게 쥐 귀를 돌려주었다.
	PRINTFORML 
	PRINTFORML 「%TEXTR("하핫, 나는 빗키!/분위기 달아올랐네에♪ 오늘도 활기차게 럭키 쿠키 빗키♪/십이신장 빗키♪ 화려하게 등장♪")%」
	PRINTFORML 
	PRINTFORMW %CALLNAME:TARGET%의 머리카락이 눈 깜짝할 사이에 하얗게 물들어간다……
ENDIF



@スタイル変更_6(対象キャラ, 動作モード)
#DIM 対象キャラ
#DIMS 動作モード
;この関数はいくつ別スタイル作ってもキャラ毎に一個

SELECTCASE 動作モード
	CASE "スタイル名取得"
		VARSET RESULTS
		;RESULTS:Xに肩書を、RESULTS:X+10にリミテッドや水着など通称(？)を入れる
		RESULTS:0 = %NAME:対象キャラ%
		RESULTS:10 = 陽

		RESULTS:1 = [北の守護神]ビカラ（陰）
		RESULTS:11 = 陰

	CASE @"スタイル解説_%NAME:対象キャラ%"
		TSTR:スタイル解説 = 
		TSTR:スタイル解説 += @"■%NAME:対象キャラ%<br>"
		TSTR:スタイル解説 += "<br>"
		TSTR:スタイル解説 += "쥐 귀를 단 빗키 스타일. <br>"
		TSTR:スタイル解説 += "밝고 즐겁게, 오늘도 활기차게 럭키 쿠키 빗키♪<br>"
		TSTR:スタイル解説 += "쥐 귀 전환 커맨드・버튼으로도 전환이 가능. <br>"
		TSTR:スタイル解説 += "<br>"
		CALL スタイル奥義アビ表示_汎用文章(対象キャラ, NAME:対象キャラ)
	CASE "スタイル解説_[北の守護神]ビカラ（陰）"
		TSTR:スタイル解説 = 
		TSTR:スタイル解説 += "■[북쪽의 수호신]비카라(음) <br>"
		TSTR:スタイル解説 += "<br>"
		TSTR:スタイル解説 += "쥐 귀를 벗은 본래의 비카라 스타일. <br>"
		TSTR:スタイル解説 += "아…… 쓸모없는 쥐라서 죄송해요……。<br>"
		TSTR:スタイル解説 += "쥐 귀 전환 커맨드・버튼으로도 전환이 가능. <br>"
		TSTR:スタイル解説 += "<br>"
		CALL スタイル奥義アビ表示_汎用文章(対象キャラ, "[北の守護神]ビカラ（陰）")
	CASE "変更後処理"
		;CSTR:対象キャラ:スタイル管理文字列をキーにして処理を実行
		;一人称や二人称、素質の変化などを想定
		SELECTCASE CSTR:対象キャラ:スタイル管理文字列
			CASE ""
				TALENT:対象キャラ:陽気／陰気 = 1
				TALENT:対象キャラ:目立ちたがり = 1
				TALENT:対象キャラ:度胸 = 0
				TALENT:対象キャラ:戦闘好き = 0
				TALENT:対象キャラ:会話資質 = 1
				TALENT:対象キャラ:羞恥心 = -1
				TALENT:対象キャラ:自慰しやすい = 0
				TALENT:対象キャラ:楽観的 = 1
				CALLNAME:対象キャラ = ビカラ
				CSTR:対象キャラ:フォルダ判定キー '= CALLNAME:対象キャラ
				SWAP CSTR:対象キャラ:画像フォルダ, CSTR:対象キャラ:スタイル変更前画像フォルダ
				CSTR:対象キャラ:画像フォルダ '= GET_RESOURCES_BASE_FOLDER(対象キャラ)
			CASE "[北の守護神]ビカラ（陰）"
				TALENT:対象キャラ:陽気／陰気 = -1
				TALENT:対象キャラ:目立ちたがり = 0
				TALENT:対象キャラ:度胸 = -1
				TALENT:対象キャラ:戦闘好き = -1
				TALENT:対象キャラ:羞恥心 = 1
				TALENT:対象キャラ:自慰しやすい = 1
				TALENT:対象キャラ:会話資質 = -1
				TALENT:対象キャラ:楽観的 = -1
				CALLNAME:対象キャラ = ビカラ（陰）
				CSTR:対象キャラ:フォルダ判定キー '= CALLNAME:対象キャラ
				SWAP CSTR:対象キャラ:画像フォルダ, CSTR:対象キャラ:スタイル変更前画像フォルダ
				CSTR:対象キャラ:画像フォルダ '= GET_RESOURCES_BASE_FOLDER(対象キャラ)
			;CASE RESULTS:2
			;CASE RESULTS:3
		ENDSELECT
ENDSELECT
