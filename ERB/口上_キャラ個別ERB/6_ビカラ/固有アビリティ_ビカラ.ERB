IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 80
	アビ名 = 陽鼠虹城
	消費ＭＰ = 300
ENDIF

生存キャラ数 = 0
テンション判定 = 0

; FOR 対象番号, 0, 4
; 	SIF BATTLE_STATE:対象番号:キャラ登録番号 < 1
