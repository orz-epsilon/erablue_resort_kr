;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「6」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
	;-2の場合は会話出来なかった扱いなので何も言わないのがいいかも
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_6_300(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		IF CSTR:対象キャラ:スタイル管理文字列 == ""
			IF RAND:2 == 0
				KSTR:(K++) = 「앗……」
				KSTR:(K++) = 「미안해…… 지금 귀를 빼고 있었거든……」
			ELSE
				KSTR:(K++) = 「미아~안」
				KSTR:(K++) = 「%TEXTR("한 번 더, 크게!! 소리 내서!! 말해줄 수 있을까!? 하하/못 들었어!! 정말 미안해~")%」
			ENDIF
		ELSE
			IF RAND:3 == 0
				KSTR:(K++) = （이 사람 누구였더라…… 평소에 고개만 숙이고 있어서）
				KSTR:(K++) = （%CALLNAME:PLAYER% 씨 얼굴을 기억 못 했어~……）
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 「죄, 죄송합니다……」
				KSTR:(K++) = （%CALLNAME:PLAYER% 씨 화났나? 안 화났나?…… 어쩌지……）
			ELSE
				KSTR:(K++) = 「죄송합니다……」
				KSTR:(K++) = （%CALLNAME:PLAYER% 맞지…… 긴장해서 말이 머리에 안 들어와……）
			ENDIF
		ENDIF
	CASE 0
		;通常成功
		;こいつ……話を聞いちゃいねえ
		IF CSTR:対象キャラ:スタイル管理文字列 == ""
			IF RAND:2 == 0
				KSTR:(K++) = 「그렇네, 그럴지도. 그런 건가%TEXTR("☆/☆彡/♪/！")%」
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 「그건 그렇고 %CALLNAME:PLAYER%도 쥐 귀를 달아보지 않을래? 지금이라면 단 3루피%TEXTR("야/. 정말 저렴해/. 속는 셈 치고 달아봐")%%TEXTR("☆/☆彡/♪/！")%」
			ELSE
				KSTR:(K++) = 「응응. 응%TEXTR("☆/☆彡/♪/！")%」
			ENDIF
		ELSE
			KSTR:(K++) = 「%TEXTR("하하/하하…… 그렇네요/그럴지도……/네")%……」
			IF RAND:6 == 0
				KSTR:(K++) = （무리무리무리…… 그렇게 대화가 이어지지 않아……）
			ELSEIF RAND:5 == 0
				KSTR:(K++) = （요건은 끝났잖아……이상한 말 하기 전에 방으로 돌아가고 싶어어……）
			ELSEIF RAND:4 == 0
				KSTR:(K++) = （빨리 혼자가 되고 싶어……! 방으로 돌아가서 고독에 시달리면서 고독을 즐기고 싶어! 나는 음침토피아의 주민이니까!）
			ELSEIF RAND:3 == 0
				KSTR:(K++) = （말 걸어오는 인싸랑 같이 있으면서 맛보는 열등감보다, 혼자만의 고독감이 훨씬 더 편안해!）
			ELSEIF RAND:2 == 0
				KSTR:(K++) = （빨리 어딘가로 가버려어……분명 나랑 대화하는 거 재미없다고 생각할 거야. 아아아, 이 시간이 견디기 힘들어）
			ELSE
				KSTR:(K++) = （무리무리무리……왜 나한테 말을 거는 거야아……무리야아, 할 말 같은 거 생각나지 않아!）
			ENDIF
		ENDIF
	CASEELSE
		;大成功
		;大成功？？？とは？？？
		IF CSTR:対象キャラ:スタイル管理文字列 == ""
			IF 陥落チェック_性的(対象キャラ) > 0 && RAND:4 == 0
				IF RAND:2 == 0
					KSTR:(K++) = 「밝고 즐겁게. 나쁜 일도, 야한 일도%TEXTR("☆/☆彡/♪/！")%」
					KSTR:(K++) = 「%TEXTR("모~든 걸 통째로 즐겨보자/넓은 마음으로, 쾅 하고 받아들여 줄게")%_H_」
				ELSE
					KSTR:(K++) = 「여기서는 %CALLNAME:PLAYER%. 네가 왕이다」
					KSTR:(K++) = 「어른들의 꿈이 가득한 나라 조금 야한 유~토피아_H_」
					KSTR:(K++) = 「멋지다고, 나는 생각해. 응응」
				ENDIF
			ELSEIF RAND:3 == 0
				KSTR:(K++) = 「%TEXTR("리조트 경영 방침인가~/황송하옵니다 황송하옵니다~")%……」
				KSTR:(K++) = 「처음부터 모든 일이 잘 풀리는 건 없어. 나도 많이 실패하면서 꿈의 나라를 목표로 하고 있어」
				KSTR:(K++) = 「실패해도 좌절하지 않고, %CALLNAME:PLAYER%이(가) 하고 싶은 대로 해보는 것, 그게 가장 좋은 해결책이라고 나는 생각해%TEXTR("☆/☆彡/♪/！")%」
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 「하하」
				KSTR:(K++) = 「그러게~ 여기 이름도 리조토피아로 개명해보는 건 어때. 꿈의 나라를 목표로 하는 거야%TEXTR("☆/☆彡/♪/！")%」
			ELSE
				KSTR:(K++) = 「하하」
				KSTR:(K++) = 「나는%TEXTR("뭐든지 알고 있어/뭐든지 꿰뚫어 보고 있지/명탐정. 몸은 아이, 두뇌는 어른이지")%. 그러니까, %CALLNAME:PLAYER%야한 건 안 돼%TEXTR("라고 생각해/라고!/라고~/자제해 줘/적당히 해 줘")%%TEXTR("☆/☆彡/♪/！")%」
			ENDIF
		ELSE
			IF RAND:4 == 0
				KSTR:(K++) = 「아, 아니요……별로……」
				KSTR:(K++) = 「랄까, 아무도 모르는%TEXTR("곳/리조트")%을(를) 골랐는데 아는 사람만 있어서……」
			ELSEIF RAND:3 == 0
				KSTR:(K++) = 「아, 저랑 이야기해서……즐, 즐거우신가요……」
				KSTR:(K++) = 「감사합니다……%CALLNAME:PLAYER%님」
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 「아, 음……」
				KSTR:(K++) = 「아직은 얼굴만 봐도 긴장된다고 할까……」
				KSTR:(K++) = 「저 전혀 어울리지 못하고 있죠……」
			ELSE
				KSTR:(K++) = 「저, 항상 평범하게 있을 뿐인데……」
				KSTR:(K++) = 「『있었어?』라고 들을 정도로 존재감이 없는데」
				KSTR:(K++) = 「이렇게 찾아내서 말을 걸어주는%CALLNAME:PLAYER%에게 감사해요……에헤헤……」
			ENDIF
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

