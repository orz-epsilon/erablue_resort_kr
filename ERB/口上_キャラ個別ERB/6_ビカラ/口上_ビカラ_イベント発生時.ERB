;****************************************
;ターン開始時や一日開始時・終了時に条件を満たしていた時表示される文章
;****************************************
;・使い方
;「6」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
@KOJO_EVENT_挨拶_6(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

IF 初体験日:TARGET:初対面 > 0

	;挨拶の時間・内容は地の文では言及されないので適宜変更してもOK
	;朝　5時～11時
	IF TIME >= 300 && TIME < 660
		IF CSTR:対象キャラ:スタイル管理文字列 == ""
			IF RAND:2 == 0
				KSTR:(K++) = 「하하, 나, 비키!」
				KSTR:(K++) = 「%TEXTR("오늘도 하루 즐겁게 보내자/오늘은 뭘 하고 놀까/오늘도 활기차게 즐겁게 보내자")%%TEXTR("☆/☆彡/♪/！")%」
			ELSE
				KSTR:(K++) = 「하하, 나, 비키!」
				KSTR:(K++) = 「%TEXTR("아침부터 활기차게, 기분 좋게 힘내볼게/오늘은 또 어떤 즐거운 일이 기다리고 있을까/")%%TEXTR("☆/☆彡/♪/！")%」
			ENDIF
		ELSE
			KSTR:(K++) = 「%TEXTR("아, 아, 아/아, 아,/안녕, 안")%녕하세요……」
		ENDIF
	;昼　11時～17時
	ELSEIF TIME >= 660 && TIME < 1020
		IF CSTR:対象キャラ:スタイル管理文字列 == ""
			IF RAND:2 == 0
				KSTR:(K++) = 「하하, 나, 비키!」
				KSTR:(K++) = 「%TEXTR("나를 만나서 행운이네. 오늘은 좋은 날이 될 거야/오늘은 뭘 하고 놀까/오늘도 활기차게 즐겁게 보내자")%%TEXTR("☆/☆彡/♪/！")%」
			ELSE
				KSTR:(K++) = 「예이%TEXTR("☆/☆彡/♪/！")%。%TEXTR("오늘도 즐겁게 보내고 있니/뭔데 뭔데, 고민이 있다면 상담해 줘/나와 함께, 유토피아")%%TEXTR("☆/☆彡/♪/！")%」
			ENDIF
		ENDIF
	ELSE
		IF CSTR:対象キャラ:スタイル管理文字列 == ""
			IF RAND:2 == 0
				KSTR:(K++) = 「하하, 나, 비키!」
				KSTR:(K++) = 「%TEXTR("만난 기념으로, 나랑 사진 한 장 찍어둘까/모처럼의 리조트잖아. 나랑 같이 실컷 즐겨보자/밤은 아직 시작이야, 같이 실컷 즐겨볼까")%%TEXTR("☆/☆彡/♪/！")%」
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 「하하, 나, 비키!」
				KSTR:(K++) = 「%TEXTR("나도 같이 리조트에서의 특별한 하루를 북돋아 줄게/여기는 제2의 유토피아. 반짝반짝 쑥쑥 힘내자/밤이 되어도 활기 가득. 즐겁게 매일 놀아보자")%%TEXTR("☆/☆彡/♪/！")%」
			ENDIF
		ELSE
			KSTR:(K++) = 「%TEXTR("저, 저, 저/저, 저,/안녕, 안")%녕하세요……」
		ENDIF
	ENDIF
ENDIF
CALL 口上変数表示(対象キャラ, 0)

