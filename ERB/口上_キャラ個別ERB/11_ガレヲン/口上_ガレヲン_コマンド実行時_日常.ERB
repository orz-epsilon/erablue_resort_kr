;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「11」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと

;--------------------------------------------------
;COM300_会話
;--------------------------------------------------
;一旦対ヒトの子で組むけど、その他のヒトの子以外はどうすれば（
;%CSTR:対象キャラ:二人称%の中身を変えて対応？

;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功	-2:会話しすぎで大失敗
	;-2の場合は会話出来なかった扱いなので何も言わないのがいいかも
;ABL:MASTER:話術技能によって効果上昇

@KOJO_COM_11_300(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		;	KSTR:(K++) = 草。（大草原）
		IF RAND:2 == 0
			KSTR:(K++) = 수심.（인간의 마음에 이해가 미치지 못하는 것은 저의 슬픔입니다…）
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 우려.（지금의 저로서는 인간의 마음을 모두 이해하기는 어렵네요…）
		ELSE
			KSTR:(K++) = 유감.（%CSTR:対象キャラ:二人称%와 마음을 나누기에는 저는 아직 미숙하네요…）
		ENDIF
	CASE 0
		;通常成功
		IF RAND:3 == 0
			KSTR:(K++) = 선함.（가냘픈 생명이 이루는 그 노력, 훌륭합니다…）
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 이해.（%CSTR:対象キャラ:二人称%의 마음은 전해졌습니다）
		ELSE
			KSTR:(K++) = 동경.（작은 생명의 마음. 하늘처럼 넓고 크네요）
		ENDIF
	CASEELSE
		;大成功
		;恋慕。（あーあーマイクテスト、マイクテスト。特異点と器の接続が拡大されたのを確認。これが愛……）
		IF TALENT:TARGET:恋慕
			IF RAND:4 == 0
				KSTR:(K++) = 유래.（이 그릇의 형태 말인가요? 물론, 모든 인간의 아이를 본뜬 것입니다. 하늘을 살아가는 모든 생명의 형태를 담아내는 것은 어려웠기에, 적어도 인간의 아이만이라도 남김없이 담아내고 싶었습니다）
			ELSEIF RAND:3 == 0
				KSTR:(K++) = 축복.（당신이 %CSTR:対象キャラ:二人称%이기 때문에 축복을 주는 것이 아니라, 당신이 당신으로서 이 하늘 세계를 열심히 살아가기 때문에 축복을 주고 싶은 것입니다. 자, 사양 말고 _H_）
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 미래.（작고 가냘픈 하늘의 생명들. 이 메마른 대지를, 적어도 자신이 살기 좋도록 그 손으로 바꿔 만드세요. 거대한 흐름 속에서 언젠가 모든 것이 대지로 회귀한다 할지라도. 당신들의 삶의 방식은 분명히 세계에 새겨질 것입니다）
			ELSE
				KSTR:(K++) = 난생.（이 그릇은 인간 아이의 모습과 닮았지만… 저의 본질은 육룡 『금』 갈레온이기에 제 아이가 알로 태어나는 것은 필연적인 이치입니다）
			ENDIF
		;恋慕以外
		ELSE
			IF RAND:3 == 0
				KSTR:(K++) = 축복.（%CSTR:対象キャラ:二人称%에게 축복을…）
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 감사.（%CSTR:対象キャラ:二人称%의 마음을 분명히 들었습니다）
			ELSE
				KSTR:(K++) = 감복.（%CSTR:対象キャラ:二人称%의 마음. 분명히 받아들였습니다）
			ENDIF
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

