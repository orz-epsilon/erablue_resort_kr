;--------------------------------------------------
;COM302_スキンシップ
;--------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;-1:失敗  0:通常成功  1:大成功

@KOJO_COM_11_302(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
SELECTCASE RFLAG:コマンド結果受渡し変数
	CASE -1
		;失敗
		IF RAND:2 == 0
			KSTR:(K++) = 근심. (사람의 마음에 이해가 미치지 못하는 것은 저의 슬픔…)
		ELSE
			KSTR:(K++) = 갈등. (%CSTR:対象キャラ:二人称%는 무엇을 바라고 있는 걸까요…)
		ENDIF
	CASE 0
		;通常成功
		IF RAND:2 == 0
			KSTR:(K++) = 호감. (%CSTR:対象キャラ:二人称%의 마음씨를 좋게 느끼고 있습니다)
		ELSE
			KSTR:(K++) = 호의. (%CSTR:対象キャラ:二人称%를 좋게 생각하고 있습니다)
		ENDIF
	CASEELSE
		;大成功
		;恋慕。（あーあーマイクテスト、マイクテスト。特異点と器の接続が拡大されたのを確認。これが愛……）
		IF TALENT:TARGET:恋慕
			IF RAND:3 == 0
				;祝福（物理）。
				KSTR:(K++) = 축복. (%CSTR:対象キャラ:二人称%……사랑합니다.) (쪽_H_)
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 지복. (%CSTR:対象キャラ:二人称%와 이렇게 사랑을 확인할 수 있는 것을 행복하게 느끼고 있습니다…)
			ELSE
				KSTR:(K++) = 욕망. (%CSTR:対象キャラ:二人称%는 서로 닿는 것만으로 만족하는 건가요?)
			ENDIF
		;恋慕以外
		ELSE
			IF RAND:4 == 0
				KSTR:(K++) = 축복. (%CSTR:対象キャラ:二人称%에게 축복을…)
			ELSEIF RAND:3 == 0
				KSTR:(K++) = 자유. (작은 생명의 행위를 대지는 모두 받아들입니다)
			ELSEIF RAND:2 == 0
				KSTR:(K++) = 고동. (저의 고동이 고조되고 있는 것이 %CSTR:対象キャラ:二人称%에게도 전해질 것이라고 생각합니다)
			ELSE
				KSTR:(K++) = 은총. (%CSTR:対象キャラ:二人称%와 접촉하는 기쁨을 느낍니다…)
			ENDIF
		ENDIF
ENDSELECT

CALL 口上変数表示(対象キャラ, 0)

