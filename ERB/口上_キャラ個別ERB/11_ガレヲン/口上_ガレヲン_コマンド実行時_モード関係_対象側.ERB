;--------------------------------------------------
;COM20_キス
;--------------------------------------------------
;セクハラコマンドの方のキスを削除してこちらに合流
;「TFLAG:調教モード」で判別可能。  1:セクハラ時  2:セックス中

@KOJO_COM_11_20(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｓ
;ランダム弱点コマンドの候補
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		SELECTCASE CUP:対象キャラ:快Ｓ
			;各部位の累積が10000で絶頂
			CASE IS > 10000
				;即絶頂
				KSTR:(K++) = 절정. (용서해 주세요…… 이제 저, 가, 가버릴 것 같아요……)
			CASE IS > 6000
				;かなり感じている
				KSTR:(K++) = 감미. (%TEXTR("키스/입맞춤/접문")%만 하고 있을 뿐인데……%CSTR:対象キャラ:二人称%을(를) 생각하면……)
			CASE IS > 3000
				;人並みに感じている
				KSTR:(K++) = 환희. (%CSTR:対象キャラ:二人称%와(과) 하는 %TEXTR("키스/입맞춤/접문")%은 %TEXTR("멋져요/특별해요")%……)
			CASEELSE
				;まだ快楽に慣れていない
				KSTR:(K++) = 호감. (%CSTR:対象キャラ:二人称%와(과) %TEXTR("키스/입맞춤/접문")%하고 있으면…… %TEXTR("두근두근/심장이 고동쳐요")%……)
		ENDSELECT
;	ELSEIF TALENT:対象キャラ:セフレ
;		KSTR:(K++) = 
	ELSE
;		KSTR:(K++) = 「%TEXTR("ちゅっ/チュッ/んっ/んんっ")%_H_……」
;		KSTR:(K++) = 　
		IF RAND:3 == 0
			KSTR:(K++) = 호감. (%CSTR:対象キャラ:二人称%의 마음을 좋게 느끼고 있습니다)
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 호감. (%CSTR:対象キャラ:二人称%와의 %TEXTR("키스/입맞춤/접촉")%을 바라고 있습니다)
		ELSE
			KSTR:(K++) = 호감. (%CSTR:対象キャラ:二人称%와의 %TEXTR("키스/입맞춤/접촉")%을 통해 서로를 이해합시다…)
		ENDIF
		KSTR:(K++) = 　
		;★部屋の中の人を確認して、人目を気にせず分岐を作りたい
		IF RAND:2 == 0
			KSTR:(K++) = %CALLNAME:MASTER%이(가) %TEXTR("키스/입맞춤")%하려고 하자 %CALLNAME:TARGET%은(는) %TEXTR("기쁜 듯이/살짝/행복한 듯이")% %TEXTR("미소 지으며/웃음을 띠며")% 받아들여 주었다……
		ELSE
			KSTR:(K++) = %TEXTR("키스/입맞춤")%를 받아들인 %CALLNAME:TARGET%은(는) %CALLNAME:TARGET%은(는) %TEXTR("기쁜 듯이/살짝/행복한 듯이")% %TEXTR("미소 지으며/웃음을 띠며")% 주었다……
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;COM20_1舌を入れる
;--------------------------------------------------
@KOJO_COM_11_20_1(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｓ
;ランダム弱点コマンドの候補
CALL 口上変数初期化

IF PLAYER == MASTER
;	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		SELECTCASE CUP:対象キャラ:快Ｓ
			;各部位の累積が10000で絶頂
			CASE IS > 10000
				;即絶頂
				KSTR:(K++) = 절정. (혀를 얽으면서…… 저. 가, 가버릴 것 같아요……)
			CASE IS > 6000
				;かなり感じている
				IF RAND:2 == 0
					KSTR:(K++) = 감미. (그런 식으로 혀를 얽히면…… 하아……)
				ELSE
					KSTR:(K++) = 감미. (이제 용서해 주세요…… 더 이상은……)
				ENDIF
			CASE IS > 3000
				;人並みに感じている
				KSTR:(K++) = 환희. (%CSTR:対象キャラ:二人称%와(과) 이렇게…… 혀를 얽는 건 %TEXTR("두근두근/흥분")%돼요……)
			CASEELSE
				;まだ快楽に慣れていない
				KSTR:(K++) = 호감. (%TEXTR("후훗/후후훗")%_H_이렇게…… 혀를 얽어 서로의 마음을 전하는 거군요……)
		ENDSELECT
;	ELSEIF TALENT:対象キャラ:セフレ
;		KSTR:(K++) = 
	ELSE
;		KSTR:(K++) = 「%TEXTR("んぅ/んっ/んんっ/んんんっ")%_H_……」
		IF RAND:3 == 0
			KSTR:(K++) = 호감.（나와 %CSTR:対象キャラ:二人称%의 혀가 얽혀 있습니다……）
		ELSEIF RAND:2 == 0
			KSTR:(K++) = 호감.（나와 %CSTR:対象キャラ:二人称%. 서로의 혀를 얽히게 하며……）
		ELSE
			KSTR:(K++) = 호감.（나와 %CSTR:対象キャラ:二人称%. 두 사람의 혀와 혀가 짝이 되어……）
		ENDIF
		KSTR:(K++) = 　
		;★部屋の中の人を確認して、人目を気にせず分岐を作りたい
		IF RAND:2 == 0
			KSTR:(K++) = %CALLNAME:MASTER%와 %CALLNAME:TARGET%는 열렬히 입맞춤을 나누고 입안에서 혀를 얽히게 했으며, 서로의 혀는 뱀이 교미하듯이 %TEXTR("질척질척/질척질척/미끌미끌/미끌미끌")% 얽히고, 핥고, 녹아들어 시간도 잊은 채 서로를 갈구했다……
		ELSE
			KSTR:(K++) = %CALLNAME:MASTER%와 %CALLNAME:TARGET%는 서로를 갈구하며 혀와 혀를 얽히게 하자 %TEXTR("쪽쪽/쪽쪽")% 하고 음란한 물소리를 흘리면서 서로의 혀를 생물처럼 움직여 상호간에 입안을 공격하고, 범하고, 유린하며 농밀한 시간을 보냈다……
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

