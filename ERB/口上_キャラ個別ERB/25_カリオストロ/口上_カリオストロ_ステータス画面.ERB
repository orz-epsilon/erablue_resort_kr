;・使い方
;「25」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;--------------------------------------------------
;通常画面一言口上
;--------------------------------------------------
@口上_INFO画面_一言コメント_25(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、通常時の画面で表示されるので
;基本的にWAIT系列は使わないことを推奨
;また、一行のみの表示を想定。二行以上は基本的に禁止
;※うふふ中には表示されません

;以下は分岐の例
;絶頂時
IF TCVAR:対象キャラ:前ターン絶頂
	STRDATA KSTR:(K++)
		DATA _CALLNAME_은(는) 숨을 헐떡이며 절정의 여운에 잠겨 있다……
		DATA _CALLNAME_은(는) 강렬한 쾌락을 주입당해, 엎드린 채 이따금 경련을 반복하고 있다……
		DATA 「후우, 후우, 후우…… 칼리오스트로, 가버렸어_H_H_」
		DATA 「_I_아아ー, 아아ー… 뇌, 뇌가 바보가 되는 줄 알았어…… 아니, 이미 늦었을지도, 모르겠네……_H_」
	ENDDATA
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;仕事中の一言口上
IF TALENT:対象キャラ:従業員 && TCVAR:対象キャラ:休暇中 == 0 && CFLAG:対象キャラ:現在位置 == 現在仕事:対象キャラ:1 % 10000 && CFLAG:対象キャラ:現在マップ種別 == 現在仕事:対象キャラ:1 / 10000
	SELECTCASE 現在仕事:対象キャラ:1
		CASE 2
			;ロビーで受付中
			KSTR:(K++) = 「어서 오세요～♪」
		CASE 503
			;バーエリアでバーテンダー中
			KSTR:(K++) = 「칵테일 조제도, 칼리오스트로에게 맡겨주세요♪」
		CASE 506
			;図書室で司書中
			KSTR:(K++) = 「도서실에서는 조용히. _I_상식 아니냐?_CALL_カリオストロ本性開示_」
		CASE 1503, 15
			;プールで監視員中
			KSTR:(K++) = 「우로보로스의 워터 슬라이더는 현재 {5 * RAND:5 + 10}분 대기 중입니다～♪」
		CASE 10000 TO 10009
			;各種店舗で店番中
			CALLFORMF 空艇港店舗名表示_{空艇港店舗状況:(現在仕事:対象キャラ:1 - 10000):0}(現在仕事:対象キャラ:1 - 10000)
			SELECTCASE REPLACE(TSTR:場所名受渡, "『.*』", "")
				CASE "道具屋"
					IF RAND:3
						KSTR:(K++) = 「이거랑 이건 이쪽에, 이건 저쪽에 두고… 읏차」
					ELSE
						KSTR:(K++) = 「_I_오, %CSTR:対象キャラ:二人称%. 너도 나님 특제 드링크 샘플 써볼래?_CALL_カリオストロ本性開示_」
					ENDIF
				CASE "土産物屋"
					IF RAND:10
						KSTR:(K++) = 「_I_이런 건, 어디 가도 의외로 별반 다를 게 없단 말이지……_CALL_カリオストロ本性開示_」
					ELSE
						KSTR:(K++) = 「_I_그러고 보니, 그 녀석도 여행지에서 이런 거 샀었지… 매번 매번, 질리지도 않고……_CALL_カリオストロ本性開示_」
					ENDIF
				CASE "食事処"
					KSTR:(K++) = 「특별 서비스 들어갑니다～♪　맛있어져라_H_　모에모에 큥_H_H_」
				CASE "装飾品店"
					KSTR:(K++) = 어느새인가, 『세계 제일의 미소녀 연금술사 보증 코너』가 만들어져 있다……
			ENDSELECT
	ENDSELECT
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置
;状況で分岐

IF CFLAG:対象キャラ:飲み会
	;飲み会中
	IF RAND:5
		KSTR:(K++) = 「에헤헷 칼리오스트로, 취해버렸어♪」
	ELSE
		KSTR:(K++) = 「_I_응, %CSTR:対象キャラ:二人称%도 마시고 있나?……바보, 이 정도로 내가 취할 리 없잖아_CALL_カリオストロ本性開示_」
	ENDIF
ELSEIF CFLAG:対象キャラ:睡眠
	;ダウン・睡眠中
	IF CFLAG:対象キャラ:体力限界 && RAND:4
		KSTR:(K++) = 잠든 채로, 가끔 쾌락이 되돌아왔는지 움찔, 움찔 경련하고 있다……
	ELSEIF 陥落チェック_性的(対象キャラ) && RAND:3
		STRDATA KSTR:(K++)
			DATA 「음~ 에헤헤~ _2nd_사앙~_H_……」
			DATA 「_2nd_……나도오, 너를……쿨쿨……」
			DATA 「음~…웅얼웅얼……_2nd_H_……」
		ENDDATA
	ELSE
		KSTR:(K++) = 「음~……새근…새근……」
	ENDIF
ELSEIF CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;一緒に隠密中
	STRDATA KSTR:(K++)
		DATA 「_2nd_님, 조금 두근거리네요♪」
		DATA 「남의 눈을 피해서……무엇을 할 생각일까요?」
		DATA 「_I_그래서? 이번엔 뭘 꾸미고 있는 거야?_CALL_カリオストロ本性開示_」
	ENDDATA
ELSEIF CFLAG:対象キャラ:デート == MASTER + 100
	;デート中
	;デートの相手のキャラ番号 + 100が入っている
	;あなた相手なら「CFLAG:対象キャラ:デート == MASTER + 100」
	STRDATA KSTR:(K++)
		DATA 「응? _2nd_님, 왜 그래요?」
		DATA 「그렇게 쳐다보면…부끄럽잖아아_H_」
		DATA 「_I_……어이, 뭘 딴청 피우는 거야. 네 옆에 있는 건……세계 제일의 미소녀, 라고?_CALL_カリオストロ本性開示_」
		DATA 「_I_자자, 제대로 에스코트해 달라고?_CALL_カリオストロ本性開示_」
	ENDDATA
ELSEIF CFLAG:対象キャラ:一緒に遊ぶ
	;一緒に遊ぶ中
	STRDATA KSTR:(K++)
		DATA 「_2nd_님, 뭘 보고 있는 걸까나~? (히죽히죽)」
		DATA 「_2nd_님, 뭐 하고 놀까요?」
		DATA 「_I_세계 제일의 미소녀와 함께 있는데, 그 이상으로 우선할 건 없잖아?_CALL_カリオストロ本性開示_」
		DATA 「_I_자, 제대로 즐겁게 해 줘?_CALL_カリオストロ本性開示_」
	ENDDATA
ELSEIF CFLAG:対象キャラ:同行
	;同行中
	STRDATA KSTR:(K++)
		DATA 「_2nd_님, 뭘 보고 있는 걸까~? (히죽히죽)」
		DATA 「_2nd_님, 어디로 데려가 줄 거야?」
		DATA 「_I_자, 제대로 즐겁게 해 줘?_CALL_カリオストロ本性開示_」
		DATA 「_I_자자, 제대로 에스코트해 줘?_CALL_カリオストロ本性開示_」
	ENDDATA
ELSEIF CFLAG:PLAYER:隠密 && !CFLAG:対象キャラ:隠密
	;あなたが隠れていて、キャラはあなたに気づいていない
	KSTR:(K++) = （_I_뭔가 시선이 느껴지는데… 기분 탓인가?_）
ELSEIF !CFLAG:PLAYER:隠密 && CFLAG:対象キャラ:隠密
	;キャラの野外オナニー中
	KSTR:(K++) = 「_I_젠장, 이 몸이 뭘 하는 거야……_COLOR_0xFFCCE7_하지만, 멈출 수 없어, 으읏_H_CALL_カリオストロ本性開示_」
ENDIF
;この時点で口上が入ってるなら表示へ飛ばす
SIF KSTR:0 != ""
	GOTO 表示位置

;最も多い好感度要素で分岐
SELECTCASE MAXRAND(CFLAG:対象キャラ:友情度, CFLAG:対象キャラ:信頼度, CFLAG:対象キャラ:恋心度, CFLAG:対象キャラ:性愛度, CFLAG:対象キャラ:キャラ固有好感度, CFLAG:対象キャラ:恋慕度)
	CASE 0
		;友情度
		CALL 口上_ステータス画面_友情コメント_25(対象キャラ, 1)
	CASE 1
		;信頼度
		CALL 口上_ステータス画面_信頼コメント_25(対象キャラ, 1)
	CASE 2
		;恋心度
		CALL 口上_ステータス画面_恋心コメント_25(対象キャラ, 1)
	CASE 3
		;性愛度
		CALL 口上_ステータス画面_性愛コメント_25(対象キャラ, 1)
	CASE 4
		;錬金知識
		CALL 口上_ステータス画面_キャラ固有好感度要素コメント_25(対象キャラ, 1)
	CASE 5
		;恋慕度
		CALL 口上_ステータス画面_恋慕コメント_25(対象キャラ, 1)
ENDSELECT

$表示位置
CALL PRINT_STATEコメント表示(対象キャラ, 2)

;--------------------------------------------------
;ステータス画面一言口上_友情
;--------------------------------------------------
@口上_ステータス画面_友情コメント_25(対象キャラ, ARG=0)
#DIM 対象キャラ
CALL 口上変数初期化

;口上と同じ感覚で使う為に書式を統一しているが、ステータス画面で表示されるので
;基本的にWAIT系列は使わないことを推奨

SELECTCASE CFLAG:対象キャラ:友情度
	CASE IS == 0
		;初対面
		KSTR:(K++) = 「여기 오너분…？
		KSTR:(K++) = 　칼리오스트로, 어디선가 만난 적이 있나?」
	CASE IS <= 経験値テーブル:(関係閾値:1)
		;他人
		KSTR:(K++) = 「칼리오스트로는 말이야, 세계 제일의 천재 미소녀 연금술사라고!」
	CASE IS <= 経験値テーブル:(関係閾値:2)
		;顔見知り
		KSTR:(K++) = 「_2nd_님, 항상 일 열심히 해서 대단해_H_」
	CASE IS <= 経験値テーブル:(関係閾値:3)
		;友人
		KSTR:(K++) = 「_2nd_님도오, 칼리오스트로랑 같이 놀자?
		KSTR:(K++) = 　_I_세계 제일의 미소녀의 유혹이야, 설마…… 싫다고는 안 하겠지?_」
	CASE IS <= 経験値テーブル:(関係閾値:4)
		;親友
		KSTR:(K++) = 「_I_%CSTR:対象キャラ:二人称%、너와 함께라면 즐겁게 지낼 수 있을 것 같아_」
	CASEELSE
		;無二の友
		KSTR:(K++) = 「_I_곤란한 일이 있으면 사양 말고 의지해.
		KSTR:(K++) = 　_I_%CSTR:対象キャラ:二人称%을(를) 위해서라면 내가 나서주겠어_」
ENDSELECT

SIF ARG
	RETURN

CALL PRINT_STATEコメント表示(対象キャラ)

