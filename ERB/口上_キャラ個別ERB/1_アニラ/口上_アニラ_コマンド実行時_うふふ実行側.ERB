;--------------------------------------------------
;実行側口上のテストのために１個だけ追加
;--------------------------------------------------
@KOJO_COMPLAYER_1_0(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｃ、Ｂ
;ランダム弱点コマンドの候補
CALL 口上変数初期化

IF TARGET == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		KSTR:(K++) = 「%CALLNAME:MASTER%, 여기가 기분 좋은가?」
		KSTR:(K++) = 「좋아좋아, 내 손으로 부드럽게 이끌어주마_H_」
	ELSEIF TALENT:対象キャラ:セフレ
		KSTR:(K++) = 「크흐흐_H_ 자자, 여기는 어떤가?」
		KSTR:(K++) = 「벌벌 떨고 있구나_H_ 이대로 가게 해버릴까_H_」
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)
