;--------------------------------------------------
;うふふコマンド
;--------------------------------------------------
;COM0_愛撫
;--------------------------------------------------
@KOJO_COM_10_0(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｃ、Ｂ
;ランダム弱点コマンドの候補
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	;IF TALENT:対象キャラ:恋慕
		SELECTCASE MAX(CUP:対象キャラ:快Ｃ, CUP:対象キャラ:快Ｂ)
			;各部位の累積が10000で絶頂、場合分けの数値は参考数値なのでイメージで変えてもらってOK
			CASE IS > 10000
				;即絶頂
				IF RAND:2
					KSTR:(K++) = 「앗앗아아_H_우어, 어어우읏_H__H_」
					KSTR:(K++) = 너무 강한 쾌락에 농락당해, %CALLNAME:対象キャラ%은(는) 짐승 같은 신음을 내고 있다….
				ELSE
					KSTR:(K++) = 「아읏, 히이읏_H_어읏, 잠깐, 너무 느껴져읏_H__H_」
					KSTR:(K++) = %CALLNAME:MASTER%의 손이 피부를 스칠 때마다, %CALLNAME:対象キャラ%은(는) 움찔움찔하며 온몸을 떨고 있다….
				ENDIF
			CASE IS > 6000
				;かなり感じている
				IF RAND:2
					KSTR:(K++) = 「하아…_H_좋아, 좋은 기분이야…앗아앙읏_H_」
					KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 얼굴을 붉히며, 상당히 느끼고 있는 듯하다….
				ELSE
					KSTR:(K++) = 「응아앗_H_더, 더…읏_H_」
					KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 더한 자극을 찾아, %CALLNAME:MASTER%의 팔에 매달리고 있다….
				ENDIF
			CASE IS > 3000
				;人並みに感じている
				IF RAND:2
					KSTR:(K++) = 「응…그, 그렇군. 조금…기분 좋군…아앗…」
					KSTR:(K++) = 살짝 뺨을 붉힌 %CALLNAME:対象キャラ%은(는) 미약한 신음 소리를 내고 있다….
				ELSE
					KSTR:(K++) = 「그래, 거기야…더 강해도 상관없다네」
					KSTR:(K++) = %CALLNAME:対象キャラ%은(는) %CALLNAME:MASTER%의 손이 좋은 곳에 닿도록, 조금씩 몸을 비틀고 있다….
				ENDIF
			CASEELSE
				;まだ快楽に慣れていない
				IF RAND:2
					KSTR:(K++) = 「오, 훗, 후하핫…이렇게 쓰다듬어지니 간지럽군…」
					KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 간지러운 듯 몸을 비틀고 있다….
				ELSE
					KSTR:(K++) = 「…?이것이 짝에게 필요한 일인가?」
					KSTR:(K++) = 「그렇다면%CSTR:対象キャラ:一人称%도%CSTR:対象キャラ:二人称%으로 만들어 줄 필요가 있지 않을까?」
				ENDIF
		ENDSELECT
	;ELSEIF TALENT:対象キャラ:セフレ
	;	KSTR:(K++) = 
	;ELSE
	;	KSTR:(K++) = 
	;ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)

