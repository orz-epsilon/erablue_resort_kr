							KSTR:(K++) = 「맛이나 냄새도 생각보다 나쁘지 않아…」
					ENDSELECT
				ENDIF
			ELSEIF RCVAR:対象キャラ:精飲フラグ
			;なんとか飲み込む
				;IF RCVAR:対象キャラ:被射精絶頂の強度
					;射精による快楽で絶頂した時
					;KSTR:(K++) = 
				;ELSE
					SELECTCASE RAND:3
						CASE 0
							KSTR:(K++) = 「음읍… 꿀꺽… 크하아… 하아…」
							KSTR:(K++) = 「모, 목에 들러붙어서 따끔거리는구나…」
						CASE 1
							KSTR:(K++) = 「게홋… 어째서 이런 것을… 쓰고 비린 데다 삼키기 어려워…」
							KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 계속 목을 신경 쓰고 있다….
						CASEELSE
							KSTR:(K++) = 「우웨엑… 하, 하라는 대로 마셔줬다」
							KSTR:(K++) = 「…물을 주지 않겠나? 목이 역겨워…」
					ENDSELECT
				;ENDIF
			ELSEIF ABL:対象キャラ:技巧 > 2
			;ティッシュに吐き出す
				KSTR:(K++) = 「웁…! …우웩, 우웨엑…!」
				KSTR:(K++) = 「하아, 핫… 이, 이런 비린 것을, 마실 수 있겠나…!」
			ELSE
			;吐き出してむせる
				KSTR:(K++) = 「웁…! 컥, 콜록콜록!」
				KSTR:(K++) = 「하아, 핫… 이, 이런 비린 것을, 마실 수 있겠나…!」
			ENDIF
		CASE 3
			;乳内
			IF RCVAR:対象キャラ:被射精絶頂の強度
				;射精による快楽で絶頂した時
				SELECTCASE RAND:3
					CASE 0
						KSTR:(K++) = 「크으읏_H_으윽, 크하아…읏_H_」
						KSTR:(K++) = （정액 냄새와 쾌락으로… 뇌가 저려!_H_）
					CASE 1
						KSTR:(K++) = 「아으읏_H_ 읏, 으윽… 크아…_H_」
						KSTR:(K++) = 「%CSTR:二人称%의 것의 맥동과, %CSTR:対象キャラ:一人称%의 고동이 겹쳐져서… 무심코 정신을 잃어버렸구나…_H_」
					CASEELSE
						KSTR:(K++) = 「응으읏_H_ 핫, 하앗…_H_」
