						KSTR:(K++) = %CALLNAME:対象キャラ%는 끈적하게 들러붙은 정액을, 그 거유를 흔들며 끈적끈적 소리를 내며 만지고 있다….
				ENDSELECT
			ENDIF
		CASE 5
			;顔
			SELECTCASE RAND:3
				CASE 0
					KSTR:(K++) = 「하아아… 얼굴이, 뜨거워…」
				CASE 1
