
@固有アビ_26_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 効果数値
#DIM 効果成功率
#DIMS アビ名



;最終前調整仕様



IF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
	アビ名 = ナノアナライズ+
	消費ＭＰ = 40
	効果数値 = 25 + 20
	効果成功率 = 100
ELSE
	アビ名 = ナノアナライズ
	消費ＭＰ = 25
	効果数値 = 25 + 15
	効果成功率 = 100
ENDIF



SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 소비 MP：{消費ＭＰ}
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
			詳細文文字列受け渡し変数 += @"<br>적 하나에게 [{効果数値}％] (B칸・5턴)의 방어력 감소 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>[20％] (B칸・5턴)의 공격력 감소 효과를 부여한다."
		ELSE
			詳細文文字列受け渡し変数 += @"<br>적 하나에게 [{効果数値}％] (B칸・5턴)의 방어력 감소 효과를 부여한다."
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ対象選択テンプレート_敵単体
		アビ汎用変数:効果割合 = 効果数値
		アビ汎用文字列:バフ・デバフ枠 = 防御力B
		アビ汎用文字列:バフ・デバフ対象能力 = 防御力
		アビ汎用変数:持続ターン = 5
		アビ汎用変数:基礎成功確率 = 100
		CALL アビテンプレート_不利効果_デバフ効果セット
		
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果割合 = 20
			アビ汎用変数:持続ターン = 5
			アビ汎用変数:基礎成功確率 = 100
			アビ汎用文字列:バフ・デバフ枠 = 攻撃力B
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			CALL アビテンプレート_不利効果_デバフ効果セット
		ENDIF
ENDSELECT
RETURN RESULT


@固有アビ_26_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 効果数値
#DIM 効果成功率
#DIMS アビ名



;最終仕様


IF 基礎BATTLE_STATE:キャラ番号:Lv >= 27
	アビ名 = エクリプス+
	消費ＭＰ = 50
	効果数値 = 333
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 3
	アビ名 = エクリプス
	消費ＭＰ = 50
	効果数値 = 100
ELSE
	アビ名 =
ENDIF



SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 소비 MP：{消費ＭＰ}
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 27
			詳細文文字列受け渡し変数 += @"<br>적 전체에게 [333]의 무속성 피해를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>[200％]의 자속성 피해를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>[1]의 슬로우 효과를 부여한다. 성공률 90％."
		ELSE
			詳細文文字列受け渡し変数 += @"<br>적 전체에게 [100]의 무속성 피해를 부여한다."
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		アビ汎用変数:命中率補正値 = 100
		CALL アビ対象選択テンプレート_敵全体
		アビ汎用変数:効果量 = 効果数値
		CALL アビテンプレート_ダメージ処理_無属性

		
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 27
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果割合 = 200
			CALL アビテンプレート_ダメージ処理_自属性
			
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:基礎成功確率 = 90
			アビ汎用変数:効果量 = 1
			CALL アビテンプレート_不利効果_スロウ
		ENDIF

ENDSELECT
RETURN RESULT




@固有アビ_26_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 効果数値
#DIM 効果成功率
#DIMS アビ名



;とりあえず原作通り固定値

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 25
	アビ名 = アトミック・レゾリューション+
	消費ＭＰ = 50
	効果数値 = 1200
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
	アビ名 = アトミック・レゾリューション
	消費ＭＰ = 50
	効果数値 = 700
ELSE
	アビ名 =
ENDIF



SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		詳細文文字列受け渡し変数 = 소비 MP：{消費ＭＰ}
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 25
			詳細文文字列受け渡し変数 += @"<br>적 하나에게 [1200]의 무속성 피해를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>［1］의 버프 제거를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>［1］(일반 칸・6턴)의 최대 CT 증가 효과를 부여한다."
		ELSE
			詳細文文字列受け渡し変数 += @"<br>적 하나에게 ［700］의 무속성 대미지를 준다."
			詳細文文字列受け渡し変数 += @"<br>［1］의 버프 제거를 부여한다."
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		アビ汎用変数:命中率補正値 = 100
		CALL アビ対象選択テンプレート_敵単体
		アビ汎用変数:効果量 = 効果数値
		CALL アビテンプレート_ダメージ処理_自属性
		CALL アビテンプレート_不利効果_バフ消去()
		
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 25
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:基礎成功確率 = 100
			アビ汎用文字列:バフ・デバフ枠 = 最大ＣＴ増加
			アビ汎用文字列:バフ・デバフ対象能力 = 最大ＣＴ増加
			アビ汎用変数:持続ターン = 6
			アビ汎用変数:効果量 = 1
			CALL アビテンプレート_不利効果_デバフ効果セット
		ENDIF

ENDSELECT
RETURN RESULT









