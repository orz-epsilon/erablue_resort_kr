;--------------------------------------------------
;ダンジョン探索中に条件を満たしていた時表示される文章
;--------------------------------------------------
;・使い方
;「XXXX」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;--------------------------------------------------

;--------------------------------------------------
;「仲間と会話」ボタン押下時
;簡単に何度も見られるので、条件分岐やランダム化で複数パターンの登録を推奨
;--------------------------------------------------
@KOJO_DUNGEON_仲間と会話_26(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)


IF PLAYER == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		SELECTCASE RAND:6
		CASE 0
			WSTR:(K++) = 「%CALLNAME:MASTER%은(는) 연금술 같은 거에 관심 있어?」
		CASE 1
			WSTR:(K++) = 「%CALLNAME:MASTER%의 본가는 어떤 느낌이야?」
		CASE 2
			WSTR:(K++) = 「리조트 경영은 어떤 느낌이야? 힘들어?」
		CASE 3
			WSTR:(K++) = 「내 옷 귀엽지☆ 더 칭찬해 줘도 돼!」
		CASE 4
			WSTR:(K++) = 「땅 고르기는 특기야! 연금술은 편리하지☆」
		CASE 5
			WSTR:(K++) = 「좋았어☆ 오늘도 기분 좋게 가자!」
		ENDSELECT
	ELSE
		SELECTCASE RAND:6
		CASE 0
			WSTR:(K++) = 「저 장애물 말이야! 흔적도 없이 날려버려도 돼?」
		CASE 1
			WSTR:(K++) = 「오늘도 클라리스 짱 최고 귀여워☆ 미소녀 연금술사☆ 예이!☆」
		CASE 2
			WSTR:(K++) = 「난 섬세한 작업 같은 건 무리야! 그러니까 화려하게 할게☆」
		CASE 3
			WSTR:(K++) = 「걷기 힘들 때 같은 거 말이야! 주변 일대를 날려버리고 싶어지지! 쾅 하고 말이야☆」
		CASE 4
			WSTR:(K++) = 「%CALLNAME:MASTER% 기분 좀 다운됐어? 좀 더 기운 내자☆」
		CASE 5
			WSTR:(K++) = 「예이예이! 나는 미소녀~ 흥흥흥흥!」
		ENDSELECT
	ENDIF
ENDIF
CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0)




;--------------------------------------------------
;戦闘中特定タイミングで表示される文章
;--------------------------------------------------
;固有スキル発動時
;「（キャラ名）の（アビ名）！」よりも前に表示される
;汎用アビや衣装アビだと発動しないので注意
;--------------------------------------------------
@KOJO_DUNGEON_固有アビ発動時_26_1(対象キャラ, 使用アビ名)
#DIMS 使用アビ名
#DIM 対象キャラ

;YYYYを固有アビ関数の「@固有アビ_26_YYYY」のYYYYと同じに変更する
;使用したアビリティの名前は「使用アビ名」に入ってくる
CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)



IF 基礎BATTLE_STATE:対象キャラ:Lv < 20
	LOCAL:1 = RAND:6 + 1
	IF LOCAL:1 <= 3
		KSTR:(K++) = 「이런 느낌?」
	ELSEIF LOCAL:1 == 4
		KSTR:(K++) = 「약하게 만들 거야☆」
	ELSEIF LOCAL:1 == 5
		KSTR:(K++) = 「해버릴 거야!」
	ELSEIF LOCAL:1 == 6
		KSTR:(K++) = 「자, 간다!」
	ENDIF
ELSE
	LOCAL:1 = RAND:6 + 1
	IF LOCAL:1 <= 3
		KSTR:(K++) = 「내 힘을 보여줄게!!」
	ELSEIF LOCAL:1 == 4
		KSTR:(K++) = 「부드럽게 해줄게☆」
	ELSEIF LOCAL:1 == 5
		KSTR:(K++) = 「해치워버릴 거야!」
	ELSEIF LOCAL:1 == 6
		KSTR:(K++) = 「자, 간다!」
	ENDIF

ENDIF

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ)



