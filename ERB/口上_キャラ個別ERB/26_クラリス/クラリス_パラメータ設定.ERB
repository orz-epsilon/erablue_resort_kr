;--------------------------------------------------
;汎用喘ぎ使用時設定
;--------------------------------------------------
@汎用喘ぎ時使用時設定_26(対象キャラ, 相手=-1, 自称単語, 他称単語)
#DIM 対象キャラ
#DIM 相手
#DIMS REF 自称単語
#DIMS REF 他称単語

自称単語 '= CSTR:対象キャラ:一人称

IF INRANGE(相手, 0, CHARANUM-1)
	他称単語 '= CALLNAME:相手
	;相手キャラに応じて呼び方を変えたい場合、ここで変化させること。下記は一例
	IF 相手 == キャラ検索("[開闢の錬金術師]カリオストロ")
		他称単語 = ししょー
	ELSEIF 相手 == キャラ検索("[相承の錬金術師]プロメティア")
		他称単語 = お母様
	ENDIF
ELSE
	他称単語 '= CSTR:対象キャラ:二人称
ENDIF

RETURN 1
