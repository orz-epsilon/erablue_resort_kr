;--------------------------------------------------
;COM20_キス
;--------------------------------------------------
;セクハラコマンドの方のキスを削除してこちらに合流
;「TFLAG:調教モード」で判別可能。  1:セクハラ時  2:セックス中

@KOJO_COM_29_20(対象キャラ)
#DIM 対象キャラ
#DIM 対象キャラ１
#DIM 対象キャラ２
;取得快楽：Ｓ
;ランダム弱点コマンドの候補
CALL 口上変数初期化


IF PLAYER == MASTER
	;相手があなたの時
	IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-20-") < 0
		IF TCVAR:対象キャラ:言いなり && 陥落チェック_性的(GETCHARA(29)) == 0
		;未陥落かつ言いなり
			KSTR:(K++) = BUTTON_[억지로 빼앗는다]
			KSTR:(K++) = BUTTON_[스스로 바치라고 명령한다]
			KSTR:(K++) = INPUTS
			CALL 口上変数表示(対象キャラ, 0)
			CALL 口上変数初期化
			IF RESULTS == "[억지로 빼앗는다]"
				KSTR:(K++) = 「읏! 아, 그, 그만두세, 읏!? 음읍! 으으으으읏!!」
				KSTR:(K++) = 　
				NSTR:(K++) = %CALLNAME:PLAYER%은(는), 끌어안은 팔 안에서 벗어나려 발버둥 치는 비라를 붙잡고, 강제로
				IF 初体験済みチェック("ファーストキス", 対象キャラ)
				;ファーストキスでない場合。他の場所に捧げてる場合もそうだけど、キャラ間恋慕の夜這いとかでオーナー以外としてる場合を想定しておいとく
					WSTR:(K++) = 입술을 빼앗았다……
				ELSE
					WSTR:(K++) = 첫 키스를 빼앗았다……
				ENDIF
				KSTR:(K++) = 　
				KSTR:(K++) = ────비라의 달콤하고 부드러운 입술을, 빨고, 핥고, 모조리 탐하여 만끽한%CALLNAME:PLAYER%이(가) 입술을 떼자,
				WSTR:(K++) = 눈가에서 눈물을 흘리며 비라는 입술을 닦고, %CALLNAME:PLAYER%를 노려보았다.
				KSTR:(K++) = 　
				WSTR:(K++) = 「읏, 감히……감히 저의 입술을……읏!! 절대로……절대로 용서하지 않을 테니까요, 읏!!!」
				KSTR:(K++) = 　
				NSTR:(K++) = ……하지만, 아무리 입으로 짖어대도, 비라는 오늘 밤 하룻밤 %CALLNAME:PLAYER%의
				NSTR:(K++) = COLOR_{カラーパレット("えっちな色")}_뜻대로
				KSTR:(K++) = 될 것을 승낙한 것이다.
				WSTR:(K++) = 모든 것은 합의 하에. 아무리 말로 저항을 표시한다 한들, %CALLNAME:PLAYER%에게는 망설일 필요조차 조금도 없다.
				KSTR:(K++) = 　
				WSTR:(K++) = 무력으로는 한참 미치지 못할 강자를 굴복시키고 지배하는 전능감에 취해, 뇌가 저릴 정도의 희열에 잠기며, %CALLNAME:PLAYER%은(는) 다시 비라의 입술을 빼앗았다……
				KSTR:(K++) = 　
				KSTR:(K++) = 「읏……읍!! 으읍, 으읍～～～～～～읍!!! ……────」
				CALL 履歴データベース登録(CFLAG:対象キャラ:人物番号, @"<font color='#%カラーパレット_HTML("赤ピンク")%'>%CALLNAME:寝取らせ_主導キャラ%のものだったはずの唇は%CALLNAME:PLAYER%に差し出され、無残にも奪われてしまった……</font><img src='えっちハート'>","うふふ")
			ELSEIF RESULTS == "[스스로 바치라고 명령한다]"
				KSTR:(K++) = 「읏……!! 그, 런……!」
				KSTR:(K++) = 　
				KSTR:(K++) = ────이왕 이렇게 된 거. 비라에게 스스로 키스를 바치게 하자.
				KSTR:(K++) = 번뜩이는 생각을 %CALLNAME:PLAYER%이(가) 그대로 입 밖에 내자, 비라는 절망을 여실히 표정에 띄우며 말을 잇지 못했다.
				KSTR:(K++) = 　
				IF キャラ一致チェック(寝取らせ_主導キャラ, "[蒼天の守護騎士]カタリナ・アリゼ")
				;カタリナによって差し出されている場合
					KSTR:(K++) = 「……으, 싫어! 싫어요, 언니!! 제발, 읏!! 제발, 그것만은……읏!!」
					KSTR:(K++) = 　
					KSTR:(K++) = 싫다고 고개를 저으며 비라는 떨리는 목소리로, 매달리듯 카타리나의 이름을 부르지만, 비라를 내어준 장본인은 눈앞에서 벌어지려는 비도를 막으려 하지 않는다.
					WSTR:(K++) = 그것은 즉, 「그것이야말로 카타리나의 바람이다」라는 것의, 다름 아닌 증명이었다……
					KSTR:(K++) = 　
					WSTR:(K++) = 「……………………」
					KSTR:(K++) = 　
					WSTR:(K++) = 「…………알겠습니다. 그것이 언니의, 바람이라면……」
					KSTR:(K++) = 　
					WSTR:(K++) = 길고 긴 침묵 끝에, 자비 따위 얻을 수 없음을 이해한 비라는 천천히 %CALLNAME:PLAYER%에게 몸을 돌려, 한 줄기 눈물과 함께 %CALLNAME:PLAYER%에게 입을 맞췄다……
					KSTR:(K++) = 
					KSTR:(K++) = 「……응, 읏…………하…………」
				ELSE
					WSTR:(K++) = 「……으, 싫어! 싫어요!! 제발, 읏!! 제발, 그것만은……읏!!」
					KSTR:(K++) = 　
					WSTR:(K++) = 싫다고 고개를 저으며 비라는, 떨리는 목소리로 %CALLNAME:PLAYER%에게, 그리고 방구석에서 이 광경을 보며 자위에 빠져있는 %CALLNAME:寝取らせ_主導キャラ%에게 매달린다.
					KSTR:(K++) = 　
					WSTR:(K++) = 「다른 일이라면, 뭐든지! 뭐든지 해 드릴 테니까……!! 그러니 제발, 키스만은, %CALLNAME:寝取らせ_主導キャラ%에게……읏! 키스, 만은……읏」
KSTR:(K++) = 　
KSTR:(K++) = 분명 비라는, %CALLNAME:PLAYER%에게 입술을 '빼앗기는' 것까지는 각오하고 왔을 것이다. 하지만 '스스로 바치는' 것까지는 각오하지 못했던 것 같다.
WSTR:(K++) = 알비온 영주의 의연한 품위는 어디로 갔는지. 눈앞에서 그저 당황하며 필사적으로 목숨을 구걸하는 나약한 소녀의 모습에, 압도적인 우월감이 %CALLNAME:PLAYER%의 뇌수를 마비시킨다……
KSTR:(K++) = 　
