			NSTR:(K++) = 「%TEXTR("읏, 안 돼요, 안 돼요! 안 돼! 안 돼/읏, 안 돼요, 안 돼요! 지금 넣으면, 가버려/아아……싫어, 읏! 그건, 읏! 그것만은, 참을 수 없어요/읏, 싫어! 더 이상 저에게서, 빼앗지 마세요")%
			KSTR:(K++) = ……읏, %TEXTR("으읍/하아읍/응읍/아읍")%읏_H_ %TEXTR("하아, 아/으읍/아읏/흐, 깊숙이/으읍, 안쪽")%……_H__H_」
			KSTR:(K++) = 　
