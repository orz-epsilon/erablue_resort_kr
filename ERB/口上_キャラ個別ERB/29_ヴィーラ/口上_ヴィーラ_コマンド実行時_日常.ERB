			ELSEIF ABL:対象キャラ:(TCVAR:対象キャラ:野外オナニー_部位) > 2
				KSTR:(K++) = 
			ELSE
				KSTR:(K++) = 
			ENDIF
		ENDIF
	CASE 4
		;温泉施設の覗き用場所で
		SELECTCASE CFLAG:対象キャラ:現在位置
			CASE 702, 802
				; 服を脱いでいる様子が見える…
				KSTR:(K++) = 
			CASE 703, 803
				; 石鹸で体を洗っている様子が見える…
				KSTR:(K++) = 
			CASE 704, 804
				; 裸で湯船に浸かっている様子が見える…
				KSTR:(K++) = 
