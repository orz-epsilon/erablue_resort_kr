	;画像の表情に齟齬が発生するので、陥落前は画像なし。こっちは嫌そうだったり呆れたりしてる顔のイメージ
		IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-20-") < 0
			WSTR:(K++) = 「……하아? 저에게 발로 해달라고요? 남성기를? 그 변태 같은 취향은 대체 뭔가요……」
			KSTR:(K++) = 　
		ENDIF
		KSTR:(K++) = 「하아……%TEXTR("정말/정말이지")%%TEXTR("더럽네요……/역겹네요……")%」
		KSTR:(K++) = 　
		SELECTCASE RAND:2
		CASE 0
			KSTR:(K++) = 「……읏, 발바닥이 끈적끈적%TEXTR("하는데요……。/해서 불쾌한데요……。/해서 불쾌해요!")% 본인이 낸 것이니, 본인이 핥아서 깨끗하게 해주시겠어요?」
		CASE 1
			KSTR:(K++) = 「%TEXTR("이걸로 왜 거친 숨을 쉬고 있는지, 의미를 모르겠네요/차라리 이대로 밟아 뭉개버릴까요/이건 이제, 밟아 뭉개버려도 좋다는 뜻일까요")%……」
		ENDSELECT
	ENDIF
ENDIF

