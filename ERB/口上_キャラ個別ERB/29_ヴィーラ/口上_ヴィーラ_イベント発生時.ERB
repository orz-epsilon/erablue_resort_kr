;--------------------------------------------------
;処女喪失時
;--------------------------------------------------
@KOJO_EVENT_処女喪失_29(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
IF TALENT:対象キャラ:恋慕
	KSTR:(K++) = 「아, 아아……_H_ 후후, 이걸로 저, %CALLNAME:PLAYER%의 것이 되어버렸네요……_H_」
ELSEIF TCVAR:対象キャラ:言いなり && 陥落チェック_性的(GETCHARA(29)) == 0
	KSTR:(K++) = %CALLNAME:寝取らせ_主導キャラ%에게 바칠 예정이었던 순결을 %CALLNAME:PLAYER%에게 바친 비라는, 눈가에서 한 줄기, 실의의 눈물을 흘렸다……
	KSTR:(K++) = 　
	IF キャラ一致チェック(寝取らせ_主導キャラ, "[蒼天の守護騎士]カタリナ・アリゼ")
		KSTR:(K++) = 「……이것을, 원하셨던 거죠……언니, 님……」
	ELSE
		KSTR:(K++) = 「으으……어째서인가요……%CALLNAME:寝取らせ_主導キャラ%……」
	ENDIF
ELSE
	KSTR:(K++) = (────아아……언니, 님……)
ENDIF

CALL 口上変数表示(対象キャラ, 0)



