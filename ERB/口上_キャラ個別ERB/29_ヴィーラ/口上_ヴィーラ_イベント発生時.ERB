;--------------------------------------------------
;挨拶時
;　一日に一回、初めて顔を合わせたときに表示。マスターが隠密状態のときは発生しない
;--------------------------------------------------
@KOJO_EVENT_挨拶_29(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化

;挨拶の時間・内容は地の文では言及されないので適宜変更してもOK
SELECTCASE TIME
	;朝　5時～11時
	CASE 5*60 TO 11*60
		LOCALS = 안녕하세요
		KSTR:(K++) = 「어머, 안녕하세요」
	;昼　11時～18時
	CASE 11*60 TO 18*60
		LOCALS = 안녕하세요
		KSTR:(K++) = 「어머, 평안하신가요」
	;夜　それ以外
	CASEELSE
		LOCALS = 안녕하세요
		KSTR:(K++) = 「어머, 안녕하세요」
		IF TALENT:対象キャラ:恋慕
			SELECTCASE RAND:4
			CASE 0
				KSTR:(K++) = 　
				KSTR:(K++) = 「결국 오늘은 이 시간까지 만나지 못했네요. %TEXTR("……이래 봬도 외로웠다고요?/……어머, 안 되나요? 제가 외로워하면")%」
			CASEELSE
				WSTR:(K++) = 「오늘은 만나지 못한 채 하루가 끝나버리는 줄 알았는데……후후, 이렇게 제대로 만났네요……_H_」
				KSTR:(K++) = 　
				IF RAND:2 == 0
					KSTR:(K++) = 「…………그 의외라는 듯한 표정은 뭔가요. 이래 봬도 제대로 좋아할 생각이라고요? %CALLNAME:PLAYER%을(를)요」
				ELSE
					KSTR:(K++) = 「당신의 여자를 이렇게나 외롭게 했으니. ……이 다음은 '보상'을 기대해도 될까요?_H_」
				ENDIF
			ENDSELECT
		ENDIF
ENDSELECT



CALL 口上変数表示(対象キャラ, 0)

