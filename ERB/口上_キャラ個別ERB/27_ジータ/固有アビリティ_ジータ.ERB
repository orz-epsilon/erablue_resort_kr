
@固有アビ_27_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 攻撃バフ値
#DIMS アビ名

	;レイジ
	;味方攻撃UP、++で命中UP
	IF 基礎BATTLE_STATE:キャラ番号:Lv >= 22
		アビ名 = レイジ＋＋
		消費ＭＰ = 40
		攻撃バフ値 = 50
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 12
		アビ名 = レイジ＋
		消費ＭＰ = 30
		攻撃バフ値 = 35
	ELSE
		アビ名 = レイジ
		消費ＭＰ = 20
		攻撃バフ値 = 20
	ENDIF


	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>아군 전체에게［{攻撃バフ値}％］（A 프레임・3턴）의 공격력 상승 효과를 부여한다.
			RETURN 消費ＭＰ
			
		CASE "アビ効果"
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果割合 = 攻撃バフ値
			アビ汎用文字列:バフ・デバフ枠 = 攻撃力A
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
	ENDSELECT


@固有アビ_27_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 威力
#DIMS アビ名

	;レギンレイヴ
	;敵単攻撃、防御減
	IF 基礎BATTLE_STATE:キャラ番号:Lv >= 20
		アビ名 = レギンレイヴ＋＋
		消費ＭＰ = 50
		威力 = 300
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 13
		アビ名 = レギンレイヴ＋
		消費ＭＰ = 40
		威力 = 250
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 5
		アビ名 = レギンレイヴ
		消費ＭＰ = 30
		威力 = 200
	ELSE
		アビ名 = 
	ENDIF

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>적 단일 대상에게［{威力}％］의 자속성 대미지를 준다.
			詳細文文字列受け渡し変数 += "<br>［15％］（B 프레임・3턴）의 방어력 감소 효과를 부여한다."
			RETURN 消費ＭＰ
			
		CASE "アビ効果"
			;ダメージ
			CALL アビ対象選択テンプレート_敵単体
			アビ汎用変数:効果割合 = 威力
			CALL アビテンプレート_ダメージ処理_自属性
			;防御減
			アビ汎用変数:効果割合 = 15
			アビ汎用文字列:バフ・デバフ枠 = 防御力B
			アビ汎用文字列:バフ・デバフ対象能力 = 防御力
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_不利効果_デバフ効果セット
	ENDSELECT


