
@固有奥義_27(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIMS 奥義名

		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 36
			IF 陥落チェック(キャラ番号)
				奥義名 = レギンレイヴ・極
				奥義威力 = 600
			ELSE
				奥義名 = テンペストブレード＋＋
				奥義威力 = 600
				ENDIF
			ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 24
				奥義名 = テンペストブレード＋
				奥義威力 = 550
			ELSE
				奥義名 = テンペストブレード
				奥義威力 = 500
			ENDIF

		;奥義威力を0にした場合、通常の奥義処理は行われず奥義追加効果のみが行われる。
		;全体攻撃にしたい時や、攻撃しない奥義を作る場合は0に設定のこと
		IF 奥義名 == "レギンレイヴ・極"
アビ汎用文字列:実行時メッセージ１ = 지금, 『끝』의 힘을 해방한다……!!
		ELSE
			アビ汎用文字列:実行時メッセージ１ = 폭풍처럼, 수많은 참격이 날아갔다!
		ENDIF

		SELECTCASE ARGS
			CASE "奥義名"
				TSTR:コマンド名受渡 = %奥義名%
			CASE "奥義説明文"
				詳細文文字列受け渡し変数 = <br>적 단일 대상에게 ［{奥義威力}％］의 자속성 대미지를 준다.
				詳細文文字列受け渡し変数 += "<br>추가로 3턴 동안, 아군 전체에게 30％의 명중률 UP과 TA 확률 UP을 부여한다."
				RETURN 奥義威力
			CASE "奥義追加効果"
			;命中バフ
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果割合 = 30
			アビ汎用文字列:バフ・デバフ枠 = 命中率A
			アビ汎用文字列:バフ・デバフ対象能力 = 命中率
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
			;TAバフ
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果割合 = 30
			アビ汎用文字列:バフ・デバフ枠 = TA率A
			アビ汎用文字列:バフ・デバフ対象能力 = TA率
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		;ENDIF
		ENDSELECT
