;--------------------------------------------------
;キャラの絶頂後、あなたの射精への反応など
;--------------------------------------------------
;・使い方
;「27」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;--------------------------------------------------

;--------------------------------------------------
;通常絶頂時
;--------------------------------------------------
@KOJO_ORGASM_通常絶頂_27(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;NOWEX:対象キャラ:Ｃ絶頂、NOWEX:対象キャラ:Ｖ絶頂、NOWEX:対象キャラ:Ａ絶頂、NOWEX:対象キャラ:Ｂ絶頂、NOWEX:対象キャラ:Ｓ絶頂
	;それぞれの絶頂強度が入っている
	;1:絶頂(10000超え)  2:強絶頂(20000超え)  3:超強絶頂(30000超え)  4:最強絶頂(40000超え)  5:究極絶頂(50000超え)
	;この強度の名前ダサいから変えたい……

CALL 口上変数初期化

相手キャラ番号 = 絶頂相手算出(対象キャラ)

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	;多部位同時絶頂判定
	LOCAL:1 = 0
	FOR LOCAL, 0, 5
		SIF NOWEX:対象キャラ:LOCAL
			LOCAL:1 += 1
	NEXT
	SELECTCASE LOCAL:1
		CASE 2
			;2部位同時絶頂
KSTR:(K++) = 「이히_H_와……나는 읏……_H_가지 않았어!!」
KSTR:(K++) = (이런 거…안 되는데_H_기분 좋아아……_H_)
KSTR:(K++) = 지기 싫어하는 %CALLNAME:対象キャラ%은(는) 거듭되는 절정에 형식적인 저항을 보이고 있다……
		CASE 3
			;3部位同時絶頂
KSTR:(K++) = 「오오…후……흐_H_안 져_H_………!! 나……햐_H_……단장이니까아………」
KSTR:(K++) = (이……이런 짓 하는 거 모두에게 들키면………나………_H_)
KSTR:(K++) = %CALLNAME:対象キャラ%은(는) %CALLNAME:MASTER%의 기교로 추하게 분수처럼 뿜어내며 계속 절정에 이르고 있다는 사실을 인정하지 않지만, 개발된 무자각적인 육체는 이미 오래전에 굴복하고 있다………
		CASE 4
			;4部位同時絶頂
KSTR:(K++) = 「그……흐_H_어우……미안해…햐_H_모두의……단장인데……미안……_H_」
KSTR:(K++) = 마음마저 쾌락에 진 음란한 %CALLNAME:対象キャラ%은(는) 헐떡이며 헛소리처럼 동료들을 향해 사죄하고 있다…
		CASE 5
			;全部位同時絶頂、理論上は存在しうる
KSTR:(K++) = 「아아……_H_으……히……그_H_아빠……_H_좋……게 해줄……래_H_…줘……_H_」
KSTR:(K++) = 성장기의 %CALLNAME:対象キャラ%의 심신에게는 과도한 쾌락을 주어버린 듯하다, 제대로 호흡하지 못하고 몽롱한 의식 속에서 환각을 보고 있는 듯하다……
		CASEELSE
			;1部位絶頂
			IF NOWEX:対象キャラ:Ｃ絶頂
KSTR:(K++) = 「햐_H_……크흐……_H_……안 갔어……그치………」
KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 다리를 후들거리면서 강한 척하고 있다……
			ELSEIF NOWEX:対象キャラ:Ｖ絶頂
KSTR:(K++) = 「배가……_H_아흐……괘…괜찮아……히이_H_」
KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 요도에서 세차게 분수처럼 뿜어내며, 질에서의 절정에 몸을 떨고 있다……
			ELSEIF NOWEX:対象キャラ:Ａ絶頂
				KSTR:(K++) = 
			ELSEIF NOWEX:対象キャラ:Ｂ絶頂
				KSTR:(K++) = 
			ELSEIF NOWEX:対象キャラ:Ｓ絶頂
				KSTR:(K++) = 
			ENDIF
	ENDSELECT
ENDIF

;ルリアと同位置ではなく1/5の確率で発生
IF CFLAG:対象キャラ:現在位置 != CFLAG:GETCHARA(28):現在位置 && TALENT:対象キャラ:命のリンク
	SELECTCASE RAND:5
	CASE 0
					KSTR:(K++) = _L_
		IF EXP:GETCHARA(28):絶頂経験 <= 30
KSTR:(K++) = _COLOR_0x4169e1_「힉…_H_」
		KSTR:(K++) = _COLOR_0x4169e1_(%CALLNAME:対象キャラ%……? 기분 탓일까요……)
		KSTR:(K++) = _COLOR_0x4169e1_%CALLNAME:対象キャラ%와 감각이 공유되고 있는 %CALLNAME:GETCHARA(28)%은(는) 사람들 앞에서 갑작스러운 쾌감에 휩싸여 동요하고 있다……
		ELSE
			SELECTCASE RAND:3
			CASE 0
			KSTR:(K++) = _COLOR_0x4169e1_「햐……읏……가랑이가_H_」
			KSTR:(K++) = _COLOR_0x4169e1_(보이지……않겠죠………%CALLNAME:対象キャラ%을(를) 위해……흐읍……목소리를 참아야 해……으으_H_)
			CASE 1
			KSTR:(K++) = _COLOR_0x4169e1_「냐……으읍…%CALLNAME:対象キャラ%아_H_」
			KSTR:(K++) = _COLOR_0x4169e1_하복부를 덮치는 급격한 쾌락에 %CALLNAME:GETCHARA(28)%은(는) 힘없이 바닥에 주저앉아, 애액을 뿜어버렸다……
			KSTR:(K++) = _COLOR_0x4169e1_다리를 아기 사슴처럼 후들거리며, 뚝뚝 넘쳐흐르는 애액을 반쯤 울면서 청소한 뒤 %CALLNAME:GETCHARA(28)%은(는) 그 자리를 떠났다
			CASE 2
			KSTR:(K++) = _COLOR_0x4169e1_「또……인가요…으으…으……_H_」
			KSTR:(K++) = _COLOR_0x4169e1_%CALLNAME:GETCHARA(28)%은(는) 늘 입고 있는 하얀 원피스를 자신의 애액으로 축축하게 적시면서, 쾌락을 참으려 하고 있다……
			KSTR:(K++) = _COLOR_0x4169e1_(%CALLNAME:対象キャラ%……가랑이가…욱신욱신거려…이상해진 걸까……_H_)
			ENDSELECT
		ENDIF
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

;--------------------------------------------------
;調教者の射精時
;--------------------------------------------------
@KOJO_ORGASM_被射精_27(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;RFLAG:フィニッシュ場所
	;どこに出されたか  
;RCVAR:対象キャラ:被射精絶頂の強度
	;１以上だと射精された時にキャラも絶頂
	;現状はフィニッシュ場所が0～3の時しか起こらない
CALL 口上変数初期化

相手キャラ番号 = RFLAG:口上用射精キャラ番号

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	SELECTCASE RFLAG:フィニッシュ場所
		CASE 0
			;膣内
			;現在の体力気力によって分岐
			;(23/10/20追記　気力の削除に応じて条件を変更しました。by開発者きくうし)
			IF RCVAR:対象キャラ:被射精絶頂の強度
				;IF BASE:対象キャラ:気力 <= 300 && BASE:対象キャラ:体力 <= 601
				IF BASE:対象キャラ:体力 <= 201
					KSTR:(K++) = 「아읍…비_H_읍_H_어읍……_H_으읍……_H_」
					KSTR:(K++) = 체력이 다해 기절 직전인 %CALLNAME:対象キャラ%은(는) 신음 소리 같은 이성의 조각도 없는 저속한 교성밖에 내지 못하게 되었다
					KSTR:(K++) = %CALLNAME:MASTER%이 패배를 인정하면 재워주겠다고 제안하자, 겨우 교성 외의 말을 입에 담았다……
					KSTR:(K++) = 「에헤…히_H_패배…했어_H_%CALLNAME:MASTER%님…_H_의 어른 ㅈ…으읍…_H_에게 패배……했어_H_」
					KSTR:(K++) = 만족하지 못한 %CALLNAME:MASTER%은(는) 혀를 늘어뜨리고 더블 피스로 패배를 인정한 %CALLNAME:対象キャラ%에게 덮쳐, 성장기의 자궁을 부숴버릴 기세로 쳐올려 가장 깊숙한 곳에 사정해주었다……
					KSTR:(K++) = (엄마도…………이런 기분이었을까…………에헤……헤_H_)
				ELSEIF BASE:対象キャラ:体力 <= 601
					KSTR:(K++) = 「으…응_H_잇_H__H__H_…미안해애……_H_나히야이_H_가고 있으니까아_H_배를…_찌르지 마아_H_」
					KSTR:(K++) = 사죄하는 %CALLNAME:対象キャラ%의 목을 팔로 조르고, 질식으로 인해 조임이 좋아진 생질에 무책임하게 질내사정했다
					KSTR:(K++) = 「카핫…카훗…히이…으으으~_H_넘쳐흐르고 있어어_H_」
					KSTR:(K++) = （%CALLNAME:MASTER%님에게 잔뜩 씨앗을 심어져 버렸어……머리가 어질어질해……………_H_）
				ELSE
					KSTR:(K++) = 「이히…_H_냐하_H_나는 지지 않아…_H_%CALLNAME:MASTER%님이 훨씬 약하니까………_H_」
					KSTR:(K++) = (으으_H_배가…기분 좋아_H_이런 건…이길 수 없어어_H_)
					KSTR:(K++) = %CALLNAME:対象キャラ%은(는) %CALLNAME:MASTER%의 질내사정으로 다리가 후들거리고 추하게 질 오르가즘을 느꼈음에도 패배를 인정하지 않는 듯하다……
				ENDIF
			ELSE
				;IF BASE:対象キャラ:気力 <= 300
				IF BASE:対象キャラ:体力 <= 201
				KSTR:(K++) = 「흑흑……배…배가…뜨거워…너무 격렬해……흐윽_H_」
				KSTR:(K++) = (어…어른들은……매일 이런 걸 하고 있었구나………_H_)
				;KSTR:(K++) = %CALLNAME:対象キャラ%は%CALLNAME:MASTER%との激しい中出し交尾で気力をすり減らし、怯えている……
				KSTR:(K++) = %CALLNAME:対象キャラ%은(는) %CALLNAME:MASTER%과의 격렬한 질내사정 교미로 체력을 소모하고, 겁에 질려 있다……
				ELSE
				KSTR:(K++) = 「어라아? 내보냈네……_H_혹시 섹…_H_스도…내가 더 강한 걸까아?_H_……」
				KSTR:(K++) = (내가 더 강한 걸……절대 지지 않을 거야_H_)
				KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 신음 소리를 흘리면서, 사정한 %CALLNAME:MASTER%을 도발하고 있다…
				ENDIF
			ENDIF
		CASE 1
			;腸内
			IF RCVAR:対象キャラ:被射精絶頂の強度
				KSTR:(K++) = 「으…후……_H_엉덩이 섹스 기분 좋아? 나…나는 말이야……아_H_그럭저럭일까_H_」
				KSTR:(K++) = (잘 모르겠지만………일방적으로 %CALLNAME:MASTER%님을 사정시키는 거 즐겁네_H_)
			ELSE
				KSTR:(K++) = 「힉…윽…으윽……%CALLNAME:MASTER%……님? 헤에……내 엉덩이에 싸버렸네_H_」
				KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 항문을 괴롭히는 이물감에 얼굴을 찡그리고 있었지만, 가학심이 자극된 것일까? %CALLNAME:MASTER%이 허무하게 장내에 사정한 것을 눈을 가늘게 뜨며 몰아붙였다……
			ENDIF
		CASE 2
			;口
			IF RCVAR:対象キャラ:精飲フラグ
				KSTR:(K++) = 「헤로오_H_」
				KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 천박하게 입을 벌려 %CALLNAME:MASTER%이(가) 낸 정액을 과시하며, 천천히 맛보듯이 삼켰다……
				KSTR:(K++) = 「케푸읏………후훗……대단하지_H_나는 단장이니까 정액도 제대로 마실 수 있거든_H_」
				KSTR:(K++) = 입에 음모를 달라붙인 %CALLNAME:対象キャラ%은(는) 으스대는 얼굴로 말하고 있다……
			ELSE
				KSTR:(K++) = 사정할 것 같은 %CALLNAME:MASTER%은(는) %CALLNAME:対象キャラ%의 머리를 억누르고, 목구멍 깊숙이 백탁을 밀어 넣었다
				KSTR:(K++) = 「웩……콜록……너무해!! 살살 해줘……즈읍…」
				KSTR:(K++) = 눈을 글썽이며, 코에서 정액을 흘리면서 %CALLNAME:対象キャラ%은(는) 항의했다
				ENDIF

		CASE 3
			;乳内
				KSTR:(K++) = 「아~_H_%CALLNAME:MASTER%님 가슴에 사정해버렸네_H_안 돼_H_」
				KSTR:(K++) = 장난스럽게 미소 짓는 %CALLNAME:対象キャラ%은(는) 아직 성장기의 유방으로, 참을 수 없는 액을 흘리는 %CALLNAME:MASTER%의 귀두를 꽉 밀폐시켜 사정하게 했다……

		CASE 5
			;顔
			KSTR:(K++) = 「꺄우……아헤에_H_더럽혀져 버렸어………_H_」
			KSTR:(K++) = 혀를 내밀어 %CALLNAME:MASTER%의 사정을 입으로 받아내려던 %CALLNAME:対象キャラ%은(는), 뜻밖에 얼굴이 더럽혀진 것에 흥분하고 있다
		CASE 6
			;腹
			KSTR:(K++) = 
		CASE 7
			;背中
			KSTR:(K++) = 
		CASE 30
			IF CFLAG:対象キャラ:うふふ
				;うふふ中汎用射精
				SELECTCASE RAND:3
				CASE 0
				KSTR:(K++) = 「헤……?」
				KSTR:(K++) = %CALLNAME:対象キャラ%은(는) %CALLNAME:MASTER%의 요도에서 세차게 방출되는 대량의 백탁에 아연실색하고 있다……
				KSTR:(K++) = (그……그렇게……기분 좋았던 걸까? 모르겠어……_H_)
				CASE 1
				KSTR:(K++) = 「이……이렇게 많이 내보내도 괜찮아? 내……내 탓이야? 미안해……_H_」
				KSTR:(K++) = %CALLNAME:対象キャラ%은(는) %CALLNAME:MASTER%의 정액을 손으로 떠서 뚫어지게 바라보고 있다…
				CASE 2
				KSTR:(K++) = 「으……햐_H_……나 열심히 했어!! 칭찬해 줘!!」
				KSTR:(K++) = %CALLNAME:MASTER%의 욕정을 자극하여 열심히 사정시켜 준 %CALLNAME:対象キャラ%를 안아주고, 머리를 쓰다듬었다
				KSTR:(K++) = (더 칭찬받고 싶어_H_많이 사정시켜야지……_H_)
				ENDSELECT
			ELSE
				;非うふふ時の射精、逆セクハラなど
				KSTR:(K++) = 
			ENDIF
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)
