;特定のキャラをメインにするイベントカテゴリ
;YYYYを任意のイベント名に変えて使うこと、他との重複不可

@イベント発生条件_キャライベント_エンドオブデイドリーム
#DIM キャラ番号取得
#DIM キャラ番号取得１


キャラ番号取得 = GETCHARA(1475)
キャラ番号取得１ = GETCHARA(2726)

SIF 天使のような悪魔の事務員イベフラグ >= 2
	RETURN 1

;開放条件を満たしたら1を返すこと
;IF 王子様 != 1
;ちっひイベ完走済みでない
;ENDIF

RETURN 0

@イベント関数_キャライベント_エンドオブデイドリーム(ARG)
#DIM 上昇量
#DIM キャラ番号取得
#DIM キャラ番号取得１

上昇量 = 0

キャラ番号取得 = GETCHARA(1475)
キャラ番号取得１ = GETCHARA(2726)

;滞在していない場合、いることにする。イベントうふふできないのでね
IF CFLAG:キャラ番号取得:招待不可フラグ
	CFLAG:キャラ番号取得:招待不可フラグ = 0
ENDIF
IF CFLAG:キャラ番号取得１:招待不可フラグ
	CFLAG:キャラ番号取得１:招待不可フラグ = 0
ENDIF
IF CFLAG:キャラ番号取得:滞在期間 < 1
	CFLAG:キャラ番号取得:滞在期間 = 1
	CALL CLOTHES_TODAY(キャラ番号取得)
	CALL CLOTHES_RESET(キャラ番号取得)
ENDIF
IF CFLAG:キャラ番号取得１:滞在期間 < 1
	CFLAG:キャラ番号取得１:滞在期間 = 1
	CALL CLOTHES_TODAY(キャラ番号取得１)
	CALL CLOTHES_RESET(キャラ番号取得)
ENDIF

