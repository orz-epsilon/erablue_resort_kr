;****************************************
;ダンジョン探索中に条件を満たしていた時表示される文章
;****************************************
;・使い方
;「24」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;****************************************

;--------------------------------------------------
;「仲間と会話」ボタン押下時
;--------------------------------------------------
@KOJO_DUNGEON_仲間と会話_24(対象キャラ)
#DIM 対象キャラ

;簡単に何度も見られるので、条件分岐やランダム化で複数パターンの登録を推奨

CALL 口上変数初期化
LOCAL = キャラ隊列検索(対象キャラ)

IF 陥落チェック_性的(対象キャラ)
	SELECTCASE RAND:5
		CASE 0
			KSTR:(K++) = 「%CALLNAME:MASTER%……이, 항상 고마워」
		CASE 1
			KSTR:(K++) = 「알겠어? 나를 제대로 의지하라고?」
			KSTR:(K++) = 「그러면 나도…조금은 너를 의지해 줘도 괜찮으니까…」
		CASE 2
			KSTR:(K++) = 「정말 어쩔 수 없네, 내가 없으면 안 되니까♪」
		CASE 3
			KSTR:(K++) = 「등을 맡길게? 방심하면 용서 안 할 거니까!」
		CASE 4
			KSTR:(K++) = 「아~ 정말 끈질기네! 만지는 건 돌아가서 해_H_」
	ENDSELECT
ELSE
	SELECTCASE RAND:5
		CASE 0
			KSTR:(K++) = 「메두시아나, 잠깐 쉬자」
		CASE 1
			KSTR:(K++) = 「지루하네…어떻게 좀 해봐!」
		CASE 2
			KSTR:(K++) = 「어떤 적이라도 물리쳐 줄 테니까」
		CASE 3
			KSTR:(K++) = 「상대할 만한 적이 있으면 좋겠는데」
		CASE 4
			KSTR:(K++) = 「나한테 전부 맡기라고!」
	ENDSELECT
ENDIF

CALL メッセージ欄表示用関数(@"探索用_{LOCAL}_顔", CALLNAME:対象キャラ,,0)



