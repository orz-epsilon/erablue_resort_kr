;--------------------------------------------------
;キャラの絶頂後、あなたの射精への反応など
;--------------------------------------------------
;・使い方
;「4」をキャラクター番号に置換し、それぞれの関数に処理を入れる
;--------------------------------------------------

;--------------------------------------------------
;調教者の射精時
;--------------------------------------------------
@KOJO_ORGASM_被射精_4(対象キャラ)
#DIM 対象キャラ
#DIM 相手キャラ番号
;RFLAG:フィニッシュ場所
	;どこに出されたか  
;RCVAR:対象キャラ:被射精絶頂の強度
	;１以上だと射精された時にキャラも絶頂
	;現状はフィニッシュ場所が0～3の時しか起こらない
CALL 口上変数初期化

相手キャラ番号 = RFLAG:口上用射精キャラ番号

IF 相手キャラ番号 == MASTER
	;相手があなたの時
	SELECTCASE RFLAG:フィニッシュ場所
		CASE 0
			;膣内
	IF CFLAG:対象キャラ:発情期フラグ < 0
			;発情期フラグで分岐さらに精液経験で分岐
			IF RCVAR:対象キャラ:被射精絶頂の強度
				KSTR:(K++) = 「이힛_H_와후_H_잘했어%CALLNAME:MASTER%_H_이렇게나 많이 받으면 나 임신할지도 몰라_H__H__H_」
				KSTR:(K++) = 발정기의 암캐 자궁에 흠뻑 쏟아진 %CALLNAME:対象キャラ%은(는) 절정하며 허리를 계속 움직이고 있다… 
			ELSE
				KSTR:(K++) = 「욱신거려………더 줘_H_나에게 씨앗을 쏟아줘……하아_H__H__H_」
				KSTR:(K++) = 발정기의 바지라는 헤픈 얼굴로 %CALLNAME:MASTER%의 정자를 조르고 있다…
			ENDIF
	ELSE
		IF EXP:対象キャラ:精液経験 >= 30
			IF RCVAR:対象キャラ:被射精絶頂の強度
				KSTR:(K++) = 「와햐아_H_!! 으으으_H_%CALLNAME:MASTER%……_H_」 
			ELSE
				KSTR:(K++) = 「와하아…뜨겁네_H_더 나올 거지? 부탁해_H_」
			ENDIF
		ELSE
			IF RCVAR:対象キャラ:被射精絶頂の強度
				KSTR:(K++) = 「아후……_H_같이 가버렸네_H_사정하고 있는 게 느껴져_H_」 
			ELSE
				KSTR:(K++) = 「안에서 쿵쾅거리고 있어……씨앗이지?이상한 기분이야…」
			ENDIF
		ENDIF
	ENDIF

		CASE 1
			;腸内
			IF RCVAR:対象キャラ:被射精絶頂の強度
				KSTR:(K++) = 「크흐…이히히…엉덩이가 네 씨앗으로 가득 찼어…」
			ELSE
				KSTR:(K++) = 「아하!! 엉덩이에 싸버렸네~_H_헛된 교미 부끄럽지 않아~?_H_」
			ENDIF
		CASE 2
			;口
			IF RCVAR:対象キャラ:被射精絶頂の強度
				KSTR:(K++) = 
			ELSE
				KSTR:(K++) = 
			ENDIF
		CASE 3
			;乳内
			IF RCVAR:対象キャラ:被射精絶頂の強度
				KSTR:(K++) = 
			ELSE
				KSTR:(K++) = 
			ENDIF
		CASE 5
			;顔
			KSTR:(K++) = 「우뱌!! 쌀 거면 싼다고 말해줘……아깝잖아」
		CASE 6
			;腹
			KSTR:(K++) = 
		CASE 7
			;背中
			KSTR:(K++) = 
		CASE 30
			IF CFLAG:対象キャラ:うふふ
				;うふふ中汎用射精
				IF EXP:対象キャラ:精液経験 >= 15
					SELECTCASE RAND:3
					CASE 0
					KSTR:(K++) = 「헛된 정자 싸버렸네_H_불쌍해~_H_」
					KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 입가를 손으로 가리고 미소를 짓고 있다……
					CASE 1
					KSTR:(K++) = 「우헤에…너무 많이 쌌잖아_H_」
					KSTR:(K++) = (교미할 때 이렇게나 많이 받으면 임신할지도 모르겠네……_H_)
					CASE 2
KSTR:(K++) = 「킁킁………냄새나네~_H_이렇게나 내보내고……더럽잖아_H_」
KSTR:(K++) = %CALLNAME:対象キャラ%은(는) %CALLNAME:MASTER%의 씨앗을 만지면서, 악담을 퍼붓고 있다……
					ENDSELECT
				ELSE
KSTR:(K++) = 「우와 재밌네!!멍청한 얼굴이었잖아_H_」
				ENDIF
			ELSE
				;非うふふ時の射精、逆セクハラなど
				KSTR:(K++) = 
			ENDIF
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)
