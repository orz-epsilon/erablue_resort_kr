;COM380_0_5 遊戯室でカードで遊ぶ
;-------------------------------------------------
;RFLAG:コマンド結果受渡し変数
	;賭けをしているか  1:している 2:してない
;RFLAG:コマンド結果受渡し変数３
	;賭けの内容  1:ルピ賭けあなた勝利  -1:ルピ賭けキャラ勝利  2:罰ゲーム賭けあなた勝利  -2:罰ゲーム賭けキャラ勝利  0:賭けていない
;RFLAG:コマンド結果受渡し変数２
	;あなた勝利時の罰ゲーム内容  0:でこぴん  1:お酒を飲む  10:下着の色を言う  11:セクシーポーズで淫語  12:乳首当てゲーム
	;あなた敗北時は罰ゲームはでこぴんで固定（今のところ）

;TEQUIP:対象キャラ:下半身下着あり
	;下着の色罰ゲームに関連  1:下着  2:前張り  3:ふんどし  0:下着なし
;知識素質:対象キャラ:性知識
	;淫語罰ゲームに関連  5以上、4以下、2以下、0以下でそれぞれ分岐
;RFLAG:コマンド結果受渡し変数４
	;乳首当てゲームに関連  1:的中  -1:ハズレ  2:的中したが誤魔化したので指をぐりぐりして認めさせる

@KOJO_COM_4_380_0_5(対象キャラ)
#DIM 対象キャラ
CALL 口上変数初期化
IF RFLAG:コマンド結果受渡し変数
	SELECTCASE RFLAG:コマンド結果受渡し変数３
		CASE 1
			;ルピ賭けあなた勝利
			KSTR:(K++) = 「져버렸어!! 다음엔 이길 거야!!」
		CASE -1
			;ルピ賭けキャラ勝利
			KSTR:(K++) = 「후후훗. 하늘은 나를 편들었어!!」
		CASE 2
			;罰ゲーム賭けあなた勝利
			SELECTCASE RFLAG:コマンド結果受渡し変数２
				CASE 0
					;でこぴん
					KSTR:(K++) = 「아파ー!! 살살 해줘도 괜찮잖아 너어……」
				CASE 1
					;お酒を飲む、TCVAR:対象キャラ:初飲酒フラグ = 1の時、キャラが初めて飲酒した
					IF TCVAR:対象キャラ:初飲酒フラグ
						KSTR:(K++) = 「우와 맛있잖아! 이게 벌칙 게임으로 괜찮은 거야?」
					ELSE
						KSTR:(K++) = 「맛있어_H_…다음엔 꼭 이길 거야!!」
					ENDIF
				CASE 10
					;下着の色を言う
					KSTR:(K++) = 「음~…… 정말로 물어보는구나 너…」
					KSTR:(K++) = 「안 입었어!! 아쉽게 됐네~_H_」
				CASE 11
					;セクシーポーズで淫語
					KSTR:(K++) = 「글쎄……」
					KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 매우 짧은, 은밀한 부위를 가리는 앞치마 형태의 천에 손을 대고,
					KSTR:(K++) = 기세 좋게 %CALLNAME:MASTER% 앞에서 걷어 올렸다!!
					KSTR:(K++) =「아쉽게 됐네~_H_%CALLNAME:MASTER%」
					KSTR:(K++) = %CALLNAME:対象キャラ%의 검은 타이츠 너머로 보일 은밀한 부위는, 꼬리로 가려져 있었다……
				CASE 12
					;乳首当てゲーム
					IF RFLAG:コマンド結果受渡し変数４ == 1
						;的中
						KSTR:(K++) = 「햐아_H_…… 」
						KSTR:(K++) = %CALLNAME:対象キャラ%은(는) 부끄러운 듯 가느다란 목소리로 비명을 질렀다
						KSTR:(K++) = 「크흠… 다음엔, 안 질 거다!!!」
					ELSEIF RFLAG:コマンド結果受渡し変数４ == -1
						;ハズレ
						KSTR:(K++) = 「으으……… 부끄럽지 않거든!! 젖꼭지도 아니고!!」
					ELSEIF RFLAG:コマンド結果受渡し変数４ == 2
						;的中したが誤魔化したので指をぐりぐりして認めさせる
						KSTR:(K++) = 「우아아_H_…… 아쉽게 됐네_H_내 승리다」
						KSTR:(K++) = %CALLNAME:MASTER%은(는) 작고 고집스러운 돌기를 몇 번이고 누르고 마찰시켰다
						KSTR:(K++) = 「저기 미, 미안해 용서해 줘!! 나_H_… 내가 잘못했으니까!!」
						KSTR:(K++) = %CALLNAME:MASTER%은(는) %CALLNAME:対象キャラ%을(를) 반쯤 울 때까지 벌을 주었다.
					ENDIF
			ENDSELECT
		CASE -2
			;罰ゲーム賭けキャラ勝利
			KSTR:(K++) = 
	ENDSELECT
ENDIF

CALL 口上変数表示(対象キャラ, 0)

