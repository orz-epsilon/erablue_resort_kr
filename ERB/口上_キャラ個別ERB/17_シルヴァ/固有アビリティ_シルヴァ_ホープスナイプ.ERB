@固有アビ_17_4(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 42
	アビ名 = ホープスナイプ＋
	消費ＭＰ = 58
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 26
	アビ名 = ホープスナイプ
	消費ＭＰ = 42
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 38
詳細文文字列受け渡し変数 = 소비ＭＰ：58
詳細文文字列受け渡し変数 += "<br>자신에게 잠복 효과(고유 슬롯・5턴・제거 불가)를 부여한다."
詳細文文字列受け渡し変数 += "<br>자신에게 [10％](고유 슬롯・5턴・제거 불가)의 추격 상승 효과를 부여한다."
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 26
詳細文文字列受け渡し変数 = 소비ＭＰ：42
詳細文文字列受け渡し変数 += "<br>자신에게 잠복 효과(고유 슬롯・3턴・제거 불가)를 부여한다."
詳細文文字列受け渡し変数 += "<br>아군 전체에게 [10％](고유 슬롯・3턴・제거 불가)의 추격 상승 효과를 부여한다."
		ENDIF
	CASE "アビ効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 38
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
アビ汎用文字列:バフ・デバフ枠 = ホープスナイプ
アビ汎用文字列:バフ・デバフ対象能力 = 잠복
			アビ汎用変数:持続ターン = 5
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体
アビ汎用文字列:バフ・デバフ枠 = ホープスナイプ
アビ汎用文字列:バフ・デバフ対象能力 = 추격
			アビ汎用変数:効果割合 = 10
			アビ汎用変数:持続ターン = 5
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 26
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
アビ汎用文字列:バフ・デバフ枠 = ホープスナイプ
アビ汎用文字列:バフ・デバフ対象能力 = 잠복
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体
アビ汎用文字列:バフ・デバフ枠 = ホープスナイプ
アビ汎用文字列:バフ・デバフ対象能力 = 추격
			アビ汎用変数:効果割合 = 10
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
ENDSELECT


 
