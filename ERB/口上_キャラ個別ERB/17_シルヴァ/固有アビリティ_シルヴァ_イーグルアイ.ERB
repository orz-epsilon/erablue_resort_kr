@固有アビ_17_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
	アビ名 = イーグルアイ＋＋
	消費ＭＰ = 70
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 28
	アビ名 = イーグルアイ＋
	消費ＭＰ = 55
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 14
	アビ名 = イーグルアイ
	消費ＭＰ = 25
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			詳細文文字列受け渡し変数 = 소비 MP:70
			詳細文文字列受け渡し変数 += "<br>자신에게［210％］（고유 슬롯・1회・제거 불가）의 대미지 보정_오의 대미지 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += "<br>［50％］（고유 슬롯・1회・제거 불가）의 대미지 보정_체인 버스트 대미지 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += "<br>［999％］（고유 슬롯・1회・제거 불가）의 명중률 상승 효과를 부여한다."
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 28
			詳細文文字列受け渡し変数 = 소비 MP:55
			詳細文文字列受け渡し変数 += "<br>자신에게［200％］（고유 슬롯・1회・제거 불가）의 대미지 보정_오의 대미지 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += "<br>［40％］（고유 슬롯・1회・제거 불가）의 대미지 보정_체인 버스트 대미지 상승 효과를 부여한다."
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 14
			詳細文文字列受け渡し変数 = 소비 MP:25
			詳細文文字列受け渡し変数 += "<br>자신에게［200％］（고유 슬롯・1회・제거 불가）의 대미지 보정_오의 대미지 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += "<br>［30％］（고유 슬롯・1회・제거 불가）의 대미지 보정_체인 버스트 대미지 상승 효과를 부여한다."
		ENDIF
	CASE "アビ効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 45
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = 狙撃
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_奥義ダメージ
			アビ汎用変数:効果割合 = 210
			アビ汎用変数:持続回数 = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 狙撃
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_チェンバダメージ
			アビ汎用変数:効果割合 = 50
			アビ汎用変数:持続回数 = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 狙撃
			アビ汎用文字列:バフ・デバフ対象能力 = 命中率
			アビ汎用変数:効果割合 = 999
			アビ汎用変数:持続回数 = 1
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 28
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = 狙撃
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_奥義ダメージ
			アビ汎用変数:効果割合 = 200
			アビ汎用変数:持続回数 = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 狙撃
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_チェンバダメージ
			アビ汎用変数:効果割合 = 40
			アビ汎用変数:持続回数 = 1
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 14
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用文字列:バフ・デバフ枠 = 狙撃
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_奥義ダメージ
			アビ汎用変数:効果割合 = 200
			アビ汎用変数:持続回数 = 1
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 狙撃
			アビ汎用文字列:バフ・デバフ対象能力 = ダメージ補正_チェンバダメージ
			アビ汎用変数:効果割合 = 30
			アビ汎用変数:持続回数 = 1
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
ENDSELECT


 
