 
@固有アビ_17_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 22
	アビ名 = タクティシャン＋＋
	消費ＭＰ = 31
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
	アビ名 = タクティシャン＋
	消費ＭＰ = 16
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 1
	アビ名 = タクティシャン
	消費ＭＰ = 10
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 22
			詳細文文字列受け渡し変数 = 소비 MP：31
			詳細文文字列受け渡し変数 += "<br>적 단일 대상에게［75］（A 프레임・3턴）의 크리티컬률 감소 효과를 부여한다."
			詳細文文字列受け渡し変数 += "<br>［50％］（A 프레임・3턴）의 명중률 상승 효과를 부여한다."
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
			詳細文文字列受け渡し変数 = 소비 MP：16
			詳細文文字列受け渡し変数 += "<br>아군 단일 대상에게［65］（A 프레임・3턴）의 크리티컬률 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += "<br>［40％］（A 프레임・3턴）의 명중률 상승 효과를 부여한다."
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 1
			詳細文文字列受け渡し変数 = 소비 MP：10
			詳細文文字列受け渡し変数 += "<br>아군 단일 대상에게［55］（A 프레임・3턴）의 크리티컬률 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += "<br>［30％］（A 프레임・3턴）의 명중률 상승 효과를 부여한다."
		ENDIF
	CASE "アビ効果"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 22
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_敵単体
			アビ汎用文字列:バフ・デバフ枠 = クリティカル率A
			アビ汎用文字列:バフ・デバフ対象能力 = クリティカル率
			アビ汎用変数:効果量 = 75
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_不利効果_デバフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 命中率A
			アビ汎用文字列:バフ・デバフ対象能力 = 命中率
			アビ汎用変数:効果割合 = 50
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 10
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方単体
			アビ汎用文字列:バフ・デバフ枠 = クリティカル率A
			アビ汎用文字列:バフ・デバフ対象能力 = クリティカル率
			アビ汎用変数:効果量 = 65
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 명중률A
			アビ汎用文字列:バフ・デバフ対象能力 = 명중률
			アビ汎用変数:効果割合 = 40
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 1
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方単体
			アビ汎用文字列:バフ・デバフ枠 = 치명타율A
			アビ汎用文字列:バフ・デバフ対象能力 = 치명타율
			アビ汎用変数:効果量 = 55
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 명중률A
			アビ汎用文字列:バフ・デバフ対象能力 = 명중률
			アビ汎用変数:効果割合 = 30
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
ENDSELECT


 
