
@固有奥義_28(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 奥義威力
#DIM 奥義実威力
#DIM 攻撃バフ値
#DIM 防御デバフ値
#DIMS 奥義名

	; IF イベント完了フラグ確認("？？？")
	IF 基礎BATTLE_STATE:キャラ番号:Lv >= 35
		奥義名 = 汝の名は、バハムート
		奥義威力 = 0
		奥義実威力 = 600
		攻撃バフ値 = 20
		防御デバフ値 = 15
		
	ELSE
		奥義名 = 始原の竜、闇の炎の子
		奥義威力 = 0
		奥義実威力 = 500
		攻撃バフ値 = 15
	ENDIF

	;奥義威力を0にした場合、通常の奥義処理は行われず奥義追加効果のみが行われる。
	;全体攻撃にしたい時や、攻撃しない奥義を作る場合は0に設定のこと

	アビ汎用文字列:実行時メッセージ１ = 거룡의 포효가 천지를 뒤흔든다……!

		SELECTCASE ARGS
			CASE "奥義名"
				TSTR:コマンド名受渡 = %奥義名%
			CASE "奥義説明文"
				詳細文文字列受け渡し変数 = 오의 위력:{奥義実威力}％<br>자속성 전체 공격.
				詳細文文字列受け渡し変数 += "<br>추가로 3턴 동안, 아군 전체에게{攻撃バフ値}％의 공격력 UP."
			IF 基礎BATTLE_STATE:キャラ番号:Lv >= 35
				詳細文文字列受け渡し変数 += "<br>적 전체에게{防御デバフ値}％의 방어력 DOWN."
			ENDIF
			
			RETURN 奥義威力
		CASE "奥義追加効果"
			;テンプレート使用の例は下部分を参照
				;ダメージ
				アビ汎用文字列:ダメージ種類 = 오의 대미지
				CALL アビ対象選択テンプレート_敵全体_生者のみ
				アビ汎用変数:効果割合 = 奥義実威力
				CALL アビテンプレート_ダメージ処理_自属性
				;味方攻撃バフ
				CALL アビ汎用変数文字列リセット
				CALL アビ対象選択テンプレート_味方全体_生者のみ
				アビ汎用変数:効果割合 = 攻撃バフ値
				アビ汎用文字列:バフ・デバフ枠 = バハ_攻撃
				アビ汎用文字列:バフ・デバフ対象能力 = 공격력
				アビ汎用変数:持続ターン = 3
				CALL アビテンプレート_有利効果_バフ効果セット
			;「汝の名は、バハムート」の場合、敵防御デバフ効果も発生
			IF 奥義名 == "汝の名は、バハムート"
				;敵防御デバフ
				CALL アビ汎用変数文字列リセット
				CALL アビ対象選択テンプレート_敵全体_生者のみ
				アビ汎用変数:効果割合 = 防御デバフ値
				アビ汎用文字列:バフ・デバフ枠 = バハ_防御
				アビ汎用文字列:バフ・デバフ対象能力 = 방어력
				アビ汎用変数:持続ターン = 3
				アビ汎用変数:基礎成功確率 = 100
				CALL アビテンプレート_不利効果_デバフ効果セット
			ENDIF
	ENDSELECT
