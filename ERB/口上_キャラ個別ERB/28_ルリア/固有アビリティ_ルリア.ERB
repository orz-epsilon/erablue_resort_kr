		アビ名 = 猛き炎
		消費ＭＰ = 60
	ELSE
		アビ名 = 
	ENDIF

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
			;アビ汎用文字列:選択時メッセージ１ = 
			;アビ汎用文字列:実行時メッセージ１ = 
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 소비 MP：{消費ＭＰ}<br>아군 전체에게［30％］（고유 프레임・3턴）의 공격력 상승 효과를 부여한다.
