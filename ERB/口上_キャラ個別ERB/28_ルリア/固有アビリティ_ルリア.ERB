			詳細文文字列受け渡し変数 += @"<br>［{クリ率}％］（고유 프레임・3턴）의 크리티컬률 상승 효과를 부여한다."
		ELSEIF アビ名 == "猛き炎＋＋"
			詳細文文字列受け渡し変数 += @"<br>［{クリ率}％］（고유 프레임・3턴）의 크리티컬률 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>［100％］（고유 칸・3턴）의 명중률 상승 효과를 부여한다."
		ENDIF
			RETURN 消費ＭＰ
		CASE "アビ効果"
			;奥義ゲージUP
			CALL アビ対象選択テンプレート_自己のみ
			アビ汎用変数:効果量 = 20
			CALL アビテンプレート_有利効果_奥義ゲージUP
			;攻撃UP
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果割合 = 30
			アビ汎用文字列:バフ・デバフ枠 = 炎_攻撃
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		IF アビ名 == "猛き炎＋"
			;クリティカル率UP
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果量 = クリ率
			アビ汎用文字列:バフ・デバフ枠 = 炎_クリティカル
			アビ汎用文字列:バフ・デバフ対象能力 = クリティカル率
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ELSEIF アビ名 == "猛き炎＋＋"
			;命中UP
			CALL アビ汎用変数文字列リセット
			アビ汎用変数:効果量 = 100
			アビ汎用文字列:バフ・デバフ枠 = 炎_命中
			アビ汎用文字列:バフ・デバフ対象能力 = 命中率
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
	ENDSELECT

@固有アビ_28_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIM 回復値
#DIMS アビ名

	IF 基礎BATTLE_STATE:キャラ番号:Lv >= 22
		アビ名 = 癒しの水＋＋
		消費ＭＰ = 40
		回復値 = 150
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 12
		アビ名 = 癒しの水＋
		消費ＭＰ = 25
		回復値 = 100
	ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 5
		アビ名 = 癒しの水
		消費ＭＰ = 20
		回復値 = 50
	ELSE
		アビ名 = 
	ENDIF

	SELECTCASE ARGS
		CASE "アビ名"
			TSTR:コマンド名受渡 = %アビ名%
			;アビ汎用文字列:選択時メッセージ１ = 
			;アビ汎用文字列:実行時メッセージ１ = 
		CASE "アビ説明文"
			詳細文文字列受け渡し変数 = 소비 MP：{消費ＭＰ}<br>아군 전체에게［회복력✕{回復値}％］의 HP 회복을 부여한다.
		IF アビ名 == "癒しの水＋"
			詳細文文字列受け渡し変数 += @"<br>［1］의 디버프 제거를 부여한다."
		ELSEIF アビ名 == "癒しの水＋＋"
			詳細文文字列受け渡し変数 += @"<br>［1］의 디버프 제거를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>［100］（A 칸・3턴）의 재생 효과를 부여한다."
		ENDIF
			RETURN 消費ＭＰ
		CASE "アビ効果"
			;ゲージUP
			CALL アビ対象選択テンプレート_自己のみ
			CALL アビテンプレート_有利効果_奥義ゲージUP
			アビ汎用変数:効果量 = 20
			;HP回復
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果割合 = 回復値
			CALL アビテンプレート_回復処理_MAXでも回復
		IF アビ名 == "癒しの水＋"
			;バフ消去
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			CALL アビテンプレート_有利効果_デバフ消去()
		ELSEIF アビ名 == "癒しの水＋＋"
			;HP再生
			CALL アビ汎用変数文字列リセット
			CALL アビ対象選択テンプレート_味方全体_生者のみ
			アビ汎用変数:効果量 = 100
			アビ汎用文字列:バフ・デバフ枠 = 再生A
			アビ汎用文字列:バフ・デバフ対象能力 = 再生
			アビ汎用変数:持続ターン = 3
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
	ENDSELECT

