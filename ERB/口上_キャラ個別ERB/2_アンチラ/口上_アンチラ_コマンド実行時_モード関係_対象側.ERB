;--------------------------------------------------
;COM20_キス
;--------------------------------------------------
;セクハラコマンドの方のキスを削除してこちらに合流
;「TFLAG:調教モード」で判別可能。  1:セクハラ時  2:セックス中

@KOJO_COM_2_20(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｓ
;ランダム弱点コマンドの候補
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-20-") < 0
		IF TALENT:対象キャラ:恋慕
			WSTR:(K++) = 「응읏……_H_」
			KSTR:(K++) = 　
			WSTR:(K++) = 「……에헤헤, 뽀뽀, 해버렸네_H_」
			KSTR:(K++) = 　
			IF 初体験方法取得("ファーストキス", 対象キャラ, PLAYER) == "陰茎"
				KSTR:(K++) = 「고추가 먼저였어? 아, 그건 무효야!!_A_」
			ELSEIF 初体験方法取得("ファーストキス", 対象キャラ, PLAYER) == "アナル"
				KSTR:(K++) = 「어, 엉덩이 구멍이 먼저였어? 읏, 정말~! 배려심 없잖아~~~~~!!!_A__A_」
			ELSE
				KSTR:(K++) = 「……저기, 한 번 더. 으읍_H_ ……읍_H_」
			ENDIF
		ELSEIF TALENT:対象キャラ:セフレ
			WSTR:(K++) = 「아……응, 읏_H_」
			KSTR:(K++) = 　
			WSTR:(K++) = 「후하아……_H_ ……드디어 해줬네. ……늦었잖아, 바보」
			KSTR:(K++) = 　
			KSTR:(K++) = 「……응! 늦은 벌로 한 번 더!_H_」
		ELSE
			IF TFLAG:調教モード == 1
			;セクハラ時
				WSTR:(K++) = 「으읍! 으음~~……읏!」
				KSTR:(K++) = 　
				KSTR:(K++) = 「읏……으으……처음이었단 말이야? 바보……」
			ELSE
			;うふふ時
				WSTR:(K++) = 「으읍! 으음~~……읏」
				KSTR:(K++) = 　
				KSTR:(K++) = 「하아……키스, 당해버렸어……. 처음이었단 말이야? 정말!」
			ENDIF
		ENDIF
	ELSE
		IF TALENT:対象キャラ:恋慕
			SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「으읍……_H_ ……에헤헤_H_ 한 번 더_H_」
