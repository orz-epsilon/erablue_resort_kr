;-------------------------------------------------
;固有コマンド枠
;----------------------------------------------------
;コマンド名
;----------------------------------------------------
@CHARACOMNAME372_2
#FUNCTION
;アンチラのSSR固有コマンド
;マゾっ気が育っちゃったアンチラが編み出した、禁断の秘術

TSTR:コマンド名受渡 = 금단의 엣치 법

TSTR:コマンドカラー受渡 = FFD900

;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_372_2
#FUNCTION
TFLAG:コマンドタイプ受渡 = COMTYPE("Ｖ系")

@COM_TOOLTIP_372_2
LOCALS = <br>■신외신 변화・금단의 엣치 법<br>
LOCALS += "마조기가 자란 안치라가 고안해 낸, 금단의 커맨드. <br>친한 여자아이들 사이에 끼어드는 배덕의 맛을 알 수 있다<br>V 삽입 가능 시에만 실행 가능."
LOCALS += "<br>COM 타입: V계<br>획득 소스: 쾌V・접촉・고통・불결(일정 조건 시)"
LOCALS += "<br>고유 획득 경험: V 성교 경험(TARGET)・C 성교 경험_V 삽입(PLAYER)<br>"
TSTR:ツールチップ受渡 = %LOCALS%

;-------------------------------------------------
;実行処理
;-------------------------------------------------
@CHARACOM372_2
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------


;セックス時の快楽に加えて奉仕と苦痛
;内容的にセックス一～二回ぶんやってる感じなので、時間経過を多めに。そのぶん獲得ソースも多めに。
;うふふ中のワンコマンドが5分で、このコマンドは25分(5+20)なので……5倍？

CALL SOURCE_CALC_快Ｖ(PLAYER, TARGET, 2000)
CALL SOURCE_CALC_露出(TARGET, PLAYER, 250)
CALL SOURCE_CALC_接触(TARGET, PLAYER, 7500)
CALL SOURCE_CALC_快Ｃ(TARGET, PLAYER, 2000)
CALL SOURCE_CALC_奉仕(TARGET, PLAYER, 2150)
CALL SOURCE_CALC_苦痛(TARGET, PLAYER, 500)


RCVAR:TARGET:奉仕コマンドフラグ = 1
RCVAR:TARGET:苦痛コマンドフラグ = 1
RCVAR:TARGET:汎用喘ぎ_文節低減フラグ = 1

TIME += 20

RETURN 1

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:PLAYER:Ｃ性交経験_Ｖ挿入 ++
EXP:Ｖ性交経験 ++

;同性愛
SIF 同性愛性癖判定(PLAYER,TARGET)
	EXP:PLAYER:同性愛経験 += 4
SIF 同性愛性癖判定(TARGET,PLAYER)
	EXP:TARGET:同性愛経験 += 4

;だ～い好きなセフレのあなたに目一杯楽しんでほしいという愛から出た行動ゆえに愛情経験をあげたい
;それはそれとして流石に行き過ぎじゃないか？これは……。ライン超えてね？

EXP:愛情経験 += TALENT:セフレ * 2


RETURN 1
;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE372_2

;一括管理
SIF GLOBAL_COMABLE(372)
	RETURN RESULT
;TARGETがアンチラ
LOCAL = GETCHARA(2)
SIF TARGET != LOCAL
	RETURN 0
;ベッドがないとダメ
SIF BEDROOM(CFLAG:PLAYER:現在マップ種別, CFLAG:PLAYER:現在位置) == 0
	RETURN 0
;二人きり限定
SIF GET_TARGETNUM() > 1
	RETURN 0
	
;セフレかつマゾ性感3以上を要求
SIF !TALENT:セフレ
	RETURN 0
SIF ABL:マゾ性感 <= 2
	RETURN 0
	
;Ｖ挿入可能時とは言うけど、ここまでの条件クリアしてて挿入不可なことある？

;全ての条件を揃えた状態で、確率との勝負
;EVENTCOMENDのCOM_RAND = RAND:1000で0.5%を引き当ててもらう。どこまでも口上依存で、パターンも少ないので。
;パターンが増えたら徐々に確率を上げたいけれど……増えるの？書くの？大丈夫？怒られない？


SIF COM_RAND > 4
	RETURN 0
	
RETURN 1

;-------------------------------------------------
;実行時メッセージ
;-------------------------------------------------
@MESSAGE_COM372_2


PRINTFORML %CALLNAME:TARGET%은(는) 신외신의 법과 변화의 법을 합친 기술로, 금단의 쾌락을 %CALLNAME:PLAYER%에게 만끽하게 했다…
