;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「PLAYER」の時に呼ばれる
;つまり指示モード時、あるいはオートコマンド時の口上
;****************************************
;****************************************
;快楽量での分岐は、口上を喋っているキャラの快楽ではなく、相手に与えた快楽であるということに注意すること！！
;****************************************
;****************************************
;・使い方
;「XXXX」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:TARGET:快Ｃ
	;CUP:TARGET:快Ｖ
	;CUP:TARGET:快Ａ
	;CUP:TARGET:快Ｂ
	;CUP:TARGET:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;オートコマンドで実行しているのか、指示モードで実行しているのか
	;TFLAG:オートコマンドフラグ > 1 の時はオートコマンド、それ以外なら指示モード

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ_PLAYER:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと


;--------------------------------------------------
;COM0_愛撫
;--------------------------------------------------
@KOJO_COMPLAYER_2_0(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｃ、Ｂ
;ランダム弱点コマンドの候補
;オートコマンド許可
CALL 口上変数初期化

IF TARGET == MASTER
	;相手があなたの時
	IF STRFIND(コマンド初回フラグ_PLAYER:対象キャラ:0, @"-0-") < 0
		;初回
		KSTR:(K++) = 
	ELSE
		IF TALENT:対象キャラ:恋慕
			KSTR:(K++) = 「쪽……_H_ 에헤헤~_H_ 찍어버렸네, 키스마크_H_」
			WSTR:(K++) = 「좋지! 너는 내 거니까_H_」
			KSTR:(K++) = 　
			KSTR:(K++) = 「……응후후~_H_ 내 몸에도, 찍어도 돼_H_」
		ELSEIF TALENT:対象キャラ:セフレ
			SELECTCASE RAND:2
			CASE 0
				KSTR:(K++) = 「응, 쪽_H_ 후후, 이렇게 있으니, 꽤 귀여운 얼굴을 하네, 너도_H_」
			CASE 1
				WSTR:(K++) = 「응후후~_H_ 너, 이거 좋아하잖아_H_ 헤픈 얼굴이 되어버렸네~?_H_」
				KSTR:(K++) = 
				KSTR:(K++) = 「……'능숙해졌다'고, 누구 탓이라고 생각하는 거야~!」
			ENDSELECT
		ELSE
			KSTR:(K++) = 「음…… 이렇게? 이런 느낌? ……기분 좋아?」
		ENDIF
	ENDIF
ENDIF

CALL 口上変数表示(対象キャラ, 0)



