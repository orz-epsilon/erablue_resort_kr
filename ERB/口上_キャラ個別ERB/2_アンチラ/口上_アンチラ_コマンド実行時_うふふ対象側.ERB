;****************************************
;コマンド実行後に表示される文章
;該当のキャラが「TARGET」の時に呼ばれる
;****************************************
;・使い方
;「XXXX」をキャラクター番号に置換、コマンド番号の所に任意のコマンド番号を入れ、中身に処理を記述する
;テンプレート中にある分岐は例示としておいてあるものなので、必要な場合は各自でコピペをお願いします
;****************************************
;・わかりづらい変数
;・コマンド実行による各部位の快楽量
	;CUP:対象キャラ:快Ｃ
	;CUP:対象キャラ:快Ｖ
	;CUP:対象キャラ:快Ａ
	;CUP:対象キャラ:快Ｂ
	;CUP:対象キャラ:快Ｓ

;TCVAR:対象キャラ:弱点コマンドフラグ
	;該当コマンドが弱点かどうか
	;現在弱点コマンドをゲーム中に変更する手段は無く、パラメータ設定ファイルで指定するか、指定の無い場所は開始時にランダムで決定される
	;口上テンプレートのパラメータ設定ファイルで全部弱点指定してしまえば弱点コマンドフラグで分岐する必要がない

;コマンド初回実行
	;IF STRFIND(コマンド初回フラグ:対象キャラ:0, @"-コマンド番号-") < 0
	;コマンド番号は任意に変更のこと


;--------------------------------------------------
;COM0_愛撫
;--------------------------------------------------
@KOJO_COM_2_0(対象キャラ)
#DIM 対象キャラ
;取得快楽：Ｃ、Ｂ
;ランダム弱点コマンドの候補
CALL 口上変数初期化

IF PLAYER == MASTER
	;相手があなたの時
	IF TALENT:対象キャラ:恋慕
		SELECTCASE MAX(CUP:対象キャラ:快Ｃ, CUP:対象キャラ:快Ｂ)
			;各部位の累積が10000で絶頂、場合分けの数値は参考数値なのでイメージで変えてもらってOK
			CASE IS > 10000
				;即絶頂
				WSTR:(K++) = 「아_H_ 하_H_ 갈게_H_ 갈 거니까_H_ 꽉, 꽉 안아줘_H__H_」
				KSTR:(K++) = 　
				KSTR:(K++) = 「으아_H_ 가_H_ 가아아아, 으으으으~~~~읏_H__H_」
			CASE IS > 6000
				;かなり感じている
				WSTR:(K++) = 「앗_H_ 후우, 윽_H_ 저기, 잔뜩_H_ 잔뜩 뽀뽀해줘_H_」
				KSTR:(K++) = 　
				KSTR:(K++) = 「좋아_H_ 이거 좋아_H_ 너무 행복해서, 좋아아아_H_」
			CASE IS > 3000
				;人並みに感じている
				KSTR:(K++) = 「응읏_H_ 이거, 좋아……_H_ 꽉 안기는 거, 좋아……_H_」
			CASEELSE
				;まだ快楽に慣れていない
				KSTR:(K++) = 「응_H_ 헤헤…… 저기, 내 몸, 만지는 거 기분 좋아? ……그렇구나_H_」
		ENDSELECT
	ELSEIF TALENT:対象キャラ:セフレ
		SELECTCASE MAX(CUP:対象キャラ:快Ｃ, CUP:対象キャラ:快Ｂ)
			;各部位の累積が10000で絶頂、場合分けの数値は参考数値なのでイメージで変えてもらってOK
			CASE IS > 10000
				;即絶頂
				WSTR:(K++) = 「아_H_ 거기, 더_H_ 더 꼬집어서, 아프게 해줘, 읏_H_」
				KSTR:(K++) = 　
				KSTR:(K++) = 「아극_H_ 가, 갈게_H_ 가버려_H_ 으, 으으으……읏읏_H__H_」
			CASE IS > 6000
				;かなり感じている
				KSTR:(K++) = 「아_H_ 아으_H_ 거기_H_ 거기 안 돼_H_ 기분 좋으니까, 안 돼애애_H_」
			CASE IS > 3000
				;人並みに感じている
				KSTR:(K++) = 「아_H_ 하으_H_ 하아_H_ 하아_H_ 저기, 더 꽉 안아줘?_H_」
			CASEELSE
				;まだ快楽に慣れていない
				KSTR:(K++) = 「응_H_ 후후_H_ 이렇게 만져지는 거, 꽤 좋을지도, 읏_H_」
		ENDSELECT
	ELSE
		SELECTCASE MAX(CUP:対象キャラ:快Ｃ, CUP:対象キャラ:快Ｂ)
			;各部位の累積が10000で絶頂、場合分けの数値は参考数値なのでイメージで変えてもらってOK
			CASE IS > 10000
				;即絶頂
				WSTR:(K++) = 「아_H_ 앗_H_ 와_H_ 와버려_H_ 기분 좋은 거, 기분으로_H_」
				KSTR:(K++) = 　
				KSTR:(K++) = 「으_H_ 으으으으으읏_H__H_」
			CASE IS > 6000
				;かなり感じている
				KSTR:(K++) = 「후아_H_ 앗_H_ 아응읏_H_」
				KSTR:(K++) = 「머리가 멍해져 버렸어……_H_ 에헤헤…… 이거 좋아_H_」
			CASE IS > 3000
				;人並みに感じている
				KSTR:(K++) = 「응……_H_ 후……_H_ 뭔가, 몸이 뜨거워진 것 같아……」
			CASEELSE
				;まだ快楽に慣れていない
				KSTR:(K++) = 「응읏…… 뭔가 간질간질해. 이거, 정말 기분 좋아지는 거야?」
		ENDSELECT
	ENDIF
ENDIF

