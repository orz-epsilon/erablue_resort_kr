
@固有アビ_2_1(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 基礎BATTLE_STATE:キャラ番号:Lv >= 55
	アビ名 = 不生不滅＋
	消費ＭＰ = 400
ELSE
	アビ名 = 不生不滅
	消費ＭＰ = 400
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 55
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>아군 전체에게 [완전 회복]의 HP 회복을 부여한다.
			詳細文文字列受け渡し変数 += @"<br>[25％] (A 프레임・2턴)의 방어력 감소 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>[25％] (A 프레임・2턴)의 약체 내성 감소 효과를 부여한다."
		ELSE
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>아군 전체에게 [완전 회복]의 HP 회복을 부여한다.
			詳細文文字列受け渡し変数 += @"<br>[30％] (A 프레임・3턴)의 방어력 감소 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>[30％] (A 프레임・3턴)의 약체 내성 감소 효과를 부여한다."
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_味方全体_生者のみ
		アビ汎用変数:効果量 = 9999
		CALL アビテンプレート_回復処理_MAXでも回復
		
		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 防御力A
		アビ汎用文字列:バフ・デバフ対象能力 = 防御力
		IF 基礎BATTLE_STATE:キャラ番号:Lv >= 55
			アビ汎用変数:効果割合 = 25
			アビ汎用変数:持続ターン = 2
		ELSE
			アビ汎用変数:効果割合 = 30
			アビ汎用変数:持続ターン = 3
		ENDIF
		CALL アビテンプレート_不利効果_デバフ効果セット
		
		アビ汎用文字列:バフ・デバフ枠 = 弱体耐性A
		アビ汎用文字列:バフ・デバフ対象能力 = 弱体耐性
		CALL アビテンプレート_不利効果_デバフ効果セット
ENDSELECT



@固有アビ_2_2(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名

IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 70
	アビ名 = 君子万年＋＋
	消費ＭＰ = 50
ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 65
	アビ名 = 君子万年＋
	消費ＭＰ = 35
ELSE
	アビ名 = 君子万年
	消費ＭＰ = 20
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 70
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>아군 한 명에게 [400] (일반 프레임)의 배리어 효과를 부여한다.
			詳細文文字列受け渡し変数 += @"<br>[100％] (고유 프레임・1턴・제거 불가)의 적대심 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>[30％] (C 프레임・1피해)의 추격 효과를 부여한다."
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 65
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>아군 한 명에게 [350] (일반 프레임・3턴)의 배리어 효과를 부여한다.
			詳細文文字列受け渡し変数 += @"<br>[100％] (고유 프레임・1턴・제거 불가)의 적대심 상승 효과를 부여한다."
		ELSE
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>아군 한 명에게 ［250］（일반 칸・3턴）의 배리어 효과를 부여한다.
			詳細文文字列受け渡し変数 += @"<br>［100％］（고유 칸・1턴・제거 불가）의 적대심 상승 효과를 부여한다."
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ効果"
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_味方単体_生者のみ
		アビ汎用文字列:バフ・デバフ枠 = 배리어
		アビ汎用文字列:バフ・デバフ対象能力 = 배리어
		IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 70
			アビ汎用変数:効果量 = 400
			アビ汎用変数:持続ターン = -1
		ELSEIF 基礎BATTLE_STATE:キャラ番号:Lv >= 65
			アビ汎用変数:効果量 = 350
			アビ汎用変数:持続ターン = 3
		ELSE
			アビ汎用変数:効果量 = 250
			アビ汎用変数:持続ターン = 3
		ENDIF
		CALL アビテンプレート_有利効果_バフ効果セット

		CALL アビ汎用変数文字列リセット
		アビ汎用文字列:バフ・デバフ枠 = 敵対心_君子万年
		アビ汎用文字列:バフ・デバフ対象能力 = 적대심
		アビ汎用変数:効果量 = 200
		アビ汎用変数:持続ターン = 1
		CALL アビテンプレート_有利効果_バフ効果セット
		
		IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 70
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 追撃C
			アビ汎用文字列:バフ・デバフ対象能力 = 추격
			アビ汎用変数:効果割合 = 30
			アビ汎用変数:持続被ダメ回数 = 1
			アビ汎用変数:消去不可オプション = 1
			CALL アビテンプレート_有利効果_バフ効果セット
		ENDIF
ENDSELECT



@固有アビ_2_3(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 対象番号
#DIM バフ行数

IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 80
	アビ名 = 葦編三絶＋
	消費ＭＰ = 70
ELSE
	アビ名 = 葦編三絶
	消費ＭＰ = 50
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
		IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 80
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>아군 전체에게 （6턴・제거 불가）의 위편삼절 효과를 부여한다.
			詳細文文字列受け渡し変数 += @"<br>◆발동 2회째에 치명타율 상승 효과 추가/발동 3회째에 주는 피해량 상승 효과 추가"
		ELSE
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>아군 전체에게 （6턴・제거 불가）의 위편삼절 효과를 부여한다.
		ENDIF
		RETURN 消費ＭＰ
	CASE "アビ説明文_詳細"
		IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 80
			詳細文文字列受け渡し変数 = 消費ＭＰ：{消費ＭＰ}<br>아군 전체에게 （6턴・제거 불가）의 위편삼절 효과를 부여한다.
			詳細文文字列受け渡し変数 += @"<br>＞［50％］의 공격력 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>＞［50％］의 방어력 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>＞［30％］의 DA율 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>＞［15％］의 TA율 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>＞동일 전투에서 2회 이상 사용했을 때, ［50％］의 크리티컬율 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>＞동일 전투에서 3회 이상 사용했을 때, ［10％］의 주는 대미지 상승 효과를 부여한다."
		ELSE
			詳細文文字列受け渡し変数 = 소비 MP：{消費ＭＰ}<br>아군 전체에게 (6턴・제거 불가)의 위편삼절 효과를 부여한다.
			詳細文文字列受け渡し変数 += @"<br>＞［10％］의 공격력 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>＞［10％］의 방어력 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>＞［10％］의 DA율 상승 효과를 부여한다."
			詳細文文字列受け渡し変数 += @"<br>＞［5％］의 TA율 상승 효과를 부여한다."
		ENDIF
	CASE "アビ効果"
		CALL アビ汎用変数文字列リセット
		CALL アビ対象選択テンプレート_味方全体_生者のみ
		アビ汎用文字列:バフ・デバフ枠 = 葦編三絶
		アビ汎用文字列:バフ・デバフ対象能力 = 葦編三絶
		アビ汎用変数:持続ターン = 6
		アビ汎用変数:特殊表示オプション = 1
		CALL アビテンプレート_有利効果_バフ効果セット

		IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 80
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_攻撃力
			アビ汎用文字列:バフ・デバフ対象能力 = 攻撃力
			アビ汎用変数:効果割合 = 50
			CALL アビテンプレート_有利効果_付随バフ効果セット("葦編三絶")
			
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_防御力
			アビ汎用文字列:バフ・デバフ対象能力 = 防御力
			アビ汎用変数:効果割合 = 50
			CALL アビテンプレート_有利効果_付随バフ効果セット("葦編三絶")
			
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_DA率
			アビ汎用文字列:バフ・デバフ対象能力 = DA율
			アビ汎用変数:効果量 = 30
			CALL アビテンプレート_有利効果_付随バフ効果セット("葦編三絶")
			
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_TA율
			アビ汎用文字列:バフ・デバフ対象能力 = TA율
			アビ汎用変数:効果量 = 15
			CALL アビテンプレート_有利効果_付随バフ効果セット("葦編三絶")
			IF 戦闘中カウント:戦闘行動キャラ:0 > 1
				CALL アビ汎用変数文字列リセット
				アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_피해량 증가
				アビ汎用文字列:バフ・デバフ対象能力 = 피해량
				アビ汎用変数:効果割合 = 10
				CALL アビテンプレート_有利効果_付随バフ効果セット("葦編三絶")
			ELSEIF 戦闘中カウント:戦闘行動キャラ:0 > 0
				CALL アビ汎用変数文字列リセット
				アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_크리율
				アビ汎用文字列:バフ・デバフ対象能力 = 크리티컬율
				アビ汎用変数:効果量 = 50
				CALL アビテンプレート_有利効果_付随バフ効果セット("葦編三絶")
			ENDIF
		ELSE
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_공격력
			アビ汎用文字列:バフ・デバフ対象能力 = 공격력
			アビ汎用変数:効果割合 = 10
			CALL アビテンプレート_有利効果_付随バフ効果セット("葦編三絶")
			
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_방어력
			アビ汎用文字列:バフ・デバフ対象能力 = 방어력
			アビ汎用変数:効果割合 = 10
			CALL アビテンプレート_有利効果_付随バフ効果セット("葦編三絶")
			
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_DA율
			アビ汎用文字列:バフ・デバフ対象能力 = DA율
			アビ汎用変数:効果量 = 10
			CALL アビテンプレート_有利効果_付随バフ効果セット("葦編三絶")
			
			CALL アビ汎用変数文字列リセット
			アビ汎用文字列:バフ・デバフ枠 = 葦編三絶_TA율
			アビ汎用文字列:バフ・デバフ対象能力 = TA율
			アビ汎用変数:効果量 = 5
		ENDIF
		
		戦闘中カウント:戦闘行動キャラ:0 += 1 
		戦闘中カウント:戦闘行動キャラ:1 = 1
ENDSELECT



@固有アビ_2_4(ARGS, キャラ番号)
#DIM キャラ番号
#DIM 消費ＭＰ
#DIMS アビ名
#DIM 対象番号
#DIM バフ・デバフ行数

IF 陥落チェック(キャラ番号) && 基礎BATTLE_STATE:キャラ番号:Lv >= 75
	アビ名 = 三令五申
	消費ＭＰ = 70
ENDIF

SELECTCASE ARGS
	CASE "アビ名"
		TSTR:コマンド名受渡 = %アビ名%
	CASE "アビ説明文"
詳細文文字列受け渡し変数 = 소비 MP：{消費ＭＰ}<br>적 전체에［500％］의 바람 속성 데미지를 준다.
詳細文文字列受け渡し変数 += @"<br>（고유 칸・영구・회복 불가）의 3종 삼원 효과를 부여한다."
詳細文文字列受け渡し変数 += @"<br>◆발동 횟수에 따라 삼원 효과 성능 향상"
		RETURN 消費ＭＰ
	CASE "アビ説明文_詳細"
詳細文文字列受け渡し変数 = 소비 MP：{消費ＭＰ}<br>적 전체에［500％］의 바람 속성 데미지를 준다.
詳細文文字列受け渡し変数 += @"<br>（고유 칸・회복 불가）의 불견원 효과를 부여한다."
