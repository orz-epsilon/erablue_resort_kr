@舞踏会イベ判定(対象キャラ)
#DIM 対象キャラ

;個別口上の外でこれ使いたくないけど、CFLAGに新設するよりはマシなので……
特定状況口上用フラグ:対象キャラ:0 = 0
IF イベント完了フラグ確認("『シンデレラ』と『舞踏会』") > 0
	IF CFLAG:対象キャラ:C_DAY_RAND % 17 == 0 || DAY_RAND % 192 == 0 ;192
		SELECTCASE RAND:3
			CASE 0 ;需观察大腿4 太腿の付け根など、スカート等で隠れる部分
				特定状況口上用フラグ:対象キャラ:0 = 4
			CASE 1 ;需观察胸部2 胸元。胸チラで見えたり、水着になったら見えたりする
				特定状況口上用フラグ:対象キャラ:0 = 2
;			CASE 2 ;需观察身上3 その他。へそ下とか。へそ出ししてると見える
;				特定状況口上用フラグ:対象キャラ:0 = 3
			CASEELSE
			;直接1 着衣状態で普通に目視できる位置にマークがある
			;全体確率のうち、最低でも50%はあって欲しい。そうすれば見かけ上は3%となるため
				特定状況口上用フラグ:対象キャラ:0 = 1
		ENDSELECT
		;本人は「その日いちにちシンデレラであること」を把握しているので、あなたがマークを目視したか否かに関わらず特殊言いなり状態
		TCVAR:対象キャラ:特殊言いなり = 1
	ENDIF

	IF NAME:対象キャラ == "[346プロアイドル事業部統括]美城常務" || NAME:対象キャラ == "[佐々木千枝の母]佐々木百枝"
		特定状況口上用フラグ:対象キャラ:0 = 0
			TCVAR:対象キャラ:特殊言いなり = 0
	ENDIF
	IF NAME:対象キャラ == "[アイドル事務所のアシスタント]千川ちひろ"
		特定状況口上用フラグ:対象キャラ:0 = 1
			TCVAR:対象キャラ:特殊言いなり = 1
	ENDIF
ENDIF

@秘書起床業務画像出力(対象キャラ, 行為画像, 代替画像, 実行側フラグ = 0)
#DIM 対象キャラ
#DIMS DYNAMIC 行為画像
#DIMS DYNAMIC 代替画像
#DIM 実行側フラグ
#DIM レイヤー記録
#DIMS 衣装一時保存
#DIMS 行為画像保存

衣装一時保存 '= CSTR:対象キャラ:顔グラ表示切り替え用文字列
行為画像保存 '= 行為画像

SIF 代替画像 == ""
	代替画像 '= 行為画像

レイヤー記録 = TFLAG:口上用画像表示番号

DEBUGCLEAR
DO
	;まず秘書朝起こし_衣装_行為画像を探す
	DEBUGPRINTFORML ＊%CALLNAME:対象キャラ%の衣装：%REPLACE(CSTR:対象キャラ:顔グラ表示切り替え用文字列, "顔_", "")%のコマンド：%行為画像%でチャレンジ＊
	CALL 汎用一枚絵画像_名称算出(対象キャラ, "秘書朝起こし_", 行為画像)
	DEBUGPRINTFORM 秘書朝起こし_%RESULTS%が
	CALL PRINT_STRL(@"IMAGEPATH_%CSTR:対象キャラ:画像フォルダ%/秘書朝起こし_%RESULTS%")
	IF レイヤー記録 == TFLAG:口上用画像表示番号
		CLEARLINE 1
		;秘書朝起こし_衣装_行為画像が表示されてないということなので、コマンド実行時_衣装_行為画像を探す
		LOCALS '= コマンド実行時画像名称変換処理(対象キャラ, 行為画像)
		SIF 実行側フラグ
			LOCALS '= "プレイヤー側_" + LOCALS
		DEBUGPRINTFORML 無いので、コマンド実行時_%LOCALS%を探すよ…
		CALL PRINT_STRL(@"IMAGEPATH_%CSTR:対象キャラ:画像フォルダ%/コマンド実行時_%LOCALS%")
		IF レイヤー記録 == TFLAG:口上用画像表示番号
			CLEARLINE 1
			;コマンド実行時_衣装_行為画像も表示されてないということなので、短冊_衣装_差分_行為画像を探す
			LOCALS '= "差分_" + 行為画像
			SIF 行為画像 == "ノーマル"
				LOCALS '= ""
			DEBUGPRINTFORM 無いので、短冊_%REPLACE(CSTR:対象キャラ:顔グラ表示切り替え用文字列, "顔_", "")%_%LOCALS%を探すよ…
			IF LOCALS == ""
				SWAP CSTR:対象キャラ:顔グラ表示切り替え用文字列, CSTR:対象キャラ:短冊グラ表示切り替え用文字列
				RESULTS '= REPLACE(グラ表示用文字列算出(対象キャラ, "短冊_"), "顔_|短冊_", "")
				SWAP CSTR:対象キャラ:顔グラ表示切り替え用文字列, CSTR:対象キャラ:短冊グラ表示切り替え用文字列
			ELSE
				CALL 汎用一枚絵画像_名称算出(対象キャラ, "短冊_", LOCALS)
			ENDIF
			DEBUGPRINTFORM [%RESULTS%]が帰ってきたよ。
			CALL PRINT_STRL(@"IMAGEPATH_%CSTR:対象キャラ:画像フォルダ%/短冊_%RESULTS%")
			IF レイヤー記録 == TFLAG:口上用画像表示番号
				CLEARLINE 1
				;短冊_衣装_差分_行為画像も表示されていないとのことなので、条件を変えて探し直す
				IF 代替画像 != 行為画像
					;代替画像でサーチ再開
					行為画像 '= 代替画像
					DEBUGPRINTFORML 無いので行為：%行為画像%で再挑戦
				ELSEIF CSTR:対象キャラ:顔グラ表示切り替え用文字列 != "顔_デフォルト"
					CSTR:対象キャラ:顔グラ表示切り替え用文字列 '= "顔_デフォルト"
					;行為画像にセットし直し、衣装をデフォルトにセットしてサーチ再開
					SIF 行為画像 != 行為画像保存
						行為画像 '= 行為画像保存
					DEBUGPRINTFORML 無いので衣装：デフォルト、行為：%行為画像%で再チャレンジ
				ELSE
					DEBUGPRINTFORML 無いのでギブアップ
					BREAK
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	SIF レイヤー記録 != TFLAG:口上用画像表示番号
		DEBUGPRINTL あったよ
LOOP レイヤー記録 == TFLAG:口上用画像表示番号

CSTR:対象キャラ:顔グラ表示切り替え用文字列 '= 衣装一時保存

