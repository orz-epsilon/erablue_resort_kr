@RAPE_COMTYPE_20
#FUNCTION
TFLAG:コマンドタイプ受渡 = RAPE_COMTYPE("Ｖ系")

@RAPE_COM_TOOLTIP_20
LOCALS = <br>■강제로 범하다<br>
LOCALS += "상대의 질에 억지로 삽입하여 섹스를 하는 커맨드. <br>V삽입계 모드 시, [범하는 체위를 바꾸다]로 변화한다. <br>V삽입계 모드가 되어, 모드를 변경하거나 성행위를 종료할 때까지 지속적으로 쾌락이 발생한다. <br>[처녀]를 잃는다."
LOCALS += "<br>RAPE_COM 타입: V계<br>획득 소스: 쾌V・노출・접촉・고통・불결(일정 조건 시)"
LOCALS += "<br>고유 획득 경험: V성교 경험(TARGET)・C성교 경험_V삽입(PLAYER)<br>"
TSTR:ツールチップ受渡 = %LOCALS%

@RAPE_COM20

;この時点であなたが相手にＶ挿入しているなら、「犯す体位を変える」として実行されているということになる。
SIF MODE_確認_完全一致("Ｖ挿入系", PLAYER, TARGET) > -1
	RFLAG:コマンド結果受渡し変数２ = 1

	$体位_LOOP
	DRAWLINE
	PRINTL ■체위를 선택해 주세요
	PRINTL
	FOR LOCAL, 0, 20
		TRYCCALLFORM RAPE_COM_ABLE20_{LOCAL}
			IF RESULT
				SELECTCASE LOCAL
					CASE 0
						PRINTBUTTONLC "[0]정상위", 0
					CASE 1
						PRINTBUTTONLC "[1]후배위", 1
					CASE 2
						PRINTBUTTONLC "[2]누운 후배위", 2
					CASE 3
						PRINTBUTTONLC "[3]대면 좌위", 3
					CASE 4
						PRINTBUTTONLC "[4]배면 좌위", 4
					CASE 5
						PRINTBUTTONLC "[5]기승위", 5
					CASE 6
						PRINTBUTTONLC "[6]측위", 6
					CASE 7
						PRINTBUTTONLC "[7]굴곡위", 7
					CASE 8
						PRINTBUTTONLC "[8]에키벤", 8
					CASE 9
						PRINTBUTTONLC "[9]배면 에키벤", 9
					CASE 10
						PRINTBUTTONLC "[10]대면 입위", 10
					CASE 11
						PRINTBUTTONLC "[11]서서 하는 백", 11
				ENDSELECT
			ENDIF
		CATCH
			CONTINUE
		ENDCATCH
	NEXT

	PRINTL
	PRINTL
	PRINTBUTTONLC "[999]돌아가기", 999

	$INPUT_LOOP
	INPUT

	LOCAL = RESULT
	SELECTCASE LOCAL
		CASE 0 TO 11
			TRYCALLFORM RAPE_COM_ABLE20_{LOCAL}
			IF RESULT
				TRYCALLFORM RAPE_COM20_{LOCAL}
				;メッセージ用に体位の種類を保存
				RFLAG:コマンド結果受渡し変数 = LOCAL
				RETURN 1
			ENDIF
			GOTO INPUT_LOOP
		CASE 999
			RETURN -1
		CASEELSE
			GOTO INPUT_LOOP
	ENDSELECT


