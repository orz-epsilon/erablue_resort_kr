@GET_年齢文字列(性別, 年齢層, 外見年齢, 実年齢 = 0)
#FUNCTIONS
#DIM 性別
#DIM 年齢層
#DIM 外見年齢
#DIM 実年齢
#DIM 詳細表示フラグ

LOCALS '= GET_TALENTNAME(164, (外見年齢? 外見年齢 # 年齢層))

IF 外見年齢 == 年齢層_幼い && 年齢層 >= 年齢層_老年
	LOCALS = \@ 性別 == 2? 쇼타 할배# 로리 할매\@
ELSEIF 外見年齢 && !実年齢
	LOCALS += "（실제 나이:" + GET_TALENTNAME(164, 年齢層) + "）"
ELSEIF 外見年齢
	LOCALS += @"（실제 나이:{実年齢}세）"
ENDIF
RETURNF LOCALS


@GET_見た目年齢(年齢層, 外見年齢)
#FUNCTION
#DIM 年齢層
#DIM 外見年齢

IF INRANGE(外見年齢, 年齢層_幼い, 年齢層_人外)
	;外見年齢の見た目年齢は[外見年齢]の値を使う
	RETURNF 外見年齢
ELSEIF 外見年齢
	;[外見年齢]の値がおかしい場合は見た目大人として扱う
	RETURNF 年齢層_大人
ELSEIF INRANGE(年齢層, 年齢層_幼い, 年齢層_人外)
	;年齢層が設定されている場合はそれを使う
	RETURNF 年齢層
ELSE
	;年齢不詳や未設定は大人として扱う
	RETURNF 年齢層_大人
ENDIF

@キャラ見た目年齢(対象キャラ)
#FUNCTION
#DIM 対象キャラ
RETURNF GET_見た目年齢(TALENT:対象キャラ:年齢層, TALENT:対象キャラ:外見年齢)


@GET_フレーバー素質NAME(ARG, ARG:1)
#FUNCTIONS
SELECTCASE ARG
	CASE フレーバー素質_陰毛濃さ
		IF ARG:1 == 1
			RETURNF "무모"
		ELSEIF ARG:1 == 2
			RETURNF "옅음"
		ELSEIF ARG:1 == 3
			RETURNF "보통"
		ELSEIF ARG:1 == 4
			RETURNF "진함"
		ELSEIF ARG:1 == 5
			RETURNF "억센 털"
		ENDIF
	CASE フレーバー素質_乳首大きさ
		IF ARG:1 == 1
			RETURNF "콩알 크기"
		ELSEIF ARG:1 == 2
			RETURNF "작은 편"
		ELSEIF ARG:1 == 3
			RETURNF "평균적"
		ELSEIF ARG:1 == 4
			RETURNF "큰 편"
		ELSEIF ARG:1 == 5
			RETURNF "거대 유두"
		ENDIF
	CASE フレーバー素質_乳輪大きさ
		IF ARG:1 == 1
			RETURNF "극소"
		ELSEIF ARG:1 == 2
			RETURNF "작은 편"
		ELSEIF ARG:1 == 3
			RETURNF "평균적"
		ELSEIF ARG:1 == 4
			RETURNF "큰 편"
		ELSEIF ARG:1 == 5
			RETURNF "거대 유륜"
		ENDIF
	CASE フレーバー素質_性器種類
		IF ARG:1 == 1
			RETURNF "지렁이 천 마리"
		ELSEIF ARG:1 == 2
			RETURNF "청어알 천장"
		ELSEIF ARG:1 == 3
			RETURNF "문어단지"
		ELSEIF ARG:1 == 4
			RETURNF "주머니"
		ELSEIF ARG:1 == 5
			RETURNF "가마니 조이기"
		ENDIF
	CASE フレーバー素質_クリ大きさ
		IF ARG:1 == 1
			RETURNF "작은 편"
		ELSEIF ARG:1 == 2
			RETURNF "평균적"
		ELSEIF ARG:1 == 3
			RETURNF "큰 편"
		ELSEIF ARG:1 == 4
			;後天的に変更するパターンのみ
			RETURNF "클리토리스 음경"
		ENDIF
	CASE フレーバー素質_ほくろ位置
		LOCALS = 
		SIF GETBIT(ARG:1, 0)
			LOCALS += "유두 옆/"
		SIF GETBIT(ARG:1, 1)
			LOCALS += "음순 옆/"
		SIF GETBIT(ARG:1, 2)
			LOCALS += "항문 옆/"
		SIF GETBIT(ARG:1, 3)
			LOCALS += "음경/"
		STRLENS LOCALS
		SUBSTRING LOCALS, 0, RESULT - 1
		RETURNF RESULTS
	CASE フレーバー素質_ふたなり時_玉ありなし
		IF ARG:1 == フレーバー素質_ふたなり時_玉なし
			RETURNF "고환 없음"
		ELSEIF ARG:1 == フレーバー素質_ふたなり時_玉あり
			RETURNF "고환 있음"
		ENDIF
ENDSELECT

