
;-------------------------------------------------
;07_811_01マッサージを始める
;-------------------------------------------------
@COMNAME_PLACE_380_0_811
#FUNCTION

IF 施設改造度:7:0 == 0
	TSTR:コマンド名受渡 = 
	RETURNF 0
ENDIF
TSTR:コマンド名受渡 = 마사지를 시작한다
RETURNF 1

;===================================================
;コマンドタイプ
;===================================================
@COMTYPE_380_0_811
#FUNCTION
TFLAG:コマンドタイプ受渡 = COMTYPE("日常")
		
@COM380_0_811
CALL COM380_0_711
RETURN RESULT

;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE380_0_811

;条件に合う場合0（不許可）を返す
;どの条件にも引っかからないなら1（許可）を返す
;一括管理
SIF GLOBAL_COMABLE(380)
	RETURN RESULT
;睡眠中
SIF CFLAG:睡眠
	RETURN 0
;二人きりのみ
SIF GET_TARGETNUM() > 1
	RETURN 0
;禁止
SIF TCVAR:TARGET:マッサージ禁止
	RETURN 0
;ちゃんと性別合わせて
SIF 施設利用性別(TARGET) == 性別_男性
	RETURN 0
RETURN 1

;-------------------------------------------------
;実行時メッセージ
;-------------------------------------------------
@MESSAGE_COM380_0_811

PRINTFORML %CALLNAME:PLAYER%은(는) %CALLNAME:TARGET%에게 마사지를 시작했다.

IF 特定状況口上用フラグ:TARGET:0 == 2
	PRINTL
	SETCOLOR カラーパレット("えっちな色")
	PRINTFORM 시술복으로 갈아입은 %CALLNAME:TARGET%의 가슴팍에
	PRINT_IMG "デレマス_マーク"
	CALL PRINT_STRL(@"마크를 발견했다_H_")
	PRINTFORMW %CALLNAME:TARGET%은(는) 오늘의 『신데렐라』였던 것 같다
	特定状況口上用フラグ:TARGET:0 = 1
	RESETCOLOR
ELSEIF 特定状況口上用フラグ:TARGET:0 == 3
	PRINTL
	SETCOLOR カラーパレット("えっちな色")
	PRINTFORM 시술복으로 갈아입은 %CALLNAME:TARGET%의 배꼽 아래에
	PRINT_IMG "デレマス_マーク"
	CALL PRINT_STRL(@"마크를 발견했다_H_")
	PRINTFORMW %CALLNAME:TARGET%은(는) 오늘의 『신데렐라』였던 것 같다
	特定状況口上用フラグ:TARGET:0 = 1
ELSEIF 特定状況口上用フラグ:TARGET:0 == 4
	PRINTL
	SETCOLOR カラーパレット("えっちな色")
	PRINTFORM 시술복으로 갈아입은 %CALLNAME:TARGET%의 허벅지 안쪽에
	PRINT_IMG "デレマス_マーク"
	CALL PRINT_STRL(@"마크를 발견했다_H_")
	PRINTFORMW %CALLNAME:TARGET%은(는) 오늘의 『신데렐라』였던 것 같다
	特定状況口上用フラグ:TARGET:0 = 1
	RESETCOLOR
ENDIF

IF PREGNANCY_SIZE(TARGET) >= 2 && EXIST画像FILE("resources/" + CSTR:TARGET:画像フォルダ + "/マッサージ開始_妊娠")
	CALL PRINT_STRW(@"IMAGEPATH_%CSTR:TARGET:画像フォルダ%/マッサージ開始_妊娠")
ELSEIF EXIST画像FILE("resources/" + CSTR:TARGET:画像フォルダ + "/マッサージ開始")
	CALL PRINT_STRW(@"IMAGEPATH_%CSTR:TARGET:画像フォルダ%/マッサージ開始")
ENDIF


