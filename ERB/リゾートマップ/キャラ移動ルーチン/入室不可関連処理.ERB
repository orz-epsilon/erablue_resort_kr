@キャラ同士うふふ時表示文章(対象キャラ１, 対象キャラ２)
#DIM 対象キャラ１
#DIM 対象キャラ２
#DIM 攻めキャラ
#DIM 受けキャラ
#DIM 対象キャラ１判定値
#DIM 対象キャラ２判定値
#DIM 配列番号
#DIMS モード名
#DIM 表示フラグ
#DIMS 呼び寄せ配列, 100
#DIM 参加人数
#DIM 乱入チェック

;キャラがうふふ中で施錠されてる時の表示文章を制御する
;まず複数人うふふ、メンツ記録は両方に入るのでどっち見てもいいはず
VARSET 呼び寄せ配列
参加人数 = 0
IF TIME <= 720 && CSTR:対象キャラ１:多人数NPCうふふ_メンツ記録_AM != ""
	SPLIT CSTR:対象キャラ１:多人数NPCうふふ_メンツ記録_AM, "_", 呼び寄せ配列
	参加人数 = RESULT
	IF 参加人数 >= 3
		PRINTFORML 안에서 여러 사람의 교성이 들려온다……아무래도 {RESULT}명이서 즐기고 있는 것 같다
	ENDIF
ELSEIF TIME > 720 && CSTR:対象キャラ１:多人数NPCうふふ_メンツ記録_PM != ""
	SPLIT CSTR:対象キャラ１:多人数NPCうふふ_メンツ記録_PM, "_", 呼び寄せ配列
	参加人数 = RESULT
	IF 参加人数 >= 3
		PRINTFORML 안에서 여러 사람의 교성이 들려온다……아무래도 {RESULT}명이서 즐기고 있는 것 같다
	ENDIF
ENDIF
IF 参加人数 < 3
	;以下、受け攻めの設定を見て口上などを呼び出す
	CALL 受け攻め関係性算出(対象キャラ１, 対象キャラ２)
	IF RESULT >= 0
		攻めキャラ = RESULT:10
		受けキャラ = RESULT:11

		;攻め受けが決定したのでそれに応じたメッセージ
		PRINTFORML 안에서 %CALLNAME:攻めキャラ%의 목소리와, %CALLNAME:受けキャラ%의 신음 소리가 들려온다……
		PRINTFORMW 아무래도 두 사람이서 즐기고 있는 것 같다…
	ELSE
		;多分存在しないはずなんだけど、関係性がない二人の場合はシンプルメッセージ
		PRINTFORMW 안에서 %CALLNAME:対象キャラ１%와 %CALLNAME:対象キャラ２%의 교성이 들려온다……아무래도 즐기고 있는 것 같다…
	ENDIF
	参加人数 = 2
	;乱入チェック
	乱入チェック = 0
	IF (TALENT:対象キャラ１:恋慕 && TALENT:対象キャラ２:恋慕) || (TALENT:対象キャラ１:セフレ || TALENT:対象キャラ２:セフレ)
		;二人の場合は両方恋慕or片方セフレでOK
		乱入チェック = 1
	ENDIF
ELSE
	;乱入チェック
	乱入チェック = 1
	FOR LOCAL, 0, 参加人数
		;複数人の場合は全員陥落でOK
		IF 陥落チェック(TOINT(呼び寄せ配列:LOCAL)) == 0
			乱入チェック = 0
			BREAK
		ENDIF
	NEXT
ENDIF


;一定条件で乱入可能
IF あなた単独() == 0
	;誰かを連れてる時は無理
	PRINTL 
	PRINTFORML 안의 모습을 엿볼까요?
	PRINTBUTTONLC "[2] 예", 2
	PRINTBUTTONLC "[1] 아니오", 1
	BINPUT
ELSEIF 乱入チェック
	PRINTL 
	PRINTFORML 난입하시겠습니까?
	PRINTBUTTONLC "[0] 예", 0
	PRINTBUTTONLC "[1] 아니오", 1
	PRINTBUTTONLC "[2] 안을 엿본다", 2
	PRINTBUTTONLC "[10] 성행위에 가담하지 않고 방에 들어간다", 10
	BINPUT
	IF RESULT == 0
		IF 参加人数 < 3
			PRINTFORMW %CALLNAME:PLAYER%은(는) 마스터키로 문을 열고, %CALLNAME:対象キャラ１%와(과) %CALLNAME:対象キャラ２%의 애정 행각에 난입했다.
		ELSE
			PRINTFORMW %CALLNAME:PLAYER%은(는) 마스터키로 문을 열고, %CALLNAME:対象キャラ１%들의 애정 행각에 난입했다.
		ENDIF
		FOR LOCAL, 0, 参加人数
			CALL うふふ開始キャラ処理(TOINT(呼び寄せ配列:LOCAL), "キャラ同士うふふ乱入")
			;愛撫系モードは消す
			CALL MODE_DELETE_ターゲット側("愛撫系", TOINT(呼び寄せ配列:LOCAL))
			;先に同室フラグを建てることで発覚口上をスキップする
			CFLAG:(TOINT(呼び寄せ配列:LOCAL)):同室 = 1
		NEXT

		CFLAG:PLAYER:うふふ = 1
		RETURN 1
	ELSEIF RESULT == 10
		IF 参加人数 < 3
			PRINTFORMW %CALLNAME:PLAYER%은(는) 마스터키로 문을 열고, 살며시 %CALLNAME:対象キャラ１%와(과) %CALLNAME:対象キャラ２%이(가) 애정 행각을 벌이는 방으로 들어갔다.
		ELSE
			PRINTFORMW %CALLNAME:PLAYER%은(는) 마스터키로 문을 열고, 살며시 %CALLNAME:対象キャラ１%들이 애정 행각을 벌이는 방으로 들어갔다.
		ENDIF
		FOR LOCAL, 0, 参加人数
			;先に同室フラグを建てることで発覚口上をスキップする
			CFLAG:(TOINT(呼び寄せ配列:LOCAL)):同室 = 1
		NEXT

		RETURN 1
	ENDIF
ELSEIF フィールド展開:うふふ目撃スルー
	PRINTL 
	PRINTFORML 방 안으로 들어가시겠습니까?
	PRINTBUTTONLC "[10] 성행위에 가담하지 않고 방에 들어간다", 10
	PRINTBUTTONLC "[1] 아니오", 1
	BINPUT
	IF RESULT == 10
		IF 参加人数 < 3
			PRINTFORMW %CALLNAME:PLAYER%은(는) 마스터키로 문을 열고, 살며시 %CALLNAME:対象キャラ１%와(과) %CALLNAME:対象キャラ２%이(가) 애정 행각을 벌이는 방으로 들어갔다.
		ELSE
			PRINTFORMW %CALLNAME:PLAYER%은(는) 마스터키로 문을 열고, 살며시 %CALLNAME:対象キャラ１%들이 애정 행각을 벌이는 방으로 들어갔다.
		ENDIF
		FOR LOCAL, 0, 参加人数
			;先に同室フラグを建てることで発覚口上をスキップする
			CFLAG:(TOINT(呼び寄せ配列:LOCAL)):同室 = 1
		NEXT
		
		RETURN 1
	ENDIF
ELSE
	PRINTL 
	PRINTFORML 안의 모습을 엿볼까요?
	PRINTBUTTONLC "[2] 예", 2
	PRINTBUTTONLC "[1] 아니오", 1
	BINPUT
ENDIF

IF RESULT == 2
	表示フラグ = 0
	VARSET RESULT
	IF 参加人数 == 2 && DT_SELECT("体位モードデータベース", @"対象キャラ = {受けキャラ}")
		FOR 配列番号, 1, RESULT + 1
			モード名 '= DT_CELL_GETS("体位モードデータベース", RESULT:配列番号, "モード名", 1)
			IF モード名 == "キス"
				PRINTFORML %CALLNAME:攻めキャラ%와(과) %CALLNAME:受けキャラ%이(가) 정열적으로 입술을 맞대고 있다……
				表示フラグ ++
			ELSEIF モード名 == "ディープキス"
				PRINTFORML %CALLNAME:攻めキャラ%와(과) %CALLNAME:受けキャラ%이(가) 혀를 얽어 서로를 맛보고 있다……
				表示フラグ ++
			ELSEIF 系統リスト_アイテム系(モード名)
				PRINTFORML %モード名%가 %CALLNAME:受けキャラ%을(를) 기계적으로 몰아붙이는 모습이 보인다……
				表示フラグ ++
			ELSEIF 系統リスト_愛撫系(モード名)
				PRINTFORM %CALLNAME:攻めキャラ%이(가)%TEXTR("정성껏/정중하게/격렬하게/거리낌 없이")%%CALLNAME:受けキャラ%의
				IF モード名 == "Ｃ愛撫"
					IF GETBIT(TALENT:受けキャラ:性別, 1)
						PRINT 음경을
					ELSE
						PRINT 클리토리스를
					ENDIF
				ELSEIF モード名 == "Ｖ愛撫"
						PRINT 질구를
				ELSEIF モード名 == "Ａ愛撫"
						PRINT 항문을
				ELSEIF モード名 == "Ｂ愛撫"
						PRINT 유두를
				ENDIF
				PRINTL 주무르며, 울부짖게 하는 모습이 보인다……
				表示フラグ ++
			ELSEIF 系統リスト_自慰系(モード名)
				PRINTFORM %CALLNAME:受けキャラ%이(가) 자신의 손으로 자신의
				IF 系統リスト_Ｃ自慰系(モード名)
					IF GETBIT(TALENT:受けキャラ:性別, 1)
						PRINT 음경을
					ELSE
						PRINT 클리토리스를
					ENDIF
				ELSEIF 系統リスト_Ｖ自慰系(モード名)
						PRINT 질구를
				ELSEIF 系統リスト_Ａ自慰系(モード名)
						PRINT 항문을
				ELSEIF 系統リスト_Ｂ自慰系(モード名)
						PRINT 유두를
				ENDIF
				PRINTL 주무르며, 쾌락을 탐하는 모습이 보인다……
				表示フラグ ++
			ELSEIF 系統リスト_Ｖ挿入系(モード名)
				PRINTFORML %CALLNAME:攻めキャラ%이(가) %CALLNAME:受けキャラ%에 삽입하며 서로를 원하는 모습이 보인다……
				表示フラグ ++
			ELSEIF 系統リスト_Ａ挿入系(モード名)
				PRINTFORML %CALLNAME:攻めキャラ%이(가) %CALLNAME:受けキャラ%의 아날에 삽입하며 서로를 원하는 모습이 보인다……
				表示フラグ ++
			ENDIF
		NEXT
	ENDIF
	IF 参加人数 == 2 && DT_SELECT("体位モードデータベース", @"対象キャラ = {攻めキャラ}")
		FOR 配列番号, 1, RESULT + 1
			モード名 '= DT_CELL_GETS("体位モードデータベース", RESULT:配列番号, "モード名", 1)
			IF 系統リスト_アイテム系(モード名)
				PRINTFORML %モード名%이(가) %CALLNAME:攻めキャラ%을(를) 기계적으로 공격하는 모습이 보인다……
				表示フラグ ++
			ELSEIF 系統リスト_愛撫系(モード名)
				PRINTFORM %CALLNAME:受けキャラ%이(가) %TEXTR("꼼꼼하게/부드럽게/격렬하게/거리낌 없이")% %CALLNAME:攻めキャラ%의
				IF モード名 == "Ｃ愛撫"
					IF GETBIT(TALENT:攻めキャラ:性別, 1)
						PRINT 음경을
					ELSE
						PRINT 클리토리스를
					ENDIF
				ELSEIF モード名 == "Ｖ愛撫"
						PRINT 질구를
				ELSEIF モード名 == "Ａ愛撫"
						PRINT 아날을
				ELSEIF モード名 == "Ｂ愛撫"
						PRINT 유두를
				ENDIF
				PRINTL 애무하며 봉사하는 모습이 보인다……
				表示フラグ ++
			ELSEIF 系統リスト_自慰系(モード名)
				PRINTFORM %CALLNAME:攻めキャラ%이(가) 자신의 손으로 자신의
				IF 系統リスト_Ｃ自慰系(モード名)
					IF GETBIT(TALENT:攻めキャラ:性別, 1)
						PRINT 음경을
					ELSE
						PRINT 클리토리스를
					ENDIF
				ELSEIF 系統リスト_Ｖ自慰系(モード名)
						PRINT 질구를
				ELSEIF 系統リスト_Ａ自慰系(モード名)
						PRINT 아날을
				ELSEIF 系統リスト_Ｂ自慰系(モード名)
						PRINT 젖꼭지를
				ENDIF
				PRINTL 만지작거리며 쾌락을 탐하는 모습이 보인다……
				表示フラグ ++
			ENDIF
		NEXT
	ENDIF
	IF 表示フラグ
		WAIT
	ELSEIF 参加人数 == 2
		PRINTFORMW %CALLNAME:攻めキャラ%와 %CALLNAME:受けキャラ%이 침대 위에서 다정하게 애정행각을 벌이는 모습이 보인다……
	ELSE
		PRINTFORMW {参加人数}명이 침대 위에서 다정하게 애정행각을 벌이는 모습이 보인다……
	ENDIF
ENDIF


