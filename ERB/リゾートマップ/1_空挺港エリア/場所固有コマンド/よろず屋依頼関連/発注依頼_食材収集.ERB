@発注依頼_食材収集

依頼文章保存 = 
依頼文章保存 += "식량을 모아오게 하여, 식재료 재고를 매일 증가시킵니다.<br>"
依頼文章保存 += "식재료 재고 증가량은 변동됩니다.<br>"
依頼文章保存 += "<br>"
依頼文章保存 += @"변동 범위:"
依頼文章保存 += @"100～200<br>"
依頼文章保存 += @"필요 보수액:%NUM_FORMAT(3000)%<br>"
依頼報酬額 = 3000
依頼文章保存 += "<br>"
依頼文章保存 += "<button value='201'>[201] 이것으로 발주한다</button><br><br>"


@依頼追加表示情報_食材収集(表示依頼枠番号)
#DIM 表示依頼枠番号

詳細文文字列受け渡し変数 = 

@発注実処理_食材収集(表示依頼枠番号)
#DIM 表示依頼枠番号

BINPUT
LOCAL = RESULT
SELECTCASE LOCAL
	CASE 201
		IF MONEY < 依頼報酬額
			PRINTL 
			PRINTW 루피가 부족합니다.
			RETURN 0
		ENDIF
		PRINTL
		PRINTFORMW 의뢰: 식재료 수집을(를) 발주했습니다.
		CALL 各依頼ステータス初期値_食材収集(表示依頼枠番号)
		RETURN 1
	CASE 999
		RETURN -1
ENDSELECT

@各依頼ステータス初期値_食材収集(表示依頼枠番号)
#DIM 表示依頼枠番号
;連続発注用にステータス部分のみ分離

依頼報酬額 = 3000

SIF MONEY < 依頼報酬額
	RETURN -1

MONEY -= 依頼報酬額
遂行中依頼_対象名:表示依頼枠番号 = 食料在庫
依頼完了確率_初期値:表示依頼枠番号 = 100

RETURN 1

@依頼完了時処理_食材収集(表示依頼枠番号)
#DIM 表示依頼枠番号

LOCAL = RAND:100 + 100
依頼報告文字列:表示依頼枠番号 += @"%依頼受注者名:表示依頼枠番号% 이(가) %遂行中依頼:表示依頼枠番号% 의 의뢰를 달성한 것 같다!<br>"
依頼報告文字列:表示依頼枠番号 += @"%遂行中依頼_対象名:表示依頼枠番号% 을(를) {LOCAL}개 얻었다!<br>"
FLAG:食材在庫量 += LOCAL
