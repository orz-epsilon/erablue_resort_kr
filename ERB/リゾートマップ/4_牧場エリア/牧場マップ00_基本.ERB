@GETPLACENAME_4_0(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 1
		TSTR:場所名受渡 = 목장 입구
	CASE 2
		TSTR:場所名受渡 = 매점
	CASE 3
		TSTR:場所名受渡 = 식당
	CASE 4
		TSTR:場所名受渡 = 축사
	CASE 5
		TSTR:場所名受渡 = 방목장
	CASE 6
		TSTR:場所名受渡 = 교류 광장
	CASE 7
		TSTR:場所名受渡 = 창고
ENDSELECT

@GETPLACENAME_4_10(ARG)
#FUNCTION
#DIMS 配列分解文字列, 2

IF 飼育区部屋割り配列:(ARG - 1000) == ""
	LOCALS = 거주자 없음
ELSE
	VARSET 配列分解文字列
	SPLIT 飼育区部屋割り配列:(ARG - 1000), "_", 配列分解文字列
	IF STRCOUNT(飼育区部屋割り配列:(ARG - 1000), "_") > 1
		LOCALS = %CALLNAME:(TOINT(配列分解文字列:0))%외
	ELSE
		LOCALS = %CALLNAME:(TOINT(配列分解文字列:0))%
	ENDIF
ENDIF
TSTR:場所名受渡 = 특별 사육 구역{ARG}번：%LOCALS%

