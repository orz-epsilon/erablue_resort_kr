@DRAW_MAP_BG_4_0(SLICED, 表示文字列)
#DIMS REF 表示文字列
#DIMS SLICED
#DIM 改行フラグ

SELECTCASE SLICED
	;ふつうの
	CASEELSE
		表示文字列 += @"%SLICED%"
ENDSELECT

改行フラグ = 0


@エリア来訪時イベント_4

IF 牧場初来訪イベントフラグ == 0
	DRAWLINE
	PRINTL ［첫 방문：목장 지역］
	DRAWLINE
	PRINTW
	PRINTFORMW %CALLNAME:PLAYER%은(는) 섬을 개척하고, 비어있는 구역에 개척한 목장을 방문했다.
	PRINTFORMW 풍요로운 자연 속에서 가축들이 한가롭게 어울리고 있으며, 동물과 교감하러 온 관광객들의 모습도 보인다.
	PRINTFORMW 목장을 경영하면 리조트에서 사용할 식재료도 충당할 수 있을 것이고, 특별한 가축을 기르면 질 좋은 식자재를 얻는 것도 가능할 것이다.
	PRINTL
	PRINTFORMW 또한, 다른 세계에서 알 등을 가져오면 여기서 돌봐 성장시키는 것도 가능할 것 같다. (※미구현입니다)
	PRINTFORMW 지능이 높은 동물이라면 정착민과 같은 취급을 하여, 리조트 발전에 기여하게 하자.
	PRINTL
	SETCOLOR カラーパレット("黄")
	IF STRCOUNT(所持制服文字列, @"汎用/普通のオーバーオール_") == 0 && STRCOUNT(所持エロ衣装文字列, @"エロ/普通のオーバーオール_") == 0
		PRINTFORMW 목장 구역 완성으로 일반 의상 「평범한 작업복」을 입수했다.
		CALL 制服登録処理("普通のオーバーオール")
	ENDIF
	IF STRCOUNT(所持制服文字列, @"汎用/裸ミニスカオーバーオール_") == 0 && STRCOUNT(所持エロ衣装文字列, @"エロ/裸ミニスカオーバーオール_") == 0
		PRINTFORMW 목장 구역 완성으로 에로 의상 「맨몸 미니스커트 작업복」을 입수했다.
		CALL エロ衣装登録処理("裸ミニスカオーバーオール")
	ENDIF
	RESETCOLOR
	牧場初来訪イベントフラグ = 1
ENDIF


