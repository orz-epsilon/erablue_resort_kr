@家畜設定画面(選択番号)
#DIM 候補数
#DIM 選択番号
#DIMS 家畜名
#DIMS 関数配列, 100

VARSET RESULTS
VARSET 関数配列
候補数 = ENUMFUNCBEGINSWITH("家畜情報_")
ARRAYCOPY "RESULTS", "関数配列"

DRAWLINE
PRINT 현재 설정 가축:
IF 現在設定家畜:選択番号 != ""
	PRINTFORML %現在設定家畜:選択番号%
	SELECTCASE 現在設定家畜:選択番号
		CASE "デジタマ"
			PRINT ※가축을 전환하면 디지타마의 성장 정도가 리셋됩니다.
	ENDSELECT
ELSE
	PRINT --------------------
ENDIF
PRINTL
DRAWLINE

FOR LOCAL, 0, 候補数
	RESULT = 0
	TRYCALLFORM %関数配列:LOCAL%("出現条件")
	IF RESULT
		家畜名 = %SUBSTRING(関数配列:LOCAL, 9)%
		SIF 現在設定家畜:選択番号 == 家畜名
			CONTINUE
		詳細文文字列受け渡し変数 = 
		詳細文文字列受け渡し変数２ = 
		TRYCALLFORM %関数配列:LOCAL%("基礎情報")
		HTML_PRINT @"<button title='<br>%詳細文文字列受け渡し変数%<br>%詳細文文字列受け渡し変数２%' value='{LOCAL}'>[{LOCAL}] %家畜名%</button>"
	ENDIF
NEXT
PRINTL
PRINTBUTTON "[999] 변경하지 않고 돌아가기", 999
PRINTL
PRINTL
BINPUT
PRINTL
PRINTL
PRINTL

LOCAL = RESULT
SELECTCASE LOCAL
	CASE 999
		RETURN 0
	CASEELSE
		現在設定家畜:選択番号 '= SUBSTRING(関数配列:LOCAL, 9)
		家畜_記録変数:選択番号 = 0
		RETURN 0
ENDSELECT



@特別飼育区_ランダムキャラ追加(管理番号, 進化先No)
#DIM 管理番号
#DIM キャラ番号
#DIM 部屋番号
#DIM 進化先No

キャラ番号 = CHARANUM

ADDCHARA 進化先No
CALL ランダムキャラデータ復元(Ｒキャラ追加候補記録, キャラ番号, 管理番号)

CALL ADD_PERSON_FROM_CHARA(キャラ番号)
CALL コマンド存在チェック
CALL キャラクター初期化(キャラ番号)

;汎用立ち絵を使わないよう、生成後に汎用立ち絵登録文字列を消す
CSTR:キャラ番号:汎用立ち絵登録文字列 = 

CFLAG:キャラ番号:招待不可フラグ = 0
CALL ステータス記録_ランダムキャラデータベース(Ｒキャラ追加候補記録, 管理番号, CFLAG:キャラ番号:人物番号)

;定住処理
TALENT:キャラ番号:定住者 = 3
CFLAG:キャラ番号:滞在期間 = 999
FOR 部屋番号, 0, 特別飼育区広さ()
	IF 飼育区部屋割り配列:部屋番号 == ""
		飼育区部屋割り配列:部屋番号 = {キャラ番号}_
		BREAK
	ENDIF
NEXT
CFLAG:LOCAL:信頼度 += 経験値テーブル:30
CALL FAVOR_LvUPCheck(LOCAL)
CALL 口上変数初期化
