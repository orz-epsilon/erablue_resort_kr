

@家畜情報_ウットリュフ豚(動作モード, 家畜番号 = -1)
#DIMS 動作モード
#DIMS 入手名
#DIM 家畜番号

SELECTCASE 動作モード
	CASE "出現条件"
		;出現する場合は１を返す
		RETURN 1
	CASE "基礎情報"
		;フレーバーの解説
詳細文文字列受け渡し変数 = 우트뤼프라고 불리는 버섯을 등에 기른 돼지.<br>
詳細文文字列受け渡し変数 += "고기에도 버섯 향이 배어 있어, 그냥 굽기만 해도 맛있다.<br>"
詳細文文字列受け渡し変数 += "충분히 자란 후에는 등의 버섯도 먹을 수 있다.<br>"
		;登場イベ：Oh My リュミエール♪

		;特殊効果の解説
詳細文文字列受け渡し変数２ = 수요일 종료 시에 「평범한 돼지고기」「질 좋은 돼지고기」「녹는 돼지고기」 중에서 무작위로 1개를 얻는다.<br>
		RETURN 1500
	CASE "通常_一日終了時効果"
		;一日終了時レポート処理_その他報告で呼ばれる
		;水曜のみ
		SIF GET_DAY() != "水"
			RETURN 0

RSTR:その他報告_記録文字列 += "　　가축: 우트뤼프 돼지에게서"

		SELECTCASE RAND:3
			CASE 0
				入手名 = ただの豚肉
			CASE 1
				入手名 = 質の良い豚肉
			CASE 2
				入手名 = とろける豚肉
		ENDSELECT

		CALL 素材入手処理(入手名, 1)
		RSTR:その他報告_記録文字列 += @"%入手名%"
RSTR:その他報告_記録文字列 += "을(를) 손에 넣었다!<br>"
ENDSELECT

