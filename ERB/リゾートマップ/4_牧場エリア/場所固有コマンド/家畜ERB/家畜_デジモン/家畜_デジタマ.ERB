

@家畜情報_デジタマ（デジモンシリーズ）(動作モード, 家畜番号 = -1)
#DIMS 動作モード
#DIMS 入手名
#DIM 家畜番号

SELECTCASE 動作モード
	CASE "出現条件"
		;出現する場合は１を返す
		RETURN 1
	CASE "基礎情報"
		;フレーバーの解説
		詳細文文字列受け渡し変数 = 모든 디지몬 시리즈의 근원이 되는 알. <br>
		詳細文文字列受け渡し変数 += "5일간 키우면 무작위 유년기 디지몬으로 진화한다. <br>"
		詳細文文字列受け渡し変数 += "진화 전에 전환하면 기간이 리셋되니 주의. <br>"

		;特殊効果の解説
		詳細文文字列受け渡し変数２ = 5일간 키우면 다른 가축으로 변화한다.
		IF 家畜番号 >= 0
			詳細文文字列受け渡し変数２ += @"（현재{家畜_記録変数:家畜番号}일 경과）"
		ENDIF
		詳細文文字列受け渡し変数２ += "<br>"
		RETURN 10
	CASE "通常_一日終了時効果"
		;一日終了時レポート処理_その他報告で呼ばれる
		;５日カウント
		家畜_記録変数:家畜番号 ++
		IF 家畜_記録変数:家畜番号 >= 5
			;孵化する
			
			RSTR:その他報告_記録文字列 += "　　가축: 디지타마가 부화하여 가축:"

			SELECTCASE RAND:3
				CASE 0
					;ワクチン系列
					入手名 = コロモン
				CASE 1
					;データ系列
					入手名 = ツノモン
				CASE 2
					;ウィルス系列
					入手名 = パグモン
			ENDSELECT

			RSTR:その他報告_記録文字列 += @"%入手名%으로 진화했다!<br>"
			レポート強調フラグ:その他報告 = 1
			家畜_記録変数:家畜番号 = 0
			現在設定家畜:家畜番号 = %入手名%（デジモンシリーズ）
		ENDIF
ENDSELECT

