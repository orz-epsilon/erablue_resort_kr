

@家畜情報_ツノモン（デジモンシリーズ）(動作モード, 家畜番号 = -1)
#DIMS 動作モード
#DIMS 入手名
#DIM 家畜番号
#DIM 候補数
#DIM 進化先No


SELECTCASE 動作モード
	CASE "出現条件"
		;出現する場合は１を返す
		;デジタマからの進化なので出現しない
		RETURN 0
	CASE "基礎情報"
		;フレーバーの解説
		詳細文文字列受け渡し変数 = 유년기 디지몬의 일종. 둥근 몸으로 활발하게 움직인다. <br>
		詳細文文字列受け渡し変数 += "5일간 키우면 무작위 디지몬으로 진화한다. <br>"
		詳細文文字列受け渡し変数 += "(데이터종 디지몬으로 진화하기 쉽다) <br>"
		詳細文文字列受け渡し変数 += "진화 전에 전환한다 하면 기간이 초기화되니 주의. <br>"

		;特殊効果の解説
		詳細文文字列受け渡し変数２ = 5일간 키우면 다른 가축으로 변화한다.
		IF 家畜番号 >= 0
			詳細文文字列受け渡し変数２ += @"(현재 {家畜_記録変数:家畜番号}일 경과)"
		ENDIF
		詳細文文字列受け渡し変数２ += "<br>"
		RETURN 1000
	CASE "通常_一日終了時効果"
		;一日終了時レポート処理_その他報告で呼ばれる
		;５日カウント
		家畜_記録変数:家畜番号 ++
		IF 家畜_記録変数:家畜番号 >= 5
			;進化する
			RSTR:その他報告_記録文字列 += "　　가축: 뿔몬(디지몬 시리즈)이 진화할 것 같다……!<br>"
			レポート強調フラグ:その他報告 = 1
		ENDIF
	CASE "重要_一日終了時効果"
		;レポート閉じた後に一つずつ呼ばれる
		IF 家畜_記録変数:家畜番号 >= 5
			;進化する処理
			家畜_記録変数:家畜番号 = 0

			;進化先決定
			IF RAND:2
				;50%で特定種のデジモンへ
				候補数 = DT_SELECT("ランダムCSVデータベース", "ランダムキャラ設定 = 'デジモン' And フリー文字列１ = 'データ種'")
			ELSE
				;それ以外は全部から抽選
				候補数 = DT_SELECT("ランダムCSVデータベース", "ランダムキャラ設定 = 'デジモン'")
			ENDIF
			IF 候補数 < 1
				DRAWLINE
				PRINTFORMW 뿔몬은(는) 진화하지 못했다……
				RETURN 0
			ENDIF

			進化先No = DT_CELL_GET("ランダムCSVデータベース", RESULT:(RAND:候補数 + 1), "CSV番号", 1)

			DRAWLINE
			PRINTFORMW 뿔몬은(는) %CSVCALLNAME(進化先No)%(으)로 진화했다!
			DRAWLINE
			CALL ランダムキャラ加入確認_デジモンシリーズ(進化先No)
		ENDIF
ENDSELECT

