

@家畜情報_お牛さま(動作モード, 家畜番号 = -1)
#DIMS 動作モード
#DIMS 入手名
#DIM 家畜番号

SELECTCASE 動作モード
	CASE "出現条件"
		;出現する場合は１を返す
		RETURN 1
	CASE "基礎情報"
		;フレーバーの解説
		詳細文文字列受け渡し変数 = 우신궁에서 기르는 것과 같은 품종의 젖소. <br>
		詳細文文字列受け渡し変数 += "진하고 깔끔한 풍미의 우유를 채취할 수 있다. <br>"
		詳細文文字列受け渡し変数 += "육우로서도 일정 이상의 품질을 기대할 수 있는 가성비 좋은 가축. <br>"

		;特殊効果の解説
		詳細文文字列受け渡し変数２ = 월요일 종료 시 「저렴한 소고기」「보통 소고기」「고급 소고기」 중에서 무작위로 1개 입수한다. <br>
		RETURN 3000
	CASE "通常_一日終了時効果"
		;一日終了時レポート処理_その他報告で呼ばれる
		;月曜のみ
		SIF GET_DAY() != "月"
			RETURN 0

		RSTR:その他報告_記録文字列 += "　　가축: 소님에게서"

		SELECTCASE RAND:3
			CASE 0
				入手名 = お手頃牛肉
			CASE 1
				入手名 = 普通の牛肉
			CASE 2
				入手名 = 高級牛肉
		ENDSELECT

		CALL 素材入手処理(入手名, 1)
		RSTR:その他報告_記録文字列 += @"%入手名%"
		RSTR:その他報告_記録文字列 += "을(를) 손에 넣었다!<br>"
ENDSELECT

