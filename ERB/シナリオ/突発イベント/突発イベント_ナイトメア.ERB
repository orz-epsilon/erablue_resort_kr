#DIM キャラ番号_キクル
;イベント消滅日数渡し = 10
;イベント消滅確率渡し = 30
;イベント再発生日数渡し = 20
;イベント再発生確率渡し = 50

キャラ番号_キクル = GETCHARA(3024) ;
SIF CFLAG:キャラ番号_キクル:招待不可フラグ != 0
	RETURN 0
SIF イベント完了フラグ確認("カミカイヒ_ストーリー") < 1
    RETURN 0
RETURN 1

