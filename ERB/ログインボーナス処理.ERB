@DISTRIBUTE_GACHA(REWARDS,REWARD_AMOUNT)
#DIMS REF REWARDS
#DIM REF REWARD_AMOUNT
#DIM DIST_METHOD
#DIMS REWARD_NAME
#DIM UNDERSCORE_POS



